{
  "manifest_version": 3,
  "name": "ONEOFFICEAUTOMATION Browser Connector",
  "short_name": "OOA Connector",
  "version": "1.1.2",
  "description": "Lets ONEOFFICEAUTOMATION agents and Agent Studio see, capture, record and automate tabs in this browser.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "scripting", "nativeMessaging", "webNavigation", "storage", "alarms", "downloads", "debugger"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "all_frames": true,
    "match_about_blank": true,
    "run_at": "document_idle",
    "js": ["ooa-page.js", "content.js"]
  }],
  "action": { "default_title": "ONEOFFICEAUTOMATION Browser Connector", "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
