# Supply-chain rules (docs/architecture/12-ui-redesign.md, section 7): exact versions, no install scripts.
save-exact=true
ignore-scripts=true
fund=false
audit-level=high
# npm 11.5 fails resolving Vitest 5's optional peers ("reading 'edgesOut'"); every package we use is listed in
# package.json, and "npm ls" checks the peers.
legacy-peer-deps=true
