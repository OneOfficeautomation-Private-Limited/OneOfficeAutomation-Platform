[
 {
  "command": "ooa.email/send",
  "name": "send through the session's outgoing server (new), then find and read it",
  "requires": "mail",
  "credentials": {
   "pw": "test/mail/password"
  },
  "files": {
   "invoice.txt": "INV-1"
  },
  "steps": [
   {
    "action": "ooa.email/connect",
    "args": {
     "imap_host": "127.0.0.1",
     "port": "{imap_port}",
     "user": "bot@sample.test",
     "password": "$pw",
     "security": "none",
     "smtp_host": "127.0.0.1",
     "smtp_port": "{smtp_port}",
     "smtp_security": "none"
    }
   },
   {
    "action": "ooa.email/send",
    "args": {
     "to": "bot@sample.test",
     "subject": "Invoice 1",
     "body": "Please pay",
     "attachments": [
      "{tmp}/invoice.txt"
     ],
     "importance": "high"
    },
    "out": {
     "message_id": "mid"
    }
   },
   {
    "action": "ooa.email/list",
    "args": {
     "subject_contains": "Invoice"
    },
    "out": {
     "table": "t",
     "count": "n"
    }
   },
   {
    "action": "ooa.datatable/get_value",
    "args": {
     "table": "$t",
     "row": 0,
     "column": "id"
    },
    "out": {
     "value": "id"
    }
   },
   {
    "action": "ooa.email/get",
    "args": {
     "id": "$id"
    },
    "out": {
     "email": "e"
    }
   },
   {
    "action": "core/set",
    "args": {
     "variable": "subject",
     "value": {
      "expr": "$e.subject"
     }
    }
   },
   {
    "action": "ooa.email/disconnect"
   }
  ],
  "expect": {
   "n": 1,
   "subject": "Invoice 1",
   "mid": {
    "$contains": "@"
   }
  }
 },
 {
