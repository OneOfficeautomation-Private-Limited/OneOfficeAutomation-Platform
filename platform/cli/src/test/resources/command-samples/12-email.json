 {
  "command": "ooa.email/reply",
  "name": "reply, reply all, forward, mark, attachments, eml, folders, move, delete",
  "requires": "mail",
  "credentials": {
   "pw": "test/mail/password"
  },
  "files": {
   "a.pdf": "%PDF-1.4 sample"
  },
  "steps": [
   {
    "action": "ooa.email/connect",
    "args": {
     "imap_host": "127.0.0.1",
     "port": "{imap_port}",
     "user": "bot@sample.test",
     "password": "$pw",
     "security": "none",
     "smtp_host": "127.0.0.1",
     "smtp_port": "{smtp_port}",
     "smtp_security": "none"
    }
   },
   {
    "action": "ooa.email/send",
    "args": {
     "to": "bot@sample.test",
     "cc": "other@sample.test",
     "subject": "Order 7",
     "body": "hello",
     "attachments": [
      "{tmp}/a.pdf"
     ]
    }
   },
   {
    "action": "ooa.email/list",
    "out": {
     "table": "t"
    }
   },
   {
    "action": "ooa.datatable/get_value",
    "args": {
     "table": "$t",
     "row": 0,
     "column": "id"
    },
    "out": {
     "value": "id"
    }
   },
   {
    "action": "ooa.email/reply",
    "args": {
     "id": "$id",
     "body": "Thanks"
    }
   },
   {
    "action": "ooa.email/reply_all",
    "args": {
     "id": "$id",
     "body": "Thanks all"
    }
   },
   {
    "action": "ooa.email/forward",
    "args": {
     "id": "$id",
     "to": "bot@sample.test",
     "note": "FYI"
    }
   },
   {
    "action": "ooa.email/mark",
    "args": {
     "id": "$id",
     "read": false,
     "flagged": true
    }
   },
   {
    "action": "ooa.email/list",
    "args": {
     "unread_only": true
    },
    "out": {
     "count": "unread"
    }
   },
   {
    "action": "ooa.email/save_attachments",
    "args": {
     "id": "$id",
     "target_folder": "{tmp}/att"
    },
    "out": {
     "files": "files"
    }
   },
   {
    "action": "ooa.email/save_email_as_eml",
    "args": {
     "id": "$id",
     "local_path": "{tmp}/order.eml"
    }
   },
   {
    "action": "ooa.email/folder_exists",
    "args": {
     "folder": "Done"
    },
    "out": {
     "exists": "before"
    }
   },
   {
    "action": "ooa.email/move",
    "args": {
     "id": "$id",
     "to_folder": "Done",
     "create_folder": true
    }
   },
   {
    "action": "ooa.email/folder_exists",
    "args": {
     "folder": "Done"
    },
    "out": {
     "exists": "after"
    }
   },
   {
    "action": "ooa.email/get_folders",
    "out": {
     "folders": "folders"
    }
   },
   {
    "action": "ooa.email/list",
    "args": {
     "subject_contains": "Re:"
    },
    "out": {
     "count": "replies"
    }
   },
   {
    "action": "ooa.email/list",
    "args": {
     "subject_contains": "Fwd"
    },
    "out": {
     "count": "forwards"
    }
   },
   {
    "action": "ooa.email/save_all_attachments",
    "args": {
     "target_folder": "{tmp}/all",
     "folder": "Done"
    },
    "out": {
     "files": "allfiles"
    }
   },
   {
    "action": "ooa.email/move_all",
    "args": {
     "to_folder": "Done",
     "subject_contains": "Re:"
    },
    "out": {
     "count": "moved"
    }
   },
   {
    "action": "ooa.email/delete_all",
    "args": {
     "folder": "Done",
     "permanent": true
    },
    "out": {
     "count": "deleted"
    }
   },
   {
    "action": "ooa.email/list",
    "out": {
     "table": "rest",
     "count": "left"
    }
   },
   {
    "action": "ooa.datatable/get_value",
    "args": {
     "table": "$rest",
     "row": 0,
     "column": "id"
    },
    "out": {
     "value": "last"
    }
   },
   {
    "action": "ooa.email/delete",
    "args": {
     "id": "$last",
     "permanent": true
    }
   },
   {
    "action": "ooa.email/list",
    "out": {
     "count": "empty"
    }
   },
   {
    "action": "ooa.email/disconnect"
   }
  ],
  "expect": {
   "unread": 4,
   "files": {
    "$type": "array"
   },
   "before": false,
   "after": true,
   "replies": 2,
   "forwards": 1,
   "moved": 2,
   "deleted": 3,
   "left": 1,
   "empty": 0
  },
  "expectFiles": {
   "att/a.pdf": "%PDF-1.4 sample",
   "order.eml": true
  }
 },
 {
