[
 {
  "command": "core/set",
  "name": "expression",
  "vars": {
   "a": 2
  },
  "steps": [
   {
    "action": "core/set",
    "args": {
     "variable": "b",
     "value": {
      "expr": "$a * 21"
     }
    }
   }
  ],
  "expect": {
   "b": 42
  }
 },
 {
  "command": "core/set",
  "name": "text with interpolation",
  "vars": {
   "n": "Ann"
  },
  "steps": [
   {
    "action": "core/set",
    "args": {
     "variable": "t",
     "value": "Hello ${n}!"
    }
   }
  ],
  "expect": {
   "t": "Hello Ann!"
  }
 },
 {
  "command": "core/if",
  "name": "else-if branch",
  "vars": {
   "amount": 500,
   "band": ""
  },
  "steps": [
   {
    "action": "core/if",
    "args": {
     "condition": {
      "op": "gt",
      "left": "$amount",
      "right": 1000
     }
    },
    "children": [
     {
      "action": "core/set",
      "args": {
       "variable": "band",
       "value": "high"
      }
     }
    ],
    "elseIf": [
     {
      "condition": {
       "op": "between",
       "left": "$amount",
       "right": [
        100,
        1000
       ]
      },
      "children": [
       {
        "action": "core/set",
        "args": {
         "variable": "band",
         "value": "mid"
        }
       }
      ]
     }
    ],
    "else": [
     {
      "action": "core/set",
      "args": {
       "variable": "band",
       "value": "low"
      }
     }
    ]
   }
  ],
  "expect": {
   "band": "mid"
  }
 },
 {
  "command": "core/if",
  "name": "ignore case and all-of group",
  "vars": {
   "s": "  Paid ",
   "ok": false
  },
  "steps": [
   {
    "action": "core/if",
    "args": {
     "condition": {
      "all": [
       {
        "op": "eq",
        "left": "$s",
        "right": "PAID",
        "ignoreCase": true,
        "trim": true
       },
       "len($s) > 2"
      ]
     }
    },
    "children": [
     {
      "action": "core/set",
      "args": {
       "variable": "ok",
       "value": true
      }
     }
    ]
   }
  ],
  "expect": {
   "ok": true
  }
 },
 {
  "command": "core/loop",
  "name": "times with start and step",
  "vars": {
   "sum": 0
  },
  "steps": [
   {
    "action": "core/loop",
    "args": {
     "iterator": "times",
     "count": 4,
     "start": 10,
     "step": 5,
     "as": "i"
    },
    "children": [
     {
      "action": "core/set",
      "args": {
       "variable": "sum",
       "value": {
        "expr": "$sum + $i"
       }
      }
     }
    ]
   }
  ],
  "expect": {
   "sum": 70,
   "i": 25
  }
 },
 {
  "command": "core/loop",
  "name": "list range reversed with index",
  "vars": {
   "items": [
    "a",
    "b",
    "c",
    "d"
   ],
   "out": ""
  },
  "steps": [
   {
    "action": "core/loop",
    "args": {
     "iterator": "list",
     "over": "$items",
     "from_index": 1,
     "to_index": 2,
     "reverse": true,
     "as": "x",
     "index": "k"
    },
    "children": [
     {
      "action": "core/set",
      "args": {
       "variable": "out",
       "value": "${out}${x}${k}"
      }
     }
    ]
   }
  ],
  "expect": {
   "out": "c2b1"
  }
 },
 {
  "command": "core/loop",
  "name": "while checked at end",
  "vars": {
   "n": 5
  },
  "steps": [
   {
    "action": "core/loop",
    "args": {
     "iterator": "while",
     "condition": {
      "op": "lt",
      "left": "$n",
      "right": 3
     },
     "check_at_end": true
    },
    "children": [
     {
      "action": "core/set",
      "args": {
       "variable": "n",
       "value": {
        "expr": "$n + 1"
       }
      }
     }
    ]
   }
  ],
  "expect": {
   "n": 6
  }
 },
 {
