 {
  "command": "core/loop",
  "name": "safety limit",
  "vars": {
   "n": 0
  },
  "steps": [
   {
    "action": "core/loop",
    "args": {
     "iterator": "while",
     "condition": "true",
     "max_iterations": 3
    },
    "children": [
     {
      "action": "core/set",
      "args": {
       "variable": "n",
       "value": {
        "expr": "$n + 1"
       }
      }
     }
    ]
   }
  ],
  "error": "LOOP.LIMIT"
 },
 {
  "command": "core/break",
  "name": "labelled outer loop",
  "vars": {
   "hits": 0
  },
  "steps": [
   {
    "action": "core/loop",
    "args": {
     "iterator": "times",
     "count": 3,
     "label": "outer"
    },
    "children": [
     {
      "action": "core/loop",
      "args": {
       "iterator": "times",
       "count": 3,
       "as": "j"
      },
      "children": [
       {
        "action": "core/set",
        "args": {
         "variable": "hits",
         "value": {
          "expr": "$hits + 1"
         }
        }
       },
       {
        "action": "core/if",
        "args": {
         "condition": "$j == 1"
        },
        "children": [
         {
          "action": "core/break",
          "args": {
           "label": "outer"
          }
         }
        ]
       }
      ]
     }
    ]
   }
  ],
  "expect": {
   "hits": 2
  }
 },
 {
  "command": "core/continue",
  "name": "skip even",
  "vars": {
   "odd": 0
  },
  "steps": [
   {
    "action": "core/loop",
    "args": {
     "iterator": "times",
     "count": 5,
     "as": "i"
    },
    "children": [
     {
      "action": "core/if",
      "args": {
       "condition": "$i % 2 == 0"
      },
      "children": [
       {
        "action": "core/continue"
       }
      ]
     },
     {
      "action": "core/set",
      "args": {
       "variable": "odd",
       "value": {
        "expr": "$odd + 1"
       }
      }
     }
    ]
   }
  ],
  "expect": {
   "odd": 2
  }
 },
 {
  "command": "core/try",
  "name": "catch by code, message and line",
  "vars": {
   "msg": "",
   "fin": false
  },
  "steps": [
   {
    "action": "core/try",
    "children": [
     {
      "action": "core/throw",
      "args": {
       "code": "BUSINESS.NO_INVOICE",
       "message": "Invoice missing"
      }
     }
    ],
    "catch": [
     {
      "codes": [
       "BUSINESS.*"
      ],
      "as": "err",
      "message_to": "msg",
      "children": []
     }
    ],
    "finally": [
     {
      "action": "core/set",
      "args": {
       "variable": "fin",
       "value": true
      }
     }
    ]
   }
  ],
  "expect": {
   "msg": "Invoice missing",
   "fin": true,
   "err": {
    "$type": "object"
   }
  }
 },
 {
  "command": "core/throw",
