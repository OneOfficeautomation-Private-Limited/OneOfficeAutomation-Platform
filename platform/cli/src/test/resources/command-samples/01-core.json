 {
  "command": "core/run_bot",
  "name": "inputs and output map",
  "agents": {
   "double": {
    "kind": "TaskBot",
    "id": "double",
    "name": "double",
    "variables": [
     {
      "name": "n",
      "type": "Number",
      "direction": "input",
      "required": true
     },
     {
      "name": "r",
      "type": "Number",
      "direction": "output",
      "default": 0
     }
    ],
    "steps": [
     {
      "id": "1",
      "action": "core/set",
      "args": {
       "variable": "r",
       "value": {
        "expr": "$n * 2"
       }
      }
     }
    ]
   }
  },
  "vars": {
   "x": 21,
   "y": 0
  },
  "steps": [
   {
    "action": "core/run_bot",
    "args": {
     "automation": "double",
     "inputs": {
      "n": "$x"
     },
     "output_map": {
      "r": "y"
     },
     "repeat": 2
    },
    "out": {
     "status": "st",
     "runs": "runs"
    }
   }
  ],
  "expect": {
   "y": 42,
   "st": "success",
   "runs": 2
  }
 },
 {
  "command": "core/run_bot",
  "name": "child fails, parent carries on",
  "agents": {
   "bad": {
    "kind": "TaskBot",
    "id": "bad",
    "name": "bad",
    "variables": [],
    "steps": [
     {
      "id": "1",
      "action": "core/throw",
      "args": {
       "code": "BUSINESS.X",
       "message": "no"
      }
     }
    ]
   }
  },
  "steps": [
   {
    "action": "core/run_bot",
    "args": {
     "automation": "bad",
     "fail_on_error": false
    },
    "out": {
     "status": "st",
     "error": "err"
    }
   }
  ],
  "expect": {
   "st": "failed",
   "err": {
    "$type": "object"
   }
  }
 }
]