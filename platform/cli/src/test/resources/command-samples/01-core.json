 {
  "command": "core/stop",
  "name": "ends the run, finally still runs",
  "vars": {
   "after": false,
   "fin": false
  },
  "steps": [
   {
    "action": "core/try",
    "children": [
     {
      "action": "core/stop",
      "args": {
       "message": "done early"
      }
     },
     {
      "action": "core/set",
      "args": {
       "variable": "after",
       "value": true
      }
     }
    ],
    "finally": [
     {
      "action": "core/set",
      "args": {
       "variable": "fin",
       "value": true
      }
     }
    ]
   }
  ],
  "expect": {
   "after": false,
   "fin": true
  }
 },
