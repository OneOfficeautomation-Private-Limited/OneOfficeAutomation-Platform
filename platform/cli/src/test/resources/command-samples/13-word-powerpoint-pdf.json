 {
  "command": "ooa.powerpoint/create_presentation",
  "name": "slides, text on the last slide (new default), table, replace, format, copy, delete, read",
  "steps": [
   {
    "action": "ooa.powerpoint/create_presentation",
    "args": {
     "path": "{tmp}/p.pptx"
    }
   },
   {
    "action": "ooa.powerpoint/add_slide",
    "args": {
     "layout": "title_only",
     "title": "Q3 {{region}}"
    },
    "out": {
     "slide": "s1"
    }
   },
   {
    "action": "ooa.powerpoint/insert_text",
    "args": {
     "text": "Revenue up"
    }
   },
   {
    "action": "ooa.powerpoint/insert_table",
    "args": {
     "table": {
      "columns": [
       "Region",
       "Sales"
      ],
      "rows": [
       [
        "North",
        "10"
       ]
      ]
     }
    }
   },
   {
    "action": "ooa.powerpoint/find_replace_text",
    "args": {
     "find": "{{region}}",
     "replace_with": "North"
    },
    "out": {
     "count": "r"
    }
   },
   {
    "action": "ooa.powerpoint/format_text",
    "args": {
     "text": "Revenue",
     "bold": true,
     "color": "#00AA00"
    },
    "out": {
     "count": "f"
    }
   },
   {
    "action": "ooa.powerpoint/copy_slide",
    "args": {
     "slide": 1
    },
    "out": {
     "slide": "s2"
    }
   },
   {
    "action": "ooa.powerpoint/slide_count",
    "out": {
     "count": "before"
    }
   },
   {
    "action": "ooa.powerpoint/delete_slide",
    "args": {
     "slide": 2
    }
   },
   {
    "action": "ooa.powerpoint/slide_count",
    "out": {
     "count": "after"
    }
   },
   {
    "action": "ooa.powerpoint/read_text",
    "out": {
     "text": "txt"
    }
   },
   {
    "action": "ooa.powerpoint/save"
   },
   {
    "action": "ooa.powerpoint/save_as",
    "args": {
     "path": "{tmp}/copy.pptx"
    }
   },
   {
    "action": "ooa.powerpoint/close"
   },
   {
    "action": "ooa.powerpoint/open",
    "args": {
     "path": "{tmp}/copy.pptx"
    }
   },
   {
    "action": "ooa.powerpoint/slide_count",
    "out": {
     "count": "reopened"
    }
   }
  ],
  "expect": {
   "s1": 1,
   "r": 1,
   "f": 1,
   "s2": 2,
   "before": 2,
   "after": 1,
   "reopened": 1,
   "txt": {
    "$contains": "Q3 North"
   }
  },
  "expectFiles": {
   "p.pptx": true
  }
 },
