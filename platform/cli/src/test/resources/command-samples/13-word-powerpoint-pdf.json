 {
  "command": "ooa.pdf/page_count",
  "name": "pages, text, area text, properties, split, merge a folder (new), images, encrypt, decrypt",
  "files": {
   "in/a.pdf": "%PDF-1.4\n1 0 obj << /Type /Catalog /Pages 2 0 R >> endobj\n2 0 obj << /Type /Pages /Kids [3 0 R 5 0 R] /Count 2 >> endobj\n3 0 obj << /Type /Page /Parent 2 0 R /MediaBox [0 0 300 200] /Contents 4 0 R /Resources << /Font << /F1 6 0 R >> >> >> endobj\n4 0 obj << /Length 44 >> stream\nBT /F1 18 Tf 20 150 Td (Invoice 7) Tj ET\nendstream endobj\n5 0 obj << /Type /Page /Parent 2 0 R /MediaBox [0 0 300 200] /Contents 7 0 R /Resources << /Font << /F1 6 0 R >> >> >> endobj\n6 0 obj << /Type /Font /Subtype /Type1 /BaseFont /Helvetica >> endobj\n7 0 obj << /Length 42 >> stream\nBT /F1 18 Tf 20 150 Td (Page two) Tj ET\nendstream endobj\ntrailer << /Root 1 0 R >>\n%%EOF\n"
  },
  "steps": [
   {
    "action": "ooa.pdf/page_count",
    "args": {
     "path": "{tmp}/in/a.pdf"
    },
    "out": {
     "count": "pages"
    }
   },
   {
    "action": "ooa.pdf/extract_text",
    "args": {
     "path": "{tmp}/in/a.pdf",
     "pages": "2"
    },
    "out": {
     "text": "p2"
    }
   },
   {
    "action": "ooa.pdf/extract_area_text",
    "args": {
     "path": "{tmp}/in/a.pdf",
     "page": 1,
     "x": 0,
     "y": 0,
     "width": 300,
     "height": 100
    },
    "out": {
     "text": "area"
    }
   },
   {
    "action": "ooa.pdf/get_properties",
    "args": {
     "path": "{tmp}/in/a.pdf"
    },
    "out": {
     "properties": "props"
    }
   },
   {
    "action": "ooa.pdf/split",
    "args": {
     "path": "{tmp}/in/a.pdf",
     "target_folder": "{tmp}/parts"
    },
    "out": {
     "files": "parts"
    }
   },
   {
    "action": "ooa.pdf/merge",
    "args": {
     "folder": "{tmp}/parts",
     "target": "{tmp}/merged.pdf"
    },
    "out": {
     "page_count": "merged",
     "files": "used"
    }
   },
   {
    "action": "ooa.pdf/to_images",
    "args": {
     "path": "{tmp}/in/a.pdf",
     "target_folder": "{tmp}/img",
     "dpi": 50,
     "pages": "1"
    },
    "out": {
     "files": "imgs"
    }
   },
   {
    "action": "ooa.pdf/extract_images",
    "args": {
     "path": "{tmp}/in/a.pdf",
     "target_folder": "{tmp}/ex"
    },
    "out": {
     "count": "embedded"
    }
   },
   {
    "action": "ooa.pdf/encrypt",
    "args": {
     "path": "{tmp}/merged.pdf",
     "target": "{tmp}/locked.pdf",
     "user_password": "$up",
     "owner_password": "$op"
    }
   },
   {
    "action": "ooa.pdf/decrypt",
    "args": {
     "path": "{tmp}/locked.pdf",
     "password": "$up",
     "target": "{tmp}/open.pdf"
    }
   },
   {
    "action": "ooa.pdf/page_count",
    "args": {
     "path": "{tmp}/open.pdf"
    },
    "out": {
     "count": "reopened"
    }
   },
   {
    "action": "ooa.pdf/read_form",
    "args": {
     "path": "{tmp}/open.pdf"
    },
    "out": {
     "fields": "fields"
    }
   }
  ],
  "expect": {
   "pages": 2,
   "p2": {
    "$contains": "Page two"
   },
   "area": {
    "$contains": "Invoice 7"
   },
   "props": {
    "$type": "object"
   },
   "merged": 2,
   "embedded": 0,
   "reopened": 2,
   "fields": {}
  },
  "expectFiles": {
   "merged.pdf": true,
   "locked.pdf": true
  },
  "credentials": {
   "up": "test/pdf/user",
   "op": "test/pdf/owner"
  },
  "secrets": {
   "test/pdf/user": "u1",
   "test/pdf/owner": "o1"
  }
 },
