[
 {
  "command": "ooa.word/create_document",
  "name": "create, write (no blank first line, fixed), replace in a paragraph range (new), format, table, read back",
  "steps": [
   {
    "action": "ooa.word/create_document",
    "args": {
     "path": "{tmp}/d.docx"
    }
   },
   {
    "action": "ooa.word/add_paragraph",
    "args": {
     "text": "Dear {{name}},"
    }
   },
   {
    "action": "ooa.word/add_paragraph",
    "args": {
     "text": "Total: {{amount}}",
     "bold": true
    }
   },
   {
    "action": "ooa.word/add_paragraph",
    "args": {
     "text": "Footer {{name}}"
    }
   },
   {
    "action": "ooa.word/insert_text",
    "args": {
     "text": "INVOICE",
     "position": "start"
    }
   },
   {
    "action": "ooa.word/replace_text",
    "args": {
     "find": "{{name}}",
     "replace_with": "Ann",
     "from_paragraph": 1,
     "to_paragraph": 2
    },
    "out": {
     "count": "n1"
    }
   },
   {
    "action": "ooa.word/replace_text",
    "args": {
     "find": "{{amount}}",
     "replace_with": "42.00"
    },
    "out": {
     "count": "n2"
    }
   },
   {
    "action": "ooa.word/format_text",
    "args": {
     "text": "INVOICE",
     "bold": true,
     "size": 18,
     "color": "#C00000"
    },
    "out": {
     "count": "f"
    }
   },
   {
    "action": "ooa.word/add_table",
    "args": {
     "table": {
      "columns": [
       "Item",
       "Qty"
      ],
      "rows": [
       [
        "pen",
        "2"
       ]
      ]
     }
    }
   },
   {
    "action": "ooa.word/read_tables",
    "args": {
     "index": 1
    },
    "out": {
     "table": "t",
     "count": "tc"
    }
   },
   {
    "action": "ooa.word/read_text",
    "out": {
     "text": "txt",
     "paragraphs": "paras"
    }
   },
   {
    "action": "ooa.word/save_as",
    "args": {
     "path": "{tmp}/d.txt",
     "format": "txt"
    }
   },
   {
    "action": "ooa.word/close",
    "args": {
     "save": true
    }
   }
  ],
  "expect": {
   "n1": 1,
   "n2": 1,
   "f": 1,
   "tc": 1,
   "t": {
    "columns": [
     "Item",
     "Qty"
    ],
    "rows": [
     [
      "pen",
      "2"
     ]
    ]
   },
   "txt": {
    "$contains": "Footer {{name}}"
   },
   "paras": [
    "INVOICE",
    "Dear Ann,",
    "Total: 42.00",
    "Footer {{name}}"
   ]
  },
  "expectFiles": {
   "d.docx": true,
   "d.txt": true
  }
 },
