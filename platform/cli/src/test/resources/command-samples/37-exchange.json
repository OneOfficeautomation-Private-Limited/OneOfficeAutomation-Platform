[
 {
  "command": "ooa.exchange/list",
  "name": "connect, find unread invoices and read the first (stand-in EWS server)",
  "credentials": {
   "pw": "test/mail/password"
  },
  "mock": [
   {
    "method": "POST",
    "path": "/EWS/Exchange.asmx",
    "contains": "<m:GetFolder",
    "status": 200,
    "body": "<?xml version=\"1.0\" encoding=\"utf-8\"?><s:Envelope xmlns:s=\"http://schemas.xmlsoap.org/soap/envelope/\"><s:Body xmlns:m=\"http://schemas.microsoft.com/exchange/services/2006/messages\" xmlns:t=\"http://schemas.microsoft.com/exchange/services/2006/types\"><m:GetFolderResponse><m:ResponseMessages><m:GetFolderResponseMessage ResponseClass=\"Success\"><m:ResponseCode>NoError</m:ResponseCode><m:Folders><t:Folder><t:FolderId Id=\"INBOXID\"/></t:Folder></m:Folders></m:GetFolderResponseMessage></m:ResponseMessages></m:GetFolderResponse></s:Body></s:Envelope>"
   },
   {
    "method": "POST",
    "path": "/EWS/Exchange.asmx",
    "contains": "<m:FindItem",
    "status": 200,
    "body": "<?xml version=\"1.0\" encoding=\"utf-8\"?><s:Envelope xmlns:s=\"http://schemas.xmlsoap.org/soap/envelope/\"><s:Body xmlns:m=\"http://schemas.microsoft.com/exchange/services/2006/messages\" xmlns:t=\"http://schemas.microsoft.com/exchange/services/2006/types\"><m:FindItemResponse><m:ResponseMessages><m:FindItemResponseMessage ResponseClass=\"Success\"><m:ResponseCode>NoError</m:ResponseCode><m:RootFolder IncludesLastItemInRange=\"true\"><t:Items><t:Message><t:ItemId Id=\"AAMkID1\" ChangeKey=\"CK\"/><t:Subject>Invoice 42</t:Subject><t:DateTimeReceived>2026-11-03T09:15:00Z</t:DateTimeReceived><t:HasAttachments>false</t:HasAttachments><t:From><t:Mailbox><t:EmailAddress>billing@vendor.test</t:EmailAddress></t:Mailbox></t:From><t:IsRead>false</t:IsRead></t:Message><t:Message><t:ItemId Id=\"AAMkID2\" ChangeKey=\"CK\"/><t:Subject>Invoice 43</t:Subject><t:DateTimeReceived>2026-11-02T09:15:00Z</t:DateTimeReceived><t:HasAttachments>false</t:HasAttachments><t:From><t:Mailbox><t:EmailAddress>billing@vendor.test</t:EmailAddress></t:Mailbox></t:From><t:IsRead>false</t:IsRead></t:Message></t:Items></m:RootFolder></m:FindItemResponseMessage></m:ResponseMessages></m:FindItemResponse></s:Body></s:Envelope>"
   },
   {
    "method": "POST",
    "path": "/EWS/Exchange.asmx",
    "contains": "<m:GetItem",
    "status": 200,
    "body": "<?xml version=\"1.0\" encoding=\"utf-8\"?><s:Envelope xmlns:s=\"http://schemas.xmlsoap.org/soap/envelope/\"><s:Body xmlns:m=\"http://schemas.microsoft.com/exchange/services/2006/messages\" xmlns:t=\"http://schemas.microsoft.com/exchange/services/2006/types\"><m:GetItemResponse><m:ResponseMessages><m:GetItemResponseMessage ResponseClass=\"Success\"><m:ResponseCode>NoError</m:ResponseCode><m:Items><t:Message><t:ItemId Id=\"AAMkID1\" ChangeKey=\"CK\"/><t:Subject>Invoice 42</t:Subject><t:Body BodyType=\"Text\">Please pay</t:Body><t:IsRead>true</t:IsRead><t:From><t:Mailbox><t:EmailAddress>billing@vendor.test</t:EmailAddress></t:Mailbox></t:From></t:Message></m:Items></m:GetItemResponseMessage></m:ResponseMessages></m:GetItemResponse></s:Body></s:Envelope>"
   }
  ],
  "steps": [
   {
    "action": "ooa.exchange/connect",
    "args": {
     "ews_url": "{mock}/EWS/Exchange.asmx",
     "user": "ACME\\bot",
     "password": "$pw",
     "sign_in": "basic"
    }
   },
   {
    "action": "ooa.exchange/list",
    "args": {
     "unread_only": true,
     "subject_contains": "Invoice"
    },
    "out": {
     "table": "t",
     "count": "n"
    }
   },
   {
    "action": "ooa.datatable/get_value",
    "args": {
     "table": "$t",
     "row": 0,
     "column": "id"
    },
    "out": {
     "value": "id"
    }
   },
   {
    "action": "ooa.exchange/get",
    "args": {
     "id": "$id",
     "mark_read": false
    },
    "out": {
     "email": "e"
    }
   },
   {
    "action": "core/set",
    "args": {
     "variable": "text",
     "value": {
      "expr": "$e.text"
     }
    }
   },
   {
    "action": "ooa.exchange/disconnect"
   }
  ],
  "expect": {
   "n": 2,
   "id": "AAMkID1",
   "text": "Please pay"
  },
  "expectRequests": [
   "POST /EWS/Exchange.asmx <m:GetFolder",
   "POST /EWS/Exchange.asmx IsRead",
   "POST /EWS/Exchange.asmx <m:GetItem"
  ]
 },
