  {"command": "ooa.xml/delete_nodes", "name": "removes", "steps": [{"action": "ooa.xml/delete_nodes", "args": {"xml": "<r><i/><i/></r>", "xpath": "//i"}, "out": {"count": "n"}}], "expect": {"n": 2}},
  {"command": "ooa.xml/xpath_function", "name": "count", "steps": [{"action": "ooa.xml/xpath_function", "args": {"xml": "<r><i/><i/></r>", "expression": "count(//i)", "result_type": "number"}, "out": {"result": "n"}}], "expect": {"n": 2}},
  {"command": "ooa.xml/to_dictionary", "name": "converts", "steps": [{"action": "ooa.xml/to_dictionary", "args": {"xml": "<r><a>1</a></r>"}, "out": {"value": "v"}}], "expect": {"v": {"$type": "object"}}},
  {"command": "ooa.xml/validate", "name": "well-formed only", "steps": [{"action": "ooa.xml/validate", "args": {"xml": "<r><a></r>"}, "out": {"valid": "ok"}}], "expect": {"ok": false}},
  {"command": "ooa.xml/save_file", "name": "indent", "steps": [{"action": "ooa.xml/save_file", "args": {"xml": "<r><a>1</a></r>", "path": "{tmp}/o.xml", "indent": true}, "out": {"path": "p"}}], "expectFiles": {"o.xml": true}},
  {"command": "ooa.xml/get_value", "name": "XXE refused", "steps": [{"action": "ooa.xml/get_value", "args": {"xml": "<!DOCTYPE r [<!ENTITY x SYSTEM 'file:///c:/windows/win.ini'>]><r>&x;</r>", "xpath": "/r"}}], "error": "XML.DTD_NOT_ALLOWED"},
  {"command": "ooa.csv/write", "name": "quote all", "vars": {"t": {"columns": ["a"], "rows": [["x"]]}},
