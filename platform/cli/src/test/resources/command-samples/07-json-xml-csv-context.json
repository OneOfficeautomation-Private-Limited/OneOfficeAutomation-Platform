  {"command": "ooa.csv/read", "name": "skip lines, trim", "files": {"in.csv": "title line\nname;qty\n  pen ;2\n\ncup;3\n"},
   "steps": [{"action": "ooa.csv/read", "args": {"path": "{tmp}/in.csv", "delimiter": ";", "skip_lines": 1, "trim": "both", "skip_empty_rows": true}, "out": {"table": "t", "row_count": "n"}}],
   "expect": {"n": 2, "t": {"columns": ["name", "qty"], "rows": [["pen", "2"], ["cup", "3"]]}}},
  {"command": "ooa.csv/rows", "name": "loop iterator", "files": {"in.csv": "n\n1\n2\n"}, "vars": {"sum": 0},
   "steps": [{"action": "core/loop", "args": {"iterator": "ooa.csv/rows", "iterator_args": {"path": "{tmp}/in.csv", "detect_types": true}, "as": "row"}, "children": [{"action": "core/set", "args": {"variable": "sum", "value": {"expr": "$sum + $row.n"}}}]}], "expect": {"sum": 3}},
  {"command": "ooa.xml/nodes", "name": "loop iterator", "vars": {"out": ""},
