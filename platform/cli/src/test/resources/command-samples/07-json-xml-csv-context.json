  {"command": "ooa.run_context/get", "name": "run information", "steps": [{"action": "ooa.run_context/get", "out": {"info": "i"}}], "expect": {"i": {"$type": "object"}}},
  {"command": "ooa.run_context/get_value", "name": "processors", "steps": [{"action": "ooa.run_context/get_value", "args": {"name": "processors"}, "out": {"value": "v"}},
     {"action": "core/set", "args": {"variable": "ok", "value": {"expr": "$v >= 1"}}}], "expect": {"ok": true}},
  {"command": "ooa.global_values/get", "name": "default when not defined", "steps": [{"action": "ooa.global_values/get", "args": {"name": "no_such_value", "default": 5, "type": "Number"}, "out": {"value": "v"}}], "expect": {"v": 5}},
  {"command": "ooa.global_values/get_all", "name": "dictionary", "steps": [{"action": "ooa.global_values/get_all", "out": {"values": "v"}}], "expect": {"v": {"$type": "object"}}},
  {"command": "ooa.global_values/is_defined", "name": "condition", "vars": {"ok": true},
   "steps": [{"action": "core/if", "args": {"condition": {"condition": "ooa.global_values/is_defined", "args": {"name": "no_such_value"}}}, "else": [{"action": "core/set", "args": {"variable": "ok", "value": false}}]}], "expect": {"ok": false}}
,
