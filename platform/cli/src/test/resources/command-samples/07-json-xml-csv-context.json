[
  {"command": "ooa.json/parse", "name": "text to dictionary", "steps": [{"action": "ooa.json/parse", "args": {"text": "{\"a\": {\"b\": [1, 2]}}"}, "out": {"value": "v"}}], "expect": {"v": {"a": {"b": [1, 2]}}}},
  {"command": "ooa.json/parse", "name": "bad JSON", "steps": [{"action": "ooa.json/parse", "args": {"text": "{oops"}}], "error": "JSON.INVALID"},
  {"command": "ooa.json/stringify", "name": "pretty", "vars": {"v": {"a": 1}}, "steps": [{"action": "ooa.json/stringify", "args": {"value": "$v", "pretty": true, "indent": 1}, "out": {"text": "t"}}], "expect": {"t": "{\n \"a\": 1\n}"}},
  {"command": "ooa.json/get_node", "name": "path with index", "vars": {"v": {"a": {"b": [1, 2]}}}, "steps": [{"action": "ooa.json/get_node", "args": {"value": "$v", "path": "a.b[1]"}, "out": {"result": "r", "found": "f"}}], "expect": {"r": 2, "f": true}},
  {"command": "ooa.json/get_node", "name": "missing gives default", "vars": {"v": {}}, "steps": [{"action": "ooa.json/get_node", "args": {"value": "$v", "path": "x.y", "default": "-"}, "out": {"result": "r", "found": "f"}}], "expect": {"r": "-", "f": false}},
  {"command": "ooa.json/get_nodes", "name": "several", "vars": {"v": {"a": 1, "b": {"c": 2}}}, "steps": [{"action": "ooa.json/get_nodes", "args": {"value": "$v", "paths": {"one": "a", "two": "b.c", "none": "z"}}, "out": {"values": "r", "missing": "m"}}], "expect": {"m": ["none"]}},
  {"command": "ooa.json/get_node_array", "name": "list at path", "vars": {"v": {"items": [{"id": 1}, {"id": 2}]}}, "steps": [{"action": "ooa.json/get_node_array", "args": {"value": "$v", "path": "items"}, "out": {"count": "n"}}], "expect": {"n": 2}},
  {"command": "ooa.json/insert_node", "name": "create parents", "vars": {"v": {}}, "steps": [{"action": "ooa.json/insert_node", "args": {"value": "$v", "path": "a.b", "node": 5, "create_parents": true}, "out": {"value": "v"}}], "expect": {"v": {"a": {"b": 5}}}},
  {"command": "ooa.json/insert_node", "name": "exists is an error", "vars": {"v": {"a": 1}}, "steps": [{"action": "ooa.json/insert_node", "args": {"value": "$v", "path": "a", "node": 5}}], "error": "JSON.NODE_EXISTS"},
  {"command": "ooa.json/update_node", "name": "previous value", "vars": {"v": {"a": 1}}, "steps": [{"action": "ooa.json/update_node", "args": {"value": "$v", "path": "a", "node": 2}, "out": {"value": "v", "previous": "p"}}], "expect": {"v": {"a": 2}, "p": 1}},
  {"command": "ooa.json/delete_node", "name": "removes", "vars": {"v": {"a": 1, "b": 2}}, "steps": [{"action": "ooa.json/delete_node", "args": {"value": "$v", "path": "a"}, "out": {"value": "v", "removed": "r"}}], "expect": {"v": {"b": 2}, "r": 1}},
  {"command": "ooa.json/to_table", "name": "flatten", "vars": {"v": [{"id": 1, "who": {"name": "A"}}]}, "steps": [{"action": "ooa.json/to_table", "args": {"value": "$v", "flatten": true}, "out": {"table": "t"}}], "expect": {"t": {"columns": ["id", "who.name"], "rows": [[1, "A"]]}}},
  {"command": "ooa.json/validate", "name": "schema errors", "vars": {"v": {"n": "x"}},
   "steps": [{"action": "ooa.json/validate", "args": {"json": "$v", "schema": {"type": "object", "required": ["id"], "properties": {"n": {"type": "number"}}}}, "out": {"valid": "ok", "errors": "e"}},
     {"action": "core/set", "args": {"variable": "n", "value": {"expr": "len($e)"}}}], "expect": {"ok": false, "n": 2}},
  {"command": "ooa.json/write_file", "name": "write then read", "vars": {"v": {"a": [1]}},
