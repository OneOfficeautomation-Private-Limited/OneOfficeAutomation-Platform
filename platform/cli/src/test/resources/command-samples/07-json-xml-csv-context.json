  {"command": "ooa.json/read_file", "name": "missing file", "steps": [{"action": "ooa.json/read_file", "args": {"path": "{tmp}/none.json"}}], "error": "FILE.NOT_FOUND"},
  {"command": "ooa.xml/get_value", "name": "attribute", "steps": [{"action": "ooa.xml/get_value", "args": {"xml": "<r><i id='7'>x</i></r>", "xpath": "/r/i", "attribute": "id"}, "out": {"value": "v", "found": "f"}}], "expect": {"v": "7", "f": true}},
  {"command": "ooa.xml/get_nodes", "name": "texts", "steps": [{"action": "ooa.xml/get_nodes", "args": {"xml": "<r><i>a</i><i>b</i></r>", "xpath": "//i"}, "out": {"values": "v", "count": "n"}}], "expect": {"v": ["a", "b"], "n": 2}},
  {"command": "ooa.xml/insert_node", "name": "with attribute", "steps": [{"action": "ooa.xml/insert_node", "args": {"xml": "<r/>", "parent_xpath": "/r", "name": "i", "text": "x", "attributes": {"k": "1"}}, "out": {"xml": "x", "count": "n"}},
