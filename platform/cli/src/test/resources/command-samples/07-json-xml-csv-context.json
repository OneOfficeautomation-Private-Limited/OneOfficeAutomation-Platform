  {"command": "ooa.xml/set_value", "name": "updates text", "steps": [{"action": "ooa.xml/set_value", "args": {"xml": "<r><i>a</i></r>", "xpath": "/r/i", "value": "b"}, "out": {"xml": "x"}},
