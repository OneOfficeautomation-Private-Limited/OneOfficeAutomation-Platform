[
  {"command": "ooa.string/find", "name": "regex capture group returns only the number", "vars": {"t": "Subtotal: 90\nTotal: 120 EUR"},
   "steps": [{"action": "ooa.string/find", "args": {"text": "$t", "find": "Total: (\\d+)", "regex": true, "group": 1}, "out": {"match": "m", "found": "f"}}],
   "expect": {"m": "120", "f": true}},
  {"command": "ooa.string/find", "name": "capture group in match and all_matches", "vars": {"t": "INV-204 and INV-305"},
   "steps": [{"action": "ooa.string/find", "args": {"text": "$t", "find": "INV-(\\d+)", "regex": true, "group": 1}, "out": {"match": "m", "all_matches": "all", "index": "i"}}],
   "expect": {"m": "204", "all": ["204", "305"], "i": 0}},
  {"command": "ooa.string/find", "name": "group that does not exist", "steps": [{"action": "ooa.string/find", "args": {"text": "Total: 5", "find": "Total: (\\d+)", "regex": true, "group": 2}}],
   "error": "STRING.BAD_GROUP"},
  {"command": "ooa.string/extract_text", "name": "until end of line", "vars": {"t": "Name: Ada Lovelace\nRole: Analyst"},
   "steps": [{"action": "ooa.string/extract_text", "args": {"text": "$t", "after": "Name:", "until": "end_of_line"}, "out": {"result": "r"}}], "expect": {"r": "Ada Lovelace"}},
  {"command": "ooa.string/extract_text", "name": "until end of line, before marker found first", "vars": {"t": "Ref: A-17 (urgent)\r\nNext"},
   "steps": [{"action": "ooa.string/extract_text", "args": {"text": "$t", "after": "Ref:", "before": "(", "until": "end_of_line"}, "out": {"result": "r"}}], "expect": {"r": "A-17"}},
  {"command": "ooa.string/compare", "name": "ignore line breaks", "vars": {"a": "Payment received\r\nthank you", "b": "Payment received thank you"},
   "steps": [{"action": "ooa.string/compare", "args": {"text": "$a", "other": "$b", "ignore_line_breaks": true}, "out": {"equal": "eq", "result": "r"}}], "expect": {"eq": true, "r": 0}},
  {"command": "ooa.string/compare", "name": "line breaks count by default", "vars": {"a": "a\nb", "b": "a b"},
   "steps": [{"action": "ooa.string/compare", "args": {"text": "$a", "other": "$b"}, "out": {"equal": "eq"}}], "expect": {"eq": false}},
  {"command": "ooa.datatable/write_to_file", "name": "custom row delimiter", "vars": {"t": {"columns": ["a", "b"], "rows": [[1, "x"], [2, "y"]]}},
   "steps": [{"action": "ooa.datatable/write_to_file", "args": {"table": "$t", "path": "{tmp}/out.csv", "row_delimiter": "|"}}], "expectFiles": {"out.csv": "a,b|1,x|2,y|"}},
  {"command": "ooa.datatable/write_to_file", "name": "row delimiter with escaped line break", "vars": {"t": {"columns": ["a"], "rows": [[1]]}},
   "steps": [{"action": "ooa.datatable/write_to_file", "args": {"table": "$t", "path": "{tmp}/out.csv", "row_delimiter": ";\\n"}}], "expectFiles": {"out.csv": "a;\n1;\n"}},
  {"command": "ooa.csv/write", "name": "regional delimiter round trip", "vars": {"t": {"columns": ["Item", "Qty"], "rows": [["Pen", "2"]]}},
   "steps": [{"action": "ooa.csv/write", "args": {"table": "$t", "path": "{tmp}/r.csv", "delimiter": "regional"}},
             {"action": "ooa.csv/read", "args": {"path": "{tmp}/r.csv", "delimiter": "regional"}, "out": {"table": "back"}}],
   "expect": {"back": {"columns": ["Item", "Qty"], "rows": [["Pen", "2"]]}}},
  {"command": "ooa.file/delete", "name": "pattern with modified_after and modified_before", "files": {"d/a.tmp": "1", "d/b.tmp": "2"},
   "steps": [{"action": "ooa.file/delete", "args": {"path": "{tmp}/d", "pattern": "*.tmp", "modified_before": "2000-01-01T00:00:00"}, "out": {"deleted": "none"}},
             {"action": "ooa.file/delete", "args": {"path": "{tmp}/d", "pattern": "*.tmp", "modified_after": "2000-01-01T00:00:00"}, "out": {"deleted": "n"}}],
   "expect": {"none": 0, "n": 2}, "expectFiles": {"d/a.tmp": false}},
  {"command": "ooa.folder/copy", "name": "size and date filters", "files": {"s/small.txt": "1", "s/old.txt": "2"},
   "steps": [{"action": "ooa.folder/copy", "args": {"source": "{tmp}/s", "target": "{tmp}/t1", "larger_than_kb": 1}, "out": {"copied": "big"}},
             {"action": "ooa.folder/copy", "args": {"source": "{tmp}/s", "target": "{tmp}/t2", "smaller_than_kb": 1, "pattern": "small*"}, "out": {"copied": "small"}},
             {"action": "ooa.folder/copy", "args": {"source": "{tmp}/s", "target": "{tmp}/t3", "modified_after": "2000-01-01T00:00:00", "modified_before": "2001-01-01T00:00:00"}, "out": {"copied": "dated"}}],
   "expect": {"big": 0, "small": 1, "dated": 0}, "expectFiles": {"t2/small.txt": "1", "t1/small.txt": false}}
]
