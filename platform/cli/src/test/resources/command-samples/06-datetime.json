[
  {"command": "ooa.datetime/now", "name": "returns a date", "steps": [{"action": "ooa.datetime/now", "out": {"value": "d"}}, {"action": "ooa.datetime/get_part", "args": {"value": "$d", "part": "year"}, "out": {"result": "y"}},
     {"action": "core/set", "args": {"variable": "ok", "value": {"expr": "$y >= 2026"}}}], "expect": {"ok": true}},
  {"command": "ooa.datetime/parse", "name": "custom pattern", "steps": [{"action": "ooa.datetime/parse", "args": {"text": "23/10/2026 14:05", "pattern": "dd/MM/yyyy HH:mm"}, "out": {"value": "d"}}], "expect": {"d": "2026-10-23T14:05"}},
  {"command": "ooa.datetime/parse", "name": "standard ISO", "steps": [{"action": "ooa.datetime/parse", "args": {"text": "2026-10-23", "standard": "ISO_LOCAL_DATE"}, "out": {"value": "d"}}], "expect": {"d": "2026-10-23T00:00"}},
  {"command": "ooa.datetime/parse", "name": "bad text", "steps": [{"action": "ooa.datetime/parse", "args": {"text": "31/02/2026", "pattern": "dd/MM/yyyy"}}], "error": "DATETIME.PARSE_FAILED"},
  {"command": "ooa.datetime/format", "name": "pattern and zone", "vars": {"d": "2026-10-23T10:00:00"},
   "steps": [{"action": "ooa.datetime/format", "args": {"value": "$d", "pattern": "dd MMM yyyy HH:mm", "time_zone": "Asia/Kolkata"}, "out": {"text": "t"}}], "expect": {"t": "23 Oct 2026 15:30"}},
  {"command": "ooa.datetime/add", "name": "months", "vars": {"d": "2026-01-31T00:00:00"}, "steps": [{"action": "ooa.datetime/add", "args": {"value": "$d", "amount": 1, "unit": "months"}, "out": {"result": "r"}}], "expect": {"r": "2026-02-28T00:00"}},
  {"command": "ooa.datetime/add", "name": "business days skip weekend and holiday (new)", "vars": {"d": "2026-12-24T09:00:00"},
   "steps": [{"action": "ooa.datetime/add", "args": {"value": "$d", "amount": 2, "unit": "business_days", "holidays": ["2026-12-25"]}, "out": {"result": "r"}}], "expect": {"r": "2026-12-29T09:00"}},
  {"command": "ooa.datetime/subtract", "name": "business days back over weekend (new)", "vars": {"d": "2026-10-26T00:00:00"},
   "steps": [{"action": "ooa.datetime/subtract", "args": {"value": "$d", "amount": 1, "unit": "business_days"}, "out": {"result": "r"}}], "expect": {"r": "2026-10-23T00:00"}},
  {"command": "ooa.datetime/subtract", "name": "hours", "vars": {"d": "2026-10-23T10:00:00"}, "steps": [{"action": "ooa.datetime/subtract", "args": {"value": "$d", "amount": 3, "unit": "hours"}, "out": {"result": "r"}}], "expect": {"r": "2026-10-23T07:00"}},
  {"command": "ooa.datetime/difference", "name": "business days (new)", "vars": {"a": "2026-10-23T00:00:00", "b": "2026-10-30T00:00:00"},
   "steps": [{"action": "ooa.datetime/difference", "args": {"start": "$a", "end": "$b", "unit": "business_days"}, "out": {"result": "n"}}], "expect": {"n": 5}},
  {"command": "ooa.datetime/difference", "name": "hours fractional, absolute", "vars": {"a": "2026-10-23T12:00:00", "b": "2026-10-23T10:30:00"},
   "steps": [{"action": "ooa.datetime/difference", "args": {"start": "$a", "end": "$b", "unit": "hours", "absolute": true}, "out": {"result": "n"}}], "expect": {"n": 1.5}},
  {"command": "ooa.datetime/get_part", "name": "quarter", "vars": {"d": "2026-10-23T00:00:00"}, "steps": [{"action": "ooa.datetime/get_part", "args": {"value": "$d", "part": "quarter"}, "out": {"result": "q"}}], "expect": {"q": 4}},
  {"command": "ooa.datetime/start_of", "name": "month", "vars": {"d": "2026-10-23T15:00:00"}, "steps": [{"action": "ooa.datetime/start_of", "args": {"value": "$d", "unit": "month"}, "out": {"result": "r"}}], "expect": {"r": "2026-10-01T00:00"}},
  {"command": "ooa.datetime/end_of", "name": "month", "vars": {"d": "2026-02-10T15:00:00"}, "steps": [{"action": "ooa.datetime/end_of", "args": {"value": "$d", "unit": "month"}, "out": {"result": "r"}}], "expect": {"r": {"$contains": "2026-02-28T23:59:59"}}},
  {"command": "ooa.datetime/convert_time_zone", "name": "to New York", "vars": {"d": "2026-07-01T12:00:00"}, "steps": [{"action": "ooa.datetime/convert_time_zone", "args": {"value": "$d", "time_zone": "America/New_York"}, "out": {"text": "t"}}], "expect": {"t": {"$contains": "08:00"}}},
  {"command": "ooa.datetime/is_after", "name": "dates only", "vars": {"a": "2026-10-23T18:00:00", "b": "2026-10-23T09:00:00"},
   "steps": [{"action": "ooa.datetime/is_after", "args": {"value": "$a", "other": "$b", "include_time": false}, "out": {"result": "r"}}], "expect": {"r": false}},
  {"command": "ooa.datetime/is_before", "name": "with time", "vars": {"a": "2026-10-23T08:00:00", "b": "2026-10-23T09:00:00"},
   "steps": [{"action": "ooa.datetime/is_before", "args": {"value": "$a", "other": "$b"}, "out": {"result": "r"}}], "expect": {"r": true}},
  {"command": "ooa.datetime/is_equal", "name": "same day", "vars": {"a": "2026-10-23T08:00:00", "b": "2026-10-23T09:00:00"},
   "steps": [{"action": "ooa.datetime/is_equal", "args": {"value": "$a", "other": "$b", "include_time": false}, "out": {"result": "r"}}], "expect": {"r": true}},
  {"command": "ooa.datetime/is_leap_year", "name": "by year", "steps": [{"action": "ooa.datetime/is_leap_year", "args": {"year": 2028}, "out": {"result": "r"}}], "expect": {"r": true}},
  {"command": "ooa.datetime/is_between", "name": "condition", "vars": {"d": "2026-10-23T00:00:00", "ok": false},
   "steps": [{"action": "core/if", "args": {"condition": {"condition": "ooa.datetime/is_between", "args": {"value": "$d", "from": "2026-10-01T00:00:00", "to": "2026-10-31T00:00:00"}}}, "children": [{"action": "core/set", "args": {"variable": "ok", "value": true}}]}], "expect": {"ok": true}},
  {"command": "ooa.datetime/is_weekend", "name": "Saturday", "vars": {"d": "2026-10-24T10:00:00", "ok": false},
   "steps": [{"action": "core/if", "args": {"condition": {"condition": "ooa.datetime/is_weekend", "args": {"value": "$d"}}}, "children": [{"action": "core/set", "args": {"variable": "ok", "value": true}}]}], "expect": {"ok": true}},
  {"command": "ooa.datetime/is_valid", "name": "invalid date text", "vars": {"ok": true},
   "steps": [{"action": "core/if", "args": {"condition": {"condition": "ooa.datetime/is_valid", "args": {"text": "2026-02-30"}}}, "else": [{"action": "core/set", "args": {"variable": "ok", "value": false}}]}], "expect": {"ok": false}},
  {"command": "ooa.datetime/is_business_hours", "name": "24h window every day is always true", "vars": {"ok": false},
   "steps": [{"action": "core/if", "args": {"condition": {"condition": "ooa.datetime/is_business_hours", "args": {"start_hour": 0, "end_hour": 24, "weekdays_only": false}}}, "children": [{"action": "core/set", "args": {"variable": "ok", "value": true}}]}], "expect": {"ok": true}},
  {"command": "ooa.datetime/is_business_hours", "name": "an empty window is never true", "vars": {"ok": true},
   "steps": [{"action": "core/if", "args": {"condition": {"condition": "ooa.datetime/is_business_hours", "args": {"start_hour": 5, "end_hour": 5, "weekdays_only": false}}}, "children": [{"action": "core/set", "args": {"variable": "ok", "value": false}}], "else": [{"action": "core/set", "args": {"variable": "ok", "value": true}}]}], "expect": {"ok": true}}
]
