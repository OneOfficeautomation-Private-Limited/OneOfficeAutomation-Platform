[
 {
  "command": "ooa.rest/request",
  "name": "multipart form with a text field and a file part",
  "mock": [
   {
    "method": "POST",
    "path": "/upload",
    "body": {
     "ok": true
    }
   }
  ],
  "steps": [
   {
    "action": "ooa.file/write_text",
    "args": {
     "path": "{tmp}/note.txt",
     "text": "file content 42"
    }
   },
   {
    "action": "ooa.rest/request",
    "args": {
     "url": "{mock}/upload",
     "method": "POST",
     "multipart": {
      "comment": "hello",
      "doc": {
       "file": "{tmp}/note.txt",
       "content_type": "text/plain"
      }
     }
    },
    "out": {
     "status": "status"
    }
   }
  ],
  "expect": {
   "status": 200
  },
  "expectRequests": [
   "POST /upload filename=\"note.txt\""
  ]
 },
 {
  "command": "ooa.rest/request",
  "name": "file sent as the raw body",
  "mock": [
   {
    "method": "PUT",
    "path": "/raw",
    "body": {
     "ok": true
    }
   }
  ],
  "steps": [
   {
    "action": "ooa.file/write_text",
    "args": {
     "path": "{tmp}/raw.txt",
     "text": "raw bytes here"
    }
   },
   {
    "action": "ooa.rest/request",
    "args": {
     "url": "{mock}/raw",
     "method": "PUT",
     "body_file": "{tmp}/raw.txt",
     "content_type": "text/plain"
    },
    "out": {
     "status": "status"
    }
   }
  ],
  "expect": {
   "status": 200
  },
  "expectRequests": [
   "PUT /raw raw bytes here"
  ]
 },
 {
  "command": "ooa.rest/request",
  "name": "two bodies at once are refused",
  "steps": [
   {
    "action": "ooa.rest/request",
    "args": {
     "url": "http://127.0.0.1:9/x",
     "method": "POST",
     "json": {
      "a": 1
     },
     "body": "text"
    }
   }
  ],
  "error": "REST.BAD_BODY"
 },
 {
  "command": "ooa.rest/request",
  "name": "file body that does not exist",
  "steps": [
   {
    "action": "ooa.rest/request",
    "args": {
     "url": "http://127.0.0.1:9/x",
     "method": "POST",
     "body_file": "{tmp}/missing.bin"
    }
   }
  ],
  "error": "REST.FILE_NOT_FOUND"
 },
 {
  "command": "ooa.desktop/type_text",
