 {
  "command": "ooa.microsoft365/excel_read_range",
  "name": "all cells in use, no header row, as displayed text",
  "credentials": {
   "tok": "test/api/token"
  },
  "secrets": {
   "test/api/token": "t0k"
  },
  "mock": [
   {
    "method": "GET",
    "path": "*",
    "body": {
     "address": "Sheet1!A1:B2",
     "values": [
      [
       1,
       2.5
      ],
      [
       3,
       4
      ]
     ],
     "text": [
      [
       "1",
       "2.50"
      ],
      [
       "3",
       "4"
      ]
     ]
    }
   }
  ],
  "steps": [
   {
    "action": "ooa.microsoft365/excel_read_range",
    "args": {
     "base_url": "{mock}",
     "access_token": "$tok",
     "remote_path": "Finance/b.xlsx",
     "sheet": "Sheet1",
     "header": false,
     "read_as": "text"
    },
    "out": {
     "table": "t"
    }
   }
  ],
  "expect": {
   "t": {
    "columns": [
     "Column1",
     "Column2"
    ],
    "rows": [
     [
      "1",
      "2.50"
     ],
     [
      "3",
      "4"
     ]
    ]
   }
  },
  "expectRequests": [
   "GET /me/drive/root:/Finance/b.xlsx:/workbook/worksheets('Sheet1')/usedRange"
  ]
 },
