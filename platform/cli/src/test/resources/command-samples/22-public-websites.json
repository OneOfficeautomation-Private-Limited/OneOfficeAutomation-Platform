[
 {
  "command": "use-case/P1",
  "name": "ten rounds of the moving form",
  "flow": "../../examples/use-cases/P1-rpa-challenge.flow.json",
  "copy": "../../examples/use-cases",
  "inputs": {
   "folder": ".",
   "headless": true
  },
  "expect": {
   "rounds": 10,
   "result_message": {
    "$contains": "100%"
   }
  },
  "requires": "internet",
  "probe": "https://rpachallenge.com/"
 },
 {
  "command": "use-case/P2",
