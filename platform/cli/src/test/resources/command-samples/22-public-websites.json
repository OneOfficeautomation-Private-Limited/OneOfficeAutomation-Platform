  "copy": "../../examples/use-cases",
  "inputs": {
   "folder": ".",
   "headless": true
  },
  "expect": {
   "cart_count": 3,
   "total_matches": true,
   "confirmation": {
    "$contains": "Thank you"
   }
  },
  "requires": "internet",
  "probe": "https://www.saucedemo.com/"
 },
 {
  "command": "use-case/P3",
  "name": "mystery category crawled with details",
  "flow": "../../examples/use-cases/P3-books-catalogue-crawl.flow.json",
  "copy": "../../examples/use-cases",
  "inputs": {
   "folder": ".",
   "headless": true
  },
  "expect": {
   "books": 32,
   "ratings": 5,
   "total_stock": {
    "$type": "number"
   },
   "most_expensive": {
    "$type": "string"
   }
  },
  "requires": "internet",
  "probe": "https://books.toscrape.com/",
  "expectFiles": {
   "output/books-Mystery.xlsx": true
  }
 },
 {
  "command": "use-case/P4",
