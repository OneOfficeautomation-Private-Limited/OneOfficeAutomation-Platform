[
  {"command": "ooa.number/format", "name": "Indian lakh grouping (fixed)", "steps": [{"action": "ooa.number/format", "args": {"value": 1234567.5, "decimals": 1, "locale": "en-IN"}, "out": {"text": "t"}}], "expect": {"t": "12,34,567.5"}},
  {"command": "ooa.list/add_item", "name": "several at a position, skip existing", "vars": {"l": ["a", "d"]},
   "steps": [{"action": "ooa.list/add_item", "args": {"list": "$l", "items": ["b", "c", "a"], "position": 1, "skip_existing": true}, "out": {"list": "l"}}], "expect": {"l": ["a", "b", "c", "d"]}},
  {"command": "ooa.list/append_list", "name": "appends", "vars": {"l": [1], "m": [2, 3]}, "steps": [{"action": "ooa.list/append_list", "args": {"list": "$l", "other": "$m"}, "out": {"list": "l"}}], "expect": {"l": [1, 2, 3]}},
  {"command": "ooa.list/clear", "name": "empties", "vars": {"l": [1, 2]}, "steps": [{"action": "ooa.list/clear", "args": {"list": "$l"}, "out": {"list": "l"}}], "expect": {"l": []}},
  {"command": "ooa.list/get_item", "name": "negative from end", "vars": {"l": ["a", "b", "c"]}, "steps": [{"action": "ooa.list/get_item", "args": {"list": "$l", "position": -1}, "out": {"item": "x"}}], "expect": {"x": "c"}},
  {"command": "ooa.list/get_item", "name": "default when out of range", "vars": {"l": ["a"]}, "steps": [{"action": "ooa.list/get_item", "args": {"list": "$l", "position": 5, "if_out_of_range": "default", "default": "none"}, "out": {"item": "x"}}], "expect": {"x": "none"}},
  {"command": "ooa.list/index_of", "name": "last, ignore case", "vars": {"l": ["A", "b", "a"]}, "steps": [{"action": "ooa.list/index_of", "args": {"list": "$l", "value": "a", "ignore_case": true, "last": true}, "out": {"index": "i", "found": "f"}}], "expect": {"i": 2, "f": true}},
  {"command": "ooa.list/join", "name": "skip empty, escape", "vars": {"l": ["a", "", "b"]}, "steps": [{"action": "ooa.list/join", "args": {"list": "$l", "separator": "\\n", "skip_empty": true, "escape_sequences": true}, "out": {"text": "t"}}], "expect": {"t": "a\nb"}},
  {"command": "ooa.list/remove_duplicates", "name": "keeps first", "vars": {"l": [1, 2, 1, 3]}, "steps": [{"action": "ooa.list/remove_duplicates", "args": {"list": "$l"}, "out": {"list": "l"}}], "expect": {"l": [1, 2, 3]}},
  {"command": "ooa.list/remove_item", "name": "by value, all", "vars": {"l": ["x", "y", "x"]}, "steps": [{"action": "ooa.list/remove_item", "args": {"list": "$l", "value": "x"}, "out": {"list": "l", "count": "n"}}], "expect": {"l": ["y"], "n": 2}},
  {"command": "ooa.list/remove_item", "name": "by position returns removed", "vars": {"l": ["x", "y"]}, "steps": [{"action": "ooa.list/remove_item", "args": {"list": "$l", "position": 0}, "out": {"list": "l", "removed": "r"}}], "expect": {"l": ["y"], "r": "x"}},
  {"command": "ooa.list/reverse", "name": "reverses", "vars": {"l": [1, 2, 3]}, "steps": [{"action": "ooa.list/reverse", "args": {"list": "$l"}, "out": {"list": "l"}}], "expect": {"l": [3, 2, 1]}},
  {"command": "ooa.list/set_item", "name": "replaces", "vars": {"l": [1, 2]}, "steps": [{"action": "ooa.list/set_item", "args": {"list": "$l", "position": 1, "item": 9}, "out": {"list": "l"}}], "expect": {"l": [1, 9]}},
  {"command": "ooa.list/set_item", "name": "out of range", "vars": {"l": [1]}, "steps": [{"action": "ooa.list/set_item", "args": {"list": "$l", "position": 4, "item": 9}}], "error": "LIST.INDEX"},
  {"command": "ooa.list/size", "name": "counts", "vars": {"l": [1, 2]}, "steps": [{"action": "ooa.list/size", "args": {"list": "$l"}, "out": {"count": "n"}}], "expect": {"n": 2}},
  {"command": "ooa.list/sort", "name": "descending, ignore case", "vars": {"l": ["b", "A", "c"]}, "steps": [{"action": "ooa.list/sort", "args": {"list": "$l", "descending": true}, "out": {"list": "l"}}], "expect": {"l": ["c", "b", "A"]}},
  {"command": "ooa.list/contains", "name": "condition", "vars": {"l": [1, 2], "ok": false},
   "steps": [{"action": "core/if", "args": {"condition": {"condition": "ooa.list/contains", "args": {"list": "$l", "value": 2}}}, "children": [{"action": "core/set", "args": {"variable": "ok", "value": true}}]}], "expect": {"ok": true}},
  {"command": "ooa.list/is_empty", "name": "condition", "vars": {"l": [], "ok": false},
   "steps": [{"action": "core/if", "args": {"condition": {"condition": "ooa.list/is_empty", "args": {"list": "$l"}}}, "children": [{"action": "core/set", "args": {"variable": "ok", "value": true}}]}], "expect": {"ok": true}},
  {"command": "ooa.dictionary/put", "name": "previous value", "vars": {"d": {"a": 1}}, "steps": [{"action": "ooa.dictionary/put", "args": {"dictionary": "$d", "key": "a", "value": 2}, "out": {"dictionary": "d", "previous": "p", "existed": "e"}}], "expect": {"d": {"a": 2}, "p": 1, "e": true}},
  {"command": "ooa.dictionary/put", "name": "only if missing", "vars": {"d": {"a": 1}}, "steps": [{"action": "ooa.dictionary/put", "args": {"dictionary": "$d", "key": "a", "value": 2, "only_if_missing": true}, "out": {"dictionary": "d"}}], "expect": {"d": {"a": 1}}},
  {"command": "ooa.dictionary/get", "name": "ignore case and default", "vars": {"d": {"Name": "Ann"}}, "steps": [{"action": "ooa.dictionary/get", "args": {"dictionary": "$d", "key": "name", "ignore_case": true}, "out": {"value": "v", "found": "f"}},
     {"action": "ooa.dictionary/get", "args": {"dictionary": "$d", "key": "age", "default": 0}, "out": {"value": "a"}}], "expect": {"v": "Ann", "f": true, "a": 0}},
  {"command": "ooa.dictionary/get", "name": "fail if missing", "vars": {"d": {}}, "steps": [{"action": "ooa.dictionary/get", "args": {"dictionary": "$d", "key": "x", "fail_if_missing": true}}], "error": "DICT.KEY_NOT_FOUND"},
  {"command": "ooa.dictionary/remove", "name": "removed value", "vars": {"d": {"a": 1, "b": 2}}, "steps": [{"action": "ooa.dictionary/remove", "args": {"dictionary": "$d", "key": "a"}, "out": {"dictionary": "d", "removed": "r"}}], "expect": {"d": {"b": 2}, "r": 1}},
  {"command": "ooa.dictionary/keys", "name": "keys in order", "vars": {"d": {"b": 1, "a": 2}}, "steps": [{"action": "ooa.dictionary/keys", "args": {"dictionary": "$d"}, "out": {"keys": "k"}}], "expect": {"k": ["b", "a"]}},
  {"command": "ooa.dictionary/values", "name": "values", "vars": {"d": {"b": 1, "a": 2}}, "steps": [{"action": "ooa.dictionary/values", "args": {"dictionary": "$d"}, "out": {"values": "v"}}], "expect": {"v": [1, 2]}},
  {"command": "ooa.dictionary/merge", "name": "keep existing", "vars": {"d": {"a": 1}, "o": {"a": 9, "b": 2}}, "steps": [{"action": "ooa.dictionary/merge", "args": {"dictionary": "$d", "other": "$o", "overwrite": false}, "out": {"dictionary": "d"}}], "expect": {"d": {"a": 1, "b": 2}}},
  {"command": "ooa.dictionary/size", "name": "counts", "vars": {"d": {"a": 1}}, "steps": [{"action": "ooa.dictionary/size", "args": {"dictionary": "$d"}, "out": {"count": "n"}}], "expect": {"n": 1}},
  {"command": "ooa.dictionary/contains_key", "name": "condition", "vars": {"d": {"a": 1}, "ok": false},
   "steps": [{"action": "core/if", "args": {"condition": {"condition": "ooa.dictionary/contains_key", "args": {"dictionary": "$d", "key": "a"}}}, "children": [{"action": "core/set", "args": {"variable": "ok", "value": true}}]}], "expect": {"ok": true}},
  {"command": "ooa.dictionary/contains_value", "name": "condition", "vars": {"d": {"a": 1}, "ok": false},
   "steps": [{"action": "core/if", "args": {"condition": {"condition": "ooa.dictionary/contains_value", "args": {"dictionary": "$d", "value": 1}}}, "children": [{"action": "core/set", "args": {"variable": "ok", "value": true}}]}], "expect": {"ok": true}},
  {"command": "ooa.dictionary/key_has_value", "name": "condition", "vars": {"d": {"a": "x"}, "ok": false},
   "steps": [{"action": "core/if", "args": {"condition": {"condition": "ooa.dictionary/key_has_value", "args": {"dictionary": "$d", "key": "a", "value": "x"}}}, "children": [{"action": "core/set", "args": {"variable": "ok", "value": true}}]}], "expect": {"ok": true}},
  {"command": "ooa.dictionary/is_empty", "name": "condition", "vars": {"d": {}, "ok": false},
   "steps": [{"action": "core/if", "args": {"condition": {"condition": "ooa.dictionary/is_empty", "args": {"dictionary": "$d"}}}, "children": [{"action": "core/set", "args": {"variable": "ok", "value": true}}]}], "expect": {"ok": true}}
]
