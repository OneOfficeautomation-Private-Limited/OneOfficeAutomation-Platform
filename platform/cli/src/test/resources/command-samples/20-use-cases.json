 {
  "command": "use-case/O5",
  "name": "tickets labelled and routed by a model",
  "flow": "../../examples/use-cases/O5-ai-ticket-triage.flow.json",
  "copy": "../../examples/use-cases",
  "inputs": {
   "folder": ".",
   "provider": "openai_compatible",
   "base_url": "{mock}",
   "model": "test-model",
   "api_key": {
    "$credential": "test/api/token"
   }
  },
  "expect": {
   "billing": 2,
   "technical": 1,
   "other": 1
  },
  "secrets": {
   "test/api/token": "t0k"
  },
  "mock": [
   {
    "method": "POST",
    "path": "/chat/completions",
    "contains": "Charged twice",
    "body": {
     "choices": [
      {
       "message": {
        "role": "assistant",
        "content": "{\"label\": \"Billing\", \"reason\": \"test\"}"
       }
      }
     ],
     "usage": {
      "prompt_tokens": 5,
      "completion_tokens": 3
     }
    }
   },
   {
    "method": "POST",
    "path": "/chat/completions",
    "contains": "crashes",
    "body": {
     "choices": [
      {
       "message": {
        "role": "assistant",
        "content": "{\"label\": \"Technical\", \"reason\": \"test\"}"
       }
      }
     ],
     "usage": {
      "prompt_tokens": 5,
      "completion_tokens": 3
     }
    }
   },
   {
    "method": "POST",
    "path": "/chat/completions",
    "contains": "Refund for invoice",
    "body": {
     "choices": [
      {
       "message": {
        "role": "assistant",
        "content": "{\"label\": \"Billing\", \"reason\": \"test\"}"
       }
      }
     ],
     "usage": {
      "prompt_tokens": 5,
      "completion_tokens": 3
     }
    }
   },
   {
    "method": "POST",
    "path": "/chat/completions",
    "body": {
     "choices": [
      {
       "message": {
        "role": "assistant",
        "content": "{\"label\": \"Other\", \"reason\": \"test\"}"
       }
      }
     ],
     "usage": {
      "prompt_tokens": 5,
      "completion_tokens": 3
     }
    }
   }
  ],
  "expectFiles": {
   "output/routed-tickets.csv": true
  }
 }
]