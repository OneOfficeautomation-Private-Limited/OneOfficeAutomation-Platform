 {
  "command": "use-case/O2",
  "name": "two invoice emails saved and answered",
  "flow": "../../examples/use-cases/O2-invoice-emails.flow.json",
  "copy": "../../examples/use-cases",
  "inputs": {
   "folder": ".",
   "imap_host": "127.0.0.1",
   "imap_port": "{imap_port}",
   "security": "none",
   "smtp_host": "127.0.0.1",
   "smtp_port": "{smtp_port}",
   "smtp_security": "none",
   "mailbox": "bot@sample.test",
   "password": {
    "$credential": "test/mail/password"
   }
  },
  "expect": {
   "processed": 2,
   "attachments": 2
  },
  "requires": "mail",
  "secrets": {},
  "setup": [
   {
    "action": "ooa.email/send",
    "args": {
     "smtp_host": "127.0.0.1",
     "port": "{smtp_port}",
     "security": "none",
     "to": "bot@sample.test",
     "from": "supplier@sample.test",
     "subject": "Invoice 1001",
     "body": "Please find the invoice attached.",
     "attachments": [
      "data/invoice-1001.pdf"
     ]
    }
   },
   {
    "action": "ooa.email/send",
    "args": {
     "smtp_host": "127.0.0.1",
     "port": "{smtp_port}",
     "security": "none",
     "to": "bot@sample.test",
     "from": "supplier@sample.test",
     "subject": "Invoice 1002",
     "body": "Please find the invoice attached.",
     "attachments": [
      "data/invoice-1002.pdf"
     ]
    }
   },
   {
    "action": "ooa.email/send",
    "args": {
     "smtp_host": "127.0.0.1",
     "port": "{smtp_port}",
     "security": "none",
     "to": "bot@sample.test",
     "from": "friend@sample.test",
     "subject": "Lunch?",
     "body": "Friday?"
    }
   }
  ],
  "expectFiles": {
   "output/invoices/invoice-1001.pdf": true,
   "output/invoices/invoice-1002.pdf": true
  }
 },
