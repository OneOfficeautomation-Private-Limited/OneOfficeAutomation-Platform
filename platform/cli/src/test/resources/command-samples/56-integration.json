 {
  "command": "ooa.file_transfer/delete_files",
  "name": "deletes the files that match a pattern",
  "requires": "ftp",
  "credentials": {
   "pw": "test/mail/password"
  },
  "steps": [
   {
    "action": "ooa.file_transfer/connect",
    "args": {
     "protocol": "ftp",
     "host": "127.0.0.1",
     "port": "{ftp_port}",
     "user": "agent",
     "password": "$pw",
     "passive_mode": true
    }
   },
   {
    "action": "ooa.file_transfer/create_folder",
    "args": {
     "folder": "/c6"
    }
   },
   {
    "action": "ooa.file_transfer/upload_folder",
    "args": {
     "local_folder": "{tmp}/out",
     "remote_folder": "/c6"
    }
   },
   {
    "action": "ooa.file_transfer/delete_files",
    "args": {
     "folder": "/c6",
     "pattern": "*.csv"
    },
    "out": {
     "deleted": "d"
    }
   },
   {
    "action": "ooa.list/size",
    "args": {
     "list": "$d"
    },
    "out": {
     "count": "n"
    }
   },
   {
    "action": "ooa.file_transfer/disconnect"
   }
  ],
  "expect": {
   "n": 2
  },
  "files": {
   "out/a.csv": "1",
   "out/b.csv": "2",
   "out/c.txt": "3"
  }
