[
 {
  "command": "ooa.file_transfer/connect",
  "name": "signs in and lists an empty folder of its own",
  "requires": "ftp",
  "credentials": {
   "pw": "test/mail/password"
  },
  "steps": [
   {
    "action": "ooa.file_transfer/connect",
    "args": {
     "protocol": "ftp",
     "host": "127.0.0.1",
     "port": "{ftp_port}",
     "user": "agent",
     "password": "$pw",
     "passive_mode": true
    }
   },
   {
    "action": "ooa.file_transfer/create_folder",
    "args": {
     "folder": "/c1"
    }
   },
   {
    "action": "ooa.file_transfer/list",
    "args": {
     "folder": "/c1"
    },
    "out": {
     "table": "t"
    }
   },
   {
    "action": "ooa.datatable/row_count",
    "args": {
     "table": "$t"
    },
    "out": {
     "count": "n"
    }
   },
   {
    "action": "ooa.file_transfer/disconnect"
   }
  ],
  "expect": {
   "n": 0
  }
 },
 {
  "command": "ooa.file_transfer/upload",
  "name": "uploads a file and lists it",
  "requires": "ftp",
  "credentials": {
   "pw": "test/mail/password"
  },
  "steps": [
   {
    "action": "ooa.file_transfer/connect",
    "args": {
     "protocol": "ftp",
     "host": "127.0.0.1",
     "port": "{ftp_port}",
     "user": "agent",
     "password": "$pw",
     "passive_mode": true
    }
   },
   {
    "action": "ooa.file_transfer/create_folder",
    "args": {
     "folder": "/c2"
    }
   },
   {
    "action": "ooa.file_transfer/upload",
    "args": {
     "local_path": "{tmp}/a.txt",
     "remote_path": "/c2/a.txt"
    }
   },
   {
    "action": "ooa.file_transfer/list",
    "args": {
     "folder": "/c2",
     "kind": "files"
    },
    "out": {
     "table": "t"
    }
   },
   {
    "action": "ooa.datatable/row_count",
    "args": {
     "table": "$t"
    },
    "out": {
     "count": "n"
    }
   },
   {
    "action": "ooa.file_transfer/disconnect"
   }
  ],
  "expect": {
   "n": 1
  },
  "files": {
   "a.txt": "hello"
  }
 },
 {
  "command": "ooa.file_transfer/download",
  "name": "downloads what was uploaded",
  "requires": "ftp",
  "credentials": {
   "pw": "test/mail/password"
  },
  "steps": [
   {
    "action": "ooa.file_transfer/connect",
    "args": {
     "protocol": "ftp",
     "host": "127.0.0.1",
     "port": "{ftp_port}",
     "user": "agent",
     "password": "$pw",
     "passive_mode": true
    }
   },
   {
    "action": "ooa.file_transfer/create_folder",
    "args": {
     "folder": "/c3"
    }
   },
   {
    "action": "ooa.file_transfer/upload",
    "args": {
     "local_path": "{tmp}/a.txt",
     "remote_path": "/c3/a.txt"
    }
   },
   {
    "action": "ooa.file_transfer/download",
    "args": {
     "remote_path": "/c3/a.txt",
     "local_path": "{tmp}/back.txt"
    }
   },
   {
    "action": "ooa.file/read_text",
    "args": {
     "path": "{tmp}/back.txt"
    },
    "out": {
     "text": "t"
    }
   },
   {
    "action": "ooa.file_transfer/disconnect"
   }
  ],
  "expect": {
   "t": "hello"
  },
  "files": {
   "a.txt": "hello"
  }
 },
 {
