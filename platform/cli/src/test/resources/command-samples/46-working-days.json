[
 {"command": "ooa.datetime/add_working_days", "name": "over Christmas and the year end, time of day kept", "vars": {"d": "2026-12-24T09:30:00"},
  "steps": [{"action": "ooa.datetime/add_working_days", "args": {"value": "$d", "days": 5, "holidays": ["2026-12-25", "2027-01-01"]}, "out": {"result": "r"}}],
  "expect": {"r": "2027-01-04T09:30"}},
 {"command": "ooa.datetime/add_working_days", "name": "a negative number goes back", "vars": {"d": "2027-01-04T09:30:00"},
  "steps": [{"action": "ooa.datetime/add_working_days", "args": {"value": "$d", "days": -5, "holidays": ["2026-12-25", "2027-01-01"]}, "out": {"result": "r"}}],
  "expect": {"r": "2026-12-24T09:30"}},
 {"command": "ooa.datetime/add_working_days", "name": "a Friday-Saturday weekend", "vars": {"d": "2026-11-05T00:00:00"},
  "steps": [{"action": "ooa.datetime/add_working_days", "args": {"value": "$d", "days": 1, "weekend": "FRI,SAT"}, "out": {"result": "r"}}],
  "expect": {"r": "2026-11-08T00:00"}},
 {"command": "ooa.datetime/add_working_days", "name": "leap day counts", "vars": {"d": "2028-02-28T00:00:00"},
  "steps": [{"action": "ooa.datetime/add_working_days", "args": {"value": "$d", "days": 1}, "out": {"result": "r"}}],
  "expect": {"r": "2028-02-29T00:00"}},
 {"command": "ooa.datetime/add_working_days", "name": "whole numbers only", "vars": {"d": "2026-11-05T00:00:00"},
  "steps": [{"action": "ooa.datetime/add_working_days", "args": {"value": "$d", "days": 1.5}}], "error": "DATETIME.BAD_AMOUNT"},
 {"command": "ooa.datetime/add_working_days", "name": "a calendar name needs One CommandCenter", "vars": {"d": "2026-11-05T00:00:00"},
  "steps": [{"action": "ooa.datetime/add_working_days", "args": {"value": "$d", "days": 1, "calendar": "India 2026"}}], "error": "DATETIME.NO_COMMAND_CENTER"},
 {"command": "ooa.datetime/working_days_between", "name": "Monday to Monday over a holiday", "vars": {"a": "2026-12-21T00:00:00", "b": "2026-12-28T00:00:00"},
  "steps": [{"action": "ooa.datetime/working_days_between", "args": {"start": "$a", "end": "$b", "holidays": ["2026-12-25"]}, "out": {"result": "n"}}],
  "expect": {"n": 4}},
 {"command": "ooa.datetime/working_days_between", "name": "with the start day, and backwards", "vars": {"a": "2026-11-09T00:00:00", "b": "2026-11-13T00:00:00"},
  "steps": [{"action": "ooa.datetime/working_days_between", "args": {"start": "$a", "end": "$b", "include_start": true}, "out": {"result": "n"}},
            {"action": "ooa.datetime/working_days_between", "args": {"start": "$b", "end": "$a"}, "out": {"result": "back"}}],
  "expect": {"n": 5, "back": -4}},
 {"command": "ooa.datetime/working_days_between", "name": "a weekend of every day is refused", "vars": {"a": "2026-11-09T00:00:00"},
  "steps": [{"action": "ooa.datetime/working_days_between", "args": {"start": "$a", "end": "$a", "weekend": "MON,TUE,WED,THU,FRI,SAT,SUN"}}], "error": "DATETIME.BAD_WEEKEND"},
 {"command": "ooa.datetime/next_working_day", "name": "after a Friday holiday", "vars": {"d": "2026-12-24T08:00:00"},
  "steps": [{"action": "ooa.datetime/next_working_day", "args": {"value": "$d", "holidays": ["2026-12-25"]}, "out": {"result": "r"}},
            {"action": "ooa.datetime/next_working_day", "args": {"value": "$d", "holidays": ["2026-12-25"], "same_day": true}, "out": {"result": "same"}}],
  "expect": {"r": "2026-12-28T08:00", "same": "2026-12-24T08:00"}},
 {"command": "ooa.datetime/previous_working_day", "name": "before New Year's Day", "vars": {"d": "2027-01-03T08:00:00"},
  "steps": [{"action": "ooa.datetime/previous_working_day", "args": {"value": "$d", "holidays": ["2027-01-01"], "same_day": true}, "out": {"result": "r"}}],
  "expect": {"r": "2026-12-31T08:00"}},
 {"command": "ooa.datetime/is_working_day", "name": "holiday, weekend and working day", "vars": {"h": "2026-12-25T00:00:00", "w": "2026-12-26T00:00:00", "x": "2026-12-24T00:00:00"},
  "steps": [{"action": "ooa.datetime/is_working_day", "args": {"value": "$h", "holidays": ["2026-12-25"]}, "out": {"result": "a", "reason": "ra"}},
            {"action": "ooa.datetime/is_working_day", "args": {"value": "$w", "holidays": ["2026-12-25"]}, "out": {"result": "b", "reason": "rb"}},
            {"action": "ooa.datetime/is_working_day", "args": {"value": "$x", "holidays": ["2026-12-25"]}, "out": {"result": "c", "reason": "rc"}}],
  "expect": {"a": false, "ra": "holiday", "b": false, "rb": "weekend", "c": true, "rc": ""}},
 {"command": "ooa.datetime/is_working_day", "name": "the date is read in the time zone", "vars": {"d": "2026-11-06T20:00:00"},
  "steps": [{"action": "ooa.datetime/is_working_day", "args": {"value": "$d", "time_zone": "Asia/Kolkata"}, "out": {"result": "r"}}],
  "expect": {"r": false}},
 {"command": "ooa.datetime/is_working_day", "name": "a holiday that is not a date", "vars": {"d": "2026-11-06T00:00:00"},
  "steps": [{"action": "ooa.datetime/is_working_day", "args": {"value": "$d", "holidays": ["25/12/2026"]}}], "error": "DATETIME.BAD_HOLIDAY"},
 {"command": "ooa.datetime/is_working_day", "name": "condition in an If", "vars": {"d": "2026-12-25T00:00:00"},
  "steps": [{"action": "core/set", "args": {"variable": "open", "value": "yes"}},
            {"action": "core/if", "args": {"condition": {"condition": "ooa.datetime/is_working_day", "args": {"value": "$d", "holidays": ["2026-12-25"]}}},
             "children": [], "else": [{"action": "core/set", "args": {"variable": "open", "value": "no"}}]}],
  "expect": {"open": "no"}}
]
