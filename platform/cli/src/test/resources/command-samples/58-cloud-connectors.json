  {"command": "ooa.github/create_issue", "name": "open an issue, comment, close it",
   "credentials": {"tok": "test/api/token"}, "secrets": {"test/api/token": "ghp-1"},
   "mock": [
     {"method": "POST", "path": "/repos/acme/web/issues/12/comments", "status": 201, "body": {"id": 900, "html_url": "https://github.example/acme/web/issues/12#c900"}},
     {"method": "POST", "path": "/repos/acme/web/issues", "status": 201, "body": {"number": 12, "html_url": "https://github.example/acme/web/issues/12"}},
     {"method": "PATCH", "path": "/repos/acme/web/issues/12", "body": {"number": 12, "state": "closed"}}],
   "steps": [
     {"action": "ooa.github/create_issue", "args": {"base_url": "{mock}", "token": "$tok", "owner": "acme", "repo": "web", "title": "Nightly load failed"}, "out": {"number": "num"}},
     {"action": "ooa.github/add_issue_comment", "args": {"base_url": "{mock}", "token": "$tok", "owner": "acme", "repo": "web", "number": "$num", "text": "Rerun scheduled"}},
     {"action": "ooa.github/close_issue", "args": {"base_url": "{mock}", "token": "$tok", "owner": "acme", "repo": "web", "number": "$num"}}],
   "expect": {"num": 12},
   "expectRequests": ["POST /repos/acme/web/issues Nightly load failed", "POST /repos/acme/web/issues/12/comments Rerun scheduled", "PATCH /repos/acme/web/issues/12 closed"]},

  {"command": "ooa.salesforce/find_records", "name": "find records with a value that has a quote in it",
   "credentials": {"tok": "test/api/token"}, "secrets": {"test/api/token": "sf-1"},
   "mock": [{"method": "GET", "path": "/services/data/v61.0/query", "body": {"done": true, "totalSize": 1, "records": [{"attributes": {}, "Id": "003A", "Name": "Ann O'Brien"}]}}],
   "steps": [{"action": "ooa.salesforce/find_records", "args": {"instance_url": "{mock}", "access_token": "$tok", "object": "Contact", "conditions": {"LastName": "O'Brien"}}, "out": {"count": "n", "soql": "q"}}],
   "expect": {"n": 1, "q": "SELECT Id, Name FROM Contact WHERE LastName = 'O\\'Brien' LIMIT 2000"}},

