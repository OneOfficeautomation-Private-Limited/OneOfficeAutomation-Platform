    "args": {
     "x": 0,
     "y": 0,
     "width": 20,
     "height": 20,
     "timeout_seconds": 0.6,
     "threshold_percent": 50,
     "fail_on_timeout": false
    },
    "out": {
     "changed": "c"
    }
   }
  ],
  "expect": {
   "c": false
  }
 },
 {
  "command": "ooa.application/run_program",
  "name": "exit code and output",
  "steps": [
   {
    "action": "ooa.application/run_program",
    "args": {
     "program": "cmd.exe",
     "arguments": [
      "/c",
      "echo hello"
     ]
    },
    "out": {
     "exit_code": "e",
     "output": "o"
    }
   }
  ],
  "expect": {
   "e": 0,
   "o": {
    "$contains": "hello"
   }
  }
 },
 {
  "command": "ooa.application/run_program",
