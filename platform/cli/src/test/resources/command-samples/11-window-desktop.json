 },
 {
  "command": "ooa.application/is_running",
  "name": "no such program",
  "vars": {
   "r": true
  },
  "steps": [
   {
    "action": "core/if",
    "args": {
     "condition": {
      "condition": "ooa.application/is_running",
      "args": {
       "name": "no-such-program-9f3a.exe"
      }
     }
    },
    "else": [
     {
      "action": "core/set",
      "args": {
       "variable": "r",
       "value": false
      }
     }
    ]
   }
  ],
  "expect": {
   "r": false
  }
 },
