[
 {
  "command": "ooa.window/wait_for",
  "name": "window life cycle on a test window",
  "requires": "desktop",
  "steps": [
   {
    "action": "ooa.application/start_program",
    "args": {
     "program": "powershell.exe",
     "arguments": [
      "-NoProfile",
      "-Command",
      "Add-Type -AssemblyName System.Windows.Forms; $f = New-Object Windows.Forms.Form; $f.Text = 'OOA sample window'; $f.Width = 400; $f.Height = 300; [void]$f.ShowDialog()"
     ]
    },
    "out": {
     "process_id": "pid"
    }
   },
   {
    "action": "ooa.window/wait_for",
    "args": {
     "title": "OOA sample window",
     "timeout_seconds": 30
    },
    "out": {
     "title": "t"
    }
   },
   {
    "action": "ooa.window/activate",
    "args": {
     "title": "OOA sample window"
    }
   },
   {
    "action": "ooa.window/get_active",
    "out": {
     "title": "active"
    }
   },
   {
    "action": "ooa.window/set_title",
    "args": {
     "title": "OOA sample window",
     "new_title": "OOA sample renamed"
    },
    "out": {
     "previous_title": "prev"
    }
   },
   {
    "action": "ooa.window/move_resize",
    "args": {
     "title": "OOA sample renamed",
     "x": 100,
     "y": 100,
     "width": 500,
     "height": 350
    }
   },
   {
    "action": "ooa.window/get_info",
    "args": {
     "title": "OOA sample renamed"
    },
    "out": {
     "window": "info"
    }
   },
   {
    "action": "ooa.window/maximize",
    "args": {
     "title": "OOA sample renamed"
    }
   },
   {
    "action": "ooa.window/minimize",
    "args": {
     "title": "OOA sample renamed"
    }
   },
   {
    "action": "ooa.window/restore",
    "args": {
     "title": "OOA sample renamed"
    }
   },
   {
    "action": "ooa.window/capture",
    "args": {
     "title": "OOA sample renamed",
     "path": "{tmp}/win.png",
     "activate": true
    }
   },
   {
    "action": "ooa.window/list",
    "out": {
     "titles": "all"
    }
   },
   {
    "action": "core/set",
    "args": {
     "variable": "listed",
     "value": {
      "expr": "contains($all, 'OOA sample renamed')"
     }
    }
   },
   {
    "action": "core/set",
    "args": {
     "variable": "exists",
     "value": false
    }
   },
   {
    "action": "core/if",
    "args": {
     "condition": {
      "condition": "ooa.window/exists",
      "args": {
       "title": "OOA sample renamed"
      }
     }
    },
    "children": [
     {
      "action": "core/set",
      "args": {
       "variable": "exists",
       "value": true
      }
     }
    ]
   },
   {
    "action": "ooa.window/close_all",
    "args": {
     "title": "OOA sample",
     "keep": [
      "nothing to keep"
     ]
    },
    "out": {
     "count": "closed"
    }
   },
   {
    "action": "ooa.window/wait_for",
    "args": {
     "title": "OOA sample renamed",
     "state": "close",
     "timeout_seconds": 10
    },
    "out": {
     "met": "closed_in_time"
    }
   },
   {
    "action": "core/set",
    "args": {
     "variable": "gone",
     "value": true
    }
   },
   {
    "action": "core/if",
    "args": {
     "condition": {
      "condition": "ooa.window/exists",
      "args": {
       "title": "OOA sample renamed"
      }
     }
    },
    "children": [
     {
      "action": "core/set",
      "args": {
       "variable": "gone",
       "value": false
      }
     }
    ]
   }
  ],
  "expect": {
   "t": "OOA sample window",
   "active": "OOA sample window",
   "prev": "OOA sample window",
   "listed": true,
   "exists": true,
   "closed": 1,
   "gone": true,
   "closed_in_time": true
  },
  "expectFiles": {
   "win.png": true
  }
 },
 {
  "command": "ooa.window/close_all",
  "name": "keep list (new) leaves the window open",
  "requires": "desktop",
  "steps": [
   {
    "action": "ooa.application/start_program",
    "args": {
     "program": "powershell.exe",
     "arguments": [
      "-NoProfile",
      "-Command",
      "Add-Type -AssemblyName System.Windows.Forms; $f = New-Object Windows.Forms.Form; $f.Text = 'OOA keep me'; [void]$f.ShowDialog()"
     ]
    }
   },
   {
    "action": "ooa.window/wait_for",
    "args": {
     "title": "OOA keep me",
     "timeout_seconds": 30
    }
   },
   {
    "action": "ooa.window/close_all",
    "args": {
     "title": "OOA keep",
     "keep": [
      "keep me"
     ]
    },
    "out": {
     "count": "n"
    }
   },
   {
    "action": "ooa.window/close",
    "args": {
     "title": "OOA keep me"
    }
   }
  ],
  "expect": {
   "n": 0
  }
 },
 {
  "command": "ooa.window/close_all",
  "name": "too broad a title is refused",
  "steps": [
   {
    "action": "ooa.window/close_all",
    "args": {
     "title": "a"
    }
   }
  ],
  "error": "WINDOW.PATTERN_TOO_BROAD"
 },
 {
