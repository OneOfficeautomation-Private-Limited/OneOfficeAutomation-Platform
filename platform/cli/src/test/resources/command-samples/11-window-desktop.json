  "error": "WINDOW.NOT_FOUND"
 },
 {
  "command": "ooa.desktop/clipboard_set",
  "name": "clipboard round trip",
  "requires": "desktop",
  "steps": [
   {
    "action": "ooa.desktop/clipboard_set",
    "args": {
     "text": "ooa clip"
    }
   },
   {
    "action": "ooa.desktop/clipboard_set",
    "args": {
     "text": " 2",
     "append": true
    }
   },
   {
    "action": "ooa.desktop/clipboard_get",
    "out": {
     "text": "c",
     "has_text": "h"
    }
   },
   {
    "action": "ooa.desktop/clipboard_clear"
   },
   {
    "action": "ooa.desktop/clipboard_get",
    "out": {
     "has_text": "after"
    }
   }
  ],
  "expect": {
   "c": "ooa clip 2",
   "h": true,
   "after": false
  }
 },
 {
  "command": "ooa.desktop/message_box",
  "name": "closes itself after the time-out",
  "requires": "desktop",
  "steps": [
   {
    "action": "ooa.desktop/message_box",
    "args": {
     "message": "Sample: closes in 1 s",
     "timeout_seconds": 1,
     "buttons": "ok_cancel"
    },
    "out": {
     "button": "b"
    }
   }
  ],
  "expect": {
   "b": "timeout"
  }
 },
 {
  "command": "ooa.desktop/prompt_yes_no",
  "name": "answer on time-out",
  "requires": "desktop",
  "steps": [
   {
    "action": "ooa.desktop/prompt_yes_no",
    "args": {
     "question": "Sample: answers itself",
     "timeout_seconds": 1,
     "answer_on_timeout": true
    },
    "out": {
     "answer": "a",
     "timed_out": "t"
    }
   }
  ],
  "expect": {
   "a": true,
   "t": true
  }
 },
 {
  "command": "ooa.desktop/prompt_value",
  "name": "time-out keeps the default (fixed)",
  "requires": "desktop",
  "steps": [
   {
    "action": "ooa.desktop/prompt_value",
    "args": {
     "question": "Sample: value",
     "default": "x",
     "timeout_seconds": 1
    },
    "out": {
     "value": "v",
     "timed_out": "to"
    }
   }
  ],
  "expect": {
   "v": "x",
   "to": true
  }
 },
