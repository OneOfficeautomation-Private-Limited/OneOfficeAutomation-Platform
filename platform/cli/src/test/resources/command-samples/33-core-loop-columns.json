  {"command": "core/loop", "name": "columns of each row into their own variables", "vars": {"t": {"columns": ["Name", "Amount"], "rows": [["Ann", 10], ["Bo", 25]]}, "who": "", "amt": 0, "total": 0, "names": ""},
