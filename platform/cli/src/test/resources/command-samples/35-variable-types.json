[
  {"command": "core/set", "name": "Time variable from 2:30 PM (G22)", "types": {"t": "Time"},
   "steps": [{"action": "core/set", "args": {"variable": "t", "value": "2:30 PM"}}], "expect": {"t": "14:30:00"}},
  {"command": "core/set", "name": "Time variable refuses text that is not a time (G22)", "types": {"t": "Time"},
   "steps": [{"action": "core/set", "args": {"variable": "t", "value": "half past"}}], "error": "VAR.TYPE_MISMATCH"},
  {"command": "core/set", "name": "TimeSpan variable from 1d 3h, kept as ISO 8601 (G22)", "types": {"s": "TimeSpan"},
   "steps": [{"action": "core/set", "args": {"variable": "s", "value": "1d 3h"}}], "expect": {"s": "PT27H"}},
  {"command": "core/set", "name": "DateTime plus a TimeSpan, and the TimeSpan between two dates (G22)",
   "types": {"d": "DateTime", "s": "TimeSpan", "end": "DateTime", "gap": "TimeSpan"}, "vars": {"d": "2026-10-18T09:00:00", "s": "2h 15m"},
   "steps": [{"action": "core/set", "args": {"variable": "end", "value": {"expr": "$d + $s"}}},
             {"action": "core/set", "args": {"variable": "gap", "value": {"expr": "timeBetween($end, '2026-10-17T08:30:00')"}}},
             {"action": "core/set", "args": {"variable": "mins", "value": {"expr": "totalMinutes($s)"}}}],
   "expect": {"end": "2026-10-18T11:15", "gap": "-PT26H45M", "mins": 135}},
  {"command": "core/set", "name": "Time plus a TimeSpan wraps round midnight; Time comparison (G22)",
   "types": {"t": "Time", "later": "Time"}, "vars": {"t": "22:30"},
   "steps": [{"action": "core/set", "args": {"variable": "later", "value": {"expr": "$t + timeSpan(3, 'hours')"}}},
             {"action": "core/set", "args": {"variable": "early", "value": {"expr": "$later < '06:00'"}}}],
   "expect": {"later": "01:30:00", "early": true}},
  {"command": "core/set", "name": "Binary variable from a file: length and Base64 (G22)", "types": {"b": "Binary"},
   "files": {"a.txt": "hello"},
   "steps": [{"action": "core/set", "args": {"variable": "b", "value": "{tmp}/a.txt"}},
             {"action": "core/set", "args": {"variable": "n", "value": {"expr": "binaryLength($b)"}}},
             {"action": "core/set", "args": {"variable": "text", "value": {"expr": "toBase64($b)"}}},
             {"action": "core/set", "args": {"variable": "shown", "value": "${b}"}}],
   "expect": {"n": 5, "text": "aGVsbG8=", "shown": "Binary 5 bytes", "b": {"$binary": "aGVsbG8=", "mime": "text/plain"}}},
  {"command": "core/set", "name": "Image variable: width and height (G22)", "types": {"img": "Image"},
   "vars": {"img": {"$binary": "iVBORw0KGgoAAAANSUhEUgAAAAMAAAACCAIAAAASFvFNAAAAEklEQVR4nGP4z8AAQVDqPwMDAEHSBfsl0XwmAAAAAElFTkSuQmCC"}},
   "steps": [{"action": "core/set", "args": {"variable": "size", "value": {"expr": "concat(imageWidth($img), 'x', imageHeight($img))"}}}],
   "expect": {"size": "3x2", "img": {"$binary": "iVBORw0KGgoAAAANSUhEUgAAAAMAAAACCAIAAAASFvFNAAAAEklEQVR4nGP4z8AAQVDqPwMDAEHSBfsl0XwmAAAAAElFTkSuQmCC", "mime": "image/png", "width": 3, "height": 2}}},
  {"command": "ooa.image/find_in_image", "name": "Image variables given straight to the picture fields (G22)", "types": {"img": "Image"},
   "vars": {"img": {"$binary": "iVBORw0KGgoAAAANSUhEUgAAAAMAAAACCAIAAAASFvFNAAAAEklEQVR4nGP4z8AAQVDqPwMDAEHSBfsl0XwmAAAAAElFTkSuQmCC"}},
   "steps": [{"action": "ooa.image/find_in_image", "args": {"image": "$img", "template": "$img", "tolerance": 0}, "out": {"found": "found"}}],
   "expect": {"found": true}},
  {"command": "ooa.file/read_text", "name": "an Image is not a file path for other file fields (G22)", "types": {"img": "Image"},
   "vars": {"img": {"$binary": "iVBORw0KGgoAAAANSUhEUgAAAAMAAAACCAIAAAASFvFNAAAAEklEQVR4nGP4z8AAQVDqPwMDAEHSBfsl0XwmAAAAAElFTkSuQmCC"}},
   "steps": [{"action": "ooa.file/read_text", "args": {"path": "$img"}}], "error": "VAR.TYPE_MISMATCH"}
]
