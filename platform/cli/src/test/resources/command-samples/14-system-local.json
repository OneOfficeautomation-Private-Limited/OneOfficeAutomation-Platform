 {
  "command": "ooa.dll/open",
  "name": "open, call through the session, close",
  "steps": [
   {
    "action": "ooa.dll/open",
    "args": {
     "library": "kernel32"
    }
   },
   {
    "action": "ooa.dll/call",
    "args": {
