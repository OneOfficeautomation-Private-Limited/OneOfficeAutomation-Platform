 {
  "command": "ooa.workload/add_item",
  "name": "local queue: add, get next, complete, fail, defer, counts",
  "steps": [
   {
    "action": "ooa.workload/add_item",
    "args": {
     "queue": "invoices",
     "data": {
      "no": 1
     }
    },
    "out": {
     "item_id": "a"
    }
   },
   {
    "action": "ooa.workload/add_items",
    "args": {
     "queue": "invoices",
     "table": {
      "columns": [
       "no"
      ],
      "rows": [
       [
        2
       ],
       [
        3
       ]
      ]
     }
    },
    "out": {
     "count": "added"
    }
   },
   {
    "action": "ooa.workload/get_next",
    "args": {
     "queue": "invoices"
    },
    "out": {
     "item_id": "first",
     "data": "d"
    }
   },
   {
    "action": "ooa.workload/complete",
    "args": {
     "queue": "invoices",
     "item_id": "$first",
     "result": {
      "ok": true
     }
    }
   },
   {
    "action": "ooa.workload/get_next",
    "args": {
     "queue": "invoices"
    },
    "out": {
     "item_id": "second"
    }
   },
   {
    "action": "ooa.workload/fail",
    "args": {
     "queue": "invoices",
     "item_id": "$second",
     "error": "bad",
     "max_attempts": 1
    },
    "out": {
     "will_retry": "retry"
    }
   },
   {
    "action": "ooa.workload/get_next",
    "args": {
     "queue": "invoices"
    },
    "out": {
     "item_id": "third"
    }
   },
   {
    "action": "ooa.workload/defer",
    "args": {
     "queue": "invoices",
     "item_id": "$third",
     "until": "2099-01-01T00:00:00"
    }
   },
   {
    "action": "ooa.workload/get_item",
    "args": {
     "queue": "invoices",
     "item_id": "$first"
    },
    "out": {
     "item": "item"
    }
   },
   {
    "action": "ooa.workload/update_item",
    "args": {
     "queue": "invoices",
     "item_id": "$first",
     "data": {
      "note": "x"
     }
    }
   },
   {
    "action": "ooa.workload/list_items",
    "args": {
     "queue": "invoices",
     "status": "completed"
    },
    "out": {
     "table": "done"
    }
   },
   {
    "action": "ooa.workload/counts",
    "args": {
     "queue": "invoices"
    },
    "out": {
     "counts": "c"
    }
   }
  ],
  "expect": {
   "added": 2,
   "d": {
    "no": 1
   },
   "retry": false,
   "item": {
    "$type": "object"
   },
   "c": {
    "$type": "object"
   }
  }
 },
 {
  "command": "ooa.workload/each_item",
  "name": "loop over queue items",
  "vars": {
   "sum": 0
  },
  "steps": [
   {
    "action": "ooa.workload/add_items",
    "args": {
     "queue": "q2",
     "table": {
      "columns": [
       "n"
      ],
      "rows": [
