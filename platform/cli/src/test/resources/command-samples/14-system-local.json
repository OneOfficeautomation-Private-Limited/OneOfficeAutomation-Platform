 {
  "command": "ooa.database/connect",
  "name": "create, insert, bulk insert, query, transaction, export, describe",
  "steps": [
   {
    "action": "ooa.database/connect",
    "args": {
     "jdbc_url": "jdbc:h2:mem:sample;DB_CLOSE_DELAY=-1",
     "user": "sa"
    }
   },
   {
    "action": "ooa.database/execute",
    "args": {
     "sql": "CREATE TABLE inv (id INT PRIMARY KEY, vendor VARCHAR(40), amount DECIMAL(10,2))"
    }
   },
   {
    "action": "ooa.database/execute",
    "args": {
     "sql": "INSERT INTO inv VALUES (?, ?, ?)",
     "parameters": [
      1,
      "Acme",
      120.5
     ]
    },
    "out": {
     "rows_affected": "ins"
    }
   },
   {
    "action": "ooa.database/bulk_insert",
    "args": {
     "table": "inv",
     "data": {
      "columns": [
       "id",
       "vendor",
       "amount"
      ],
      "rows": [
       [
        2,
        "Zeta",
        80
       ],
       [
        3,
        "Acme",
        10
       ]
      ]
     }
    },
    "out": {
     "rows_inserted": "bulk"
    }
   },
   {
    "action": "ooa.database/begin_transaction"
   },
   {
    "action": "ooa.database/execute",
    "args": {
     "sql": "DELETE FROM inv"
    }
   },
   {
    "action": "ooa.database/rollback"
   },
   {
    "action": "ooa.database/query",
    "args": {
     "sql": "SELECT vendor, SUM(amount) AS total FROM inv GROUP BY vendor ORDER BY vendor"
    },
    "out": {
     "table": "t",
     "row_count": "n"
    }
   },
   {
    "action": "ooa.database/begin_transaction"
   },
   {
    "action": "ooa.database/execute",
    "args": {
     "sql": "UPDATE inv SET amount = 0 WHERE id = 3"
    }
   },
   {
    "action": "ooa.database/commit"
   },
   {
    "action": "ooa.database/export_to_file",
    "args": {
     "sql": "SELECT id FROM inv ORDER BY id",
     "path": "{tmp}/ids.csv"
    },
    "out": {
     "row_count": "exported"
    }
   },
   {
    "action": "ooa.database/list_tables",
    "out": {
     "table": "tables"
    }
   },
   {
    "action": "ooa.database/describe_table",
    "args": {
     "table": "INV"
    },
    "out": {
     "table": "cols"
    }
   },
   {
    "action": "ooa.database/execute",
    "args": {
     "sql": "DROP TABLE inv"
    }
   },
   {
    "action": "ooa.database/disconnect"
   }
  ],
  "expect": {
   "ins": 1,
   "bulk": 2,
   "n": 2,
   "t": {
    "columns": [
     "VENDOR",
     "TOTAL"
    ],
    "rows": [
     [
      "Acme",
      130.5
     ],
     [
      "Zeta",
      80
     ]
    ]
   },
   "exported": 3
  },
  "expectFiles": {
   "ids.csv": true
  }
 },
