 {
  "command": "ooa.crypto/encrypt_text",
  "name": "encrypt, decrypt text and file",
  "credentials": {
   "pp": "test/crypto/pass"
  },
  "secrets": {
   "test/crypto/pass": "s3cret!"
  },
  "files": {
   "a.txt": "plain"
  },
  "steps": [
   {
    "action": "ooa.crypto/encrypt_text",
    "args": {
     "text": "hello",
     "passphrase": "$pp"
    },
    "out": {
     "result": "c"
    }
   },
   {
    "action": "ooa.crypto/decrypt_text",
    "args": {
     "text": "$c",
     "passphrase": "$pp"
    },
    "out": {
     "result": "t"
    }
   },
   {
    "action": "ooa.crypto/encrypt_file",
    "args": {
     "path": "{tmp}/a.txt",
     "target": "{tmp}/a.enc",
     "passphrase": "$pp"
    }
   },
   {
    "action": "ooa.crypto/decrypt_file",
    "args": {
     "path": "{tmp}/a.enc",
     "target": "{tmp}/b.txt",
     "passphrase": "$pp"
    }
   }
  ],
  "expect": {
   "t": "****"
  },
  "expectFiles": {
   "b.txt": "plain"
  }
 },
 {
  "command": "ooa.crypto/decrypt_text",
  "name": "wrong passphrase",
  "credentials": {
   "a": "test/crypto/a",
   "b": "test/crypto/b"
  },
  "secrets": {
   "test/crypto/a": "one",
   "test/crypto/b": "two"
  },
  "steps": [
   {
    "action": "ooa.crypto/encrypt_text",
    "args": {
     "text": "hello",
     "passphrase": "$a"
    },
    "out": {
     "result": "c"
    }
   },
   {
    "action": "ooa.crypto/decrypt_text",
    "args": {
     "text": "$c",
     "passphrase": "$b"
    }
   }
  ],
  "error": "CRYPTO.WRONG_KEY"
 },
 {
  "command": "ooa.crypto/rsa_generate_keys",
  "name": "keys, encrypt, decrypt, sign, verify",
  "steps": [
   {
    "action": "ooa.crypto/rsa_generate_keys",
    "args": {
     "folder": "{tmp}/keys"
    },
    "out": {
     "public_key": "pub",
     "private_key": "priv"
    }
   },
   {
    "action": "ooa.crypto/rsa_encrypt",
    "args": {
     "text": "hi",
     "public_key": "$pub"
    },
    "out": {
     "result": "c"
    }
   },
   {
    "action": "ooa.crypto/rsa_decrypt",
    "args": {
     "text": "$c",
     "private_key": "$priv"
    },
    "out": {
     "result": "t"
    }
   },
   {
    "action": "ooa.crypto/rsa_sign",
    "args": {
     "text": "doc",
     "private_key": "$priv"
    },
    "out": {
     "signature": "s"
    }
   },
   {
    "action": "ooa.crypto/rsa_verify",
    "args": {
     "text": "doc",
     "signature": "$s",
     "public_key": "$pub"
    },
    "out": {
     "valid": "v"
    }
   },
   {
    "action": "ooa.crypto/rsa_verify",
    "args": {
     "text": "tampered",
     "signature": "$s",
     "public_key": "$pub"
    },
    "out": {
     "valid": "v2"
    }
   }
  ],
  "expect": {
   "t": "****",
   "v": true,
   "v2": false
  }
 },
