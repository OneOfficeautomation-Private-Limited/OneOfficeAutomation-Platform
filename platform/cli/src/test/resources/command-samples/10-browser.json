[
  {"command": "ooa.browser/open", "name": "form: set text, select, click, read back", "requires": "browser",
   "files": {"form.html": "<html><head><title>Order form</title><script>function total(a, b) { return a * b; }</script></head><body><h1 id='h'>Orders</h1><input id='name'><select id='size'><option value='s'>Small</option><option value='l'>Large</option></select><button id='go' onclick=\"document.getElementById('out').textContent = 'Hi ' + document.getElementById('name').value + ' ' + document.getElementById('size').value\">Go</button><p id='out'></p><a id='link' href='form.html?x=1' data-k='v7'>again</a><table id='t'><tr><th>Item</th><th>Qty</th></tr><tr><td>pen</td><td>2</td></tr><tr><td>cup</td><td>3</td></tr></table></body></html>"},
   "steps": [
     {"action": "ooa.browser/open", "args": {"url": "{web}/form.html", "headless": true, "engine": "playwright", "keep_open": false}},
     {"action": "ooa.browser/page_info", "out": {"title": "title", "url": "url"}},
     {"action": "ooa.browser/type_text", "args": {"selector": "#name", "text": "Ann"}},
     {"action": "ooa.browser/select_option", "args": {"selector": "#size", "option": "Large"}},
     {"action": "ooa.browser/click", "args": {"selector": "#go"}},
     {"action": "ooa.browser/wait_for", "args": {"selector": "#out", "state": "visible", "timeout_ms": 5000}},
     {"action": "ooa.browser/get_text", "args": {"selector": "#out"}, "out": {"text": "out"}},
     {"action": "ooa.browser/get_attribute", "args": {"selector": "#link", "attribute": "data-k"}, "out": {"value": "attr"}},
     {"action": "ooa.browser/extract_table", "args": {"selector": "#t"}, "out": {"table": "tab"}},
     {"action": "ooa.browser/run_javascript", "args": {"script": "document.querySelectorAll('td').length"}, "out": {"result": "cells"}},
     {"action": "ooa.browser/call_javascript_function", "args": {"function": "total", "arguments": [6, 7], "return_type": "number"}, "out": {"result": "prod"}},
     {"action": "ooa.browser/get_page_source", "args": {"path": "{tmp}/saved.html"}, "out": {"source": "src"}},
     {"action": "ooa.browser/screenshot", "args": {"path": "{tmp}/shot.png"}},
     {"action": "ooa.browser/close"}],
   "expect": {"title": "Order form", "out": "Hi Ann l", "attr": "v7", "tab": {"columns": ["Item", "Qty"], "rows": [["pen", "2"], ["cup", "3"]]}, "cells": 4, "prod": 42, "src": {"$contains": "function total"}},
   "expectFiles": {"shot.png": true, "saved.html": true}},
  {"command": "ooa.browser/navigate", "name": "go to a page, back and forward", "requires": "browser",
   "files": {"a.html": "<title>A</title><p>a</p>", "b.html": "<title>B</title><p>b</p>"},
   "steps": [
     {"action": "ooa.browser/open", "args": {"url": "{web}/a.html", "headless": true, "engine": "playwright", "keep_open": false}},
     {"action": "ooa.browser/navigate", "args": {"url": "{web}/b.html"}},
     {"action": "ooa.browser/page_info", "out": {"title": "t1"}},
     {"action": "ooa.browser/history", "args": {"action": "back"}},
     {"action": "ooa.browser/page_info", "out": {"title": "t2"}},
     {"action": "ooa.browser/history", "args": {"action": "forward"}},
     {"action": "ooa.browser/history", "args": {"action": "refresh"}},
     {"action": "ooa.browser/page_info", "out": {"title": "t3"}},
     {"action": "ooa.browser/close"}], "expect": {"t1": "B", "t2": "A", "t3": "B"}},
  {"command": "ooa.browser/history", "name": "too many steps back is an error when asked", "requires": "browser",
   "files": {"a.html": "<title>A</title>"},
   "steps": [{"action": "ooa.browser/open", "args": {"url": "{web}/a.html", "headless": true, "engine": "playwright", "keep_open": false}},
     {"action": "ooa.browser/history", "args": {"action": "back", "steps": 5, "error_if_too_many": true}}], "error": "BROWSER.HISTORY_TOO_SHORT"},
  {"command": "ooa.browser/element_exists", "name": "conditions: exists, visible, text on page", "requires": "browser",
   "files": {"c.html": "<title>C</title><p id='shown'>Invoice paid</p><p id='hidden' style='display:none'>x</p>"}, "vars": {"a": false, "b": true, "c": false},
   "steps": [{"action": "ooa.browser/open", "args": {"url": "{web}/c.html", "headless": true, "engine": "playwright", "keep_open": false}},
     {"action": "core/if", "args": {"condition": {"condition": "ooa.browser/element_exists", "args": {"selector": "#hidden"}}}, "children": [{"action": "core/set", "args": {"variable": "a", "value": true}}]},
     {"action": "core/if", "args": {"condition": {"condition": "ooa.browser/element_visible", "args": {"selector": "#hidden"}}}, "else": [{"action": "core/set", "args": {"variable": "b", "value": false}}]},
     {"action": "core/if", "args": {"condition": {"condition": "ooa.browser/text_on_page", "args": {"text": "Invoice paid"}}}, "children": [{"action": "core/set", "args": {"variable": "c", "value": true}}]},
     {"action": "ooa.browser/close"}], "expect": {"a": true, "b": false, "c": true}},
  {"command": "ooa.browser/click", "name": "element not found in time", "requires": "browser", "files": {"e.html": "<title>E</title>"},
   "steps": [{"action": "ooa.browser/open", "args": {"url": "{web}/e.html", "headless": true, "engine": "playwright", "keep_open": false}},
     {"action": "ooa.browser/click", "args": {"selector": "#nope", "timeout_ms": 500}}], "error": "BROWSER.TIMEOUT"},
  {"command": "ooa.browser/element_action", "name": "captured object: check box", "requires": "browser",
   "files": {"k.html": "<title>K</title><input type='checkbox' id='agree'>"},
   "steps": [{"action": "ooa.browser/open", "args": {"url": "{web}/k.html", "headless": true, "engine": "playwright", "keep_open": false}},
     {"action": "ooa.browser/element_action", "args": {"selector": "#agree", "action": "check"}},
     {"action": "ooa.browser/element_action", "args": {"selector": "#agree", "action": "is_checked"}, "out": {"result": "on"}},
     {"action": "ooa.browser/close"}], "expect": {"on": true}},
  {"command": "ooa.browser/download", "name": "click a download link", "requires": "browser",
   "files": {"d.html": "<title>D</title><a id='dl' href='report.csv' download>get</a>", "report.csv": "a,b\n1,2\n"},
   "steps": [{"action": "ooa.browser/open", "args": {"url": "{web}/d.html", "headless": true, "engine": "playwright", "keep_open": false}},
     {"action": "ooa.browser/download", "args": {"selector": "#dl", "folder": "{tmp}/dl", "timeout_ms": 15000}, "out": {"path": "p"}},
     {"action": "ooa.browser/close"}], "expect": {"p": {"$contains": "report.csv"}}},
  {"command": "ooa.browser/download_url", "name": "download by address, no browser", "files": {"f.txt": "hello"},
   "steps": [{"action": "ooa.browser/download_url", "args": {"url": "{web}/f.txt", "save_to": "{tmp}/out/f.txt"}, "out": {"size": "n"}}], "expect": {"n": 5}, "expectFiles": {"out/f.txt": "hello"}},
  {"command": "ooa.browser/download_url", "name": "refuses to overwrite", "files": {"f.txt": "hello", "out/f.txt": "old"},
   "steps": [{"action": "ooa.browser/download_url", "args": {"url": "{web}/f.txt", "save_to": "{tmp}/out/f.txt"}}], "error": "BROWSER.FILE_EXISTS"},
  {"command": "ooa.browser/find_broken_links", "name": "by address, without a browser", "files": {"l.html": "<a href='ok.html'>ok</a><a href='missing.html'>bad</a>", "ok.html": "fine"},
   "steps": [{"action": "ooa.browser/find_broken_links", "args": {"url": "{web}/l.html", "session": "none"}, "out": {"broken_count": "b", "checked_count": "c"}}], "expect": {"b": 1, "c": 2}},
  {"command": "ooa.browser/switch_tab", "name": "no such tab", "requires": "browser", "files": {"a.html": "<title>A</title>"},
   "steps": [{"action": "ooa.browser/open", "args": {"url": "{web}/a.html", "headless": true, "engine": "playwright", "keep_open": false}},
     {"action": "ooa.browser/switch_tab", "args": {"title_contains": "Nope"}}], "error": "BROWSER.NO_TAB"},
  {"command": "ooa.browser/close", "name": "closing twice is harmless", "requires": "browser", "files": {"a.html": "<title>A</title>"},
   "steps": [{"action": "ooa.browser/open", "args": {"url": "{web}/a.html", "headless": true, "engine": "playwright", "keep_open": false}},
     {"action": "ooa.browser/close"}, {"action": "ooa.browser/close"}]},
  {"command": "ooa.browser/get_text", "name": "no open browser", "steps": [{"action": "ooa.browser/get_text", "args": {"selector": "p"}}], "error": "SESSION.NOT_FOUND"}
]
