     {"action": "ooa.terminal/connect", "args": {"host": "127.0.0.1", "port": "{ssh_port}", "terminal_type": "vt-ssh", "user": "agent", "password": "$pw", "wait_for_text": "Name:", "connect_timeout_seconds": 15}},
     {"action": "ooa.terminal/send_key", "args": {"key": "Ctrl+C", "wait_for_text": "^C", "timeout_seconds": 10}},
     {"action": "ooa.terminal/disconnect", "args": {}}],
   "expect": {}},
  {"command": "ooa.terminal/wait_for_prompt", "name": "waits for the command line's prompt", "requires": "ssh",
   "credentials": {"pw": "test/mail/password"},
   "steps": [
     {"action": "ooa.terminal/connect", "args": {"host": "127.0.0.1", "port": "{ssh_port}", "terminal_type": "vt-ssh", "user": "agent", "password": "$pw", "wait_for_text": "Name:", "connect_timeout_seconds": 15}},
     {"action": "ooa.terminal/send_text", "args": {"text": "Ada", "press_key": "Enter", "wait_for_text": "MAIN MENU", "timeout_seconds": 10}},
     {"action": "ooa.terminal/send_text", "args": {"text": "7", "press_key": "Enter"}},
     {"action": "ooa.terminal/wait_for_prompt", "args": {"prompt": "> ", "timeout_seconds": 10}, "out": {"found": "found"}},
     {"action": "ooa.terminal/disconnect", "args": {}}],
   "expect": {"found": true}},
  {"command": "ooa.terminal/set_cursor", "name": "moves the cursor (on a VT host with arrow keys)", "requires": "ssh",
   "credentials": {"pw": "test/mail/password"},
   "steps": [
     {"action": "ooa.terminal/connect", "args": {"host": "127.0.0.1", "port": "{ssh_port}", "terminal_type": "vt-ssh", "user": "agent", "password": "$pw", "wait_for_text": "Name:", "connect_timeout_seconds": 15}},
     {"action": "ooa.terminal/send_text", "args": {"text": "Ada", "press_key": "Enter", "wait_for_text": "MAIN MENU", "timeout_seconds": 10}},
     {"action": "ooa.terminal/set_cursor", "args": {"row": 5, "column": 7}},
     {"action": "core/delay", "args": {"seconds": 0.5}},
