[
  {"command": "ooa.terminal/connect", "name": "signs in to a VT host over SSH and waits for its first screen; a position and the cursor read back", "requires": "ssh",
   "credentials": {"pw": "test/mail/password"},
   "steps": [
     {"action": "ooa.terminal/connect", "args": {"host": "127.0.0.1", "port": "{ssh_port}", "terminal_type": "vt-ssh", "user": "agent", "password": "$pw", "wait_for_text": "Name:", "connect_timeout_seconds": 15}},
     {"action": "ooa.terminal/get_text", "args": {"row": 1, "column": 1, "length": 11}, "out": {"text": "title"}},
     {"action": "ooa.terminal/get_cursor", "args": {}, "out": {"row": "r", "column": "c"}},
     {"action": "ooa.terminal/show_terminal", "args": {}},
     {"action": "ooa.terminal/hide_terminal", "args": {}},
     {"action": "ooa.terminal/disconnect", "args": {}}],
   "expect": {"title": "SAMPLE HOST", "r": 2, "c": 7}},
  {"command": "ooa.terminal/get_screen", "name": "reads the whole screen, one line per row", "requires": "ssh",
   "credentials": {"pw": "test/mail/password"},
   "steps": [
     {"action": "ooa.terminal/connect", "args": {"host": "127.0.0.1", "port": "{ssh_port}", "terminal_type": "vt-ssh", "user": "agent", "password": "$pw", "wait_for_text": "Name:", "connect_timeout_seconds": 15}},
     {"action": "ooa.terminal/get_screen", "args": {}, "out": {"text": "screen"}},
     {"action": "ooa.string/count_occurrences", "args": {"text": "$screen", "find": "SAMPLE HOST"}, "out": {"count": "n"}},
     {"action": "ooa.terminal/disconnect", "args": {}}],
   "expect": {"n": 1}},
  {"command": "ooa.terminal/set_field", "name": "fills a field found by its label, presses Enter and waits for the next screen in the same step", "requires": "ssh",
   "credentials": {"pw": "test/mail/password"},
   "steps": [
     {"action": "ooa.terminal/connect", "args": {"host": "127.0.0.1", "port": "{ssh_port}", "terminal_type": "vt-ssh", "user": "agent", "password": "$pw", "wait_for_text": "Name:", "connect_timeout_seconds": 15}},
     {"action": "ooa.terminal/set_field", "args": {"label": "Name", "text": "Ada", "press_key": "Enter", "wait_for_text": "MAIN MENU", "timeout_seconds": 10}},
     {"action": "ooa.terminal/get_field", "args": {"label": "User"}, "out": {"text": "user"}},
     {"action": "ooa.terminal/disconnect", "args": {}}],
   "expect": {"user": "Ada"}},
  {"command": "ooa.terminal/get_all_fields", "name": "lists the fields that take input, with their positions", "requires": "ssh",
   "credentials": {"pw": "test/mail/password"},
   "steps": [
     {"action": "ooa.terminal/connect", "args": {"host": "127.0.0.1", "port": "{ssh_port}", "terminal_type": "vt-ssh", "user": "agent", "password": "$pw", "wait_for_text": "Name:", "connect_timeout_seconds": 15}},
     {"action": "ooa.terminal/set_field", "args": {"label": "Name", "text": "Ada", "press_key": "Enter", "wait_for_text": "MAIN MENU", "timeout_seconds": 10}},
     {"action": "ooa.terminal/set_field", "args": {"label": "Code", "text": "X42", "press_key": "Enter", "wait_for_text": "Result: X42", "timeout_seconds": 10}},
     {"action": "ooa.terminal/get_all_fields", "args": {"only_input_fields": true}, "out": {"count": "n"}},
     {"action": "ooa.terminal/get_field", "args": {"label": "Result"}, "out": {"text": "result"}},
     {"action": "ooa.terminal/disconnect", "args": {}}],
   "expect": {"n": 3, "result": "X42"}},
  {"command": "ooa.terminal/send_text", "name": "types a command, presses Enter and waits for the answer; Find text on screen gives its row", "requires": "ssh",
   "credentials": {"pw": "test/mail/password"},
   "steps": [
     {"action": "ooa.terminal/connect", "args": {"host": "127.0.0.1", "port": "{ssh_port}", "terminal_type": "vt-ssh", "user": "agent", "password": "$pw", "wait_for_text": "Name:", "connect_timeout_seconds": 15}},
     {"action": "ooa.terminal/send_text", "args": {"text": "Ada", "press_key": "Enter", "wait_for_text": "MAIN MENU", "timeout_seconds": 10}},
     {"action": "ooa.terminal/send_text", "args": {"text": "7", "press_key": "Enter", "wait_for_text": "Result: 7", "timeout_seconds": 10}},
     {"action": "ooa.terminal/send_text", "args": {"text": "hello", "press_key": "Enter", "wait_for_text": "You typed: hello", "timeout_seconds": 10}},
     {"action": "ooa.terminal/search_field", "args": {"text": "You typed"}, "out": {"found": "found", "row": "row"}},
     {"action": "ooa.terminal/disconnect", "args": {}}],
   "expect": {"found": true, "row": 10}},
  {"command": "ooa.terminal/set_key_mapping", "name": "a friendly key name pressed by Press key, written another way (Return for Enter)", "requires": "ssh",
   "credentials": {"pw": "test/mail/password"},
   "steps": [
     {"action": "ooa.terminal/connect", "args": {"host": "127.0.0.1", "port": "{ssh_port}", "terminal_type": "vt-ssh", "user": "agent", "password": "$pw", "wait_for_text": "Name:", "connect_timeout_seconds": 15}},
     {"action": "ooa.terminal/set_key_mapping", "args": {"mappings": {"Submit": "Return"}}},
     {"action": "ooa.terminal/send_text", "args": {"text": "Ada"}},
     {"action": "ooa.terminal/send_key", "args": {"key": "Submit", "wait_for_text": "MAIN MENU", "timeout_seconds": 10}},
     {"action": "ooa.terminal/wait_for_text", "args": {"text": "MAIN MENU", "timeout_seconds": 5}, "out": {"found": "found"}},
     {"action": "ooa.terminal/disconnect", "args": {}}],
   "expect": {"found": true}},
  {"command": "ooa.terminal/send_key", "name": "presses Ctrl+C and waits for what the host shows", "requires": "ssh",
   "credentials": {"pw": "test/mail/password"},
