[
  {"command": "ooa.string/extract_text", "name": "between markers, second occurrence", "vars": {"t": "a [x] b [y] c"},
   "steps": [{"action": "ooa.string/extract_text", "args": {"text": "$t", "after": "[", "before": "]", "after_occurrence": 2}, "out": {"result": "r"}}], "expect": {"r": "y"}},
  {"command": "ooa.string/extract_text", "name": "marker missing returns source", "vars": {"t": "no markers"},
   "steps": [{"action": "ooa.string/extract_text", "args": {"text": "$t", "after": "#", "if_not_found": "source"}, "out": {"result": "r"}}], "expect": {"r": "no markers"}},
  {"command": "ooa.string/replace", "name": "regex, first two only", "vars": {"t": "a1b2c3"},
   "steps": [{"action": "ooa.string/replace", "args": {"text": "$t", "find": "\\d", "replace_with": "#", "regex": true, "count": 2}, "out": {"result": "r"}}], "expect": {"r": "a#b#c3"}},
  {"command": "ooa.string/replace", "name": "ignore case", "vars": {"t": "Cat cat CAT"},
   "steps": [{"action": "ooa.string/replace", "args": {"text": "$t", "find": "cat", "replace_with": "dog", "ignore_case": true}, "out": {"result": "r"}}], "expect": {"r": "dog dog dog"}},
  {"command": "ooa.string/split", "name": "trim, drop empty", "vars": {"t": "a, b,, c"},
   "steps": [{"action": "ooa.string/split", "args": {"text": "$t", "delimiter": ",", "remove_empty": true}, "out": {"items": "parts"}}], "expect": {"parts": ["a", "b", "c"]}},
  {"command": "ooa.string/split", "name": "max parts", "vars": {"t": "k=v=w"},
   "steps": [{"action": "ooa.string/split", "args": {"text": "$t", "delimiter": "=", "max_parts": 2}, "out": {"items": "parts"}}], "expect": {"parts": ["k", "v=w"]}},
  {"command": "ooa.string/change_case", "name": "title", "steps": [{"action": "ooa.string/change_case", "args": {"text": "hello big world", "case": "title"}, "out": {"result": "r"}}], "expect": {"r": "Hello Big World"}},
  {"command": "ooa.string/compare", "name": "natural order", "steps": [{"action": "ooa.string/compare", "args": {"text": "file2", "other": "file10", "mode": "natural"}, "out": {"result": "r", "equal": "eq"}}], "expect": {"r": -1, "eq": false}},
  {"command": "ooa.string/find", "name": "regex groups, every match and count (new outputs)", "vars": {"t": "INV-204 and INV-305"},
   "steps": [{"action": "ooa.string/find", "args": {"text": "$t", "find": "INV-(?<num>\\d+)", "regex": true, "occurrence": 2},
     "out": {"index": "i", "position": "p", "match": "m", "groups": "g", "named_groups": "ng", "all_matches": "all", "count": "n"}}],
   "expect": {"i": 12, "p": 13, "m": "INV-305", "g": ["305"], "ng": {"num": "305"}, "all": ["INV-204", "INV-305"], "n": 2}},
  {"command": "ooa.string/find", "name": "not found", "steps": [{"action": "ooa.string/find", "args": {"text": "abc", "find": "z"}, "out": {"found": "f", "index": "i", "count": "n"}}], "expect": {"f": false, "i": -1, "n": 0}},
  {"command": "ooa.string/length", "name": "counts characters", "steps": [{"action": "ooa.string/length", "args": {"text": "héllo"}, "out": {"length": "n"}}], "expect": {"n": 5}},
  {"command": "ooa.string/substring", "name": "start and length", "steps": [{"action": "ooa.string/substring", "args": {"text": "hello", "start": 1, "length": 3}, "out": {"result": "r"}}], "expect": {"r": "ell"}},
  {"command": "ooa.string/substring", "name": "out of range gives empty", "steps": [{"action": "ooa.string/substring", "args": {"text": "hi", "start": 9, "if_out_of_range": "empty"}, "out": {"result": "r"}}], "expect": {"r": ""}},
  {"command": "ooa.string/substring", "name": "out of range fails by default", "steps": [{"action": "ooa.string/substring", "args": {"text": "hi", "start": 9}}], "error": "STRING.BAD_POSITION"},
  {"command": "ooa.string/trim", "name": "characters on left", "steps": [{"action": "ooa.string/trim", "args": {"text": "00120", "side": "left", "characters": "0"}, "out": {"result": "r"}}], "expect": {"r": "120"}},
  {"command": "ooa.string/reverse", "name": "reverses", "steps": [{"action": "ooa.string/reverse", "args": {"text": "abc"}, "out": {"result": "r"}}], "expect": {"r": "cba"}},
  {"command": "ooa.string/random_string", "name": "digits only, length", "steps": [{"action": "ooa.string/random_string", "args": {"length": 8, "letters": false}, "out": {"result": "r"}},
     {"action": "core/set", "args": {"variable": "ok", "value": {"expr": "len($r) == 8"}}}], "expect": {"ok": true}},
  {"command": "ooa.string/to_number", "name": "German format", "steps": [{"action": "ooa.string/to_number", "args": {"text": "1.234,5", "locale": "de-DE"}, "out": {"result": "n"}}], "expect": {"n": 1234.5}},
  {"command": "ooa.string/to_locale_number", "name": "Indian grouping", "steps": [{"action": "ooa.string/to_locale_number", "args": {"value": 1234567, "locale": "en-IN"}, "out": {"result": "r"}}], "expect": {"r": "12,34,567"}},
  {"command": "ooa.string/is_email", "name": "condition in If", "vars": {"ok": false},
   "steps": [{"action": "core/if", "args": {"condition": {"condition": "ooa.string/is_email", "args": {"text": "a@b.co"}}}, "children": [{"action": "core/set", "args": {"variable": "ok", "value": true}}]}], "expect": {"ok": true}},
  {"command": "ooa.string/is_number", "name": "condition false", "vars": {"ok": true},
   "steps": [{"action": "core/if", "args": {"condition": {"condition": "ooa.string/is_number", "args": {"text": "12a"}}}, "else": [{"action": "core/set", "args": {"variable": "ok", "value": false}}]}], "expect": {"ok": false}}
]
