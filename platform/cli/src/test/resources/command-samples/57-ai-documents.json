  {"command": "ooa.genai/prompt_with_images", "name": "a question about a scanned receipt, answered as JSON",
   "credentials": {"tok": "test/api/token"}, "secrets": {"test/api/token": "t0k"},
   "files": {"receipt.png": "png"},
   "mock": [{"method": "POST", "path": "/chat/completions", "body": {"choices": [{"message": {"role": "assistant", "content": "{\"total\": 12.5}"}}]}}],
   "steps": [{"action": "ooa.genai/prompt_with_images", "args": {"prompt": "What is the total?", "images": ["receipt.png"], "provider": "openai_compatible", "base_url": "{mock}", "api_key": "$tok",
     "model": "m", "response_format": "json", "seed": 7}, "out": {"json": "j"}}],
   "expect": {"j": {"total": 12.5}},
   "expectRequests": ["POST /chat/completions image_url"]},

  {"command": "ooa.genai/chat", "name": "a chat answer as JSON (I2)",
