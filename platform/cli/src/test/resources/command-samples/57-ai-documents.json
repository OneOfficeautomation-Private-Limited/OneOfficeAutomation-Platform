[
  {"command": "ooa.idp/classify_document", "name": "by keywords, no model needed",
   "vars": {"t": "INVOICE INV-1042  Total due 115.00 EUR  VAT 19%"},
   "steps": [{"action": "ooa.idp/classify_document", "args": {"text": "$t", "method": "keywords",
     "types": [{"name": "invoice", "keywords": ["invoice", "VAT", "total due"]}, {"name": "delivery_note", "keywords": ["delivery note", "shipped"]}]},
     "out": {"type": "ty", "method": "m"}}],
   "expect": {"ty": "invoice", "m": "keywords"}},

  {"command": "ooa.idp/classify_document", "name": "by a stand-in model",
   "credentials": {"tok": "test/api/token"}, "secrets": {"test/api/token": "t0k"},
   "mock": [{"method": "POST", "path": "/chat/completions", "body": {"choices": [{"message": {"role": "assistant", "content": "{\"type\": \"delivery_note\", \"confidence\": 0.9}"}}]}}],
   "vars": {"t": "Goods dispatched to Berlin, 3 parcels"},
   "steps": [{"action": "ooa.idp/classify_document", "args": {"text": "$t", "method": "ai", "provider": "openai_compatible", "base_url": "{mock}", "api_key": "$tok", "model": "m",
     "types": [{"name": "invoice", "description": "a supplier invoice"}, {"name": "delivery_note", "description": "goods sent"}]},
     "out": {"type": "ty", "confidence": "c"}}],
   "expect": {"ty": "delivery_note", "c": 0.9},
   "expectRequests": ["POST /chat/completions Goods dispatched"]},

  {"command": "ooa.idp/extract_by_rules", "name": "regex and after a label",
   "vars": {"t": "Invoice INV-1042\nTotal due: 115.00 EUR\nThank you"},
   "steps": [{"action": "ooa.idp/extract_by_rules", "args": {"text": "$t",
     "rules": {"invoice_number": {"regex": "INV-\\d+"}, "total": {"after": "Total due:", "until": " EUR"}, "po_number": {"regex": "PO-\\d+"}}},
     "out": {"fields": "f", "missing": "miss"}}],
   "expect": {"f": {"invoice_number": "INV-1042", "total": "115.00"}, "miss": ["po_number"]}},

  {"command": "ooa.idp/save_example", "name": "keeps a checked example, then Extract with examples sends it to the model",
   "credentials": {"tok": "test/api/token"}, "secrets": {"test/api/token": "t0k"},
   "mock": [{"method": "POST", "path": "/chat/completions", "body": {"choices": [{"message": {"role": "assistant", "content": "{\"invoice_number\": \"INV-2001\", \"total\": \"80.00\"}"}}]}}],
   "steps": [
     {"action": "ooa.idp/save_example", "args": {"examples_file": "examples/invoice.examples.json", "document_type": "invoice", "text": "Invoice INV-1042 Total 115.00",
       "fields": {"invoice_number": "INV-1042", "total": "115.00"}}, "out": {"count": "n"}},
     {"action": "ooa.idp/extract_with_examples", "args": {"text": "Invoice INV-2001 Total 80.00", "fields": {"invoice_number": "The invoice number", "total": "The total"},
       "examples_file": "examples/invoice.examples.json", "document_type": "invoice", "provider": "openai_compatible", "base_url": "{mock}", "api_key": "$tok", "model": "m"},
       "out": {"fields": "f", "examples_used": "used"}}],
   "expect": {"n": 1, "f": {"invoice_number": "INV-2001", "total": "80.00"}, "used": 1},
   "expectFiles": {"examples/invoice.examples.json": true},
   "expectRequests": ["POST /chat/completions INV-1042"]},

  {"command": "ooa.ai_skills/run", "name": "a saved prompt template filled with values",
   "credentials": {"tok": "test/api/token"}, "secrets": {"test/api/token": "t0k"},
   "files": {"ai-skills/summarise_complaint.json": "{\"description\": \"One-line summary\", \"system\": \"Be brief.\", \"prompt\": \"Summarise this complaint: ${text}\", \"provider\": \"openai_compatible\", \"model\": \"m\", \"output\": \"text\"}"},
   "mock": [{"method": "POST", "path": "/chat/completions", "body": {"choices": [{"message": {"role": "assistant", "content": "Late delivery, wants a refund."}}]}}],
   "steps": [{"action": "ooa.ai_skills/run", "args": {"skill": "summarise_complaint", "values": {"text": "My parcel came two weeks late and I want my money back"}, "base_url": "{mock}", "api_key": "$tok"},
     "out": {"text": "s", "success": "ok"}}],
   "expect": {"s": "Late delivery, wants a refund.", "ok": true},
   "expectRequests": ["POST /chat/completions two weeks late"]},

  {"command": "ooa.ai_skills/list", "name": "the saved skills",
   "credentials": {"tok": "test/api/token"}, "secrets": {"test/api/token": "t0k"},
   "files": {"ai-skills/summarise_complaint.json": "{\"description\": \"One-line summary\", \"prompt\": \"Summarise: ${text}\", \"provider\": \"openai\", \"model\": \"m\"}"},
   "steps": [{"action": "ooa.ai_skills/list", "args": {}, "out": {"skills": "all"}},
     {"action": "core/set", "args": {"variable": "n", "value": {"expr": "len($all)"}}}],
   "vars": {"n": 0},
   "expect": {"n": 1}},

  {"command": "ooa.ai_agent/run", "name": "an AI agent calls an agent as its tool, then answers",
   "credentials": {"tok": "test/api/token"}, "secrets": {"test/api/token": "t0k"},
   "agents": {"lookup_order": {"kind": "TaskBot", "id": "lookup_order", "name": "lookup_order", "description": "Find an order's status by its number",
     "variables": [{"name": "order", "type": "String", "direction": "input", "required": true}, {"name": "status", "type": "String", "direction": "output", "default": ""}],
     "steps": [{"id": "1", "action": "core/set", "args": {"variable": "status", "value": "shipped-on-tuesday"}}]}},
   "mock": [
     {"method": "POST", "path": "/chat/completions", "contains": "shipped-on-tuesday", "body": {"choices": [{"message": {"role": "assistant", "content": "Order A-1 was shipped on Tuesday."}}]}},
     {"method": "POST", "path": "/chat/completions", "body": {"choices": [{"message": {"role": "assistant", "content": null,
       "tool_calls": [{"id": "c1", "type": "function", "function": {"name": "lookup_order", "arguments": "{\"order\": \"A-1\"}"}}]}}]}}],
   "steps": [{"action": "ooa.ai_agent/run", "args": {"goal": "Where is order A-1?", "tools": ["lookup_order"], "provider": "openai_compatible", "base_url": "{mock}", "api_key": "$tok", "model": "m", "max_steps": 4},
     "out": {"answer": "a", "status": "st"}}],
   "expect": {"a": "Order A-1 was shipped on Tuesday.", "st": "completed"}},

  {"command": "ooa.comms/discover_topics", "name": "topics in a mailbox export",
   "files": {"mail/inbox.csv": "id,subject,body\n1,Invoice overdue,Our invoice 1042 is overdue please pay\n2,Invoice question,Question about invoice 1043 payment\n3,Refund request,The laptop arrived damaged I want a refund\n4,Damaged item,Item damaged in transit refund please\n5,Overdue payment,Payment for invoice 1050 overdue\n6,Return refund,Return the damaged chair for a refund\n"},
   "steps": [{"action": "ooa.comms/discover_topics", "args": {"file": "{tmp}/mail/inbox.csv", "id_column": "id", "topics": 2}, "out": {"topics": "t", "rules": "r"}},
     {"action": "core/set", "args": {"variable": "n", "value": {"expr": "len($r)"}}}],
   "vars": {"n": 0},
   "expect": {"n": 2}},

  {"command": "ooa.comms/route_messages", "name": "each message to a queue by its keywords",
   "files": {"mail/inbox.csv": "id,subject,body\n1,Invoice overdue,Our invoice 1042 is overdue\n2,Refund request,The laptop arrived damaged\n3,Hello,Just saying thanks\n"},
   "steps": [{"action": "ooa.comms/route_messages", "args": {"file": "{tmp}/mail/inbox.csv", "id_column": "id", "default_queue": "Other",
     "rules": {"Invoices": ["invoice", "overdue"], "Returns": ["refund", "damaged"]}}, "out": {"counts": "c"}}],
   "expect": {"c": {"Invoices": 1, "Returns": 1, "Other": 1}}},

