{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "rw04_b4",
  "name": "RW04-B4 Salesforce CRM updater",
  "description": "RW04-B4 (RW04 real-world test). For every order: checks the CRM host is the sandbox, finds the account by its synthetic external id, links the order (upsert by the order's external id, safe to repeat), writes the test status and delivery notes, opens one case per exception (never a duplicate), reads the order back to check the links and records the ids.",
  "tags": [
    "real-world-test",
    "RW04"
  ],
  "variables": [
    {
      "name": "base",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Real-world tests",
      "description": "Folder of the real-world tests: data, output and the stand-in server."
    },
    {
      "name": "run_id",
      "type": "String",
      "direction": "input",
      "default": "",
      "description": "Run id shared by a main agent and its children; made here when empty."
    },
    {
      "name": "standin",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local QA stand-in server (127.0.0.1 only)."
    },
    {
      "name": "watch",
      "type": "Boolean",
      "direction": "input",
      "default": true,
      "description": "Show message boxes and pause between records so a person can follow the run."
    },
    {
      "name": "pause_seconds",
      "type": "Number",
      "direction": "input",
      "default": 1,
      "description": "Pause after each record when watch is on."
    },
    {
      "name": "fault_profile",
      "type": "String",
      "direction": "input",
      "default": "none",
      "description": "none, or resilience: the stand-ins inject the five failures of runbook step 09."
    },
    {
      "name": "info",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "out_dir",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "log_file",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "records",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "rec",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "i",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "err",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "err_msg",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "rec_status",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "rec_note",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "started",
      "type": "DateTime",
      "direction": "local"
    },
    {
      "name": "results",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "key",
          "status",
          "note",
          "time"
        ],
        "rows": []
      }
    },
    {
      "name": "processed",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Records handled without an error."
    },
    {
      "name": "exceptions",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Records routed to the exception list."
    },
    {
      "name": "status",
      "type": "String",
      "direction": "output",
      "default": "not_run",
      "description": "success when every record was handled (routed exceptions included)."
    },
    {
      "name": "result_file",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "CSV file with one row per record."
    },
    {
      "name": "b2",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "b2r",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "b3",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "acct",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "acct_id",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "email",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "cust",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "state",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "bstatus",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "bnote",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "order_sf",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "created",
      "type": "Boolean",
      "direction": "local",
      "default": false
    },
    {
      "name": "case_id",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "cases",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "nc",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "back",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "host",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "notes",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "customers",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "evidence",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "key",
          "account_id",
          "order_record",
          "created",
          "status",
          "case_id",
          "notes"
        ],
        "rows": []
      }
    },
    {
      "name": "evidence_file",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "Evidence rows of this agent (one per record)."
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "1. Start"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "What this agent does: For every order: checks the CRM host is the sandbox, finds the account by its synthetic external id, links the order (upsert by the order's external id, safe to repeat), writes the test status and delivery notes, opens one case per exception (never a duplicate), reads the order back to check the links and records the ids. It works through 10 CRM order records and writes its results to the run's output folder."
          }
        },
        {
          "id": "s3",
          "action": "ooa.run_context/get",
          "args": {},
          "out": {
            "info": "info"
          },
          "description": "Read the run context (run id, runner, user)"
        },
        {
          "id": "s4",
          "action": "core/set",
          "args": {
            "variable": "started",
            "value": {
              "expr": "now()"
            }
          },
          "description": "Remember when the agent started"
        },
        {
          "id": "s5",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "empty",
              "left": "$run_id$"
            }
          },
          "children": [
            {
              "id": "s6",
              "action": "core/set",
              "args": {
                "variable": "run_id",
                "value": "SOLO-${formatDate(now(), '%Y%m%d-%H%M%S')}"
              },
              "description": "Run id for a run on its own"
            }
          ],
          "description": "Running on its own: make a run id"
        },
        {
          "id": "s7",
          "action": "core/set",
          "args": {
            "variable": "out_dir",
            "value": "${base}/output/${run_id}/RW04-B4"
          },
          "description": "This agent's output folder for the run"
        },
        {
          "id": "s8",
          "action": "ooa.folder/create",
          "args": {
            "path": "$out_dir$"
          },
          "description": "Create the output folder"
        },
        {
          "id": "s9",
          "action": "core/set",
          "args": {
            "variable": "log_file",
            "value": "${out_dir}/log.txt"
          },
          "description": "Log file of this agent"
        },
        {
          "id": "s10",
          "action": "ooa.log/write",
          "args": {
            "path": "$log_file$",
            "message": "RW04-B4 Salesforce CRM updater started; run ${run_id}; computer ${info.device}, user ${info.os_user}"
          },
          "description": "Log the start"
        },
        {
          "id": "s11",
          "action": "core/if",
          "args": {
            "condition": "$watch$"
          },
          "children": [
            {
              "id": "s12",
              "action": "ooa.desktop/message_box",
              "args": {
                "title": "RW04-B4 starts",
                "message": "RW04-B4 Salesforce CRM updater\n\nFor every order: checks the CRM host is the sandbox, finds the account by its synthetic external id, links the order (upsert by the order's external id, safe to repeat), writes the test status and delivery notes, opens one case per exception (never a duplicate), reads the order back to check the links and records the ids.\n\nRecords: 10 CRM order records\nRun: ${run_id}",
                "timeout_seconds": 4,
                "icon": "information",
                "always_on_top": true
              },
              "description": "Message box that closes by itself"
            }
          ],
          "description": "Show what is happening (watch is on)"
        }
      ],
      "description": "1. Start"
    },
    {
      "id": "s13",
      "action": "core/step",
      "args": {
        "title": "2. Prepare"
      },
      "children": [
        {
          "id": "s14",
          "action": "core/comment",
          "args": {
            "text": "Check the CRM address is the sandbox (never production) and read what intake and reservation found."
          }
        },
        {
          "id": "s15",
          "action": "ooa.csv/read",
          "args": {
            "path": "${base}/data/RW04/orders.csv"
          },
          "out": {
            "table": "records"
          },
          "description": "Read the test records (RW04/orders.csv)"
        },
        {
          "id": "s16",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "ne",
              "left": "$fault_profile$",
              "right": "none"
            }
          },
          "children": [
            {
              "id": "s17",
              "action": "ooa.rest/request",
              "args": {
                "method": "POST",
                "url": "${standin}/qa/faults",
                "json": {
                  "service": "salesforce",
                  "profile": "$fault_profile$",
                  "run_id": "$run_id$"
                }
              },
              "description": "Arm the stand-in's injected faults for this service"
            }
          ],
          "description": "Resilience run: arm the stand-in's faults"
        },
        {
          "id": "s18",
          "action": "core/set",
          "args": {
            "variable": "host",
            "value": {
              "expr": "regexExtract($standin$, '//([^/]+)', 1)"
            }
          },
          "description": "2. CRM host"
        },
        {
          "id": "s19",
          "action": "core/if",
          "args": {
            "condition": "not (startsWith($host$, '127.0.0.1') or contains($host$, '.sandbox.') or startsWith($host$, 'test.salesforce.com'))"
          },
          "children": [
            {
              "id": "s20",
              "action": "core/throw",
              "args": {
                "code": "CRM.NOT_SANDBOX",
                "message": "${host} is not a Salesforce sandbox: no production changes"
              },
              "description": "Stop: sandbox only"
            }
          ],
          "description": "Production host?"
        },
        {
          "id": "s21",
          "action": "core/if",
          "args": {
            "condition": {
              "condition": "ooa.file/exists",
              "args": {
                "path": "${base}/output/${run_id}/RW04-B2/evidence.csv"
              }
            }
          },
          "children": [
            {
              "id": "s22",
              "action": "ooa.csv/read",
              "args": {
                "path": "${base}/output/${run_id}/RW04-B2/evidence.csv"
              },
              "out": {
                "table": "b2"
              },
              "description": "Read RW04-B2 evidence"
            }
          ],
          "description": "RW04-B2 ran in this run?",
          "else": [
            {
              "id": "s23",
              "action": "core/comment",
              "args": {
                "text": "Running on its own: use the fixture, a saved copy of RW04-B2's evidence from a checked run."
              }
            },
            {
              "id": "s24",
              "action": "ooa.csv/read",
              "args": {
                "path": "${base}/data/RW04/fixtures/RW04-B2-evidence.csv"
              },
              "out": {
                "table": "b2"
              },
              "description": "Read RW04-B2 evidence (fixture)"
            }
          ]
        },
        {
          "id": "s25",
          "action": "core/if",
          "args": {
            "condition": {
              "condition": "ooa.file/exists",
              "args": {
                "path": "${base}/output/${run_id}/RW04-B2/results.csv"
              }
            }
          },
          "children": [
            {
              "id": "s26",
              "action": "ooa.csv/read",
              "args": {
                "path": "${base}/output/${run_id}/RW04-B2/results.csv"
              },
              "out": {
                "table": "b2r"
              },
              "description": "Read RW04-B2 results"
            }
          ],
          "description": "RW04-B2 ran in this run?",
          "else": [
            {
              "id": "s27",
              "action": "core/comment",
              "args": {
                "text": "Running on its own: use the fixture, a saved copy of RW04-B2's results from a checked run."
              }
            },
            {
              "id": "s28",
              "action": "ooa.csv/read",
              "args": {
                "path": "${base}/data/RW04/fixtures/RW04-B2-results.csv"
              },
              "out": {
                "table": "b2r"
              },
              "description": "Read RW04-B2 results (fixture)"
            }
          ]
        },
        {
          "id": "s29",
          "action": "core/if",
          "args": {
            "condition": {
              "condition": "ooa.file/exists",
              "args": {
                "path": "${base}/output/${run_id}/RW04-B3/evidence.csv"
              }
            }
          },
          "children": [
            {
              "id": "s30",
              "action": "ooa.csv/read",
              "args": {
                "path": "${base}/output/${run_id}/RW04-B3/evidence.csv"
              },
              "out": {
                "table": "b3"
              },
              "description": "Read RW04-B3 evidence"
            }
          ],
          "description": "RW04-B3 ran in this run?",
          "else": [
            {
              "id": "s31",
              "action": "core/comment",
              "args": {
                "text": "Running on its own: use the fixture, a saved copy of RW04-B3's evidence from a checked run."
              }
            },
            {
              "id": "s32",
              "action": "ooa.csv/read",
              "args": {
                "path": "${base}/data/RW04/fixtures/RW04-B3-evidence.csv"
              },
              "out": {
                "table": "b3"
              },
              "description": "Read RW04-B3 evidence (fixture)"
            }
          ]
        },
        {
          "id": "s33",
          "action": "ooa.csv/read",
          "args": {
            "path": "${base}/data/RW04/customers.csv"
          },
          "out": {
            "table": "customers"
          },
          "description": "QA customers"
        }
      ],
      "description": "2. Prepare"
    },
    {
      "id": "s34",
      "action": "core/step",
      "args": {
        "title": "3. Work through the records"
      },
      "children": [
        {
          "id": "s35",
          "action": "core/comment",
          "args": {
            "text": "Per order: account, link the order, status and notes, a case for an exception (deduplicated), read back, ids."
          }
        },
        {
          "id": "s36",
          "action": "core/loop",
          "args": {
            "iterator": "table_rows",
            "over": "$records$",
            "as": "rec",
            "index": "i"
          },
          "children": [
            {
              "id": "s37",
              "action": "core/set",
              "args": {
                "variable": "rec_note",
                "value": ""
              },
              "description": "Clear the note of the previous record"
            },
            {
              "id": "s38",
              "action": "core/try",
              "args": {},
              "children": [
                {
                  "id": "s39",
                  "action": "core/set",
                  "args": {
                    "variable": "cust",
                    "value": "$rec.customer_ref$"
                  },
                  "description": "Customer of the order (synthetic external id)"
                },
                {
                  "id": "s40",
                  "action": "ooa.salesforce/query",
                  "args": {
                    "soql": "SELECT Id, Name FROM Account WHERE External_Id__c = '${cust}'",
                    "instance_url": "$standin$",
                    "access_token": {
                      "$credential": "rw_qa_standins/salesforce/token"
                    }
                  },
                  "out": {
                    "table": "acct"
                  },
                  "retry": {
                    "max": 3,
                    "backoff": "exponential",
                    "delayMs": 1000
                  },
                  "description": "1. Account by synthetic external id"
                },
                {
                  "id": "s41",
                  "action": "ooa.datatable/get_value",
                  "args": {
                    "table": "$acct$",
                    "row": 0,
                    "column": "Id"
                  },
                  "out": {
                    "value": "acct_id"
                  },
                  "description": "Account id"
                },
                {
                  "id": "s42",
                  "action": "ooa.datatable/lookup",
                  "args": {
                    "table": "$b3$",
                    "column": "key",
                    "value": "$rec.key$",
                    "return_column": "state",
                    "if_not_found": ""
                  },
                  "out": {
                    "value": "state"
                  },
                  "description": "Reservation state"
                },
                {
                  "id": "s43",
                  "action": "ooa.datatable/lookup",
                  "args": {
                    "table": "$b2r$",
                    "column": "key",
                    "value": "$rec.key$",
                    "return_column": "status",
                    "if_not_found": ""
                  },
                  "out": {
                    "value": "bstatus"
                  },
                  "description": "Intake result"
                },
                {
                  "id": "s44",
                  "action": "ooa.datatable/lookup",
                  "args": {
                    "table": "$b2r$",
                    "column": "key",
                    "value": "$rec.key$",
                    "return_column": "note",
                    "if_not_found": ""
                  },
                  "out": {
                    "value": "bnote"
                  },
                  "description": "Intake note"
                },
                {
                  "id": "s45",
                  "action": "core/set",
                  "args": {
                    "variable": "state",
                    "value": {
                      "expr": "if($bstatus$ == 'exception', 'held', if(isEmpty($state$), 'not reserved', $state$))"
                    }
                  },
                  "description": "4. Test status"
                },
                {
                  "id": "s46",
                  "action": "core/set",
                  "args": {
                    "variable": "notes",
                    "value": {
                      "expr": "if($state$ == 'held', $bnote$, 'Delivery: ' + $state$)"
                    }
                  },
                  "description": "4. Delivery notes"
                },
                {
                  "id": "s47",
                  "action": "ooa.salesforce/upsert_by_external_id",
                  "args": {
                    "object": "Order__c",
                    "external_id_field": "Order_Ref__c",
                    "external_id_value": "OOA-QA-${run_id}-${rec.key}",
                    "fields": {
                      "Account__c": "$acct_id$",
                      "Name": "$rec.name$",
                      "Status__c": "$state$",
                      "Delivery_Notes__c": "$notes$",
                      "QA_Run__c": "$run_id$"
                    },
                    "instance_url": "$standin$",
                    "access_token": {
                      "$credential": "rw_qa_standins/salesforce/token"
                    }
                  },
                  "out": {
                    "id": "order_sf",
                    "created": "created"
                  },
                  "retry": {
                    "max": 3,
                    "backoff": "exponential",
                    "delayMs": 1000
                  },
                  "description": "3. Link the order (upsert: safe to repeat)"
                },
                {
                  "id": "s48",
                  "action": "core/set",
                  "args": {
                    "variable": "case_id",
                    "value": ""
                  },
                  "description": "No case yet"
                },
                {
                  "id": "s49",
                  "action": "core/if",
                  "args": {
                    "condition": {
                      "any": [
                        {
                          "op": "eq",
                          "left": "$state$",
                          "right": "held"
                        },
                        {
                          "op": "eq",
                          "left": "$state$",
                          "right": "backorder"
                        },
                        {
                          "op": "eq",
                          "left": "$state$",
                          "right": "partial"
                        }
                      ]
                    }
                  },
                  "children": [
                    {
                      "id": "s50",
                      "action": "ooa.salesforce/query",
                      "args": {
                        "soql": "SELECT Id FROM Case WHERE Subject = 'OOA-QA ${run_id} ${rec.name}'",
                        "instance_url": "$standin$",
                        "access_token": {
                          "$credential": "rw_qa_standins/salesforce/token"
                        }
                      },
                      "out": {
                        "table": "cases",
                        "count": "nc"
                      },
                      "description": "6. A case for this order already?"
                    },
                    {
                      "id": "s51",
                      "action": "core/if",
                      "args": {
                        "condition": "$nc$ == 0"
                      },
                      "children": [
                        {
                          "id": "s52",
                          "action": "ooa.salesforce/create_record",
                          "args": {
                            "object": "Case",
                            "fields": {
                              "Subject": "OOA-QA ${run_id} ${rec.name}",
                              "AccountId": "$acct_id$",
                              "Description": "$notes$",
                              "Origin": "OOA-QA",
                              "Status": "New"
                            },
                            "instance_url": "$standin$",
                            "access_token": {
                              "$credential": "rw_qa_standins/salesforce/token"
                            }
                          },
                          "out": {
                            "id": "case_id"
                          },
                          "description": "5. Open the case"
                        }
                      ],
                      "description": "None yet",
                      "else": [
                        {
                          "id": "s53",
                          "action": "ooa.datatable/get_value",
                          "args": {
                            "table": "$cases$",
                            "row": 0,
                            "column": "Id"
                          },
                          "out": {
                            "value": "case_id"
                          },
                          "description": "Use the existing case"
                        }
                      ]
                    }
                  ],
                  "description": "5. An exception the service team must see?"
                },
                {
                  "id": "s54",
                  "action": "ooa.salesforce/get_record",
                  "args": {
                    "object": "Order__c",
                    "id": "$order_sf$",
                    "instance_url": "$standin$",
                    "access_token": {
                      "$credential": "rw_qa_standins/salesforce/token"
                    }
                  },
                  "out": {
                    "record": "back"
                  },
                  "description": "7. Read the order back"
                },
                {
                  "id": "s55",
                  "action": "core/if",
                  "args": {
                    "condition": {
                      "op": "ne",
                      "left": "$back.Account__c$",
                      "right": "$acct_id$"
                    }
                  },
                  "children": [
                    {
                      "id": "s56",
                      "action": "core/throw",
                      "args": {
                        "code": "VERIFY.CRM_LINK",
                        "message": "${rec.name}: the order is not linked to ${acct_id}"
                      },
                      "description": "Stop"
                    }
                  ],
                  "description": "Link lost?"
                },
                {
                  "id": "s57",
                  "action": "ooa.datatable/add_row",
                  "args": {
                    "table": "$evidence$",
                    "values": {
                      "key": "$rec.key$",
                      "account_id": "$acct_id$",
                      "order_record": "$order_sf$",
                      "created": "$created$",
                      "status": "$state$",
                      "case_id": "$case_id$",
                      "notes": "$notes$"
                    }
                  },
                  "out": {
                    "table": "evidence"
                  },
                  "description": "9. Record the ids"
                },
                {
                  "id": "s58",
                  "action": "core/set",
                  "args": {
                    "variable": "rec_note",
                    "value": "${state}${if(isEmpty($case_id$), '', ', case ' + $case_id$)}"
                  },
                  "description": "Note for the results"
                },
                {
                  "id": "s59",
                  "action": "ooa.datatable/add_row",
                  "args": {
                    "table": "$results$",
                    "values": {
                      "key": "$rec.key$",
                      "status": "done",
                      "note": "$rec_note$",
                      "time": "${formatDate(now(), '%H:%M:%S')}"
                    }
                  },
                  "out": {
                    "table": "results"
                  },
                  "description": "Add the record's result to the results table"
                },
                {
                  "id": "s60",
                  "action": "core/set",
                  "args": {
                    "variable": "processed",
                    "value": {
                      "expr": "$processed$ + 1"
                    }
                  },
                  "description": "Count the record as handled"
                },
                {
                  "id": "s61",
                  "action": "core/if",
                  "args": {
                    "condition": "$watch$"
                  },
                  "children": [
                    {
                      "id": "s62",
                      "action": "ooa.desktop/message_box",
                      "args": {
                        "title": "RW04-B4 - record ${rec.key}",
                        "message": "RW04-B4: record ${$i + 1} of ${len($records$)}\n\n${rec.name}: account ${acct_id}\nOrder ${order_sf} (${state})\nCase: ${case_id}",
                        "timeout_seconds": 2,
                        "icon": "information",
                        "always_on_top": true
                      },
                      "description": "Message box that closes by itself"
                    }
                  ],
                  "description": "Show what is happening (watch is on)"
                }
              ],
              "description": "Handle one record; a failure is caught below and the next record goes on",
              "catch": [
                {
                  "codes": [
                    "*"
                  ],
                  "children": [
                    {
                      "id": "s63",
                      "action": "core/comment",
                      "args": {
                        "text": "The record failed: keep the reason, count it as an exception and go on with the next one."
                      }
                    },
                    {
                      "id": "s64",
                      "action": "ooa.datatable/add_row",
                      "args": {
                        "table": "$results$",
                        "values": {
                          "key": "$rec.key$",
                          "status": "exception",
                          "note": "${err.code}: ${err_msg}",
                          "time": "${formatDate(now(), '%H:%M:%S')}"
                        }
                      },
                      "out": {
                        "table": "results"
                      },
                      "description": "Add the failure to the results table"
                    },
                    {
                      "id": "s65",
                      "action": "core/set",
                      "args": {
                        "variable": "exceptions",
                        "value": {
                          "expr": "$exceptions$ + 1"
                        }
                      },
                      "description": "Count the exception"
                    },
                    {
                      "id": "s66",
                      "action": "ooa.log/write",
                      "args": {
                        "path": "$log_file$",
                        "level": "WARN",
                        "message": "Record ${rec.key}: ${err.code} ${err_msg}"
                      },
                      "description": "Log the exception"
                    },
                    {
                      "id": "s67",
                      "action": "core/if",
                      "args": {
                        "condition": "$watch$"
                      },
                      "children": [
                        {
                          "id": "s68",
                          "action": "ooa.desktop/message_box",
                          "args": {
                            "title": "RW04-B4 - exception",
                            "message": "RW04-B4: record ${rec.key} went to the exception list\n\n${err.code}: ${err_msg}",
                            "timeout_seconds": 3,
                            "icon": "warning",
                            "always_on_top": true
                          },
                          "description": "Message box that closes by itself"
                        }
                      ],
                      "description": "Show what is happening (watch is on)"
                    }
                  ],
                  "as": "err",
                  "message_to": "err_msg"
                }
              ]
            },
            {
              "id": "s69",
              "action": "core/if",
              "args": {
                "condition": "$watch$"
              },
              "children": [
                {
                  "id": "s70",
                  "action": "core/delay",
                  "args": {
                    "seconds": "$pause_seconds$"
                  },
                  "description": "Short pause"
                }
              ],
              "description": "Pause so the screen can be followed (watch is on)"
            }
          ],
          "description": "Once for each of the 10 CRM order records"
        }
      ],
      "description": "3. Work through the records"
    },
    {
      "id": "s71",
      "action": "core/step",
      "args": {
        "title": "4. Finish"
      },
      "children": [
        {
          "id": "s72",
          "action": "core/comment",
          "args": {
            "text": "Save the results, set the outputs and say how it went."
          }
        },
        {
          "id": "s73",
          "action": "core/set",
          "args": {
            "variable": "evidence_file",
            "value": "${out_dir}/evidence.csv"
          },
          "description": "Name of the evidence file"
        },
        {
          "id": "s74",
          "action": "ooa.datatable/write_to_file",
          "args": {
            "table": "$evidence$",
            "path": "$evidence_file$"
          },
          "description": "Save the evidence rows"
        },
        {
          "id": "s75",
          "action": "core/set",
          "args": {
            "variable": "result_file",
            "value": "${out_dir}/results.csv"
          },
          "description": "Name of the results file"
        },
        {
          "id": "s76",
          "action": "ooa.datatable/write_to_file",
          "args": {
            "table": "$results$",
            "path": "$result_file$"
          },
          "description": "Save one row per record"
        },
        {
          "id": "s77",
          "action": "core/set",
          "args": {
            "variable": "status",
            "value": "success"
          },
          "description": "Every record was handled (exceptions are routed, not lost)"
        },
        {
          "id": "s78",
          "action": "ooa.log/write",
          "args": {
            "path": "$log_file$",
            "message": "RW04-B4 Salesforce CRM updater finished: ${processed} handled, ${exceptions} exceptions"
          },
          "description": "Log the end"
        },
        {
          "id": "s79",
          "action": "core/if",
          "args": {
            "condition": "$watch$"
          },
          "children": [
            {
              "id": "s80",
              "action": "ooa.desktop/message_box",
              "args": {
                "title": "RW04-B4 finished",
                "message": "RW04-B4 Salesforce CRM updater finished\n\nHandled: ${processed}\nExceptions: ${exceptions}\nResults: ${result_file}",
                "timeout_seconds": 4,
                "icon": "information",
                "always_on_top": true
              },
              "description": "Message box that closes by itself"
            }
          ],
          "description": "Show what is happening (watch is on)"
        }
      ],
      "description": "4. Finish"
    }
  ]
}
