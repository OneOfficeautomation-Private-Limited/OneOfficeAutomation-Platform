{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "rw01_b1",
  "name": "RW01-B1 Case intake and dedup",
  "description": "RW01-B1 (RW01 real-world test). Reads the QA support mailbox, normalizes each message, masks personal data, finds the customer, drops duplicates by their content hash, classifies type and severity with a weighted rule table, routes malformed mail and checks each message off.",
  "tags": [
    "real-world-test",
    "RW01"
  ],
  "variables": [
    {
      "name": "base",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Real-world tests",
      "description": "Folder of the real-world tests: data, output and the stand-in server."
    },
    {
      "name": "run_id",
      "type": "String",
      "direction": "input",
      "default": "",
      "description": "Run id shared by a main agent and its children; made here when empty."
    },
    {
      "name": "standin",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local QA stand-in server (127.0.0.1 only)."
    },
    {
      "name": "watch",
      "type": "Boolean",
      "direction": "input",
      "default": true,
      "description": "Show message boxes and pause between records so a person can follow the run."
    },
    {
      "name": "pause_seconds",
      "type": "Number",
      "direction": "input",
      "default": 1,
      "description": "Pause after each record when watch is on."
    },
    {
      "name": "fault_profile",
      "type": "String",
      "direction": "input",
      "default": "none",
      "description": "none, or resilience: the stand-ins inject the five failures of runbook step 09."
    },
    {
      "name": "info",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "out_dir",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "log_file",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "records",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "rec",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "i",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "err",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "err_msg",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "rec_status",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "rec_note",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "started",
      "type": "DateTime",
      "direction": "local"
    },
    {
      "name": "results",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "key",
          "status",
          "note",
          "time"
        ],
        "rows": []
      }
    },
    {
      "name": "processed",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Records handled without an error."
    },
    {
      "name": "exceptions",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Records routed to the exception list."
    },
    {
      "name": "status",
      "type": "String",
      "direction": "output",
      "default": "not_run",
      "description": "success when every record was handled (routed exceptions included)."
    },
    {
      "name": "result_file",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "CSV file with one row per record."
    },
    {
      "name": "email",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "subject",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "body",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "masked",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "account",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "customer",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "tier",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "hash",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "hashes",
      "type": "List",
      "direction": "local",
      "default": []
    },
    {
      "name": "rule",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "best",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "rtype",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "severity",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "cases",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "customers",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "rules",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "rules_list",
      "type": "List",
      "direction": "local"
    },
    {
      "name": "case_key",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "evidence",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "key",
          "case",
          "received",
          "customer",
          "tier",
          "type",
          "severity",
          "hash",
          "masked_body"
        ],
        "rows": []
      }
    },
    {
      "name": "evidence_file",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "Evidence rows of this agent (one per record)."
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "1. Start"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "What this agent does: Reads the QA support mailbox, normalizes each message, masks personal data, finds the customer, drops duplicates by their content hash, classifies type and severity with a weighted rule table, routes malformed mail and checks each message off. It works through 10 tagged case e-mails and writes its results to the run's output folder."
          }
        },
        {
          "id": "s3",
          "action": "ooa.run_context/get",
          "args": {},
          "out": {
            "info": "info"
          },
          "description": "Read the run context (run id, runner, user)"
        },
        {
          "id": "s4",
          "action": "core/set",
          "args": {
            "variable": "started",
            "value": {
              "expr": "now()"
            }
          },
          "description": "Remember when the agent started"
        },
        {
          "id": "s5",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "empty",
              "left": "$run_id$"
            }
          },
          "children": [
            {
              "id": "s6",
              "action": "core/set",
              "args": {
                "variable": "run_id",
                "value": "SOLO-${formatDate(now(), '%Y%m%d-%H%M%S')}"
              },
              "description": "Run id for a run on its own"
            }
          ],
          "description": "Running on its own: make a run id"
        },
        {
          "id": "s7",
          "action": "core/set",
          "args": {
            "variable": "out_dir",
            "value": "${base}/output/${run_id}/RW01-B1"
          },
          "description": "This agent's output folder for the run"
        },
        {
          "id": "s8",
          "action": "ooa.folder/create",
          "args": {
            "path": "$out_dir$"
          },
          "description": "Create the output folder"
        },
        {
          "id": "s9",
          "action": "core/set",
          "args": {
            "variable": "log_file",
            "value": "${out_dir}/log.txt"
          },
          "description": "Log file of this agent"
        },
        {
          "id": "s10",
          "action": "ooa.log/write",
          "args": {
            "path": "$log_file$",
            "message": "RW01-B1 Case intake and dedup started; run ${run_id}; computer ${info.device}, user ${info.os_user}"
          },
          "description": "Log the start"
        },
        {
          "id": "s11",
          "action": "core/if",
          "args": {
            "condition": "$watch$"
          },
          "children": [
            {
              "id": "s12",
              "action": "ooa.desktop/message_box",
              "args": {
                "title": "RW01-B1 starts",
                "message": "RW01-B1 Case intake and dedup\n\nReads the QA support mailbox, normalizes each message, masks personal data, finds the customer, drops duplicates by their content hash, classifies type and severity with a weighted rule table, routes malformed mail and checks each message off.\n\nRecords: 10 tagged case e-mails\nRun: ${run_id}",
                "timeout_seconds": 4,
                "icon": "information",
                "always_on_top": true
              },
              "description": "Message box that closes by itself"
            }
          ],
          "description": "Show what is happening (watch is on)"
        }
      ],
      "description": "1. Start"
    },
    {
      "id": "s13",
      "action": "core/step",
      "args": {
        "title": "2. Prepare"
      },
      "children": [
        {
          "id": "s14",
          "action": "core/comment",
          "args": {
            "text": "Read the 10 oldest messages of the QA support mailbox (Microsoft 365 stand-in), the customers and the weighted rule table."
          }
        },
        {
          "id": "s15",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "ne",
              "left": "$fault_profile$",
              "right": "none"
            }
          },
          "children": [
            {
              "id": "s16",
              "action": "ooa.rest/request",
              "args": {
                "method": "POST",
                "url": "${standin}/qa/faults",
                "json": {
                  "service": "graph",
                  "profile": "$fault_profile$",
                  "run_id": "$run_id$"
                }
              },
              "description": "Arm the stand-in's injected faults for this service"
            }
          ],
          "description": "Resilience run: arm the stand-in's faults"
        },
        {
          "id": "s17",
          "action": "ooa.microsoft365/list_mail",
          "args": {
            "folder": "inbox",
            "max_results": 10,
            "oldest_first": true,
            "access_token": {
              "$credential": "rw_qa_standins/graph/token"
            },
            "base_url": "${standin}/graph/v1.0",
            "mailbox": "qa-support@ooa-qa.test"
          },
          "out": {
            "table": "records"
          },
          "description": "List the support mailbox's messages"
        },
        {
          "id": "s18",
          "action": "ooa.csv/read",
          "args": {
            "path": "${base}/data/RW01/cases.csv"
          },
          "out": {
            "table": "cases"
          },
          "description": "Read the cases (sender to account)"
        },
        {
          "id": "s19",
          "action": "ooa.csv/read",
          "args": {
            "path": "${base}/data/RW01/customers.csv"
          },
          "out": {
            "table": "customers"
          },
          "description": "Read the customers"
        },
        {
          "id": "s20",
          "action": "ooa.csv/read",
          "args": {
            "path": "${base}/data/RW01/rules.csv"
          },
          "out": {
            "table": "rules"
          },
          "description": "Read the weighted rule table"
        },
        {
          "id": "s21",
          "action": "ooa.datatable/to_records",
          "args": {
            "table": "$rules$"
          },
          "out": {
            "records": "rules_list"
          },
          "description": "Rules as a list to go through"
        }
      ],
      "description": "2. Prepare"
    },
    {
      "id": "s22",
      "action": "core/step",
      "args": {
        "title": "3. Work through the records"
      },
      "children": [
        {
          "id": "s23",
          "action": "core/comment",
          "args": {
            "text": "Per message: read it, normalize, mask personal data, find the customer, hash and drop duplicates, classify, route malformed mail, record the case and check the message off."
          }
        },
        {
          "id": "s24",
          "action": "core/loop",
          "args": {
            "iterator": "table_rows",
            "over": "$records$",
            "as": "rec",
            "index": "i"
          },
          "children": [
            {
              "id": "s25",
              "action": "core/set",
              "args": {
                "variable": "rec_note",
                "value": ""
              },
              "description": "Clear the note of the previous record"
            },
            {
              "id": "s26",
              "action": "core/try",
              "args": {},
              "children": [
                {
                  "id": "s27",
                  "action": "ooa.microsoft365/get_mail",
                  "args": {
                    "id": "$rec.id$",
                    "mark_read": false,
                    "body_as_text": true,
                    "access_token": {
                      "$credential": "rw_qa_standins/graph/token"
                    },
                    "base_url": "${standin}/graph/v1.0",
                    "mailbox": "qa-support@ooa-qa.test"
                  },
                  "out": {
                    "email": "email"
                  },
                  "description": "Read the message"
                },
                {
                  "id": "s28",
                  "action": "core/if",
                  "args": {
                    "condition": "isEmpty(trim(coalesce($email.subject, ''))) or isEmpty(trim(coalesce($email.body, '')))"
                  },
                  "children": [
                    {
                      "id": "s29",
                      "action": "ooa.microsoft365/move_mail",
                      "args": {
                        "id": "$rec.id$",
                        "to_folder": "malformed",
                        "access_token": {
                          "$credential": "rw_qa_standins/graph/token"
                        },
                        "base_url": "${standin}/graph/v1.0",
                        "mailbox": "qa-support@ooa-qa.test"
                      },
                      "description": "Route it to the Malformed folder"
                    },
                    {
                      "id": "s30",
                      "action": "core/throw",
                      "args": {
                        "code": "ROUTE.MALFORMED",
                        "message": "Message ${rec.id} has no subject or body; moved to Malformed"
                      },
                      "description": "Route the message"
                    }
                  ],
                  "description": "Malformed (no subject or body)?"
                },
                {
                  "id": "s31",
                  "action": "ooa.string/trim",
                  "args": {
                    "text": "$email.subject$"
                  },
                  "out": {
                    "result": "subject"
                  },
                  "description": "Normalize the subject"
                },
                {
                  "id": "s32",
                  "action": "ooa.string/trim",
                  "args": {
                    "text": "$email.body$"
                  },
                  "out": {
                    "result": "body"
                  },
                  "description": "Normalize the body"
                },
                {
                  "id": "s33",
                  "action": "core/comment",
                  "args": {
                    "text": "Personal data never goes into logs or evidence: e-mail addresses, phone numbers and card numbers are masked."
                  }
                },
                {
                  "id": "s34",
                  "action": "ooa.string/replace",
                  "args": {
                    "text": "$body$",
                    "find": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}",
                    "replace_with": "[email]",
                    "regex": true
                  },
                  "out": {
                    "result": "masked"
                  },
                  "description": "Mask e-mail addresses"
                },
                {
                  "id": "s35",
                  "action": "ooa.string/replace",
                  "args": {
                    "text": "$masked$",
                    "find": "[+]?[0-9][0-9 ()-]{7,}[0-9]",
                    "replace_with": "[number]",
                    "regex": true
                  },
                  "out": {
                    "result": "masked"
                  },
                  "description": "Mask phone and card numbers"
                },
                {
                  "id": "s36",
                  "action": "ooa.datatable/lookup",
                  "args": {
                    "table": "$cases$",
                    "column": "subject",
                    "value": {
                      "expr": "replace($subject$, 'Re: ', '')"
                    },
                    "return_column": "key",
                    "if_not_found": ""
                  },
                  "out": {
                    "value": "case_key"
                  },
                  "description": "Find the case by its subject"
                },
                {
                  "id": "s37",
                  "action": "ooa.datatable/lookup",
                  "args": {
                    "table": "$cases$",
                    "column": "from",
                    "value": "${email.from}",
                    "return_column": "account",
                    "if_not_found": ""
                  },
                  "out": {
                    "value": "account"
                  },
                  "description": "Find the sender's account"
                },
                {
                  "id": "s38",
                  "action": "ooa.datatable/lookup",
                  "args": {
                    "table": "$customers$",
                    "column": "account",
                    "value": "$account$",
                    "return_column": "customer_id",
                    "if_not_found": "UNKNOWN"
                  },
                  "out": {
                    "value": "customer"
                  },
                  "description": "Resolve the synthetic customer id"
                },
                {
                  "id": "s39",
                  "action": "ooa.datatable/lookup",
                  "args": {
                    "table": "$customers$",
                    "column": "account",
                    "value": "$account$",
                    "return_column": "tier",
                    "if_not_found": "Bronze"
                  },
                  "out": {
                    "value": "tier"
                  },
                  "description": "Account tier (for the SLA)"
                },
                {
                  "id": "s40",
                  "action": "ooa.crypto/hash_text",
                  "args": {
                    "text": {
                      "expr": "lower($body$)"
                    }
                  },
                  "out": {
                    "hash": "hash"
                  },
                  "description": "Content hash for duplicate checks"
                },
                {
                  "id": "s41",
                  "action": "core/if",
                  "args": {
                    "condition": {
                      "op": "contains",
                      "left": "$hashes$",
                      "right": "$hash$"
                    }
                  },
                  "children": [
                    {
                      "id": "s42",
                      "action": "ooa.microsoft365/move_mail",
                      "args": {
                        "id": "$rec.id$",
                        "to_folder": "duplicates",
                        "access_token": {
                          "$credential": "rw_qa_standins/graph/token"
                        },
                        "base_url": "${standin}/graph/v1.0",
                        "mailbox": "qa-support@ooa-qa.test"
                      },
                      "description": "Route the duplicate"
                    },
                    {
                      "id": "s43",
                      "action": "core/throw",
                      "args": {
                        "code": "ROUTE.DUPLICATE",
                        "message": "Message ${rec.id} repeats an earlier case (same content)"
                      },
                      "description": "Route the duplicate"
                    }
                  ],
                  "description": "Seen this content before?"
                },
                {
                  "id": "s44",
                  "action": "ooa.list/add_item",
                  "args": {
                    "list": "$hashes$",
                    "item": "$hash$"
                  },
                  "out": {
                    "list": "hashes"
                  },
                  "description": "Remember the hash"
                },
                {
                  "id": "s45",
                  "action": "core/comment",
                  "args": {
                    "text": "Classify with the weighted rule table (a rule decision, not a model guess): the heaviest matching keyword wins."
                  }
                },
                {
                  "id": "s46",
                  "action": "core/set",
                  "args": {
                    "variable": "best",
                    "value": 0
                  },
                  "description": "No rule yet"
                },
                {
                  "id": "s47",
                  "action": "core/set",
                  "args": {
                    "variable": "rtype",
                    "value": "question"
                  },
                  "description": "Default type"
                },
                {
                  "id": "s48",
                  "action": "core/set",
                  "args": {
                    "variable": "severity",
                    "value": "P4"
                  },
                  "description": "Default severity"
                },
                {
                  "id": "s49",
                  "action": "core/loop",
                  "args": {
                    "iterator": "list",
                    "over": "$rules_list$",
                    "as": "rule"
                  },
                  "children": [
                    {
                      "id": "s50",
                      "action": "core/if",
                      "args": {
                        "condition": {
                          "all": [
                            {
                              "op": "contains",
                              "left": {
                                "expr": "lower($subject$ + ' ' + $body$)"
                              },
                              "right": "$rule.keyword$"
                            },
                            "toNumber($rule.weight$) > $best$"
                          ]
                        }
                      },
                      "children": [
                        {
                          "id": "s51",
                          "action": "core/set",
                          "args": {
                            "variable": "best",
                            "value": {
                              "expr": "toNumber($rule.weight$)"
                            }
                          },
                          "description": "New best weight"
                        },
                        {
                          "id": "s52",
                          "action": "core/set",
                          "args": {
                            "variable": "rtype",
                            "value": "$rule.type$"
                          },
                          "description": "Its type"
                        },
                        {
                          "id": "s53",
                          "action": "core/set",
                          "args": {
                            "variable": "severity",
                            "value": "$rule.severity$"
                          },
                          "description": "Its severity"
                        }
                      ],
                      "description": "Matches and weighs more?"
                    }
                  ],
                  "description": "Each rule"
                },
                {
                  "id": "s54",
                  "action": "ooa.datatable/add_row",
                  "args": {
                    "table": "$evidence$",
                    "values": {
                      "key": "$rec.id$",
                      "case": "$case_key$",
                      "received": "$rec.received$",
                      "customer": "$customer$",
                      "tier": "$tier$",
                      "type": "$rtype$",
                      "severity": "$severity$",
                      "hash": "$hash$",
                      "masked_body": "$masked$"
                    }
                  },
                  "out": {
                    "table": "evidence"
                  },
                  "description": "Create the correlation record"
                },
                {
                  "id": "s55",
                  "action": "ooa.microsoft365/mark_mail",
                  "args": {
                    "id": "$rec.id$",
                    "status": "read",
                    "access_token": {
                      "$credential": "rw_qa_standins/graph/token"
                    },
                    "base_url": "${standin}/graph/v1.0",
                    "mailbox": "qa-support@ooa-qa.test"
                  },
                  "description": "Check the message off (read)"
                },
                {
                  "id": "s56",
                  "action": "core/set",
                  "args": {
                    "variable": "rec_note",
                    "value": "${case_key} ${rtype} ${severity} (${customer})"
                  },
                  "description": "Note for the results"
                },
                {
                  "id": "s57",
                  "action": "ooa.datatable/add_row",
                  "args": {
                    "table": "$results$",
                    "values": {
                      "key": "$rec.id$",
                      "status": "done",
                      "note": "$rec_note$",
                      "time": "${formatDate(now(), '%H:%M:%S')}"
                    }
                  },
                  "out": {
                    "table": "results"
                  },
                  "description": "Add the record's result to the results table"
                },
                {
                  "id": "s58",
                  "action": "core/set",
                  "args": {
                    "variable": "processed",
                    "value": {
                      "expr": "$processed$ + 1"
                    }
                  },
                  "description": "Count the record as handled"
                },
                {
                  "id": "s59",
                  "action": "core/if",
                  "args": {
                    "condition": "$watch$"
                  },
                  "children": [
                    {
                      "id": "s60",
                      "action": "ooa.desktop/message_box",
                      "args": {
                        "title": "RW01-B1 - record ${rec.id}",
                        "message": "RW01-B1: record ${$i + 1} of ${len($records$)}\n\n${subject}\nCustomer: ${customer}\nType ${rtype}, severity ${severity}",
                        "timeout_seconds": 2,
                        "icon": "information",
                        "always_on_top": true
                      },
                      "description": "Message box that closes by itself"
                    }
                  ],
                  "description": "Show what is happening (watch is on)"
                }
              ],
              "description": "Handle one record; a failure is caught below and the next record goes on",
              "catch": [
                {
                  "codes": [
                    "*"
                  ],
                  "children": [
                    {
                      "id": "s61",
                      "action": "core/comment",
                      "args": {
                        "text": "The record failed: keep the reason, count it as an exception and go on with the next one."
                      }
                    },
                    {
                      "id": "s62",
                      "action": "ooa.datatable/add_row",
                      "args": {
                        "table": "$results$",
                        "values": {
                          "key": "$rec.id$",
                          "status": "exception",
                          "note": "${err.code}: ${err_msg}",
                          "time": "${formatDate(now(), '%H:%M:%S')}"
                        }
                      },
                      "out": {
                        "table": "results"
                      },
                      "description": "Add the failure to the results table"
                    },
                    {
                      "id": "s63",
                      "action": "core/set",
                      "args": {
                        "variable": "exceptions",
                        "value": {
                          "expr": "$exceptions$ + 1"
                        }
                      },
                      "description": "Count the exception"
                    },
                    {
                      "id": "s64",
                      "action": "ooa.log/write",
                      "args": {
                        "path": "$log_file$",
                        "level": "WARN",
                        "message": "Record ${rec.id}: ${err.code} ${err_msg}"
                      },
                      "description": "Log the exception"
                    },
                    {
                      "id": "s65",
                      "action": "core/if",
                      "args": {
                        "condition": "$watch$"
                      },
                      "children": [
                        {
                          "id": "s66",
                          "action": "ooa.desktop/message_box",
                          "args": {
                            "title": "RW01-B1 - exception",
                            "message": "RW01-B1: record ${rec.id} went to the exception list\n\n${err.code}: ${err_msg}",
                            "timeout_seconds": 3,
                            "icon": "warning",
                            "always_on_top": true
                          },
                          "description": "Message box that closes by itself"
                        }
                      ],
                      "description": "Show what is happening (watch is on)"
                    }
                  ],
                  "as": "err",
                  "message_to": "err_msg"
                }
              ]
            },
            {
              "id": "s67",
              "action": "core/if",
              "args": {
                "condition": "$watch$"
              },
              "children": [
                {
                  "id": "s68",
                  "action": "core/delay",
                  "args": {
                    "seconds": "$pause_seconds$"
                  },
                  "description": "Short pause"
                }
              ],
              "description": "Pause so the screen can be followed (watch is on)"
            }
          ],
          "description": "Once for each of the 10 tagged case e-mails"
        }
      ],
      "description": "3. Work through the records"
    },
    {
      "id": "s69",
      "action": "core/step",
      "args": {
        "title": "4. Finish"
      },
      "children": [
        {
          "id": "s70",
          "action": "core/comment",
          "args": {
            "text": "Save the results, set the outputs and say how it went."
          }
        },
        {
          "id": "s71",
          "action": "core/set",
          "args": {
            "variable": "evidence_file",
            "value": "${out_dir}/evidence.csv"
          },
          "description": "Name of the evidence file"
        },
        {
          "id": "s72",
          "action": "ooa.datatable/write_to_file",
          "args": {
            "table": "$evidence$",
            "path": "$evidence_file$"
          },
          "description": "Save the evidence rows"
        },
        {
          "id": "s73",
          "action": "core/set",
          "args": {
            "variable": "result_file",
            "value": "${out_dir}/results.csv"
          },
          "description": "Name of the results file"
        },
        {
          "id": "s74",
          "action": "ooa.datatable/write_to_file",
          "args": {
            "table": "$results$",
            "path": "$result_file$"
          },
          "description": "Save one row per record"
        },
        {
          "id": "s75",
          "action": "core/set",
          "args": {
            "variable": "status",
            "value": "success"
          },
          "description": "Every record was handled (exceptions are routed, not lost)"
        },
        {
          "id": "s76",
          "action": "ooa.log/write",
          "args": {
            "path": "$log_file$",
            "message": "RW01-B1 Case intake and dedup finished: ${processed} handled, ${exceptions} exceptions"
          },
          "description": "Log the end"
        },
        {
          "id": "s77",
          "action": "core/if",
          "args": {
            "condition": "$watch$"
          },
          "children": [
            {
              "id": "s78",
              "action": "ooa.desktop/message_box",
              "args": {
                "title": "RW01-B1 finished",
                "message": "RW01-B1 Case intake and dedup finished\n\nHandled: ${processed}\nExceptions: ${exceptions}\nResults: ${result_file}",
                "timeout_seconds": 4,
                "icon": "information",
                "always_on_top": true
              },
              "description": "Message box that closes by itself"
            }
          ],
          "description": "Show what is happening (watch is on)"
        }
      ],
      "description": "4. Finish"
    }
  ]
}
