{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "rw01_b6",
  "name": "RW01-B6 Excel and audit reconciler",
  "description": "RW01-B6 (RW01 real-world test). Pulls the other agents' evidence for every case, compares the ids, works out the aging, flags conflicts, builds an Excel summary with a formula, reads it back to verify the total, exports a CSV and checks that no file holds the secret canary.",
  "tags": [
    "real-world-test",
    "RW01"
  ],
  "variables": [
    {
      "name": "base",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Real-world tests",
      "description": "Folder of the real-world tests: data, output and the stand-in server."
    },
    {
      "name": "run_id",
      "type": "String",
      "direction": "input",
      "default": "",
      "description": "Run id shared by a main agent and its children; made here when empty."
    },
    {
      "name": "standin",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local QA stand-in server (127.0.0.1 only)."
    },
    {
      "name": "watch",
      "type": "Boolean",
      "direction": "input",
      "default": true,
      "description": "Show message boxes and pause between records so a person can follow the run."
    },
    {
      "name": "pause_seconds",
      "type": "Number",
      "direction": "input",
      "default": 1,
      "description": "Pause after each record when watch is on."
    },
    {
      "name": "fault_profile",
      "type": "String",
      "direction": "input",
      "default": "none",
      "description": "none, or resilience: the stand-ins inject the five failures of runbook step 09."
    },
    {
      "name": "info",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "out_dir",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "log_file",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "records",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "rec",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "i",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "err",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "err_msg",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "rec_status",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "rec_note",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "started",
      "type": "DateTime",
      "direction": "local"
    },
    {
      "name": "results",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "key",
          "status",
          "note",
          "time"
        ],
        "rows": []
      }
    },
    {
      "name": "processed",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Records handled without an error."
    },
    {
      "name": "exceptions",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Records routed to the exception list."
    },
    {
      "name": "status",
      "type": "String",
      "direction": "output",
      "default": "not_run",
      "description": "success when every record was handled (routed exceptions included)."
    },
    {
      "name": "result_file",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "CSV file with one row per record."
    },
    {
      "name": "b1",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "key",
          "case"
        ],
        "rows": []
      }
    },
    {
      "name": "b2",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "key",
          "case"
        ],
        "rows": []
      }
    },
    {
      "name": "b3",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "key",
          "case"
        ],
        "rows": []
      }
    },
    {
      "name": "b4",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "key",
          "case"
        ],
        "rows": []
      }
    },
    {
      "name": "b5",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "key",
          "case"
        ],
        "rows": []
      }
    },
    {
      "name": "type",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "inc",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "jira_key",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "reply",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "verdict",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "age",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "arrived",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "complete",
      "type": "Boolean",
      "direction": "local",
      "default": false
    },
    {
      "name": "summary",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "case",
          "type",
          "incident",
          "jira",
          "reply",
          "public_check",
          "age_hours",
          "complete"
        ],
        "rows": []
      }
    },
    {
      "name": "total",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "canary",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "files",
      "type": "List",
      "direction": "local"
    },
    {
      "name": "file",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "text",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "workbook",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "The Excel summary."
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "1. Start"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "What this agent does: Pulls the other agents' evidence for every case, compares the ids, works out the aging, flags conflicts, builds an Excel summary with a formula, reads it back to verify the total, exports a CSV and checks that no file holds the secret canary. It works through 10 case bundles and writes its results to the run's output folder."
          }
        },
        {
          "id": "s3",
          "action": "ooa.run_context/get",
          "args": {},
          "out": {
            "info": "info"
          },
          "description": "Read the run context (run id, runner, user)"
        },
        {
          "id": "s4",
          "action": "core/set",
          "args": {
            "variable": "started",
            "value": {
              "expr": "now()"
            }
          },
          "description": "Remember when the agent started"
        },
        {
          "id": "s5",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "empty",
              "left": "$run_id$"
            }
          },
          "children": [
            {
              "id": "s6",
              "action": "core/set",
              "args": {
                "variable": "run_id",
                "value": "SOLO-${formatDate(now(), '%Y%m%d-%H%M%S')}"
              },
              "description": "Run id for a run on its own"
            }
          ],
          "description": "Running on its own: make a run id"
        },
        {
          "id": "s7",
          "action": "core/set",
          "args": {
            "variable": "out_dir",
            "value": "${base}/output/${run_id}/RW01-B6"
          },
          "description": "This agent's output folder for the run"
        },
        {
          "id": "s8",
          "action": "ooa.folder/create",
          "args": {
            "path": "$out_dir$"
          },
          "description": "Create the output folder"
        },
        {
          "id": "s9",
          "action": "core/set",
          "args": {
            "variable": "log_file",
            "value": "${out_dir}/log.txt"
          },
          "description": "Log file of this agent"
        },
        {
          "id": "s10",
          "action": "ooa.log/write",
          "args": {
            "path": "$log_file$",
            "message": "RW01-B6 Excel and audit reconciler started; run ${run_id}; computer ${info.device}, user ${info.os_user}"
          },
          "description": "Log the start"
        },
        {
          "id": "s11",
          "action": "core/if",
          "args": {
            "condition": "$watch$"
          },
          "children": [
            {
              "id": "s12",
              "action": "ooa.desktop/message_box",
              "args": {
                "title": "RW01-B6 starts",
                "message": "RW01-B6 Excel and audit reconciler\n\nPulls the other agents' evidence for every case, compares the ids, works out the aging, flags conflicts, builds an Excel summary with a formula, reads it back to verify the total, exports a CSV and checks that no file holds the secret canary.\n\nRecords: 10 case bundles\nRun: ${run_id}",
                "timeout_seconds": 4,
                "icon": "information",
                "always_on_top": true
              },
              "description": "Message box that closes by itself"
            }
          ],
          "description": "Show what is happening (watch is on)"
        }
      ],
      "description": "1. Start"
    },
    {
      "id": "s13",
      "action": "core/step",
      "args": {
        "title": "2. Prepare"
      },
      "children": [
        {
          "id": "s14",
          "action": "core/comment",
          "args": {
            "text": "Load each agent's evidence for this run (a missing file stays an empty table)."
          }
        },
        {
          "id": "s15",
          "action": "ooa.csv/read",
          "args": {
            "path": "${base}/data/RW01/cases.csv"
          },
          "out": {
            "table": "records"
          },
          "description": "Read the test records (RW01/cases.csv)"
        },
        {
          "id": "s16",
          "action": "core/if",
          "args": {
            "condition": {
              "condition": "ooa.file/exists",
              "args": {
                "path": "${base}/output/${run_id}/RW01-B1/evidence.csv"
              }
            }
          },
          "children": [
            {
              "id": "s17",
              "action": "ooa.csv/read",
              "args": {
                "path": "${base}/output/${run_id}/RW01-B1/evidence.csv"
              },
              "out": {
                "table": "b1"
              },
              "description": "Read RW01-B1 evidence"
            }
          ],
          "description": "RW01-B1 evidence present?"
        },
        {
          "id": "s18",
          "action": "core/if",
          "args": {
            "condition": {
              "condition": "ooa.file/exists",
              "args": {
                "path": "${base}/output/${run_id}/RW01-B2/evidence.csv"
              }
            }
          },
          "children": [
            {
              "id": "s19",
              "action": "ooa.csv/read",
              "args": {
                "path": "${base}/output/${run_id}/RW01-B2/evidence.csv"
              },
              "out": {
                "table": "b2"
              },
              "description": "Read RW01-B2 evidence"
            }
          ],
          "description": "RW01-B2 evidence present?"
        },
        {
          "id": "s20",
          "action": "core/if",
          "args": {
            "condition": {
              "condition": "ooa.file/exists",
              "args": {
                "path": "${base}/output/${run_id}/RW01-B3/evidence.csv"
              }
            }
          },
          "children": [
            {
              "id": "s21",
              "action": "ooa.csv/read",
              "args": {
                "path": "${base}/output/${run_id}/RW01-B3/evidence.csv"
              },
              "out": {
                "table": "b3"
              },
              "description": "Read RW01-B3 evidence"
            }
          ],
          "description": "RW01-B3 evidence present?"
        },
        {
          "id": "s22",
          "action": "core/if",
          "args": {
            "condition": {
              "condition": "ooa.file/exists",
              "args": {
                "path": "${base}/output/${run_id}/RW01-B4/evidence.csv"
              }
            }
          },
          "children": [
            {
              "id": "s23",
              "action": "ooa.csv/read",
              "args": {
                "path": "${base}/output/${run_id}/RW01-B4/evidence.csv"
              },
              "out": {
                "table": "b4"
              },
              "description": "Read RW01-B4 evidence"
            }
          ],
          "description": "RW01-B4 evidence present?"
        },
        {
          "id": "s24",
          "action": "core/if",
          "args": {
            "condition": {
              "condition": "ooa.file/exists",
              "args": {
                "path": "${base}/output/${run_id}/RW01-B5/evidence.csv"
              }
            }
          },
          "children": [
            {
              "id": "s25",
              "action": "ooa.csv/read",
              "args": {
                "path": "${base}/output/${run_id}/RW01-B5/evidence.csv"
              },
              "out": {
                "table": "b5"
              },
              "description": "Read RW01-B5 evidence"
            }
          ],
          "description": "RW01-B5 evidence present?"
        }
      ],
      "description": "2. Prepare"
    },
    {
      "id": "s26",
      "action": "core/step",
      "args": {
        "title": "3. Work through the records"
      },
      "children": [
        {
          "id": "s27",
          "action": "core/comment",
          "args": {
            "text": "Per case: gather what each agent did, work out the age, flag conflicts and incomplete bundles, add the summary row."
          }
        },
        {
          "id": "s28",
          "action": "core/loop",
          "args": {
            "iterator": "table_rows",
            "over": "$records$",
            "as": "rec",
            "index": "i"
          },
          "children": [
            {
              "id": "s29",
              "action": "core/set",
              "args": {
                "variable": "rec_note",
                "value": ""
              },
              "description": "Clear the note of the previous record"
            },
            {
              "id": "s30",
              "action": "core/try",
              "args": {},
              "children": [
                {
                  "id": "s31",
                  "action": "ooa.datatable/lookup",
                  "args": {
                    "table": "$b1$",
                    "column": "case",
                    "value": "$rec.key$",
                    "return_column": "type",
                    "if_not_found": ""
                  },
                  "out": {
                    "value": "type"
                  },
                  "description": "Intake: type"
                },
                {
                  "id": "s32",
                  "action": "ooa.datatable/lookup",
                  "args": {
                    "table": "$b3$",
                    "column": "case",
                    "value": "$rec.key$",
                    "return_column": "number",
                    "if_not_found": ""
                  },
                  "out": {
                    "value": "inc"
                  },
                  "description": "ServiceNow: incident"
                },
                {
                  "id": "s33",
                  "action": "ooa.datatable/lookup",
                  "args": {
                    "table": "$b4$",
                    "column": "case",
                    "value": "$rec.key$",
                    "return_column": "jira",
                    "if_not_found": ""
                  },
                  "out": {
                    "value": "jira_key"
                  },
                  "description": "Jira: issue"
                },
                {
                  "id": "s34",
                  "action": "ooa.datatable/lookup",
                  "args": {
                    "table": "$b5$",
                    "column": "case",
                    "value": "$rec.key$",
                    "return_column": "decision",
                    "if_not_found": ""
                  },
                  "out": {
                    "value": "reply"
                  },
                  "description": "Reply: decision"
                },
                {
                  "id": "s35",
                  "action": "ooa.datatable/lookup",
                  "args": {
                    "table": "$b2$",
                    "column": "case",
                    "value": "$rec.key$",
                    "return_column": "verdict",
                    "if_not_found": ""
                  },
                  "out": {
                    "value": "verdict"
                  },
                  "description": "Public research: verdict"
                },
                {
                  "id": "s36",
                  "action": "ooa.datatable/lookup",
                  "args": {
                    "table": "$b1$",
                    "column": "case",
                    "value": "$rec.key$",
                    "return_column": "received",
                    "if_not_found": ""
                  },
                  "out": {
                    "value": "arrived"
                  },
                  "description": "When the case arrived"
                },
                {
                  "id": "s37",
                  "action": "core/set",
                  "args": {
                    "variable": "age",
                    "value": 0
                  },
                  "description": "Unknown age"
                },
                {
                  "id": "s38",
                  "action": "core/if",
                  "args": {
                    "condition": "not isEmpty($arrived$)"
                  },
                  "children": [
                    {
                      "id": "s39",
                      "action": "ooa.datetime/difference",
                      "args": {
                        "start": "$arrived$",
                        "end": {
                          "expr": "now()"
                        },
                        "unit": "hours"
                      },
                      "out": {
                        "result": "age"
                      },
                      "description": "Aging since the case arrived (hours)"
                    }
                  ],
                  "description": "Arrival known?"
                },
                {
                  "id": "s40",
                  "action": "core/set",
                  "args": {
                    "variable": "complete",
                    "value": {
                      "expr": "not isEmpty($inc$) and not isEmpty($reply$)"
                    }
                  },
                  "description": "Complete bundle: an incident and a reply"
                },
                {
                  "id": "s41",
                  "action": "core/if",
                  "args": {
                    "condition": {
                      "op": "contains",
                      "left": "$verdict$",
                      "right": "hold"
                    }
                  },
                  "children": [
                    {
                      "id": "s42",
                      "action": "ooa.log/write",
                      "args": {
                        "path": "$log_file$",
                        "level": "WARN",
                        "message": "${rec.key}: public source differs from the knowledge base"
                      },
                      "description": "Flag the conflict"
                    }
                  ],
                  "description": "Public source differs from the knowledge base?"
                },
                {
                  "id": "s43",
                  "action": "ooa.datatable/add_row",
                  "args": {
                    "table": "$summary$",
                    "values": {
                      "case": "$rec.key$",
                      "type": "$type$",
                      "incident": "$inc$",
                      "jira": "$jira_key$",
                      "reply": "$reply$",
                      "public_check": "$verdict$",
                      "age_hours": {
                        "expr": "round($age$, 1)"
                      },
                      "complete": "$complete$"
                    }
                  },
                  "out": {
                    "table": "summary"
                  },
                  "description": "Add the summary row"
                },
                {
                  "id": "s44",
                  "action": "core/set",
                  "args": {
                    "variable": "rec_note",
                    "value": "complete ${complete}"
                  },
                  "description": "Note for the results"
                },
                {
                  "id": "s45",
                  "action": "ooa.datatable/add_row",
                  "args": {
                    "table": "$results$",
                    "values": {
                      "key": "$rec.key$",
                      "status": "done",
                      "note": "$rec_note$",
                      "time": "${formatDate(now(), '%H:%M:%S')}"
                    }
                  },
                  "out": {
                    "table": "results"
                  },
                  "description": "Add the record's result to the results table"
                },
                {
                  "id": "s46",
                  "action": "core/set",
                  "args": {
                    "variable": "processed",
                    "value": {
                      "expr": "$processed$ + 1"
                    }
                  },
                  "description": "Count the record as handled"
                },
                {
                  "id": "s47",
                  "action": "core/if",
                  "args": {
                    "condition": "$watch$"
                  },
                  "children": [
                    {
                      "id": "s48",
                      "action": "ooa.desktop/message_box",
                      "args": {
                        "title": "RW01-B6 - record ${rec.key}",
                        "message": "RW01-B6: record ${$i + 1} of ${len($records$)}\n\n${type} | ${inc} | ${jira_key} | ${reply}\nComplete: ${complete}",
                        "timeout_seconds": 2,
                        "icon": "information",
                        "always_on_top": true
                      },
                      "description": "Message box that closes by itself"
                    }
                  ],
                  "description": "Show what is happening (watch is on)"
                }
              ],
              "description": "Handle one record; a failure is caught below and the next record goes on",
              "catch": [
                {
                  "codes": [
                    "*"
                  ],
                  "children": [
                    {
                      "id": "s49",
                      "action": "core/comment",
                      "args": {
                        "text": "The record failed: keep the reason, count it as an exception and go on with the next one."
                      }
                    },
                    {
                      "id": "s50",
                      "action": "ooa.datatable/add_row",
                      "args": {
                        "table": "$results$",
                        "values": {
                          "key": "$rec.key$",
                          "status": "exception",
                          "note": "${err.code}: ${err_msg}",
                          "time": "${formatDate(now(), '%H:%M:%S')}"
                        }
                      },
                      "out": {
                        "table": "results"
                      },
                      "description": "Add the failure to the results table"
                    },
                    {
                      "id": "s51",
                      "action": "core/set",
                      "args": {
                        "variable": "exceptions",
                        "value": {
                          "expr": "$exceptions$ + 1"
                        }
                      },
                      "description": "Count the exception"
                    },
                    {
                      "id": "s52",
                      "action": "ooa.log/write",
                      "args": {
                        "path": "$log_file$",
                        "level": "WARN",
                        "message": "Record ${rec.key}: ${err.code} ${err_msg}"
                      },
                      "description": "Log the exception"
                    },
                    {
                      "id": "s53",
                      "action": "core/if",
                      "args": {
                        "condition": "$watch$"
                      },
                      "children": [
                        {
                          "id": "s54",
                          "action": "ooa.desktop/message_box",
                          "args": {
                            "title": "RW01-B6 - exception",
                            "message": "RW01-B6: record ${rec.key} went to the exception list\n\n${err.code}: ${err_msg}",
                            "timeout_seconds": 3,
                            "icon": "warning",
                            "always_on_top": true
                          },
                          "description": "Message box that closes by itself"
                        }
                      ],
                      "description": "Show what is happening (watch is on)"
                    }
                  ],
                  "as": "err",
                  "message_to": "err_msg"
                }
              ]
            },
            {
              "id": "s55",
              "action": "core/if",
              "args": {
                "condition": "$watch$"
              },
              "children": [
                {
                  "id": "s56",
                  "action": "core/delay",
                  "args": {
                    "seconds": "$pause_seconds$"
                  },
                  "description": "Short pause"
                }
              ],
              "description": "Pause so the screen can be followed (watch is on)"
            }
          ],
          "description": "Once for each of the 10 case bundles"
        }
      ],
      "description": "3. Work through the records"
    },
    {
      "id": "s57",
      "action": "core/step",
      "args": {
        "title": "4. Finish"
      },
      "children": [
        {
          "id": "s58",
          "action": "core/comment",
          "args": {
            "text": "Build the Excel summary, verify it by reading it back, export the CSV and scan for the canary."
          }
        },
        {
          "id": "s59",
          "action": "core/set",
          "args": {
            "variable": "workbook",
            "value": "${out_dir}/RW01-summary.xlsx"
          },
          "description": "Name of the workbook"
        },
        {
          "id": "s60",
          "action": "ooa.excel/create_workbook",
          "args": {
            "path": "$workbook$",
            "overwrite": true,
            "sheet": "Summary"
          },
          "description": "Create the summary workbook"
        },
        {
          "id": "s61",
          "action": "ooa.excel/write_table",
          "args": {
            "table": "$summary$",
            "sheet": "Summary",
            "start_cell": "A1"
          },
          "description": "Write the summary table"
        },
        {
          "id": "s62",
          "action": "ooa.excel/set_formula",
          "args": {
            "cell": "J1",
            "formula": "COUNTA(A2:A11)",
            "sheet": "Summary"
          },
          "description": "Count the rows (Excel formula)"
        },
        {
          "id": "s63",
          "action": "ooa.excel/save",
          "args": {},
          "description": "Save the workbook"
        },
        {
          "id": "s64",
          "action": "ooa.excel/get_cell",
          "args": {
            "cell": "J1",
            "sheet": "Summary"
          },
          "out": {
            "value": "total"
          },
          "description": "Read the total back"
        },
        {
          "id": "s65",
          "action": "ooa.excel/close",
          "args": {},
          "description": "Close the workbook"
        },
        {
          "id": "s66",
          "action": "core/if",
          "args": {
            "condition": "toNumber($total$) != len($summary$)"
          },
          "children": [
            {
              "id": "s67",
              "action": "core/throw",
              "args": {
                "code": "VERIFY.TOTALS",
                "message": "Workbook total ${total} differs from the table"
              },
              "description": "Stop: the workbook does not match"
            }
          ],
          "description": "Does the workbook's total match?"
        },
        {
          "id": "s68",
          "action": "ooa.datatable/write_to_file",
          "args": {
            "table": "$summary$",
            "path": "${out_dir}/RW01-summary.csv"
          },
          "description": "Export the sanitized CSV"
        },
        {
          "id": "s69",
          "action": "ooa.global_values/get",
          "args": {
            "name": "rw_canary",
            "default": "",
            "type": "String"
          },
          "out": {
            "value": "canary"
          },
          "description": "The secret canary"
        },
        {
          "id": "s70",
          "action": "ooa.file/list",
          "args": {
            "folder": "${base}/output/${run_id}",
            "pattern": "*.csv",
            "include_subfolders": true
          },
          "out": {
            "files": "files"
          },
          "description": "Every file of this run"
        },
        {
          "id": "s71",
          "action": "core/loop",
          "args": {
            "iterator": "list",
            "over": "$files$",
            "as": "file"
          },
          "children": [
            {
              "id": "s72",
              "action": "ooa.file/read_text",
              "args": {
                "path": "$file$"
              },
              "out": {
                "text": "text"
              },
              "description": "Read it"
            },
            {
              "id": "s73",
              "action": "core/if",
              "args": {
                "condition": {
                  "all": [
                    {
                      "op": "ne",
                      "left": "$canary$",
                      "right": ""
                    },
                    {
                      "op": "contains",
                      "left": "$text$",
                      "right": "$canary$"
                    }
                  ]
                }
              },
              "children": [
                {
                  "id": "s74",
                  "action": "core/throw",
                  "args": {
                    "code": "SECURITY.CANARY_FOUND",
                    "message": "The secret canary is in ${file}"
                  },
                  "description": "Stop: a secret leaked"
                }
              ],
              "description": "Canary inside?"
            }
          ],
          "description": "Each file"
        },
        {
          "id": "s75",
          "action": "core/if",
          "args": {
            "condition": "$watch$"
          },
          "children": [
            {
              "id": "s76",
              "action": "ooa.desktop/message_box",
              "args": {
                "title": "RW01-B6 workbook",
                "message": "Workbook: ${workbook}\nRows (Excel formula): ${total}",
                "timeout_seconds": 3,
                "icon": "information",
                "always_on_top": true
              },
              "description": "Message box that closes by itself"
            }
          ],
          "description": "Show what is happening (watch is on)"
        },
        {
          "id": "s77",
          "action": "core/set",
          "args": {
            "variable": "result_file",
            "value": "${out_dir}/results.csv"
          },
          "description": "Name of the results file"
        },
        {
          "id": "s78",
          "action": "ooa.datatable/write_to_file",
          "args": {
            "table": "$results$",
            "path": "$result_file$"
          },
          "description": "Save one row per record"
        },
        {
          "id": "s79",
          "action": "core/set",
          "args": {
            "variable": "status",
            "value": "success"
          },
          "description": "Every record was handled (exceptions are routed, not lost)"
        },
        {
          "id": "s80",
          "action": "ooa.log/write",
          "args": {
            "path": "$log_file$",
            "message": "RW01-B6 Excel and audit reconciler finished: ${processed} handled, ${exceptions} exceptions"
          },
          "description": "Log the end"
        },
        {
          "id": "s81",
          "action": "core/if",
          "args": {
            "condition": "$watch$"
          },
          "children": [
            {
              "id": "s82",
              "action": "ooa.desktop/message_box",
              "args": {
                "title": "RW01-B6 finished",
                "message": "RW01-B6 Excel and audit reconciler finished\n\nHandled: ${processed}\nExceptions: ${exceptions}\nResults: ${result_file}",
                "timeout_seconds": 4,
                "icon": "information",
                "always_on_top": true
              },
              "description": "Message box that closes by itself"
            }
          ],
          "description": "Show what is happening (watch is on)"
        }
      ],
      "description": "4. Finish"
    }
  ]
}
