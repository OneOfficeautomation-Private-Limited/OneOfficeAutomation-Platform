{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "rw01_b3",
  "name": "RW01-B3 ServiceNow case worker",
  "description": "RW01-B3 (RW01 real-world test). For each case's incident: checks the OOA-QA tag, reads the account, applies the SLA matrix, sets the assignment group, adds one internal work note, moves it to In Progress, reads it back to verify and keeps the sys_id.",
  "tags": [
    "real-world-test",
    "RW01"
  ],
  "variables": [
    {
      "name": "base",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Real-world tests",
      "description": "Folder of the real-world tests: data, output and the stand-in server."
    },
    {
      "name": "run_id",
      "type": "String",
      "direction": "input",
      "default": "",
      "description": "Run id shared by a main agent and its children; made here when empty."
    },
    {
      "name": "standin",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local QA stand-in server (127.0.0.1 only)."
    },
    {
      "name": "watch",
      "type": "Boolean",
      "direction": "input",
      "default": true,
      "description": "Show message boxes and pause between records so a person can follow the run."
    },
    {
      "name": "pause_seconds",
      "type": "Number",
      "direction": "input",
      "default": 1,
      "description": "Pause after each record when watch is on."
    },
    {
      "name": "fault_profile",
      "type": "String",
      "direction": "input",
      "default": "none",
      "description": "none, or resilience: the stand-ins inject the five failures of runbook step 09."
    },
    {
      "name": "info",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "out_dir",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "log_file",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "records",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "rec",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "i",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "err",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "err_msg",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "rec_status",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "rec_note",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "started",
      "type": "DateTime",
      "direction": "local"
    },
    {
      "name": "results",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "key",
          "status",
          "note",
          "time"
        ],
        "rows": []
      }
    },
    {
      "name": "processed",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Records handled without an error."
    },
    {
      "name": "exceptions",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Records routed to the exception list."
    },
    {
      "name": "status",
      "type": "String",
      "direction": "output",
      "default": "not_run",
      "description": "success when every record was handled (routed exceptions included)."
    },
    {
      "name": "result_file",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "CSV file with one row per record."
    },
    {
      "name": "found",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "inc",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "incs",
      "type": "List",
      "direction": "local"
    },
    {
      "name": "acct",
      "type": "List",
      "direction": "local"
    },
    {
      "name": "tier",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "sla",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "hit",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "group",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "hours",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "sev",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "after",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "evidence",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "key",
          "case",
          "number",
          "sys_id",
          "severity",
          "tier",
          "group",
          "sla_hours",
          "state"
        ],
        "rows": []
      }
    },
    {
      "name": "evidence_file",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "Evidence rows of this agent (one per record)."
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "1. Start"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "What this agent does: For each case's incident: checks the OOA-QA tag, reads the account, applies the SLA matrix, sets the assignment group, adds one internal work note, moves it to In Progress, reads it back to verify and keeps the sys_id. It works through 10 test incidents and writes its results to the run's output folder."
          }
        },
        {
          "id": "s3",
          "action": "ooa.run_context/get",
          "args": {},
          "out": {
            "info": "info"
          },
          "description": "Read the run context (run id, runner, user)"
        },
        {
          "id": "s4",
          "action": "core/set",
          "args": {
            "variable": "started",
            "value": {
              "expr": "now()"
            }
          },
          "description": "Remember when the agent started"
        },
        {
          "id": "s5",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "empty",
              "left": "$run_id$"
            }
          },
          "children": [
            {
              "id": "s6",
              "action": "core/set",
              "args": {
                "variable": "run_id",
                "value": "SOLO-${formatDate(now(), '%Y%m%d-%H%M%S')}"
              },
              "description": "Run id for a run on its own"
            }
          ],
          "description": "Running on its own: make a run id"
        },
        {
          "id": "s7",
          "action": "core/set",
          "args": {
            "variable": "out_dir",
            "value": "${base}/output/${run_id}/RW01-B3"
          },
          "description": "This agent's output folder for the run"
        },
        {
          "id": "s8",
          "action": "ooa.folder/create",
          "args": {
            "path": "$out_dir$"
          },
          "description": "Create the output folder"
        },
        {
          "id": "s9",
          "action": "core/set",
          "args": {
            "variable": "log_file",
            "value": "${out_dir}/log.txt"
          },
          "description": "Log file of this agent"
        },
        {
          "id": "s10",
          "action": "ooa.log/write",
          "args": {
            "path": "$log_file$",
            "message": "RW01-B3 ServiceNow case worker started; run ${run_id}; computer ${info.device}, user ${info.os_user}"
          },
          "description": "Log the start"
        },
        {
          "id": "s11",
          "action": "core/if",
          "args": {
            "condition": "$watch$"
          },
          "children": [
            {
              "id": "s12",
              "action": "ooa.desktop/message_box",
              "args": {
                "title": "RW01-B3 starts",
                "message": "RW01-B3 ServiceNow case worker\n\nFor each case's incident: checks the OOA-QA tag, reads the account, applies the SLA matrix, sets the assignment group, adds one internal work note, moves it to In Progress, reads it back to verify and keeps the sys_id.\n\nRecords: 10 test incidents\nRun: ${run_id}",
                "timeout_seconds": 4,
                "icon": "information",
                "always_on_top": true
              },
              "description": "Message box that closes by itself"
            }
          ],
          "description": "Show what is happening (watch is on)"
        }
      ],
      "description": "1. Start"
    },
    {
      "id": "s13",
      "action": "core/step",
      "args": {
        "title": "2. Prepare"
      },
      "children": [
        {
          "id": "s14",
          "action": "core/comment",
          "args": {
            "text": "Read the incidents to work and the SLA matrix (severity x tier -> hours and assignment group)."
          }
        },
        {
          "id": "s15",
          "action": "ooa.csv/read",
          "args": {
            "path": "${base}/data/RW01/incidents.csv"
          },
          "out": {
            "table": "records"
          },
          "description": "Read the test records (RW01/incidents.csv)"
        },
        {
          "id": "s16",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "ne",
              "left": "$fault_profile$",
              "right": "none"
            }
          },
          "children": [
            {
              "id": "s17",
              "action": "ooa.rest/request",
              "args": {
                "method": "POST",
                "url": "${standin}/qa/faults",
                "json": {
                  "service": "servicenow",
                  "profile": "$fault_profile$",
                  "run_id": "$run_id$"
                }
              },
              "description": "Arm the stand-in's injected faults for this service"
            }
          ],
          "description": "Resilience run: arm the stand-in's faults"
        },
        {
          "id": "s18",
          "action": "ooa.csv/read",
          "args": {
            "path": "${base}/data/RW01/sla_matrix.csv"
          },
          "out": {
            "table": "sla"
          },
          "description": "Read the SLA matrix"
        }
      ],
      "description": "2. Prepare"
    },
    {
      "id": "s19",
      "action": "core/step",
      "args": {
        "title": "3. Work through the records"
      },
      "children": [
        {
          "id": "s20",
          "action": "core/comment",
          "args": {
            "text": "Per incident: find it, check the tag, read the account, apply the SLA, update, add a work note, read back, verify, keep the id."
          }
        },
        {
          "id": "s21",
          "action": "core/loop",
          "args": {
            "iterator": "table_rows",
            "over": "$records$",
            "as": "rec",
            "index": "i"
          },
          "children": [
            {
              "id": "s22",
              "action": "core/set",
              "args": {
                "variable": "rec_note",
                "value": ""
              },
              "description": "Clear the note of the previous record"
            },
            {
              "id": "s23",
              "action": "core/try",
              "args": {},
              "children": [
                {
                  "id": "s24",
                  "action": "ooa.servicenow/query",
                  "args": {
                    "table": "incident",
                    "query": "correlation_id=OOA-QA-${rec.case_key}",
                    "max_records": 1,
                    "instance_url": "$standin$",
                    "access_token": {
                      "$credential": "rw_qa_standins/servicenow/token"
                    }
                  },
                  "out": {
                    "table": "found"
                  },
                  "description": "Find the incident of the case"
                },
                {
                  "id": "s25",
                  "action": "ooa.datatable/to_records",
                  "args": {
                    "table": "$found$"
                  },
                  "out": {
                    "records": "incs"
                  },
                  "description": "As a record"
                },
                {
                  "id": "s26",
                  "action": "core/if",
                  "args": {
                    "condition": {
                      "op": "empty",
                      "left": "$incs$"
                    }
                  },
                  "children": [
                    {
                      "id": "s27",
                      "action": "core/throw",
                      "args": {
                        "code": "ROUTE.NO_INCIDENT",
                        "message": "No incident for case ${rec.case_key}"
                      },
                      "description": "Route it"
                    }
                  ],
                  "description": "No incident?"
                },
                {
                  "id": "s28",
                  "action": "core/set",
                  "args": {
                    "variable": "inc",
                    "value": {
                      "expr": "first($incs$)"
                    }
                  },
                  "description": "The incident"
                },
                {
                  "id": "s29",
                  "action": "core/if",
                  "args": {
                    "condition": "not startsWith($inc.short_description$, 'OOA-QA')"
                  },
                  "children": [
                    {
                      "id": "s30",
                      "action": "core/throw",
                      "args": {
                        "code": "POLICY.NOT_QA_RECORD",
                        "message": "Incident ${inc.number} is not tagged OOA-QA; it is left unchanged"
                      },
                      "description": "Never touch an untagged record"
                    }
                  ],
                  "description": "Not tagged OOA-QA?"
                },
                {
                  "id": "s31",
                  "action": "ooa.servicenow/query",
                  "args": {
                    "table": "customer_account",
                    "query": "number=${inc.u_account}",
                    "max_records": 1,
                    "instance_url": "$standin$",
                    "access_token": {
                      "$credential": "rw_qa_standins/servicenow/token"
                    }
                  },
                  "out": {
                    "table": "found"
                  },
                  "description": "Read the account context"
                },
                {
                  "id": "s32",
                  "action": "ooa.datatable/to_records",
                  "args": {
                    "table": "$found$"
                  },
                  "out": {
                    "records": "acct"
                  },
                  "description": "As a record"
                },
                {
                  "id": "s33",
                  "action": "core/set",
                  "args": {
                    "variable": "tier",
                    "value": {
                      "expr": "if(len($acct$) > 0, get(first($acct$), 'u_tier'), 'Bronze')"
                    }
                  },
                  "description": "The account's tier"
                },
                {
                  "id": "s34",
                  "action": "core/set",
                  "args": {
                    "variable": "sev",
                    "value": "P${inc.urgency}"
                  },
                  "description": "Severity from the urgency"
                },
                {
                  "id": "s35",
                  "action": "ooa.datatable/filter",
                  "args": {
                    "table": "$sla$",
                    "column": "severity",
                    "operator": "eq",
                    "value": "$sev$",
                    "more_conditions": [
                      {
                        "column": "tier",
                        "operator": "eq",
                        "value": "$tier$"
                      }
                    ]
                  },
                  "out": {
                    "table": "hit"
                  },
                  "description": "Apply the SLA matrix"
                },
                {
                  "id": "s36",
                  "action": "ooa.datatable/get_value",
                  "args": {
                    "table": "$hit$",
                    "row": 0,
                    "column": "group"
                  },
                  "out": {
                    "value": "group"
                  },
                  "description": "Assignment group"
                },
                {
                  "id": "s37",
                  "action": "ooa.datatable/get_value",
                  "args": {
                    "table": "$hit$",
                    "row": 0,
                    "column": "hours"
                  },
                  "out": {
                    "value": "hours"
                  },
                  "description": "SLA hours"
                },
                {
                  "id": "s38",
                  "action": "ooa.servicenow/update_record",
                  "args": {
                    "table": "incident",
                    "sys_id": "$inc.sys_id$",
                    "fields": {
                      "assignment_group": "$group$",
                      "u_sla_hours": "$hours$"
                    },
                    "instance_url": "$standin$",
                    "access_token": {
                      "$credential": "rw_qa_standins/servicenow/token"
                    }
                  },
                  "description": "Set the assignment group and SLA"
                },
                {
                  "id": "s39",
                  "action": "ooa.servicenow/add_comment",
                  "args": {
                    "table": "incident",
                    "sys_id": "$inc.sys_id$",
                    "internal": true,
                    "text": "[OOA-QA ${run_id} ${rec.key}] Routed to ${group}, SLA ${hours} h (${sev}, ${tier}).",
                    "instance_url": "$standin$",
                    "access_token": {
                      "$credential": "rw_qa_standins/servicenow/token"
                    }
                  },
                  "description": "Add the internal work note (with its dedupe key)"
                },
                {
                  "id": "s40",
                  "action": "ooa.servicenow/update_record",
                  "args": {
                    "table": "incident",
                    "sys_id": "$inc.sys_id$",
                    "fields": {
                      "state": "2"
                    },
                    "instance_url": "$standin$",
                    "access_token": {
                      "$credential": "rw_qa_standins/servicenow/token"
                    }
                  },
                  "description": "Move it to In Progress"
                },
                {
                  "id": "s41",
                  "action": "ooa.servicenow/get_record",
                  "args": {
                    "table": "incident",
                    "sys_id": "$inc.sys_id$",
                    "instance_url": "$standin$",
                    "access_token": {
                      "$credential": "rw_qa_standins/servicenow/token"
                    }
                  },
                  "out": {
                    "record": "after"
                  },
                  "description": "Read it back"
                },
                {
                  "id": "s42",
                  "action": "core/if",
                  "args": {
                    "condition": {
                      "any": [
                        {
                          "op": "ne",
                          "left": "$after.assignment_group$",
                          "right": "$group$"
                        },
                        {
                          "op": "ne",
                          "left": "$after.state$",
                          "right": "2"
                        }
                      ]
                    }
                  },
                  "children": [
                    {
                      "id": "s43",
                      "action": "core/throw",
                      "args": {
                        "code": "VERIFY.MISMATCH",
                        "message": "Incident ${inc.number} did not keep its changes"
                      },
                      "description": "Report the mismatch"
                    }
                  ],
                  "description": "Did the changes stick?"
                },
                {
                  "id": "s44",
                  "action": "ooa.datatable/add_row",
                  "args": {
                    "table": "$evidence$",
                    "values": {
                      "key": "$rec.key$",
                      "case": "$rec.case_key$",
                      "number": "$inc.number$",
                      "sys_id": "$inc.sys_id$",
                      "severity": "$sev$",
                      "tier": "$tier$",
                      "group": "$group$",
                      "sla_hours": "$hours$",
                      "state": "$after.state$"
                    }
                  },
                  "out": {
                    "table": "evidence"
                  },
                  "description": "Keep the sys_id and the result"
                },
                {
                  "id": "s45",
                  "action": "core/set",
                  "args": {
                    "variable": "rec_note",
                    "value": "${inc.number} -> ${group}"
                  },
                  "description": "Note for the results"
                },
                {
                  "id": "s46",
                  "action": "ooa.datatable/add_row",
                  "args": {
                    "table": "$results$",
                    "values": {
                      "key": "$rec.key$",
                      "status": "done",
                      "note": "$rec_note$",
                      "time": "${formatDate(now(), '%H:%M:%S')}"
                    }
                  },
                  "out": {
                    "table": "results"
                  },
                  "description": "Add the record's result to the results table"
                },
                {
                  "id": "s47",
                  "action": "core/set",
                  "args": {
                    "variable": "processed",
                    "value": {
                      "expr": "$processed$ + 1"
                    }
                  },
                  "description": "Count the record as handled"
                },
                {
                  "id": "s48",
                  "action": "core/if",
                  "args": {
                    "condition": "$watch$"
                  },
                  "children": [
                    {
                      "id": "s49",
                      "action": "ooa.desktop/message_box",
                      "args": {
                        "title": "RW01-B3 - record ${rec.key}",
                        "message": "RW01-B3: record ${$i + 1} of ${len($records$)}\n\n${inc.number} ${sev} ${tier}\nGroup: ${group} (${hours} h)",
                        "timeout_seconds": 2,
                        "icon": "information",
                        "always_on_top": true
                      },
                      "description": "Message box that closes by itself"
                    }
                  ],
                  "description": "Show what is happening (watch is on)"
                }
              ],
              "description": "Handle one record; a failure is caught below and the next record goes on",
              "catch": [
                {
                  "codes": [
                    "*"
                  ],
                  "children": [
                    {
                      "id": "s50",
                      "action": "core/comment",
                      "args": {
                        "text": "The record failed: keep the reason, count it as an exception and go on with the next one."
                      }
                    },
                    {
                      "id": "s51",
                      "action": "ooa.datatable/add_row",
                      "args": {
                        "table": "$results$",
                        "values": {
                          "key": "$rec.key$",
                          "status": "exception",
                          "note": "${err.code}: ${err_msg}",
                          "time": "${formatDate(now(), '%H:%M:%S')}"
                        }
                      },
                      "out": {
                        "table": "results"
                      },
                      "description": "Add the failure to the results table"
                    },
                    {
                      "id": "s52",
                      "action": "core/set",
                      "args": {
                        "variable": "exceptions",
                        "value": {
                          "expr": "$exceptions$ + 1"
                        }
                      },
                      "description": "Count the exception"
                    },
                    {
                      "id": "s53",
                      "action": "ooa.log/write",
                      "args": {
                        "path": "$log_file$",
                        "level": "WARN",
                        "message": "Record ${rec.key}: ${err.code} ${err_msg}"
                      },
                      "description": "Log the exception"
                    },
                    {
                      "id": "s54",
                      "action": "core/if",
                      "args": {
                        "condition": "$watch$"
                      },
                      "children": [
                        {
                          "id": "s55",
                          "action": "ooa.desktop/message_box",
                          "args": {
                            "title": "RW01-B3 - exception",
                            "message": "RW01-B3: record ${rec.key} went to the exception list\n\n${err.code}: ${err_msg}",
                            "timeout_seconds": 3,
                            "icon": "warning",
                            "always_on_top": true
                          },
                          "description": "Message box that closes by itself"
                        }
                      ],
                      "description": "Show what is happening (watch is on)"
                    }
                  ],
                  "as": "err",
                  "message_to": "err_msg"
                }
              ]
            },
            {
              "id": "s56",
              "action": "core/if",
              "args": {
                "condition": "$watch$"
              },
              "children": [
                {
                  "id": "s57",
                  "action": "core/delay",
                  "args": {
                    "seconds": "$pause_seconds$"
                  },
                  "description": "Short pause"
                }
              ],
              "description": "Pause so the screen can be followed (watch is on)"
            }
          ],
