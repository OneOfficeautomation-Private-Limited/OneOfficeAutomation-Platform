{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "rw01_b2",
  "name": "RW01-B2 Public knowledge research",
  "description": "RW01-B2 (RW01 real-world test). Opens allow-listed public pages (Books to Scrape, Wikipedia, Quotes to Scrape) for each support case, extracts up to three passages, records URL, title, time and a screenshot, compares the facts with the internal knowledge base and rejects page text that tries to give the agent instructions.",
  "tags": [
    "real-world-test",
    "RW01"
  ],
  "variables": [
    {
      "name": "base",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Real-world tests",
      "description": "Folder of the real-world tests: data, output and the stand-in server."
    },
    {
      "name": "run_id",
      "type": "String",
      "direction": "input",
      "default": "",
      "description": "Run id shared by a main agent and its children; made here when empty."
    },
    {
      "name": "standin",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local QA stand-in server (127.0.0.1 only)."
    },
    {
      "name": "watch",
      "type": "Boolean",
      "direction": "input",
      "default": true,
      "description": "Show message boxes and pause between records so a person can follow the run."
    },
    {
      "name": "pause_seconds",
      "type": "Number",
      "direction": "input",
      "default": 1,
      "description": "Pause after each record when watch is on."
    },
    {
      "name": "fault_profile",
      "type": "String",
      "direction": "input",
      "default": "none",
      "description": "none, or resilience: the stand-ins inject the five failures of runbook step 09."
    },
    {
      "name": "info",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "out_dir",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "log_file",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "records",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "rec",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "i",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "err",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "err_msg",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "rec_status",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "rec_note",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "started",
      "type": "DateTime",
      "direction": "local"
    },
    {
      "name": "results",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "key",
          "status",
          "note",
          "time"
        ],
        "rows": []
      }
    },
    {
      "name": "processed",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Records handled without an error."
    },
    {
      "name": "exceptions",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Records routed to the exception list."
    },
    {
      "name": "status",
      "type": "String",
      "direction": "output",
      "default": "not_run",
      "description": "success when every record was handled (routed exceptions included)."
    },
    {
      "name": "result_file",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "CSV file with one row per record."
    },
    {
      "name": "allowed",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "host",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "qjs",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "page",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "passages",
      "type": "List",
      "direction": "local"
    },
    {
      "name": "facts",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "url",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "title",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "captured",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "shot",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "injected",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "kb",
      "type": "List",
      "direction": "local"
    },
    {
      "name": "kb_text",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "score",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "freshness",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "verdict",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "evidence",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "key",
          "case",
          "site",
          "url",
          "title",
          "captured",
          "facts",
          "kb_match",
          "verdict",
          "screenshot"
        ],
        "rows": []
      }
    },
    {
      "name": "index_file",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "evidence_file",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "Evidence packets: one row per query with URL, title, time and facts."
    },
    {
      "name": "csv_text",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "js_summary",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "wa_ok",
      "type": "Boolean",
      "direction": "local",
      "default": false
    },
    {
      "name": "wa_answer",
      "type": "String",
      "direction": "local",
      "default": ""
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "1. Start"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "What this agent does: Opens allow-listed public pages (Books to Scrape, Wikipedia, Quotes to Scrape) for each support case, extracts up to three passages, records URL, title, time and a screenshot, compares the facts with the internal knowledge base and rejects page text that tries to give the agent instructions. It works through 10 product/reference queries and writes its results to the run's output folder."
          }
        },
        {
          "id": "s3",
          "action": "ooa.run_context/get",
          "args": {},
          "out": {
            "info": "info"
          },
          "description": "Read the run context (run id, runner, user)"
        },
        {
          "id": "s4",
          "action": "core/set",
          "args": {
            "variable": "started",
            "value": {
              "expr": "now()"
            }
          },
          "description": "Remember when the agent started"
        },
        {
          "id": "s5",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "empty",
              "left": "$run_id$"
            }
          },
          "children": [
            {
              "id": "s6",
              "action": "core/set",
              "args": {
                "variable": "run_id",
                "value": "SOLO-${formatDate(now(), '%Y%m%d-%H%M%S')}"
              },
              "description": "Run id for a run on its own"
            }
          ],
          "description": "Running on its own: make a run id"
        },
        {
          "id": "s7",
          "action": "core/set",
          "args": {
            "variable": "out_dir",
            "value": "${base}/output/${run_id}/RW01-B2"
          },
          "description": "This agent's output folder for the run"
        },
        {
          "id": "s8",
          "action": "ooa.folder/create",
          "args": {
            "path": "$out_dir$"
          },
          "description": "Create the output folder"
        },
        {
          "id": "s9",
          "action": "core/set",
          "args": {
            "variable": "log_file",
            "value": "${out_dir}/log.txt"
          },
          "description": "Log file of this agent"
        },
        {
          "id": "s10",
          "action": "ooa.log/write",
          "args": {
            "path": "$log_file$",
            "message": "RW01-B2 Public knowledge research started; run ${run_id}; computer ${info.device}, user ${info.os_user}"
          },
          "description": "Log the start"
        },
        {
          "id": "s11",
          "action": "core/if",
          "args": {
            "condition": "$watch$"
          },
          "children": [
            {
              "id": "s12",
              "action": "ooa.desktop/message_box",
              "args": {
                "title": "RW01-B2 starts",
                "message": "RW01-B2 Public knowledge research\n\nOpens allow-listed public pages (Books to Scrape, Wikipedia, Quotes to Scrape) for each support case, extracts up to three passages, records URL, title, time and a screenshot, compares the facts with the internal knowledge base and rejects page text that tries to give the agent instructions.\n\nRecords: 10 product/reference queries\nRun: ${run_id}",
                "timeout_seconds": 4,
                "icon": "information",
                "always_on_top": true
              },
              "description": "Message box that closes by itself"
            }
          ],
          "description": "Show what is happening (watch is on)"
        }
      ],
      "description": "1. Start"
    },
    {
      "id": "s13",
      "action": "core/step",
      "args": {
        "title": "2. Prepare"
      },
      "children": [
        {
          "id": "s14",
          "action": "core/comment",
          "args": {
            "text": "Read the 10 queries, the allowed sites and the internal knowledge base, and open the browser."
          }
        },
        {
          "id": "s15",
          "action": "ooa.csv/read",
          "args": {
            "path": "${base}/data/RW01/queries.csv"
          },
          "out": {
            "table": "records"
          },
          "description": "Read the test records (RW01/queries.csv)"
        },
        {
          "id": "s16",
          "action": "ooa.global_values/get",
          "args": {
            "name": "rw_allowed_hosts",
            "default": "books.toscrape.com,quotes.toscrape.com,en.wikipedia.org,127.0.0.1",
            "type": "String"
          },
          "out": {
            "value": "allowed"
          },
          "description": "Read the allow-list of hosts (global value rw_allowed_hosts)"
        },
        {
          "id": "s17",
          "action": "core/set",
          "args": {
            "variable": "index_file",
            "value": "${out_dir}/internal-kb.index"
          },
          "description": "Where the internal knowledge index goes"
        },
        {
          "id": "s18",
          "action": "ooa.knowledge/build_index",
          "args": {
            "files": [
              "${base}/data/RW01/internal_kb"
            ],
            "index_file": "$index_file$"
          },
          "out": {
            "passages": "kb_text"
          },
          "description": "Index the internal knowledge base (words search, no AI model)"
        },
        {
          "id": "s19",
          "action": "ooa.folder/create",
          "args": {
            "path": "${out_dir}/evidence"
          },
          "description": "Folder for the screenshots"
        },
        {
          "id": "s20",
          "action": "ooa.browser/open",
          "args": {
            "browser": "edge",
            "engine": "playwright",
            "headless": {
              "expr": "not $watch$"
            },
            "url": "about:blank",
            "keep_open": false
          },
          "description": "Open Edge (visible, so you can watch)"
        }
      ],
      "description": "2. Prepare"
    },
    {
      "id": "s21",
      "action": "core/step",
      "args": {
        "title": "3. Work through the records"
      },
      "children": [
        {
          "id": "s22",
          "action": "core/comment",
          "args": {
            "text": "For each query: check the site is allowed, open the page, wait for it, extract passages, keep the evidence, look for injected instructions, compare with the internal knowledge base, score and save."
          }
        },
        {
          "id": "s23",
          "action": "core/loop",
          "args": {
            "iterator": "table_rows",
            "over": "$records$",
            "as": "rec",
            "index": "i"
          },
          "children": [
            {
              "id": "s24",
              "action": "core/set",
              "args": {
                "variable": "rec_note",
                "value": ""
              },
              "description": "Clear the note of the previous record"
            },
            {
              "id": "s25",
              "action": "core/try",
              "args": {},
              "children": [
                {
                  "id": "s26",
                  "action": "core/set",
                  "args": {
                    "variable": "qjs",
                    "value": {
                      "expr": "jsonStringify($rec.query$)"
                    }
                  },
                  "description": "The query as a JavaScript string"
                },
                {
                  "id": "s27",
                  "action": "core/comment",
                  "args": {
                    "text": "Policy first: the page's host must be on the allow-list before the browser goes there."
                  }
                },
                {
                  "id": "s28",
                  "action": "ooa.string/extract_text",
                  "args": {
                    "text": "$rec.url$",
                    "after": "://",
                    "before": "/"
                  },
                  "out": {
                    "result": "host"
                  },
                  "description": "Take the host out of the address"
                },
                {
                  "id": "s29",
                  "action": "core/set",
                  "args": {
                    "variable": "host",
                    "value": {
                      "expr": "first(split($host$, ':'))"
                    }
                  },
                  "description": "Without the port"
                },
                {
                  "id": "s30",
                  "action": "core/if",
                  "args": {
                    "condition": {
                      "op": "contains",
                      "left": "$allowed$",
                      "right": "$host$",
                      "ignoreCase": true
                    }
                  },
                  "children": [
                    {
                      "id": "s31",
                      "action": "ooa.browser/navigate",
                      "args": {
                        "url": "$rec.url$"
                      },
                      "description": "Open the page"
                    }
                  ],
                  "description": "Is the host allowed?",
                  "else": [
                    {
                      "id": "s32",
                      "action": "core/throw",
                      "args": {
                        "code": "POLICY.HOST_NOT_ALLOWED",
                        "message": "${host} is not on the allow-list"
                      },
                      "description": "Refuse a host that is not allowed"
                    }
                  ]
                },
                {
                  "id": "s33",
                  "action": "core/switch",
                  "args": {
                    "value": "$rec.site$",
                    "match": "equals",
                    "ignore_case": true
                  },
                  "description": "Extract up to three passages; each site has its own page layout",
                  "cases": [
                    {
                      "values": [
                        "books"
                      ],
                      "children": [
                        {
                          "id": "s34",
                          "action": "ooa.browser/click",
                          "args": {
                            "selector": "a[title=\"${rec.query}\"]",
                            "then_wait_for": "page_load"
                          },
                          "description": "Open the book's page"
                        },
                        {
                          "id": "s35",
                          "action": "ooa.browser/wait_for",
                          "args": {
                            "selector": ".product_main"
                          },
                          "description": "Wait for the product details"
                        },
                        {
                          "id": "s36",
                          "action": "ooa.browser/run_javascript",
                          "args": {
                            "script": "(() => { const m = document.querySelector('.product_main'); const rows = {}; document.querySelectorAll('table.table-striped tr').forEach(r => rows[r.querySelector('th').textContent.trim()] = r.querySelector('td').textContent.trim()); const d = document.querySelector('#product_description + p'); return {title: m.querySelector('h1').textContent.trim(), passages: ['Price ' + m.querySelector('.price_color').textContent.trim(), rows['Availability'] || '', (d ? d.textContent.trim().slice(0, 240) : '')], upc: rows['UPC'] || ''}; })()"
                          },
                          "out": {
                            "result": "page"
                          },
                          "description": "Read price, stock and description"
                        }
                      ]
                    },
                    {
                      "values": [
                        "wikipedia"
                      ],
                      "children": [
                        {
                          "id": "s37",
                          "action": "ooa.browser/wait_for",
                          "args": {
                            "selector": "table.wikitable"
                          },
                          "description": "Wait for the population table"
                        },
                        {
                          "id": "s38",
                          "action": "ooa.browser/run_javascript",
                          "args": {
                            "script": "((q) => { const rows = Array.from(document.querySelectorAll('table.wikitable tbody tr')); const r = rows.find(tr => { const a = tr.querySelector('td a'); return a && a.textContent.trim() === q; }); if (!r) return {title: q, passages: [], upc: ''}; const c = Array.from(r.querySelectorAll('td')).map(td => td.textContent.trim().replace(/\\[.*?\\]/g, '')); return {title: q, passages: ['Population (1 July 2023): ' + c[1], 'Population (1 July 2022): ' + c[2], 'Change: ' + c[3]], upc: ''}; })(${qjs})"
                          },
                          "out": {
                            "result": "page"
                          },
                          "description": "Read the country's population row"
                        }
                      ]
                    },
                    {
                      "values": [
                        "quotes"
                      ],
                      "children": [
                        {
                          "id": "s39",
                          "action": "ooa.browser/wait_for",
                          "args": {
                            "selector": ".quote"
                          },
                          "description": "Wait until the JavaScript has drawn the quotes"
                        },
                        {
                          "id": "s40",
                          "action": "ooa.browser/run_javascript",
                          "args": {
                            "script": "((q) => Array.from(document.querySelectorAll('.quote')).filter(d => d.querySelector('.author').textContent.trim() === q).slice(0, 3).map(d => d.querySelector('.text').textContent.trim()))(${qjs})"
                          },
                          "out": {
                            "result": "passages"
                          },
                          "description": "Read up to three quotes by the author"
                        },
                        {
                          "id": "s41",
                          "action": "core/set",
                          "args": {
                            "variable": "page",
                            "value": {
                              "title": "$rec.query$",
                              "passages": "$passages$",
                              "upc": ""
                            }
                          },
                          "description": "Same shape as the other sites"
                        }
                      ]
                    }
                  ],
                  "default": [
                    {
                      "id": "s42",
                      "action": "ooa.browser/wait_for",
                      "args": {
                        "selector": "body"
                      },
                      "description": "Wait for the page body"
                    },
                    {
                      "id": "s43",
                      "action": "ooa.browser/run_javascript",
                      "args": {
                        "script": "document.body.innerText.slice(0, 600)"
                      },
                      "out": {
                        "result": "facts"
                      },
                      "description": "Read the page text"
                    },
                    {
                      "id": "s44",
                      "action": "core/set",
                      "args": {
                        "variable": "page",
                        "value": {
                          "title": "$rec.query$",
                          "passages": [
                            "$facts$"
                          ],
                          "upc": ""
                        }
                      },
                      "description": "Same shape as the other sites"
                    }
                  ]
                },
                {
                  "id": "s45",
                  "action": "core/comment",
                  "args": {
                    "text": "Evidence the workbook asks for: URL, title, time and a screenshot without credentials."
                  }
                },
                {
                  "id": "s46",
                  "action": "ooa.browser/page_info",
                  "args": {},
                  "out": {
                    "url": "url",
                    "title": "title"
                  },
                  "description": "Read the page's address and title"
                },
                {
                  "id": "s47",
                  "action": "core/set",
                  "args": {
                    "variable": "captured",
                    "value": {
                      "expr": "formatDate(now(), '%Y-%m-%dT%H:%M:%SZ')"
                    }
                  },
                  "description": "Time of capture (UTC)"
                },
                {
                  "id": "s48",
                  "action": "ooa.browser/screenshot",
                  "args": {
                    "path": "${out_dir}/evidence/${rec.key}.png"
                  },
                  "description": "Screenshot of the page"
                },
                {
                  "id": "s49",
                  "action": "core/set",
                  "args": {
                    "variable": "facts",
                    "value": {
                      "expr": "join($page.passages$, ' | ')"
                    }
                  },
                  "description": "Join the passages into one text"
                },
                {
                  "id": "s50",
                  "action": "ooa.string/replace",
                  "args": {
                    "text": "$facts$",
                    "find": "\\s+",
                    "replace_with": " ",
                    "regex": true
                  },
                  "out": {
                    "result": "facts"
                  },
                  "description": "Normalize spaces and line breaks"
                },
                {
                  "id": "s51",
                  "action": "core/comment",
                  "args": {
                    "text": "Page text is untrusted: text that tries to instruct the agent is rejected, never followed."
                  }
                },
                {
                  "id": "s52",
                  "action": "ooa.string/count_occurrences",
                  "args": {
                    "text": {
                      "expr": "lower($facts$)"
                    },
                    "find": "ignore all previous instructions",
                    "match_case": false
                  },
                  "out": {
                    "count": "injected"
                  },
                  "description": "Look for injected instructions"
                },
                {
                  "id": "s53",
                  "action": "core/if",
                  "args": {
                    "condition": "$injected$ > 0"
                  },
                  "children": [
                    {
                      "id": "s54",
                      "action": "ooa.log/write",
                      "args": {
                        "path": "$log_file$",
                        "level": "WARN",
                        "message": "${rec.key}: page text tries to instruct the agent; passages rejected"
                      },
                      "description": "Log the rejected page"
                    },
                    {
                      "id": "s55",
                      "action": "core/throw",
                      "args": {
                        "code": "POLICY.PROMPT_INJECTION",
                        "message": "The page ${url} contains instructions for the agent; its passages are not used"
                      },
                      "description": "Reject the page"
                    }
                  ],
                  "description": "Injected instructions found?"
                },
                {
                  "id": "s56",
                  "action": "ooa.knowledge/search",
                  "args": {
                    "index_file": "$index_file$",
                    "query": "${rec.query} ${rec.topic}",
                    "top_k": 1
                  },
                  "out": {
                    "results": "kb"
                  },
                  "description": "Find what the internal knowledge base says"
                },
                {
                  "id": "s57",
                  "action": "core/set",
                  "args": {
                    "variable": "kb_text",
                    "value": {
                      "expr": "if(len($kb$) > 0, get(first($kb$), 'text'), '')"
                    }
                  },
                  "description": "Best internal passage"
                },
                {
                  "id": "s58",
                  "action": "ooa.fuzzy/similarity",
                  "args": {
                    "text1": {
                      "expr": "coalesce(first($page.passages$), $facts$)"
                    },
                    "text2": "$kb_text$",
                    "algorithm": "token_set"
                  },
                  "out": {
                    "score": "score"
                  },
                  "description": "How close are the key public fact and internal knowledge?"
                },
                {
                  "id": "s59",
                  "action": "core/set",
                  "args": {
                    "variable": "freshness",
                    "value": {
                      "expr": "if($rec.site == 'wikipedia', 'yearly', if($rec.site == 'books', 'live catalogue', 'static'))"
                    }
                  },
                  "description": "Score freshness by source"
                },
                {
                  "id": "s60",
                  "action": "core/set",
                  "args": {
                    "variable": "verdict",
                    "value": {
                      "expr": "if(isEmpty($kb_text$), 'no internal answer', if($score >= 40, 'agrees with KB', 'hold for review: differs from KB'))"
                    }
                  },
                  "description": "Compare with the internal knowledge base"
                },
                {
                  "id": "s61",
                  "action": "ooa.datatable/add_row",
                  "args": {
                    "table": "$evidence$",
                    "values": {
                      "key": "$rec.key$",
                      "case": "$rec.case_key$",
                      "site": "$rec.site$",
                      "url": "$url$",
                      "title": "$title$",
                      "captured": "$captured$",
                      "facts": "$facts$",
                      "kb_match": "$score$",
                      "verdict": "$verdict$",
                      "screenshot": "${out_dir}/evidence/${rec.key}.png"
                    }
                  },
                  "out": {
                    "table": "evidence"
                  },
                  "description": "Add the evidence packet"
                },
                {
                  "id": "s62",
                  "action": "core/set",
                  "args": {
                    "variable": "rec_note",
                    "value": "${verdict} (${freshness})"
                  },
                  "description": "Note for the results table"
                },
                {
                  "id": "s63",
                  "action": "ooa.datatable/add_row",
                  "args": {
                    "table": "$results$",
                    "values": {
                      "key": "$rec.key$",
                      "status": "done",
                      "note": "$rec_note$",
                      "time": "${formatDate(now(), '%H:%M:%S')}"
                    }
                  },
                  "out": {
                    "table": "results"
                  },
                  "description": "Add the record's result to the results table"
                },
                {
                  "id": "s64",
                  "action": "core/set",
                  "args": {
                    "variable": "processed",
                    "value": {
                      "expr": "$processed$ + 1"
                    }
                  },
                  "description": "Count the record as handled"
                },
                {
                  "id": "s65",
                  "action": "core/if",
                  "args": {
                    "condition": "$watch$"
                  },
                  "children": [
                    {
                      "id": "s66",
                      "action": "ooa.desktop/message_box",
                      "args": {
                        "title": "RW01-B2 - record ${rec.key}",
                        "message": "RW01-B2: record ${$i + 1} of ${len($records$)}\n\nSite: ${rec.site}\nQuery: ${rec.query}\nFacts: ${facts}\nVerdict: ${verdict}",
                        "timeout_seconds": 2,
                        "icon": "information",
                        "always_on_top": true
                      },
                      "description": "Message box that closes by itself"
                    }
                  ],
                  "description": "Show what is happening (watch is on)"
                }
              ],
              "description": "Handle one record; a failure is caught below and the next record goes on",
              "catch": [
                {
                  "codes": [
                    "*"
                  ],
                  "children": [
                    {
                      "id": "s67",
                      "action": "core/comment",
                      "args": {
                        "text": "The record failed: keep the reason, count it as an exception and go on with the next one."
                      }
                    },
                    {
                      "id": "s68",
                      "action": "ooa.datatable/add_row",
                      "args": {
                        "table": "$results$",
                        "values": {
                          "key": "$rec.key$",
                          "status": "exception",
                          "note": "${err.code}: ${err_msg}",
                          "time": "${formatDate(now(), '%H:%M:%S')}"
                        }
                      },
                      "out": {
                        "table": "results"
                      },
                      "description": "Add the failure to the results table"
                    },
                    {
                      "id": "s69",
                      "action": "core/set",
                      "args": {
                        "variable": "exceptions",
                        "value": {
                          "expr": "$exceptions$ + 1"
                        }
                      },
                      "description": "Count the exception"
                    },
                    {
                      "id": "s70",
                      "action": "ooa.log/write",
                      "args": {
                        "path": "$log_file$",
                        "level": "WARN",
                        "message": "Record ${rec.key}: ${err.code} ${err_msg}"
                      },
                      "description": "Log the exception"
                    },
                    {
                      "id": "s71",
                      "action": "core/if",
                      "args": {
                        "condition": "$watch$"
                      },
                      "children": [
                        {
                          "id": "s72",
                          "action": "ooa.desktop/message_box",
                          "args": {
                            "title": "RW01-B2 - exception",
                            "message": "RW01-B2: record ${rec.key} went to the exception list\n\n${err.code}: ${err_msg}",
                            "timeout_seconds": 3,
                            "icon": "warning",
                            "always_on_top": true
                          },
                          "description": "Message box that closes by itself"
                        }
                      ],
                      "description": "Show what is happening (watch is on)"
                    }
                  ],
                  "as": "err",
                  "message_to": "err_msg"
                }
              ]
            },
            {
              "id": "s73",
              "action": "core/if",
              "args": {
                "condition": "$watch$"
              },
              "children": [
                {
                  "id": "s74",
                  "action": "core/delay",
                  "args": {
                    "seconds": "$pause_seconds$"
                  },
                  "description": "Short pause"
                }
              ],
              "description": "Pause so the screen can be followed (watch is on)"
            }
          ],
          "description": "Once for each of the 10 product/reference queries"
        }
      ],
      "description": "3. Work through the records"
    },
    {
      "id": "s75",
      "action": "core/step",
      "args": {
        "title": "4. Finish"
      },
      "children": [
        {
          "id": "s76",
          "action": "core/comment",
          "args": {
            "text": "Save the results, set the outputs and say how it went."
          }
        },
        {
          "id": "s77",
          "action": "ooa.browser/close",
          "args": {
            "what": "session"
          },
          "description": "Close the browser"
        },
        {
          "id": "s78",
          "action": "core/set",
          "args": {
            "variable": "evidence_file",
            "value": "${out_dir}/evidence.csv"
          },
          "description": "Name of the evidence file"
        },
        {
          "id": "s79",
          "action": "ooa.datatable/write_to_file",
          "args": {
            "table": "$evidence$",
            "path": "$evidence_file$"
          },
          "description": "Save the evidence packets"
        },
        {
          "id": "s80",
          "action": "ooa.file/write_text",
          "args": {
            "path": "${out_dir}/summary.js",
            "text": "// Summarizes the research verdicts (JSON lines on standard input). Works with Node.js and with Windows' JScript.\nvar text = (typeof WScript !== 'undefined') ? WScript.StdIn.ReadAll() : require('fs').readFileSync(0, 'utf8');\nvar lines = text.split(/\\r?\\n/), agree = 0, hold = 0, none = 0;\nfor (var i = 1; i < lines.length; i++) {\n  if (!lines[i]) continue;\n  if (lines[i].indexOf('agrees with KB') >= 0) agree++; else if (lines[i].indexOf('hold for review') >= 0) hold++; else none++;\n}\nvar out = '{\"agree\": ' + agree + ', \"hold\": ' + hold + ', \"other\": ' + none + '}';\nif (typeof WScript !== 'undefined') WScript.Echo(out); else console.log(out);\n"
          },
          "description": "A small JavaScript that sums up the verdicts"
        },
        {
          "id": "s81",
          "action": "ooa.datatable/to_csv_text",
          "args": {
            "table": "$evidence$"
          },
          "out": {
            "text": "csv_text"
          },
          "description": "The evidence as text"
        },
        {
          "id": "s82",
          "action": "ooa.script/run_javascript",
          "args": {
            "file": "${out_dir}/summary.js",
            "input": "$csv_text$"
          },
          "out": {
            "json": "js_summary"
          },
          "description": "Sum up the verdicts (JavaScript: Node.js, or Windows JScript)"
        },
        {
          "id": "s83",
          "action": "ooa.log/write",
          "args": {
            "path": "$log_file$",
            "message": "Verdicts: ${jsonStringify($js_summary$)}"
          },
          "description": "Log the summary"
        },
        {
          "id": "s84",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s85",
              "action": "ooa.browser/open",
              "args": {
                "url": "https://books.toscrape.com/",
                "session": "webagent",
                "headless": {
                  "expr": "not $watch$"
                },
                "engine": "playwright",
                "keep_open": true
              },
              "description": "A browser session for the web goal agent"
            },
            {
              "id": "s86",
              "action": "ooa.web_agent/run",
              "args": {
                "start_url": "https://books.toscrape.com/",
                "goal": "Open the catalogue and report the title and price of the first book listed.",
                "allowed_sites": [
                  "books.toscrape.com"
                ],
                "max_steps": 3,
                "model": "qa-scripted",
                "api_key": {
                  "$credential": "rw_qa_standins/ai/token"
                },
                "base_url": "${standin}/v1",
                "session": "webagent"
              },
              "out": {
                "success": "wa_ok",
                "answer": "wa_answer"
              },
              "description": "Ask the web goal agent to read the catalogue's first book"
            },
            {
              "id": "s87",
              "action": "ooa.browser/close",
              "args": {
                "session": "webagent"
              },
              "continueOnError": true,
              "description": "Close its browser"
            }
          ],
          "description": "Web goal agent: the model works the public catalogue page itself (stand-in model, live site)",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s88",
                  "action": "ooa.log/write",
                  "args": {
                    "path": "$log_file$",
                    "level": "WARN",
                    "message": "Web goal agent: ${wa_answer}"
                  },
                  "description": "Note the web agent's problem"
                }
              ],
              "message_to": "wa_answer"
            }
          ]
        },
        {
          "id": "s89",
          "action": "ooa.log/write",
          "args": {
            "path": "$log_file$",
            "message": "Web goal agent (${wa_ok}): ${wa_answer}"
          },
          "description": "Log the web agent's answer"
        },
        {
          "id": "s90",
          "action": "core/set",
          "args": {
            "variable": "result_file",
            "value": "${out_dir}/results.csv"
          },
          "description": "Name of the results file"
        },
        {
          "id": "s91",
          "action": "ooa.datatable/write_to_file",
          "args": {
            "table": "$results$",
            "path": "$result_file$"
          },
          "description": "Save one row per record"
        },
        {
          "id": "s92",
          "action": "core/set",
          "args": {
            "variable": "status",
            "value": "success"
          },
          "description": "Every record was handled (exceptions are routed, not lost)"
        },
        {
          "id": "s93",
          "action": "ooa.log/write",
          "args": {
            "path": "$log_file$",
            "message": "RW01-B2 Public knowledge research finished: ${processed} handled, ${exceptions} exceptions"
          },
          "description": "Log the end"
        },
        {
          "id": "s94",
          "action": "core/if",
          "args": {
            "condition": "$watch$"
          },
          "children": [
            {
              "id": "s95",
              "action": "ooa.desktop/message_box",
              "args": {
                "title": "RW01-B2 finished",
                "message": "RW01-B2 Public knowledge research finished\n\nHandled: ${processed}\nExceptions: ${exceptions}\nResults: ${result_file}",
                "timeout_seconds": 4,
                "icon": "information",
                "always_on_top": true
              },
              "description": "Message box that closes by itself"
            }
          ],
          "description": "Show what is happening (watch is on)"
        }
      ],
      "description": "4. Finish"
    }
  ]
}
