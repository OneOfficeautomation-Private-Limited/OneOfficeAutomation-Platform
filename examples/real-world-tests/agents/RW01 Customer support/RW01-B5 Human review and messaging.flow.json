{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "rw01_b5",
  "name": "RW01-B5 Human review and messaging",
  "description": "RW01-B5 (RW01 real-world test). Builds each reply from the approved template and the case's facts, scans it for personal data, checks the approval and the separation of duties, sends only approved replies only to the QA mailbox, reconciles the sent message and logs the decision.",
  "tags": [
    "real-world-test",
    "RW01"
  ],
  "variables": [
    {
      "name": "base",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Real-world tests",
      "description": "Folder of the real-world tests: data, output and the stand-in server."
    },
    {
      "name": "run_id",
      "type": "String",
      "direction": "input",
      "default": "",
      "description": "Run id shared by a main agent and its children; made here when empty."
    },
    {
      "name": "standin",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local QA stand-in server (127.0.0.1 only)."
    },
    {
      "name": "watch",
      "type": "Boolean",
      "direction": "input",
      "default": true,
      "description": "Show message boxes and pause between records so a person can follow the run."
    },
    {
      "name": "pause_seconds",
      "type": "Number",
      "direction": "input",
      "default": 1,
      "description": "Pause after each record when watch is on."
    },
    {
      "name": "fault_profile",
      "type": "String",
      "direction": "input",
      "default": "none",
      "description": "none, or resilience: the stand-ins inject the five failures of runbook step 09."
    },
    {
      "name": "info",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "out_dir",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "log_file",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "records",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "rec",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "i",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "err",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "err_msg",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "rec_status",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "rec_note",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "started",
      "type": "DateTime",
      "direction": "local"
    },
    {
      "name": "results",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "key",
          "status",
          "note",
          "time"
        ],
        "rows": []
      }
    },
    {
      "name": "processed",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Records handled without an error."
    },
    {
      "name": "exceptions",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Records routed to the exception list."
    },
    {
      "name": "status",
      "type": "String",
      "direction": "output",
      "default": "not_run",
      "description": "success when every record was handled (routed exceptions included)."
    },
    {
      "name": "result_file",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "CSV file with one row per record."
    },
    {
      "name": "template",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "reply",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "customers",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "cases",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "account",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "name",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "pii",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "decision",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "got",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "seen",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "evidence",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "key",
          "case",
          "to",
          "decision",
          "approver",
          "sent",
          "delivered"
        ],
        "rows": []
      }
    },
    {
      "name": "evidence_file",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "Evidence rows of this agent (one per record)."
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "1. Start"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "What this agent does: Builds each reply from the approved template and the case's facts, scans it for personal data, checks the approval and the separation of duties, sends only approved replies only to the QA mailbox, reconciles the sent message and logs the decision. It works through 10 response drafts and writes its results to the run's output folder."
          }
        },
        {
          "id": "s3",
          "action": "ooa.run_context/get",
          "args": {},
          "out": {
            "info": "info"
          },
          "description": "Read the run context (run id, runner, user)"
        },
        {
          "id": "s4",
          "action": "core/set",
          "args": {
            "variable": "started",
            "value": {
              "expr": "now()"
            }
          },
          "description": "Remember when the agent started"
        },
        {
          "id": "s5",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "empty",
              "left": "$run_id$"
            }
          },
          "children": [
            {
              "id": "s6",
              "action": "core/set",
              "args": {
                "variable": "run_id",
                "value": "SOLO-${formatDate(now(), '%Y%m%d-%H%M%S')}"
              },
              "description": "Run id for a run on its own"
            }
          ],
          "description": "Running on its own: make a run id"
        },
        {
          "id": "s7",
          "action": "core/set",
          "args": {
            "variable": "out_dir",
            "value": "${base}/output/${run_id}/RW01-B5"
          },
          "description": "This agent's output folder for the run"
        },
        {
          "id": "s8",
          "action": "ooa.folder/create",
          "args": {
            "path": "$out_dir$"
          },
          "description": "Create the output folder"
        },
        {
          "id": "s9",
          "action": "core/set",
          "args": {
            "variable": "log_file",
            "value": "${out_dir}/log.txt"
          },
          "description": "Log file of this agent"
        },
        {
          "id": "s10",
          "action": "ooa.log/write",
          "args": {
            "path": "$log_file$",
            "message": "RW01-B5 Human review and messaging started; run ${run_id}; computer ${info.device}, user ${info.os_user}"
          },
          "description": "Log the start"
        },
        {
          "id": "s11",
          "action": "core/if",
          "args": {
            "condition": "$watch$"
          },
          "children": [
            {
              "id": "s12",
              "action": "ooa.desktop/message_box",
              "args": {
                "title": "RW01-B5 starts",
                "message": "RW01-B5 Human review and messaging\n\nBuilds each reply from the approved template and the case's facts, scans it for personal data, checks the approval and the separation of duties, sends only approved replies only to the QA mailbox, reconciles the sent message and logs the decision.\n\nRecords: 10 response drafts\nRun: ${run_id}",
                "timeout_seconds": 4,
                "icon": "information",
                "always_on_top": true
              },
              "description": "Message box that closes by itself"
            }
          ],
          "description": "Show what is happening (watch is on)"
        }
      ],
      "description": "1. Start"
    },
    {
      "id": "s13",
      "action": "core/step",
      "args": {
        "title": "2. Prepare"
      },
      "children": [
        {
          "id": "s14",
          "action": "core/comment",
          "args": {
            "text": "Read the approved reply template, the cases and the customers."
          }
        },
        {
          "id": "s15",
          "action": "ooa.csv/read",
          "args": {
            "path": "${base}/data/RW01/replies.csv"
          },
          "out": {
            "table": "records"
          },
          "description": "Read the test records (RW01/replies.csv)"
        },
        {
          "id": "s16",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "ne",
              "left": "$fault_profile$",
              "right": "none"
            }
          },
          "children": [
            {
              "id": "s17",
              "action": "ooa.rest/request",
              "args": {
                "method": "POST",
                "url": "${standin}/qa/faults",
                "json": {
                  "service": "graph",
                  "profile": "$fault_profile$",
                  "run_id": "$run_id$"
                }
              },
              "description": "Arm the stand-in's injected faults for this service"
            }
          ],
          "description": "Resilience run: arm the stand-in's faults"
        },
        {
          "id": "s18",
          "action": "ooa.file/read_text",
          "args": {
            "path": "${base}/data/RW01/reply_template.txt"
          },
          "out": {
            "text": "template"
          },
          "description": "Read the approved template"
        },
        {
          "id": "s19",
          "action": "ooa.csv/read",
          "args": {
            "path": "${base}/data/RW01/cases.csv"
          },
          "out": {
            "table": "cases"
          },
          "description": "Read the cases"
        },
        {
          "id": "s20",
          "action": "ooa.csv/read",
          "args": {
            "path": "${base}/data/RW01/customers.csv"
          },
          "out": {
            "table": "customers"
          },
          "description": "Read the customers"
        }
      ],
      "description": "2. Prepare"
    },
    {
      "id": "s21",
      "action": "core/step",
      "args": {
        "title": "3. Work through the records"
      },
      "children": [
        {
          "id": "s22",
          "action": "core/comment",
          "args": {
            "text": "Per draft: fill the template, scan for personal data, check approval and separation of duties, allow only QA recipients, send, reconcile and log."
          }
        },
        {
          "id": "s23",
          "action": "core/loop",
          "args": {
            "iterator": "table_rows",
            "over": "$records$",
            "as": "rec",
            "index": "i"
          },
          "children": [
            {
              "id": "s24",
              "action": "core/set",
              "args": {
                "variable": "rec_note",
                "value": ""
              },
              "description": "Clear the note of the previous record"
            },
            {
              "id": "s25",
              "action": "core/try",
              "args": {},
              "children": [
                {
                  "id": "s26",
                  "action": "ooa.datatable/lookup",
                  "args": {
                    "table": "$cases$",
                    "column": "key",
                    "value": "$rec.case_key$",
                    "return_column": "account",
                    "if_not_found": ""
                  },
                  "out": {
                    "value": "account"
                  },
                  "description": "The case's account"
                },
                {
                  "id": "s27",
                  "action": "ooa.datatable/lookup",
                  "args": {
                    "table": "$customers$",
                    "column": "account",
                    "value": "$account$",
                    "return_column": "name",
                    "if_not_found": "Customer"
                  },
                  "out": {
                    "value": "name"
                  },
                  "description": "The customer's name"
                },
                {
                  "id": "s28",
                  "action": "ooa.string/replace",
                  "args": {
                    "text": "$template$",
                    "find": "{name}",
                    "replace_with": "$name$"
                  },
                  "out": {
                    "result": "reply"
                  },
                  "description": "Fill in the name"
                },
                {
                  "id": "s29",
                  "action": "ooa.string/replace",
                  "args": {
                    "text": "$reply$",
                    "find": "{case}",
                    "replace_with": "$rec.case_key$"
                  },
                  "out": {
                    "result": "reply"
                  },
                  "description": "Fill in the case"
                },
                {
                  "id": "s30",
                  "action": "ooa.string/replace",
                  "args": {
                    "text": {
                      "expr": "replace($reply$, '{severity}', $rec.severity$)"
                    },
                    "find": "{type}",
                    "replace_with": "$rec.type$"
                  },
                  "out": {
                    "result": "reply"
                  },
                  "description": "Fill in severity and type"
                },
                {
                  "id": "s31",
                  "action": "ooa.string/replace",
                  "args": {
                    "text": {
                      "expr": "replace($reply$, '{group}', 'OOA-QA Support')"
                    },
                    "find": "{hours}",
                    "replace_with": "24"
                  },
                  "out": {
                    "result": "reply"
                  },
                  "description": "Fill in team and hours"
                },
                {
                  "id": "s32",
                  "action": "ooa.string/replace",
                  "args": {
                    "text": "$reply$",
                    "find": "{facts}",
                    "replace_with": "Our records for case ${rec.case_key} are attached to the ticket."
                  },
                  "out": {
                    "result": "reply"
                  },
                  "description": "Fill in the facts"
                },
                {
                  "id": "s33",
                  "action": "ooa.string/count_occurrences",
                  "args": {
                    "text": {
                      "expr": "replace($reply$, ' ', '')"
                    },
                    "find": "4111111111111111"
                  },
                  "out": {
                    "count": "pii"
                  },
                  "description": "Scan for card numbers left in the text"
                },
                {
                  "id": "s34",
                  "action": "core/if",
                  "args": {
                    "condition": "$pii$ > 0"
                  },
                  "children": [
                    {
                      "id": "s35",
                      "action": "core/throw",
                      "args": {
                        "code": "POLICY.PII_IN_REPLY",
                        "message": "The reply for ${rec.case_key} contains a card number"
                      },
                      "description": "Hold it"
                    }
                  ],
                  "description": "Personal data in the reply?"
                },
                {
                  "id": "s36",
                  "action": "core/if",
                  "args": {
                    "condition": {
                      "op": "eq",
                      "left": "$rec.approver$",
                      "right": "agent"
                    }
                  },
                  "children": [
                    {
                      "id": "s37",
                      "action": "core/throw",
                      "args": {
                        "code": "POLICY.SEPARATION_OF_DUTIES",
                        "message": "The reply for ${rec.case_key} needs a reviewer other than the agent"
                      },
                      "description": "Enforce separation of duties"
                    }
                  ],
                  "description": "Would the agent approve its own reply?"
                },
                {
                  "id": "s38",
                  "action": "core/set",
                  "args": {
                    "variable": "decision",
                    "value": "$rec.decision$"
                  },
                  "description": "The approver's decision"
                },
                {
                  "id": "s39",
                  "action": "core/set",
                  "args": {
                    "variable": "seen",
                    "value": 0
                  },
                  "description": "Nothing sent yet"
                },
                {
                  "id": "s40",
                  "action": "core/if",
                  "args": {
                    "condition": {
                      "op": "eq",
                      "left": "$decision$",
                      "right": "decline"
                    }
                  },
                  "children": [
                    {
                      "id": "s41",
                      "action": "ooa.log/write",
                      "args": {
                        "path": "$log_file$",
                        "message": "${rec.case_key}: declined by ${rec.approver}; not sent"
                      },
                      "description": "Log the decline (nothing is sent)"
                    }
                  ],
                  "description": "Declined?",
                  "else": [
                    {
                      "id": "s42",
                      "action": "core/if",
                      "args": {
                        "condition": "not endsWith(lower($rec.to$), '@ooa-qa.test')"
                      },
                      "children": [
                        {
                          "id": "s43",
                          "action": "core/throw",
                          "args": {
                            "code": "POLICY.EXTERNAL_RECIPIENT",
                            "message": "${rec.to} is outside the QA tenant; not sent"
                          },
                          "description": "Block an outside recipient"
                        }
                      ],
                      "description": "Only the QA tenant's addresses"
                    },
                    {
                      "id": "s44",
                      "action": "ooa.microsoft365/send_mail",
                      "args": {
                        "to": "$rec.to$",
                        "subject": "OOA-QA ${run_id} Re: case ${rec.case_key}",
                        "body": "$reply$",
                        "access_token": {
                          "$credential": "rw_qa_standins/graph/token"
                        },
                        "base_url": "${standin}/graph/v1.0",
                        "mailbox": "qa-support@ooa-qa.test"
                      },
                      "description": "Send the approved reply to the QA mailbox"
                    },
                    {
                      "id": "s45",
                      "action": "ooa.microsoft365/list_mail",
                      "args": {
                        "folder": "inbox",
                        "subject_contains": "OOA-QA ${run_id} Re: case ${rec.case_key}",
                        "max_results": 5,
                        "access_token": {
                          "$credential": "rw_qa_standins/graph/token"
                        },
                        "base_url": "${standin}/graph/v1.0",
                        "mailbox": "$rec.to$"
                      },
                      "out": {
                        "table": "got",
                        "count": "seen"
                      },
                      "description": "Reconcile: find it in the recipient's mailbox"
                    },
                    {
                      "id": "s46",
                      "action": "core/if",
                      "args": {
                        "condition": "$seen$ == 0"
                      },
                      "children": [
                        {
                          "id": "s47",
                          "action": "core/throw",
                          "args": {
                            "code": "VERIFY.NOT_DELIVERED",
                            "message": "The reply for ${rec.case_key} did not arrive"
                          },
                          "description": "Report it"
                        }
                      ],
                      "description": "Not delivered?"
                    }
                  ]
                },
                {
                  "id": "s48",
                  "action": "ooa.log/write",
                  "args": {
                    "path": "$log_file$",
                    "message": "${rec.case_key}: ${decision} by ${rec.approver}; delivered ${seen}"
                  },
                  "description": "Log the approval decision"
                },
                {
                  "id": "s49",
                  "action": "ooa.datatable/add_row",
                  "args": {
                    "table": "$evidence$",
                    "values": {
                      "key": "$rec.key$",
                      "case": "$rec.case_key$",
                      "to": "$rec.to$",
                      "decision": "$decision$",
                      "approver": "$rec.approver$",
                      "sent": {
                        "expr": "$decision$ == 'approve'"
                      },
                      "delivered": "$seen$"
                    }
                  },
                  "out": {
                    "table": "evidence"
                  },
                  "description": "Record the result"
                },
                {
                  "id": "s50",
                  "action": "core/set",
                  "args": {
                    "variable": "rec_note",
                    "value": "${decision}; delivered ${seen}"
                  },
                  "description": "Note for the results"
                },
                {
                  "id": "s51",
                  "action": "ooa.datatable/add_row",
                  "args": {
                    "table": "$results$",
                    "values": {
                      "key": "$rec.key$",
                      "status": "done",
                      "note": "$rec_note$",
                      "time": "${formatDate(now(), '%H:%M:%S')}"
                    }
                  },
                  "out": {
                    "table": "results"
                  },
                  "description": "Add the record's result to the results table"
                },
                {
                  "id": "s52",
                  "action": "core/set",
                  "args": {
                    "variable": "processed",
                    "value": {
                      "expr": "$processed$ + 1"
                    }
                  },
                  "description": "Count the record as handled"
                },
                {
                  "id": "s53",
                  "action": "core/if",
                  "args": {
                    "condition": "$watch$"
                  },
                  "children": [
                    {
                      "id": "s54",
                      "action": "ooa.desktop/message_box",
                      "args": {
                        "title": "RW01-B5 - record ${rec.key}",
                        "message": "RW01-B5: record ${$i + 1} of ${len($records$)}\n\nTo ${rec.to}: ${decision}",
                        "timeout_seconds": 2,
                        "icon": "information",
                        "always_on_top": true
                      },
                      "description": "Message box that closes by itself"
                    }
                  ],
                  "description": "Show what is happening (watch is on)"
                }
              ],
              "description": "Handle one record; a failure is caught below and the next record goes on",
              "catch": [
                {
                  "codes": [
                    "*"
                  ],
                  "children": [
                    {
                      "id": "s55",
                      "action": "core/comment",
                      "args": {
                        "text": "The record failed: keep the reason, count it as an exception and go on with the next one."
                      }
                    },
                    {
                      "id": "s56",
                      "action": "ooa.datatable/add_row",
                      "args": {
                        "table": "$results$",
                        "values": {
                          "key": "$rec.key$",
                          "status": "exception",
                          "note": "${err.code}: ${err_msg}",
                          "time": "${formatDate(now(), '%H:%M:%S')}"
                        }
                      },
                      "out": {
                        "table": "results"
                      },
                      "description": "Add the failure to the results table"
                    },
                    {
                      "id": "s57",
                      "action": "core/set",
                      "args": {
                        "variable": "exceptions",
                        "value": {
                          "expr": "$exceptions$ + 1"
                        }
                      },
                      "description": "Count the exception"
                    },
                    {
                      "id": "s58",
                      "action": "ooa.log/write",
                      "args": {
                        "path": "$log_file$",
                        "level": "WARN",
                        "message": "Record ${rec.key}: ${err.code} ${err_msg}"
                      },
                      "description": "Log the exception"
                    },
                    {
                      "id": "s59",
                      "action": "core/if",
                      "args": {
                        "condition": "$watch$"
                      },
                      "children": [
                        {
                          "id": "s60",
                          "action": "ooa.desktop/message_box",
                          "args": {
                            "title": "RW01-B5 - exception",
                            "message": "RW01-B5: record ${rec.key} went to the exception list\n\n${err.code}: ${err_msg}",
                            "timeout_seconds": 3,
                            "icon": "warning",
                            "always_on_top": true
                          },
                          "description": "Message box that closes by itself"
                        }
                      ],
                      "description": "Show what is happening (watch is on)"
                    }
                  ],
                  "as": "err",
                  "message_to": "err_msg"
                }
              ]
            },
            {
              "id": "s61",
              "action": "core/if",
              "args": {
                "condition": "$watch$"
              },
              "children": [
                {
                  "id": "s62",
                  "action": "core/delay",
                  "args": {
                    "seconds": "$pause_seconds$"
                  },
                  "description": "Short pause"
                }
              ],
              "description": "Pause so the screen can be followed (watch is on)"
            }
          ],
          "description": "Once for each of the 10 response drafts"
        }
      ],
      "description": "3. Work through the records"
    },
    {
      "id": "s63",
      "action": "core/step",
      "args": {
        "title": "4. Finish"
      },
      "children": [
        {
          "id": "s64",
          "action": "core/comment",
          "args": {
            "text": "Save the results, set the outputs and say how it went."
          }
        },
        {
          "id": "s65",
          "action": "core/set",
          "args": {
            "variable": "evidence_file",
            "value": "${out_dir}/evidence.csv"
          },
          "description": "Name of the evidence file"
        },
        {
          "id": "s66",
          "action": "ooa.datatable/write_to_file",
          "args": {
            "table": "$evidence$",
            "path": "$evidence_file$"
          },
          "description": "Save the evidence rows"
        },
        {
          "id": "s67",
          "action": "core/set",
          "args": {
            "variable": "result_file",
            "value": "${out_dir}/results.csv"
          },
          "description": "Name of the results file"
        },
        {
          "id": "s68",
          "action": "ooa.datatable/write_to_file",
          "args": {
            "table": "$results$",
            "path": "$result_file$"
          },
          "description": "Save one row per record"
        },
        {
          "id": "s69",
          "action": "core/set",
          "args": {
            "variable": "status",
            "value": "success"
          },
          "description": "Every record was handled (exceptions are routed, not lost)"
        },
        {
          "id": "s70",
          "action": "ooa.log/write",
          "args": {
            "path": "$log_file$",
            "message": "RW01-B5 Human review and messaging finished: ${processed} handled, ${exceptions} exceptions"
          },
          "description": "Log the end"
        },
        {
          "id": "s71",
          "action": "core/if",
          "args": {
            "condition": "$watch$"
          },
          "children": [
            {
              "id": "s72",
              "action": "ooa.desktop/message_box",
              "args": {
                "title": "RW01-B5 finished",
                "message": "RW01-B5 Human review and messaging finished\n\nHandled: ${processed}\nExceptions: ${exceptions}\nResults: ${result_file}",
                "timeout_seconds": 4,
                "icon": "information",
                "always_on_top": true
              },
              "description": "Message box that closes by itself"
            }
          ],
          "description": "Show what is happening (watch is on)"
        }
      ],
      "description": "4. Finish"
    }
  ]
}
