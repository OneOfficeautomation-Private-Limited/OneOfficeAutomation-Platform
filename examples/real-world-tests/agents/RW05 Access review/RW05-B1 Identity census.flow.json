{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "rw05_b1",
  "name": "RW05-B1 Identity census",
  "description": "RW05-B1 (RW05 real-world test). Pages through the QA principals in Entra ID (and AD when a test domain is given), normalizes their immutable ids, reads enabled state, groups and last sign-in, expands nested groups with a cycle limit, tags stale access, masks attributes, stores a hashed snapshot in the review database and fails closed for anyone outside the QA OU.",
  "tags": [
    "real-world-test",
    "RW05"
  ],
  "variables": [
    {
      "name": "base",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Real-world tests",
      "description": "Folder of the real-world tests: data, output and the stand-in server."
    },
    {
      "name": "run_id",
      "type": "String",
      "direction": "input",
      "default": "",
      "description": "Run id shared by a main agent and its children; made here when empty."
    },
    {
      "name": "standin",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local QA stand-in server (127.0.0.1 only)."
    },
    {
      "name": "watch",
      "type": "Boolean",
      "direction": "input",
      "default": true,
      "description": "Show message boxes and pause between records so a person can follow the run."
    },
    {
      "name": "pause_seconds",
      "type": "Number",
      "direction": "input",
      "default": 1,
      "description": "Pause after each record when watch is on."
    },
    {
      "name": "fault_profile",
      "type": "String",
      "direction": "input",
      "default": "none",
      "description": "none, or resilience: the stand-ins inject the five failures of runbook step 09."
    },
    {
      "name": "info",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "out_dir",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "log_file",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "records",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "rec",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "i",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "err",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "err_msg",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "rec_status",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "rec_note",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "started",
      "type": "DateTime",
      "direction": "local"
    },
    {
      "name": "results",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "key",
          "status",
          "note",
          "time"
        ],
        "rows": []
      }
    },
    {
      "name": "processed",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Records handled without an error."
    },
    {
      "name": "exceptions",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Records routed to the exception list."
    },
    {
      "name": "status",
      "type": "String",
      "direction": "output",
      "default": "not_run",
      "description": "success when every record was handled (routed exceptions included)."
    },
    {
      "name": "result_file",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "CSV file with one row per record."
    },
    {
      "name": "ad_server",
      "type": "String",
      "direction": "input",
      "default": "",
      "description": "LDAP address of an isolated QA domain (ldaps://...); empty: AD is skipped (no test domain here)."
    },
    {
      "name": "stale_days",
      "type": "Number",
      "direction": "input",
      "default": 90,
      "description": "No sign-in for more than this many days is stale."
    },
    {
      "name": "url",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "page",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "all",
      "type": "List",
      "direction": "local",
      "default": []
    },
    {
      "name": "pages",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "groups",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "gname",
      "type": "Dictionary",
      "direction": "local",
      "default": {}
    },
    {
      "name": "gi",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "u",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "mo",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "direct",
      "type": "List",
      "direction": "local",
      "default": []
    },
    {
      "name": "queue",
      "type": "List",
      "direction": "local",
      "default": []
    },
    {
      "name": "qi",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "gid",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "seen",
      "type": "List",
      "direction": "local",
      "default": []
    },
    {
      "name": "cycles",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "parents",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "pg",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "effective",
      "type": "List",
      "direction": "local",
      "default": []
    },
    {
      "name": "days",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "stale",
      "type": "Boolean",
      "direction": "local",
      "default": false
    },
    {
      "name": "masked",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "immutable",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "snap",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "hash",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "ad",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "db",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "evidence",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "key",
          "upn",
          "immutable_id",
          "enabled",
          "manager",
          "last_sign_in",
          "days",
          "stale",
          "direct_groups",
          "effective_groups",
          "cycles",
          "masked",
          "hash"
        ],
        "rows": []
      }
    },
    {
      "name": "evidence_file",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "Evidence rows of this agent (one per record)."
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "1. Start"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "What this agent does: Pages through the QA principals in Entra ID (and AD when a test domain is given), normalizes their immutable ids, reads enabled state, groups and last sign-in, expands nested groups with a cycle limit, tags stale access, masks attributes, stores a hashed snapshot in the review database and fails closed for anyone outside the QA OU. It works through 10 synthetic identities and writes its results to the run's output folder."
          }
        },
        {
          "id": "s3",
          "action": "ooa.run_context/get",
          "args": {},
          "out": {
            "info": "info"
          },
          "description": "Read the run context (run id, runner, user)"
        },
        {
          "id": "s4",
          "action": "core/set",
          "args": {
            "variable": "started",
            "value": {
              "expr": "now()"
            }
          },
          "description": "Remember when the agent started"
        },
        {
          "id": "s5",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "empty",
              "left": "$run_id$"
            }
          },
          "children": [
            {
              "id": "s6",
              "action": "core/set",
              "args": {
                "variable": "run_id",
                "value": "SOLO-${formatDate(now(), '%Y%m%d-%H%M%S')}"
              },
              "description": "Run id for a run on its own"
            }
          ],
          "description": "Running on its own: make a run id"
        },
        {
          "id": "s7",
          "action": "core/set",
          "args": {
            "variable": "out_dir",
            "value": "${base}/output/${run_id}/RW05-B1"
          },
          "description": "This agent's output folder for the run"
        },
        {
          "id": "s8",
          "action": "ooa.folder/create",
          "args": {
            "path": "$out_dir$"
          },
          "description": "Create the output folder"
        },
        {
          "id": "s9",
          "action": "core/set",
          "args": {
            "variable": "log_file",
            "value": "${out_dir}/log.txt"
          },
          "description": "Log file of this agent"
        },
        {
          "id": "s10",
          "action": "ooa.log/write",
          "args": {
            "path": "$log_file$",
            "message": "RW05-B1 Identity census started; run ${run_id}; computer ${info.device}, user ${info.os_user}"
          },
          "description": "Log the start"
        },
        {
          "id": "s11",
          "action": "core/if",
          "args": {
            "condition": "$watch$"
          },
          "children": [
            {
              "id": "s12",
              "action": "ooa.desktop/message_box",
              "args": {
                "title": "RW05-B1 starts",
                "message": "RW05-B1 Identity census\n\nPages through the QA principals in Entra ID (and AD when a test domain is given), normalizes their immutable ids, reads enabled state, groups and last sign-in, expands nested groups with a cycle limit, tags stale access, masks attributes, stores a hashed snapshot in the review database and fails closed for anyone outside the QA OU.\n\nRecords: 10 synthetic identities\nRun: ${run_id}",
                "timeout_seconds": 4,
                "icon": "information",
                "always_on_top": true
              },
              "description": "Message box that closes by itself"
            }
          ],
          "description": "Show what is happening (watch is on)"
        }
      ],
      "description": "1. Start"
    },
    {
      "id": "s13",
      "action": "core/step",
      "args": {
        "title": "2. Prepare"
      },
      "children": [
        {
          "id": "s14",
          "action": "core/comment",
          "args": {
            "text": "Page through the QA principals (4 per page), read the group names, open the review database; AD only with a test domain."
          }
        },
        {
          "id": "s15",
          "action": "ooa.csv/read",
          "args": {
            "path": "${base}/data/RW05/principals.csv"
          },
          "out": {
            "table": "records"
          },
          "description": "Read the test records (RW05/principals.csv)"
        },
        {
          "id": "s16",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "ne",
              "left": "$fault_profile$",
              "right": "none"
            }
          },
          "children": [
            {
              "id": "s17",
              "action": "ooa.rest/request",
              "args": {
                "method": "POST",
                "url": "${standin}/qa/faults",
                "json": {
                  "service": "graph",
                  "profile": "$fault_profile$",
                  "run_id": "$run_id$"
                }
              },
              "description": "Arm the stand-in's injected faults for this service"
            }
          ],
          "description": "Resilience run: arm the stand-in's faults"
        },
        {
          "id": "s18",
          "action": "core/set",
          "args": {
            "variable": "url",
            "value": "${standin}/graph/v1.0/users?$top=4&$filter=startswith(userPrincipalName,'qa.')"
          },
          "description": "First page of QA principals"
        },
        {
          "id": "s19",
          "action": "core/loop",
          "args": {
            "iterator": "while",
            "condition": "not isEmpty($url$)",
            "max_iterations": 20
          },
          "children": [
            {
              "id": "s20",
              "action": "ooa.rest/request",
              "args": {
                "url": "$url$",
                "bearer_token": {
                  "$credential": "rw_qa_standins/graph/token"
                }
              },
              "out": {
                "json": "page"
              },
              "retry": {
                "max": 3,
                "backoff": "exponential",
                "delayMs": 1000
              },
              "description": "Read a page"
            },
            {
              "id": "s21",
              "action": "ooa.list/append_list",
              "args": {
                "list": "$all$",
                "other": "$page.value$"
              },
              "out": {
                "list": "all"
              },
              "description": "Add its principals"
            },
            {
              "id": "s22",
              "action": "core/set",
              "args": {
                "variable": "url",
                "value": {
                  "expr": "get($page$, '@odata.nextLink', '')"
                }
              },
              "description": "Next page, if any"
            },
            {
              "id": "s23",
              "action": "core/set",
              "args": {
                "variable": "pages",
                "value": {
                  "expr": "$pages$ + 1"
                }
              },
              "description": "Count the page"
            }
          ],
          "description": "1. Each page (follow @odata.nextLink)"
        },
        {
          "id": "s24",
          "action": "ooa.rest/request",
          "args": {
            "method": "GET",
            "url": "${standin}/graph/v1.0/groups",
            "bearer_token": {
              "$credential": "rw_qa_standins/graph/token"
            }
          },
          "out": {
            "json": "groups"
          },
          "retry": {
            "max": 3,
            "backoff": "exponential",
            "delayMs": 1000
          },
          "description": "All groups (names)"
        },
        {
          "id": "s25",
          "action": "core/loop",
          "args": {
            "iterator": "list",
            "over": "$groups.value$",
            "as": "gi"
          },
          "children": [
            {
              "id": "s26",
              "action": "ooa.dictionary/put",
              "args": {
                "dictionary": "$gname$",
                "key": "$gi.id$",
                "value": "$gi.displayName$"
              },
              "out": {
                "dictionary": "gname"
              },
              "description": "Remember the name"
            }
          ],
          "description": "Group id -> name"
        },
        {
          "id": "s27",
          "action": "core/set",
          "args": {
            "variable": "db",
            "value": "${out_dir}/review"
          },
          "description": "Review database of this run"
        },
        {
          "id": "s28",
          "action": "ooa.database/connect",
          "args": {
            "database_type": "h2",
            "file": "$db$",
            "session": "rev"
          },
          "description": "Open the review database (embedded H2; live: the SQL entitlement store)"
        },
        {
          "id": "s29",
          "action": "ooa.database/execute",
          "args": {
            "sql": "DROP TABLE IF EXISTS snapshot",
            "session": "rev"
          },
          "description": "Fresh snapshot table"
        },
        {
          "id": "s30",
          "action": "ooa.database/execute",
          "args": {
            "session": "rev",
            "sql": "CREATE TABLE snapshot(pkey VARCHAR(5), immutable_id VARCHAR(40), enabled BOOLEAN, effective VARCHAR(400), stale BOOLEAN, hash VARCHAR(64), taken TIMESTAMP)"
          },
          "description": "Create it"
        },
        {
          "id": "s31",
          "action": "core/if",
          "args": {
            "condition": "not isEmpty($ad_server$)"
          },
          "children": [
            {
              "id": "s32",
              "action": "ooa.active_directory/connect",
              "args": {
                "url": "$ad_server$",
                "base_dn": "OU=QA,DC=ooa-qa,DC=test",
                "bind_user": "svc-ooa-qa",
                "password": {
                  "$credential": "rw_qa_standins/ad/password"
                }
              },
              "description": "Sign in to the QA domain"
            },
            {
              "id": "s33",
              "action": "ooa.active_directory/search",
              "args": {
                "filter": "(&(objectClass=user)(userPrincipalName=qa.*))",
                "attributes": [
                  "userPrincipalName",
                  "objectGUID",
                  "userAccountControl",
                  "lastLogonTimestamp",
                  "memberOf"
                ]
              },
              "out": {
                "table": "ad"
              },
              "description": "1. QA principals in AD"
            }
          ],
          "description": "A QA test domain given?"
        },
        {
          "id": "s34",
          "action": "ooa.log/write",
          "args": {
            "path": "$log_file$",
            "message": "Entra: ${len($all$)} QA principals in ${pages} pages"
          },
          "description": "Census source"
        }
      ],
      "description": "2. Prepare"
    },
    {
      "id": "s35",
      "action": "core/step",
      "args": {
        "title": "3. Work through the records"
      },
      "children": [
        {
          "id": "s36",
          "action": "core/comment",
          "args": {
            "text": "Per identity: QA OU check, immutable id, state and groups, nested groups (cycle limit), stale tag, masking, hashed snapshot."
          }
        },
        {
          "id": "s37",
          "action": "core/loop",
          "args": {
            "iterator": "table_rows",
            "over": "$records$",
            "as": "rec",
            "index": "i"
          },
          "children": [
            {
              "id": "s38",
              "action": "core/set",
              "args": {
                "variable": "rec_note",
                "value": ""
              },
              "description": "Clear the note of the previous record"
            },
            {
              "id": "s39",
              "action": "core/try",
              "args": {},
              "children": [
                {
                  "id": "s40",
                  "action": "core/if",
                  "args": {
                    "condition": "not (startsWith(lower($rec.upn$), 'qa.') and endsWith(lower($rec.upn$), '@ooa-qa.test'))"
                  },
                  "children": [
                    {
                      "id": "s41",
                      "action": "core/throw",
                      "args": {
                        "code": "SCOPE.NOT_QA",
                        "message": "${rec.key}: not a tagged QA principal; nothing is read or changed"
                      },
                      "description": "Fail closed"
                    }
                  ],
                  "description": "Not a tagged QA principal?"
                },
                {
                  "id": "s42",
                  "action": "ooa.rest/request",
                  "args": {
                    "method": "GET",
                    "url": "${standin}/graph/v1.0/users/${rec.upn}",
                    "bearer_token": {
                      "$credential": "rw_qa_standins/graph/token"
                    }
                  },
                  "out": {
                    "json": "u"
                  },
                  "retry": {
                    "max": 3,
                    "backoff": "exponential",
                    "delayMs": 1000
                  },
                  "description": "3. Read the identity"
                },
                {
                  "id": "s43",
                  "action": "core/if",
                  "args": {
                    "condition": "not contains(coalesce($u.onPremisesDistinguishedName$, ''), ',OU=QA,')"
                  },
                  "children": [
                    {
                      "id": "s44",
                      "action": "core/throw",
                      "args": {
                        "code": "SCOPE.OUTSIDE_QA_OU",
                        "message": "${rec.upn} is outside the QA OU: nothing is read further"
                      },
                      "description": "Fail closed"
                    }
                  ],
                  "description": "9. Outside the QA OU?"
                },
                {
                  "id": "s45",
                  "action": "core/set",
                  "args": {
                    "variable": "immutable",
                    "value": {
                      "expr": "lower(trim($u.id$))"
                    }
                  },
                  "description": "2. Normalize the immutable id"
                },
                {
                  "id": "s46",
                  "action": "ooa.rest/request",
                  "args": {
                    "method": "GET",
                    "url": "${standin}/graph/v1.0/users/${u.id}/memberOf",
                    "bearer_token": {
                      "$credential": "rw_qa_standins/graph/token"
                    }
                  },
                  "out": {
                    "json": "mo"
                  },
                  "retry": {
                    "max": 3,
                    "backoff": "exponential",
                    "delayMs": 1000
                  },
                  "description": "3. Direct groups"
                },
                {
                  "id": "s47",
                  "action": "core/set",
                  "args": {
                    "variable": "direct",
                    "value": []
                  },
                  "description": "Start the direct groups"
                },
                {
                  "id": "s48",
                  "action": "core/set",
                  "args": {
                    "variable": "queue",
                    "value": []
                  },
                  "description": "Start the expansion queue"
                },
                {
                  "id": "s49",
                  "action": "core/loop",
                  "args": {
                    "iterator": "list",
                    "over": "$mo.value$",
                    "as": "gi"
                  },
                  "children": [
                    {
                      "id": "s50",
                      "action": "ooa.list/add_item",
                      "args": {
                        "list": "$direct$",
                        "item": "$gi.displayName$"
                      },
                      "out": {
                        "list": "direct"
                      },
                      "description": "Direct group name"
                    },
                    {
                      "id": "s51",
                      "action": "ooa.list/add_item",
                      "args": {
                        "list": "$queue$",
                        "item": "$gi.id$"
                      },
                      "out": {
                        "list": "queue"
                      },
                      "description": "Queue it for expansion"
                    }
                  ],
                  "description": "Each direct group"
                },
                {
                  "id": "s52",
                  "action": "core/set",
                  "args": {
                    "variable": "seen",
                    "value": []
                  },
                  "description": "Expansion: seen"
                },
                {
                  "id": "s53",
                  "action": "core/set",
                  "args": {
                    "variable": "qi",
                    "value": 0
                  },
                  "description": "Expansion: qi"
                },
                {
                  "id": "s54",
                  "action": "core/set",
                  "args": {
                    "variable": "cycles",
                    "value": 0
                  },
                  "description": "Expansion: cycles"
                },
                {
                  "id": "s55",
                  "action": "core/loop",
                  "args": {
                    "iterator": "while",
                    "condition": "$qi$ < len($queue$) and $qi$ < 20",
                    "max_iterations": 25
                  },
                  "children": [
                    {
                      "id": "s56",
                      "action": "core/set",
                      "args": {
                        "variable": "gid",
                        "value": {
                          "expr": "$queue$[$qi$]"
                        }
                      },
                      "description": "Next group"
                    },
                    {
                      "id": "s57",
                      "action": "core/set",
                      "args": {
                        "variable": "qi",
                        "value": {
                          "expr": "$qi$ + 1"
                        }
                      },
                      "description": "Move on"
                    },
                    {
                      "id": "s58",
                      "action": "core/if",
                      "args": {
                        "condition": {
                          "op": "contains",
                          "left": "$seen$",
                          "right": "$gid$"
                        }
                      },
                      "children": [
                        {
                          "id": "s59",
                          "action": "core/set",
                          "args": {
                            "variable": "cycles",
                            "value": {
                              "expr": "$cycles$ + 1"
                            }
                          },
                          "description": "Count the cycle"
                        }
                      ],
                      "description": "Seen already (a cycle)?",
                      "else": [
                        {
                          "id": "s60",
                          "action": "ooa.list/add_item",
                          "args": {
                            "list": "$seen$",
                            "item": "$gid$"
                          },
                          "out": {
                            "list": "seen"
                          },
                          "description": "Mark it seen"
                        },
                        {
                          "id": "s61",
                          "action": "ooa.rest/request",
                          "args": {
                            "method": "GET",
                            "url": "${standin}/graph/v1.0/groups/${gid}/memberOf",
                            "bearer_token": {
                              "$credential": "rw_qa_standins/graph/token"
                            }
                          },
                          "out": {
                            "json": "parents"
                          },
                          "retry": {
                            "max": 3,
                            "backoff": "exponential",
                            "delayMs": 1000
                          },
                          "description": "Groups this group is in"
                        },
                        {
                          "id": "s62",
                          "action": "core/loop",
                          "args": {
                            "iterator": "list",
                            "over": "$parents.value$",
                            "as": "pg"
                          },
                          "children": [
                            {
                              "id": "s63",
                              "action": "ooa.list/add_item",
                              "args": {
                                "list": "$queue$",
                                "item": "$pg.id$"
                              },
                              "out": {
                                "list": "queue"
                              },
                              "description": "Queue the parent"
                            }
                          ],
                          "description": "Each parent group"
                        }
                      ]
                    }
                  ],
                  "description": "4. Expand nested groups (stops at 20 groups: cycle limit)"
                },
                {
                  "id": "s64",
                  "action": "core/set",
                  "args": {
                    "variable": "effective",
                    "value": []
                  },
                  "description": "Start the effective groups"
                },
                {
                  "id": "s65",
                  "action": "core/loop",
                  "args": {
                    "iterator": "list",
                    "over": "$seen$",
                    "as": "gid"
                  },
                  "children": [
                    {
                      "id": "s66",
                      "action": "ooa.list/add_item",
                      "args": {
                        "list": "$effective$",
                        "item": {
                          "expr": "get($gname$, $gid$, $gid$)"
                        }
                      },
                      "out": {
                        "list": "effective"
                      },
                      "description": "Add the name"
                    }
                  ],
                  "description": "5. Effective group names"
                },
                {
                  "id": "s67",
                  "action": "core/set",
                  "args": {
                    "variable": "days",
                    "value": {
                      "expr": "round(dateDiff(coalesce($u.signInActivity.lastSignInDateTime$, '2000-01-01T00:00:00Z'), now(), 'days'), 0)"
                    }
                  },
                  "description": "3. Days since the last sign-in"
                },
                {
                  "id": "s68",
                  "action": "core/set",
                  "args": {
                    "variable": "stale",
                    "value": {
                      "expr": "$days$ > $stale_days$"
                    }
                  },
                  "description": "6. Tag stale access"
                },
                {
                  "id": "s69",
                  "action": "core/set",
                  "args": {
                    "variable": "masked",
                    "value": "${substring($rec.upn$, 0, 4)}***@ooa-qa.test"
                  },
                  "description": "7. Mask the sign-in name for logs"
                },
                {
                  "id": "s70",
                  "action": "ooa.list/sort",
                  "args": {
                    "list": "$effective$"
                  },
                  "out": {
                    "list": "effective"
                  },
                  "description": "Groups in a fixed order (stable hash)"
                },
                {
                  "id": "s71",
                  "action": "core/set",
                  "args": {
                    "variable": "snap",
                    "value": "${immutable}|${u.accountEnabled}|${join($effective$, ';')}|${stale}"
                  },
                  "description": "5. The membership snapshot"
                },
                {
                  "id": "s72",
                  "action": "ooa.crypto/hash_text",
                  "args": {
                    "text": "$snap$"
                  },
                  "out": {
                    "hash": "hash"
                  },
                  "description": "8. Snapshot hash"
                },
                {
                  "id": "s73",
                  "action": "ooa.database/execute",
                  "args": {
                    "session": "rev",
                    "sql": "INSERT INTO snapshot VALUES (?, ?, ?, ?, ?, ?, CURRENT_TIMESTAMP)",
                    "parameters": [
                      "$rec.key$",
                      "$immutable$",
                      "$u.accountEnabled$",
                      {
                        "expr": "join($effective$, ';')"
                      },
                      "$stale$",
                      "$hash$"
                    ]
                  },
                  "description": "8. Store the snapshot"
                },
                {
                  "id": "s74",
                  "action": "ooa.datatable/add_row",
                  "args": {
                    "table": "$evidence$",
                    "values": {
                      "key": "$rec.key$",
                      "upn": "$rec.upn$",
                      "immutable_id": "$immutable$",
                      "enabled": "$u.accountEnabled$",
                      "manager": "$u.manager$",
                      "last_sign_in": "$u.signInActivity.lastSignInDateTime$",
                      "days": "$days$",
                      "stale": "$stale$",
                      "direct_groups": {
                        "expr": "join($direct$, ';')"
                      },
                      "effective_groups": {
                        "expr": "join($effective$, ';')"
                      },
                      "cycles": "$cycles$",
                      "masked": "$masked$",
                      "hash": "$hash$"
                    }
                  },
                  "out": {
                    "table": "evidence"
                  },
                  "description": "Census row"
                },
                {
                  "id": "s75",
                  "action": "ooa.log/write",
                  "args": {
                    "path": "$log_file$",
                    "message": "${masked}: ${len($effective$)} groups, ${days} days, stale ${stale}"
                  },
                  "description": "Log (masked)"
                },
                {
                  "id": "s76",
                  "action": "core/set",
                  "args": {
                    "variable": "rec_note",
                    "value": "${len($effective$)} groups${if($cycles$ > 0, ', cycle', '')}${if($stale$, ', stale', '')}"
                  },
                  "description": "Note for the results"
                },
                {
                  "id": "s77",
                  "action": "ooa.datatable/add_row",
                  "args": {
                    "table": "$results$",
                    "values": {
                      "key": "$rec.key$",
                      "status": "done",
                      "note": "$rec_note$",
                      "time": "${formatDate(now(), '%H:%M:%S')}"
                    }
                  },
                  "out": {
                    "table": "results"
                  },
                  "description": "Add the record's result to the results table"
                },
                {
                  "id": "s78",
                  "action": "core/set",
                  "args": {
                    "variable": "processed",
                    "value": {
                      "expr": "$processed$ + 1"
                    }
                  },
                  "description": "Count the record as handled"
                },
                {
                  "id": "s79",
                  "action": "core/if",
                  "args": {
                    "condition": "$watch$"
                  },
                  "children": [
                    {
                      "id": "s80",
                      "action": "ooa.desktop/message_box",
                      "args": {
                        "title": "RW05-B1 - record ${rec.key}",
                        "message": "RW05-B1: record ${$i + 1} of ${len($records$)}\n\n${masked}: enabled ${u.accountEnabled}, ${days} days since sign-in\nGroups: ${join($effective$, ', ')}\nCycles: ${cycles}",
                        "timeout_seconds": 2,
                        "icon": "information",
                        "always_on_top": true
                      },
                      "description": "Message box that closes by itself"
                    }
                  ],
                  "description": "Show what is happening (watch is on)"
                }
              ],
              "description": "Handle one record; a failure is caught below and the next record goes on",
              "catch": [
                {
                  "codes": [
                    "*"
                  ],
                  "children": [
                    {
                      "id": "s81",
                      "action": "core/comment",
                      "args": {
                        "text": "The record failed: keep the reason, count it as an exception and go on with the next one."
                      }
                    },
                    {
                      "id": "s82",
                      "action": "ooa.datatable/add_row",
                      "args": {
                        "table": "$results$",
                        "values": {
                          "key": "$rec.key$",
                          "status": "exception",
                          "note": "${err.code}: ${err_msg}",
                          "time": "${formatDate(now(), '%H:%M:%S')}"
                        }
                      },
                      "out": {
                        "table": "results"
                      },
                      "description": "Add the failure to the results table"
                    },
                    {
                      "id": "s83",
                      "action": "core/set",
                      "args": {
                        "variable": "exceptions",
                        "value": {
                          "expr": "$exceptions$ + 1"
                        }
                      },
                      "description": "Count the exception"
                    },
                    {
                      "id": "s84",
                      "action": "ooa.log/write",
                      "args": {
                        "path": "$log_file$",
                        "level": "WARN",
                        "message": "Record ${rec.key}: ${err.code} ${err_msg}"
                      },
                      "description": "Log the exception"
                    },
                    {
                      "id": "s85",
                      "action": "core/if",
                      "args": {
                        "condition": "$watch$"
                      },
                      "children": [
                        {
                          "id": "s86",
                          "action": "ooa.desktop/message_box",
                          "args": {
                            "title": "RW05-B1 - exception",
                            "message": "RW05-B1: record ${rec.key} went to the exception list\n\n${err.code}: ${err_msg}",
                            "timeout_seconds": 3,
                            "icon": "warning",
                            "always_on_top": true
                          },
                          "description": "Message box that closes by itself"
                        }
                      ],
                      "description": "Show what is happening (watch is on)"
                    }
                  ],
                  "as": "err",
                  "message_to": "err_msg"
                }
              ]
            },
            {
              "id": "s87",
              "action": "core/if",
              "args": {
                "condition": "$watch$"
              },
              "children": [
                {
                  "id": "s88",
                  "action": "core/delay",
                  "args": {
                    "seconds": "$pause_seconds$"
                  },
                  "description": "Short pause"
                }
              ],
              "description": "Pause so the screen can be followed (watch is on)"
            }
          ],
          "description": "Once for each of the 10 synthetic identities"
        }
      ],
      "description": "3. Work through the records"
    },
    {
      "id": "s89",
      "action": "core/step",
      "args": {
        "title": "4. Finish"
      },
      "children": [
        {
          "id": "s90",
          "action": "core/comment",
          "args": {
            "text": "Save the results, set the outputs and say how it went."
          }
        },
        {
          "id": "s91",
          "action": "ooa.database/disconnect",
          "args": {
            "session": "rev"
          },
          "description": "Close the review database"
        },
        {
          "id": "s92",
          "action": "core/set",
          "args": {
            "variable": "evidence_file",
            "value": "${out_dir}/evidence.csv"
          },
          "description": "Name of the evidence file"
        },
        {
          "id": "s93",
          "action": "ooa.datatable/write_to_file",
          "args": {
            "table": "$evidence$",
            "path": "$evidence_file$"
          },
          "description": "Save the evidence rows"
        },
        {
          "id": "s94",
          "action": "core/set",
          "args": {
            "variable": "result_file",
            "value": "${out_dir}/results.csv"
          },
          "description": "Name of the results file"
        },
        {
          "id": "s95",
          "action": "ooa.datatable/write_to_file",
          "args": {
            "table": "$results$",
            "path": "$result_file$"
          },
          "description": "Save one row per record"
        },
        {
          "id": "s96",
          "action": "core/set",
          "args": {
            "variable": "status",
            "value": "success"
          },
          "description": "Every record was handled (exceptions are routed, not lost)"
        },
        {
          "id": "s97",
          "action": "ooa.log/write",
          "args": {
            "path": "$log_file$",
            "message": "RW05-B1 Identity census finished: ${processed} handled, ${exceptions} exceptions"
          },
          "description": "Log the end"
        },
        {
          "id": "s98",
          "action": "core/if",
          "args": {
            "condition": "$watch$"
          },
          "children": [
            {
              "id": "s99",
              "action": "ooa.desktop/message_box",
              "args": {
                "title": "RW05-B1 finished",
                "message": "RW05-B1 Identity census finished\n\nHandled: ${processed}\nExceptions: ${exceptions}\nResults: ${result_file}",
                "timeout_seconds": 4,
                "icon": "information",
                "always_on_top": true
              },
              "description": "Message box that closes by itself"
            }
          ],
          "description": "Show what is happening (watch is on)"
        }
      ],
      "description": "4. Finish"
    }
  ]
}
