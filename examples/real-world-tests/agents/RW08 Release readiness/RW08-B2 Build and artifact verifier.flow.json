{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "rw08_b2",
  "name": "RW08-B2 Build and artifact verifier",
  "description": "RW08-B2 (RW08 real-world test). For each candidate: reads the CI run of its branch, requires every mandatory job to succeed on the current head SHA, fetches the artifact into QA staging, checks its digest, its PGP signature (QA test signing key) and its SBOM against the licence policy, rejects stale or production artifacts, captures the test matrix, records the digest and cleans the staging folder.",
  "tags": [
    "real-world-test",
    "RW08"
  ],
  "variables": [
    {
      "name": "base",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Real-world tests",
      "description": "Folder of the real-world tests: data, output and the stand-in server."
    },
    {
      "name": "run_id",
      "type": "String",
      "direction": "input",
      "default": "",
      "description": "Run id shared by a main agent and its children; made here when empty."
    },
    {
      "name": "standin",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local QA stand-in server (127.0.0.1 only)."
    },
    {
      "name": "watch",
      "type": "Boolean",
      "direction": "input",
      "default": true,
      "description": "Show message boxes and pause between records so a person can follow the run."
    },
    {
      "name": "pause_seconds",
      "type": "Number",
      "direction": "input",
      "default": 1,
      "description": "Pause after each record when watch is on."
    },
    {
      "name": "fault_profile",
      "type": "String",
      "direction": "input",
      "default": "none",
      "description": "none, or resilience: the stand-ins inject the five failures of runbook step 09."
    },
    {
      "name": "info",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "out_dir",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "log_file",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "records",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "rec",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "i",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "err",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "err_msg",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "rec_status",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "rec_note",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "started",
      "type": "DateTime",
      "direction": "local"
    },
    {
      "name": "results",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "key",
          "status",
          "note",
          "time"
        ],
        "rows": []
      }
    },
    {
      "name": "processed",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Records handled without an error."
    },
    {
      "name": "exceptions",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Records routed to the exception list."
    },
    {
      "name": "status",
      "type": "String",
      "direction": "output",
      "default": "not_run",
      "description": "success when every record was handled (routed exceptions included)."
    },
    {
      "name": "result_file",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "CSV file with one row per record."
    },
    {
      "name": "policy",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "fp",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "runs",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "run",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "jobs",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "j",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "failed",
      "type": "List",
      "direction": "local",
      "default": []
    },
    {
      "name": "arts",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "art",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "stage",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "zip",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "digest",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "sig",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "valid",
      "type": "Boolean",
      "direction": "local",
      "default": false
    },
    {
      "name": "files",
      "type": "List",
      "direction": "local"
    },
    {
      "name": "sbom",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "comp",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "lic",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "pol",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "bad_lic",
      "type": "List",
      "direction": "local",
      "default": []
    },
    {
      "name": "tests",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "passed",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "tfailed",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "ver",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "x",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "kp",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "sftp_host",
      "type": "String",
      "direction": "input",
      "default": "",
      "description": "QA artifact store reached by SFTP; empty: skipped (no SFTP server here)."
    },
    {
      "name": "evidence",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "key",
          "run_id",
          "head_sha",
          "artifact",
          "digest",
          "signature",
          "signer",
          "licences",
          "tests_passed",
          "tests_failed",
          "version"
        ],
        "rows": []
      }
    },
    {
      "name": "evidence_file",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "Evidence rows of this agent (one per record)."
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "1. Start"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "What this agent does: For each candidate: reads the CI run of its branch, requires every mandatory job to succeed on the current head SHA, fetches the artifact into QA staging, checks its digest, its PGP signature (QA test signing key) and its SBOM against the licence policy, rejects stale or production artifacts, captures the test matrix, records the digest and cleans the staging folder. It works through 10 build candidates (the accepted ones) and writes its results to the run's output folder."
          }
        },
        {
          "id": "s3",
          "action": "ooa.run_context/get",
          "args": {},
          "out": {
            "info": "info"
          },
          "description": "Read the run context (run id, runner, user)"
        },
        {
          "id": "s4",
          "action": "core/set",
          "args": {
            "variable": "started",
            "value": {
              "expr": "now()"
            }
          },
          "description": "Remember when the agent started"
        },
        {
          "id": "s5",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "empty",
              "left": "$run_id$"
            }
          },
          "children": [
            {
              "id": "s6",
              "action": "core/set",
              "args": {
                "variable": "run_id",
                "value": "SOLO-${formatDate(now(), '%Y%m%d-%H%M%S')}"
              },
              "description": "Run id for a run on its own"
            }
          ],
          "description": "Running on its own: make a run id"
        },
        {
          "id": "s7",
          "action": "core/set",
          "args": {
            "variable": "out_dir",
            "value": "${base}/output/${run_id}/RW08-B2"
          },
          "description": "This agent's output folder for the run"
        },
        {
          "id": "s8",
          "action": "ooa.folder/create",
          "args": {
            "path": "$out_dir$"
          },
          "description": "Create the output folder"
        },
        {
          "id": "s9",
          "action": "core/set",
          "args": {
            "variable": "log_file",
            "value": "${out_dir}/log.txt"
          },
          "description": "Log file of this agent"
        },
        {
          "id": "s10",
          "action": "ooa.log/write",
          "args": {
            "path": "$log_file$",
            "message": "RW08-B2 Build and artifact verifier started; run ${run_id}; computer ${info.device}, user ${info.os_user}"
          },
          "description": "Log the start"
        },
        {
          "id": "s11",
          "action": "core/if",
          "args": {
            "condition": "$watch$"
          },
          "children": [
            {
              "id": "s12",
              "action": "ooa.desktop/message_box",
              "args": {
                "title": "RW08-B2 starts",
                "message": "RW08-B2 Build and artifact verifier\n\nFor each candidate: reads the CI run of its branch, requires every mandatory job to succeed on the current head SHA, fetches the artifact into QA staging, checks its digest, its PGP signature (QA test signing key) and its SBOM against the licence policy, rejects stale or production artifacts, captures the test matrix, records the digest and cleans the staging folder.\n\nRecords: 10 build candidates (the accepted ones)\nRun: ${run_id}",
                "timeout_seconds": 4,
                "icon": "information",
                "always_on_top": true
              },
              "description": "Message box that closes by itself"
            }
          ],
          "description": "Show what is happening (watch is on)"
        }
      ],
      "description": "1. Start"
    },
    {
      "id": "s13",
      "action": "core/step",
      "args": {
        "title": "2. Prepare"
      },
      "children": [
        {
          "id": "s14",
          "action": "core/comment",
          "args": {
            "text": "Accepted candidates; the licence policy; QA release engineering signs the QA artifacts with the test signing key (PGP)."
          }
        },
        {
          "id": "s15",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "ne",
              "left": "$fault_profile$",
              "right": "none"
            }
          },
          "children": [
            {
              "id": "s16",
              "action": "ooa.rest/request",
              "args": {
                "method": "POST",
                "url": "${standin}/qa/faults",
                "json": {
                  "service": "github",
                  "profile": "$fault_profile$",
                  "run_id": "$run_id$"
                }
              },
              "description": "Arm the stand-in's injected faults for this service"
            }
          ],
          "description": "Resilience run: arm the stand-in's faults"
        },
        {
          "id": "s17",
          "action": "core/if",
          "args": {
            "condition": {
              "condition": "ooa.file/exists",
              "args": {
                "path": "${base}/output/${run_id}/RW08-B1/evidence.csv"
              }
            }
          },
          "children": [
            {
              "id": "s18",
              "action": "ooa.csv/read",
              "args": {
                "path": "${base}/output/${run_id}/RW08-B1/evidence.csv"
              },
              "out": {
                "table": "records"
              },
              "description": "Read RW08-B1 evidence"
            }
          ],
          "description": "RW08-B1 ran in this run?",
          "else": [
            {
              "id": "s19",
              "action": "core/comment",
              "args": {
                "text": "Running on its own: use the fixture, a saved copy of RW08-B1's evidence from a checked run."
              }
            },
            {
              "id": "s20",
              "action": "ooa.csv/read",
              "args": {
                "path": "${base}/data/RW08/fixtures/RW08-B1-evidence.csv"
              },
              "out": {
                "table": "records"
              },
              "description": "Read RW08-B1 evidence (fixture)"
            }
          ]
        },
        {
          "id": "s21",
          "action": "ooa.csv/read",
          "args": {
            "path": "${base}/data/RW08/licence_policy.csv"
          },
          "out": {
            "table": "policy"
          },
          "description": "Licence policy"
        },
        {
          "id": "s22",
          "action": "core/set",
          "args": {
            "variable": "kp",
            "value": "${out_dir}/gnupg"
          },
          "description": "Test key ring of this run"
        },
        {
          "id": "s23",
          "action": "ooa.pgp/create_keys",
          "args": {
            "name": "OOA-QA Release Signing",
            "email": "release-signing@ooa-qa.test",
            "comment": "OOA-QA test signing key",
            "algorithm": "ed25519",
            "expires": "1d",
            "gnupg_home": "$kp$"
          },
          "out": {
            "fingerprint": "fp"
          },
          "description": "QA package signing test key (made up, this run only)"
        },
        {
          "id": "s24",
          "action": "core/comment",
          "args": {
            "text": "The signed artifacts come from the QA release pipeline; here the agent plays that part for the artifacts the pipeline marks signed."
          }
        },
        {
          "id": "s25",
          "action": "ooa.folder/create",
          "args": {
            "path": "${out_dir}/staging"
          },
          "description": "QA staging"
        }
      ],
      "description": "2. Prepare"
    },
    {
      "id": "s26",
      "action": "core/step",
      "args": {
        "title": "3. Work through the records"
      },
      "children": [
        {
          "id": "s27",
          "action": "core/comment",
          "args": {
            "text": "Per candidate: CI run and jobs on the head SHA, artifact into staging, digest, signature, SBOM licences, staleness, tests, digest record."
          }
        },
        {
          "id": "s28",
          "action": "core/loop",
          "args": {
            "iterator": "table_rows",
            "over": "$records$",
            "as": "rec",
            "index": "i"
          },
          "children": [
            {
              "id": "s29",
              "action": "core/set",
              "args": {
                "variable": "rec_note",
                "value": ""
              },
              "description": "Clear the note of the previous record"
            },
            {
              "id": "s30",
              "action": "core/try",
              "args": {},
              "children": [
                {
                  "id": "s31",
                  "action": "ooa.rest/request",
                  "args": {
                    "url": "${standin}/github/repos/${rec.owner}/${rec.repo}/actions/runs",
                    "query": {
                      "branch": "$rec.head$"
                    },
                    "bearer_token": {
                      "$credential": "rw_qa_standins/github/token"
                    }
                  },
                  "out": {
                    "json": "runs"
                  },
                  "retry": {
                    "max": 3,
                    "backoff": "exponential",
                    "delayMs": 1000
                  },
                  "description": "1. CI runs of the branch"
                },
                {
                  "id": "s32",
                  "action": "core/set",
                  "args": {
                    "variable": "run",
                    "value": {
                      "expr": "first($runs.workflow_runs$)"
                    }
                  },
                  "description": "Newest run"
                },
                {
                  "id": "s33",
                  "action": "ooa.github/get_workflow_run",
                  "args": {
                    "owner": "$rec.owner$",
                    "repo": "$rec.repo$",
                    "run_id": "$run.id$",
                    "token": {
                      "$credential": "rw_qa_standins/github/token"
                    },
                    "base_url": "${standin}/github"
                  },
                  "out": {
                    "run": "x"
                  },
                  "retry": {
                    "max": 3,
                    "backoff": "exponential",
                    "delayMs": 1000
                  },
                  "description": "1. Its status"
                },
                {
                  "id": "s34",
                  "action": "core/if",
                  "args": {
                    "condition": {
                      "op": "ne",
                      "left": "$x.sha$",
                      "right": "$rec.head_sha$"
                    }
                  },
                  "children": [
                    {
                      "id": "s35",
                      "action": "core/throw",
                      "args": {
                        "code": "BUILD.NOT_HEAD",
                        "message": "${rec.key}: CI ran on ${x.sha}, head is ${rec.head_sha}"
                      },
                      "description": "Reject"
                    }
                  ],
                  "description": "2. Built from another commit than the current head?"
                },
                {
                  "id": "s36",
                  "action": "ooa.rest/request",
                  "args": {
                    "url": "${standin}/github/repos/${rec.owner}/${rec.repo}/actions/runs/${run.id}/jobs",
                    "bearer_token": {
                      "$credential": "rw_qa_standins/github/token"
                    }
                  },
                  "out": {
                    "json": "jobs"
                  },
                  "description": "2. Its jobs"
                },
                {
                  "id": "s37",
                  "action": "core/set",
                  "args": {
                    "variable": "failed",
                    "value": []
                  },
                  "description": "No failed job yet"
                },
                {
                  "id": "s38",
                  "action": "core/loop",
                  "args": {
                    "iterator": "list",
                    "over": "$jobs.jobs$",
                    "as": "j"
                  },
                  "children": [
                    {
                      "id": "s39",
                      "action": "core/if",
                      "args": {
                        "condition": "contains(split($rec.required_checks$, ','), $j.name$) and $j.conclusion$ != 'success'"
                      },
                      "children": [
                        {
                          "id": "s40",
                          "action": "ooa.list/add_item",
                          "args": {
                            "list": "$failed$",
                            "item": "${j.name}=${j.conclusion}"
                          },
                          "out": {
                            "list": "failed"
                          },
                          "description": "Note it"
                        }
                      ],
                      "description": "Mandatory and not green?"
                    }
                  ],
                  "description": "Each mandatory job"
                },
                {
                  "id": "s41",
                  "action": "core/if",
                  "args": {
                    "condition": "len($failed$) > 0"
                  },
                  "children": [
                    {
                      "id": "s42",
                      "action": "core/throw",
                      "args": {
                        "code": "BUILD.FAILED",
                        "message": "${rec.key}: ${join($failed$, ', ')}"
                      },
                      "description": "Reject"
                    }
                  ],
                  "description": "A mandatory job failed?"
                },
                {
                  "id": "s43",
                  "action": "ooa.rest/request",
                  "args": {
                    "url": "${standin}/github/repos/${rec.owner}/${rec.repo}/actions/runs/${run.id}/artifacts",
                    "bearer_token": {
                      "$credential": "rw_qa_standins/github/token"
                    }
                  },
                  "out": {
                    "json": "arts"
                  },
                  "description": "The run's artifacts"
                },
                {
                  "id": "s44",
                  "action": "core/set",
                  "args": {
                    "variable": "art",
                    "value": {
                      "expr": "first($arts.artifacts$)"
                    }
                  },
                  "description": "The artifact"
                },
                {
                  "id": "s45",
                  "action": "core/if",
                  "args": {
                    "condition": "contains(lower($art.name$), 'prod')"
                  },
                  "children": [
                    {
                      "id": "s46",
                      "action": "core/throw",
                      "args": {
                        "code": "SCOPE.PROD_ARTIFACT",
                        "message": "${art.name} is a production artifact"
                      },
                      "description": "Reject"
                    }
                  ],
                  "description": "8. A production artifact?"
                },
                {
                  "id": "s47",
                  "action": "core/set",
                  "args": {
                    "variable": "stage",
                    "value": "${out_dir}/staging/${rec.key}"
                  },
                  "description": "Staging folder of the candidate"
                },
                {
                  "id": "s48",
                  "action": "core/set",
                  "args": {
                    "variable": "zip",
                    "value": "${stage}/${art.name}"
                  },
                  "description": "Staged artifact"
                },
                {
                  "id": "s49",
                  "action": "ooa.folder/create",
                  "args": {
                    "path": "$stage$"
                  },
                  "description": "Its staging folder"
                },
                {
                  "id": "s50",
                  "action": "ooa.file/copy",
                  "args": {
                    "source": "${base}/data/RW08/artifacts/${art.name}",
                    "target": "$zip$",
                    "overwrite": true
                  },
                  "description": "3. Fetch the artifact into QA staging (the QA artifact store)"
                },
                {
                  "id": "s51",
                  "action": "ooa.crypto/hash_file",
                  "args": {
                    "path": "$zip$"
                  },
                  "out": {
                    "hash": "digest"
                  },
                  "description": "4. Digest"
                },
                {
                  "id": "s52",
                  "action": "core/if",
                  "args": {
                    "condition": {
                      "op": "ne",
                      "left": "sha256:${digest}",
                      "right": "$art.digest$"
                    }
                  },
                  "children": [
                    {
                      "id": "s53",
                      "action": "core/throw",
                      "args": {
                        "code": "ARTIFACT.DIGEST",
                        "message": "${rec.key}: digest ${digest} does not match the build's ${art.digest}"
                      },
                      "description": "Reject"
                    }
                  ],
                  "description": "Digest differs from the build's?"
                },
                {
                  "id": "s54",
                  "action": "core/if",
                  "args": {
                    "condition": "toBoolean($art.signed$)"
                  },
                  "children": [
                    {
                      "id": "s55",
                      "action": "ooa.pgp/sign",
                      "args": {
                        "path": "$zip$",
                        "signature": "${zip}.sig",
                        "gnupg_home": "$kp$"
                      },
                      "description": "(QA pipeline) detached signature with the test key"
                    }
                  ],
                  "description": "Pipeline marks it signed?"
                },
                {
                  "id": "s56",
                  "action": "core/if",
                  "args": {
                    "condition": {
                      "condition": "ooa.file/exists",
                      "args": {
                        "path": "${zip}.sig"
                      }
                    }
                  },
                  "children": [
                    {
                      "id": "s57",
                      "action": "ooa.pgp/verify",
                      "args": {
                        "path": "$zip$",
                        "signature": "${zip}.sig",
                        "gnupg_home": "$kp$"
                      },
                      "out": {
                        "valid": "valid",
                        "signer": "lic"
                      },
                      "description": "4. Verify the signature"
                    }
                  ],
                  "description": "A signature present?",
                  "else": [
                    {
                      "id": "s58",
                      "action": "core/set",
                      "args": {
                        "variable": "valid",
                        "value": false
                      },
                      "description": "No signature"
                    }
                  ]
                },
                {
                  "id": "s59",
                  "action": "core/if",
                  "args": {
                    "condition": "not $valid$"
                  },
                  "children": [
                    {
                      "id": "s60",
                      "action": "core/throw",
                      "args": {
                        "code": "SIGNATURE.ARTIFACT",
                        "message": "${rec.key}: ${art.name} has no valid signature"
                      },
                      "description": "Reject"
                    }
                  ],
                  "description": "Not validly signed?"
                },
                {
                  "id": "s61",
                  "action": "ooa.file/unzip",
                  "args": {
                    "archive": "$zip$",
                    "folder": "${stage}/content"
                  },
                  "out": {
                    "files": "files"
                  },
                  "description": "Open the artifact"
                },
                {
                  "id": "s62",
                  "action": "ooa.json/read_file",
                  "args": {
                    "path": "${stage}/content/sbom.json"
                  },
                  "out": {
                    "value": "sbom"
                  },
                  "description": "4. The SBOM"
                },
                {
                  "id": "s63",
                  "action": "core/set",
                  "args": {
                    "variable": "bad_lic",
                    "value": []
                  },
                  "description": "No forbidden licence yet"
                },
                {
                  "id": "s64",
                  "action": "core/loop",
                  "args": {
                    "iterator": "list",
                    "over": "$sbom.components$",
                    "as": "comp"
                  },
                  "children": [
                    {
                      "id": "s65",
                      "action": "core/set",
                      "args": {
                        "variable": "lic",
                        "value": {
                          "expr": "first($comp.licenses$).license.id"
                        }
                      },
                      "description": "Its licence"
                    },
                    {
                      "id": "s66",
                      "action": "ooa.datatable/lookup",
                      "args": {
                        "table": "$policy$",
                        "column": "licence",
                        "value": "$lic$",
                        "return_column": "policy",
                        "if_not_found": "unknown"
                      },
                      "out": {
                        "value": "pol"
                      },
                      "description": "Policy"
                    },
                    {
                      "id": "s67",
                      "action": "core/if",
                      "args": {
                        "condition": {
                          "op": "ne",
                          "left": "$pol$",
                          "right": "allowed"
                        }
                      },
                      "children": [
                        {
                          "id": "s68",
                          "action": "ooa.list/add_item",
                          "args": {
                            "list": "$bad_lic$",
                            "item": "${comp.name}:${lic} (${pol})"
                          },
                          "out": {
                            "list": "bad_lic"
                          },
                          "description": "Note it"
                        }
                      ],
                      "description": "Not allowed?"
                    }
                  ],
                  "description": "5. Each component's licence"
                },
                {
                  "id": "s69",
                  "action": "core/if",
                  "args": {
                    "condition": "len($bad_lic$) > 0"
                  },
                  "children": [
                    {
                      "id": "s70",
                      "action": "core/throw",
                      "args": {
                        "code": "LICENCE.POLICY",
                        "message": "${rec.key}: ${join($bad_lic$, ', ')}"
                      },
                      "description": "Reject"
                    }
                  ],
                  "description": "Licence policy broken?"
                },
                {
                  "id": "s71",
                  "action": "core/if",
                  "args": {
                    "condition": "dateDiff($art.created_at$, $run.created_at$, 'minutes') > 0"
                  },
                  "children": [
                    {
                      "id": "s72",
                      "action": "core/throw",
                      "args": {
                        "code": "ARTIFACT.STALE",
                        "message": "${rec.key}: artifact created before its CI run"
                      },
                      "description": "Reject"
                    }
                  ],
                  "description": "6. Artifact older than its run (stale)?"
                },
                {
                  "id": "s73",
                  "action": "ooa.json/read_file",
                  "args": {
                    "path": "${stage}/content/tests.json"
                  },
                  "out": {
                    "value": "tests"
                  },
                  "description": "7. Test matrix"
                },
                {
                  "id": "s74",
                  "action": "core/set",
                  "args": {
                    "variable": "passed",
                    "value": {
                      "expr": "sum([first($tests.matrix$).passed, last($tests.matrix$).passed])"
                    }
                  },
                  "description": "Passed"
                },
                {
                  "id": "s75",
                  "action": "core/set",
                  "args": {
                    "variable": "tfailed",
                    "value": {
                      "expr": "sum([first($tests.matrix$).failed, last($tests.matrix$).failed])"
                    }
                  },
                  "description": "Failed"
                },
                {
                  "id": "s76",
                  "action": "ooa.file/read_text",
                  "args": {
                    "path": "${stage}/content/version.txt"
                  },
                  "out": {
                    "text": "ver"
                  },
                  "description": "Version"
                },
                {
                  "id": "s77",
                  "action": "ooa.datatable/add_row",
                  "args": {
                    "table": "$evidence$",
                    "values": {
                      "key": "$rec.key$",
                      "run_id": "$run.id$",
                      "head_sha": "$rec.head_sha$",
                      "artifact": "$art.name$",
                      "digest": "sha256:${digest}",
                      "signature": "${zip}.sig",
                      "signer": "$fp$",
                      "licences": "ok",
                      "tests_passed": "$passed$",
                      "tests_failed": "$tfailed$",
                      "version": {
                        "expr": "trim($ver$)"
                      }
                    }
                  },
                  "out": {
                    "table": "evidence"
                  },
                  "description": "9. Record the digest"
                },
                {
                  "id": "s78",
                  "action": "core/if",
                  "args": {
                    "condition": "not isEmpty($sftp_host$)"
                  },
                  "children": [
                    {
                      "id": "s79",
                      "action": "ooa.file_transfer/connect",
                      "args": {
                        "protocol": "sftp",
                        "host": "$sftp_host$",
                        "user": "ooa-qa",
                        "password": {
                          "$credential": "rw_qa_standins/sftp/password"
                        },
                        "session": "sftp"
                      },
                      "description": "Connect to the QA artifact store (SFTP)"
                    },
                    {
                      "id": "s80",
                      "action": "ooa.file_transfer/upload",
                      "args": {
                        "local_path": "$zip$",
                        "remote_path": "/qa-staging/${art.name}",
                        "session": "sftp"
                      },
                      "description": "Publish the verified artifact to QA staging"
                    },
                    {
                      "id": "s81",
                      "action": "ooa.file_transfer/disconnect",
                      "args": {
                        "session": "sftp"
                      },
                      "description": "Disconnect"
                    }
                  ],
                  "description": "A QA artifact SFTP server given?"
                },
                {
                  "id": "s82",
                  "action": "ooa.folder/delete",
                  "args": {
                    "path": "${stage}/content",
                    "recursive": true
                  },
                  "description": "10. Clean the unpacked files"
                },
                {
                  "id": "s83",
                  "action": "core/set",
                  "args": {
                    "variable": "rec_note",
                    "value": "${art.name} ok"
                  },
                  "description": "Note"
                },
                {
                  "id": "s84",
                  "action": "ooa.datatable/add_row",
                  "args": {
                    "table": "$results$",
                    "values": {
                      "key": "$rec.key$",
                      "status": "done",
                      "note": "$rec_note$",
                      "time": "${formatDate(now(), '%H:%M:%S')}"
                    }
                  },
                  "out": {
                    "table": "results"
                  },
                  "description": "Add the record's result to the results table"
                },
                {
                  "id": "s85",
                  "action": "core/set",
                  "args": {
                    "variable": "processed",
                    "value": {
                      "expr": "$processed$ + 1"
                    }
                  },
                  "description": "Count the record as handled"
                },
                {
                  "id": "s86",
                  "action": "core/if",
                  "args": {
                    "condition": "$watch$"
                  },
                  "children": [
                    {
                      "id": "s87",
                      "action": "ooa.desktop/message_box",
                      "args": {
                        "title": "RW08-B2 - record ${rec.key}",
                        "message": "RW08-B2: record ${$i + 1} of ${len($records$)}\n\n${rec.key}: run ${run.id} ${run.conclusion} on ${substring($rec.head_sha$, 0, 8)}\n${art.name} sig ${valid}\nTests ${passed}/${tfailed}",
                        "timeout_seconds": 2,
                        "icon": "information",
                        "always_on_top": true
                      },
                      "description": "Message box that closes by itself"
                    }
                  ],
                  "description": "Show what is happening (watch is on)"
                }
              ],
              "description": "Handle one record; a failure is caught below and the next record goes on",
              "catch": [
                {
                  "codes": [
                    "*"
                  ],
                  "children": [
                    {
                      "id": "s88",
                      "action": "core/comment",
                      "args": {
                        "text": "The record failed: keep the reason, count it as an exception and go on with the next one."
                      }
                    },
                    {
                      "id": "s89",
                      "action": "ooa.datatable/add_row",
                      "args": {
                        "table": "$results$",
                        "values": {
                          "key": "$rec.key$",
                          "status": "exception",
                          "note": "${err.code}: ${err_msg}",
                          "time": "${formatDate(now(), '%H:%M:%S')}"
                        }
                      },
                      "out": {
                        "table": "results"
                      },
                      "description": "Add the failure to the results table"
                    },
                    {
                      "id": "s90",
                      "action": "core/set",
                      "args": {
                        "variable": "exceptions",
                        "value": {
                          "expr": "$exceptions$ + 1"
                        }
                      },
                      "description": "Count the exception"
                    },
                    {
                      "id": "s91",
                      "action": "ooa.log/write",
                      "args": {
                        "path": "$log_file$",
                        "level": "WARN",
                        "message": "Record ${rec.key}: ${err.code} ${err_msg}"
                      },
                      "description": "Log the exception"
                    },
                    {
                      "id": "s92",
                      "action": "core/if",
                      "args": {
                        "condition": "$watch$"
                      },
                      "children": [
                        {
                          "id": "s93",
                          "action": "ooa.desktop/message_box",
                          "args": {
                            "title": "RW08-B2 - exception",
                            "message": "RW08-B2: record ${rec.key} went to the exception list\n\n${err.code}: ${err_msg}",
                            "timeout_seconds": 3,
                            "icon": "warning",
                            "always_on_top": true
                          },
                          "description": "Message box that closes by itself"
                        }
                      ],
                      "description": "Show what is happening (watch is on)"
                    }
                  ],
                  "as": "err",
                  "message_to": "err_msg"
                }
              ]
            },
            {
              "id": "s94",
              "action": "core/if",
              "args": {
                "condition": "$watch$"
              },
              "children": [
                {
                  "id": "s95",
                  "action": "core/delay",
                  "args": {
                    "seconds": "$pause_seconds$"
                  },
                  "description": "Short pause"
                }
              ],
              "description": "Pause so the screen can be followed (watch is on)"
            }
          ],
          "description": "Once for each of the 10 build candidates (the accepted ones)"
        }
      ],
      "description": "3. Work through the records"
    },
    {
      "id": "s96",
      "action": "core/step",
      "args": {
        "title": "4. Finish"
      },
      "children": [
        {
          "id": "s97",
          "action": "core/comment",
          "args": {
            "text": "Save the results, set the outputs and say how it went."
          }
        },
        {
          "id": "s98",
          "action": "core/set",
          "args": {
            "variable": "evidence_file",
            "value": "${out_dir}/evidence.csv"
          },
          "description": "Name of the evidence file"
        },
        {
          "id": "s99",
          "action": "ooa.datatable/write_to_file",
          "args": {
            "table": "$evidence$",
            "path": "$evidence_file$"
          },
          "description": "Save the evidence rows"
        },
        {
          "id": "s100",
          "action": "core/set",
          "args": {
            "variable": "result_file",
            "value": "${out_dir}/results.csv"
          },
          "description": "Name of the results file"
        },
        {
          "id": "s101",
          "action": "ooa.datatable/write_to_file",
          "args": {
            "table": "$results$",
            "path": "$result_file$"
          },
          "description": "Save one row per record"
        },
        {
          "id": "s102",
          "action": "core/set",
          "args": {
            "variable": "status",
            "value": "success"
          },
          "description": "Every record was handled (exceptions are routed, not lost)"
        },
        {
          "id": "s103",
          "action": "ooa.log/write",
          "args": {
            "path": "$log_file$",
            "message": "RW08-B2 Build and artifact verifier finished: ${processed} handled, ${exceptions} exceptions"
          },
          "description": "Log the end"
        },
        {
          "id": "s104",
          "action": "core/if",
          "args": {
            "condition": "$watch$"
          },
          "children": [
            {
              "id": "s105",
              "action": "ooa.desktop/message_box",
              "args": {
                "title": "RW08-B2 finished",
                "message": "RW08-B2 Build and artifact verifier finished\n\nHandled: ${processed}\nExceptions: ${exceptions}\nResults: ${result_file}",
                "timeout_seconds": 4,
                "icon": "information",
                "always_on_top": true
              },
              "description": "Message box that closes by itself"
            }
          ],
          "description": "Show what is happening (watch is on)"
        }
      ],
      "description": "4. Finish"
    }
  ]
}
