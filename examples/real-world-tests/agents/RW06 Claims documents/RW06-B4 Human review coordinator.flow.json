{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "rw06_b4",
  "name": "RW06-B4 Human review coordinator",
  "description": "RW06-B4 (RW06 real-world test). For each claim: opens a ServiceNow task with a redacted summary and evidence links, assigns an independent test reviewer, waits for approve, reject or request-info, reassigns on a timeout, records comments, signs the approval (no ERP draft without it), resumes by run id and audits every transition.",
  "tags": [
    "real-world-test",
    "RW06"
  ],
  "variables": [
    {
      "name": "base",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Real-world tests",
      "description": "Folder of the real-world tests: data, output and the stand-in server."
    },
    {
      "name": "run_id",
      "type": "String",
      "direction": "input",
      "default": "",
      "description": "Run id shared by a main agent and its children; made here when empty."
    },
    {
      "name": "standin",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local QA stand-in server (127.0.0.1 only)."
    },
    {
      "name": "watch",
      "type": "Boolean",
      "direction": "input",
      "default": true,
      "description": "Show message boxes and pause between records so a person can follow the run."
    },
    {
      "name": "pause_seconds",
      "type": "Number",
      "direction": "input",
      "default": 1,
      "description": "Pause after each record when watch is on."
    },
    {
      "name": "fault_profile",
      "type": "String",
      "direction": "input",
      "default": "none",
      "description": "none, or resilience: the stand-ins inject the five failures of runbook step 09."
    },
    {
      "name": "info",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "out_dir",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "log_file",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "records",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "rec",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "i",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "err",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "err_msg",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "rec_status",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "rec_note",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "started",
      "type": "DateTime",
      "direction": "local"
    },
    {
      "name": "results",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "key",
          "status",
          "note",
          "time"
        ],
        "rows": []
      }
    },
    {
      "name": "processed",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Records handled without an error."
    },
    {
      "name": "exceptions",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Records routed to the exception list."
    },
    {
      "name": "status",
      "type": "String",
      "direction": "output",
      "default": "not_run",
      "description": "success when every record was handled (routed exceptions included)."
    },
    {
      "name": "result_file",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "CSV file with one row per record."
    },
    {
      "name": "b2",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "done",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "key",
          "claim_id",
          "task",
          "reviewer",
          "status",
          "approved_amount",
          "approval_id",
          "token"
        ],
        "rows": []
      }
    },
    {
      "name": "prev",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "claimant",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "reviewer",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "summary",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "task",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "req",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "ans",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "tries",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "token",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "again",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "reassigned",
      "type": "Boolean",
      "direction": "local",
      "default": false
    },
    {
      "name": "evidence",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "key",
          "claim_id",
          "task",
          "reviewer",
          "status",
          "approved_amount",
          "approval_id",
          "token"
        ],
        "rows": []
      }
    },
    {
      "name": "evidence_file",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "Evidence rows of this agent (one per record)."
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "1. Start"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "What this agent does: For each claim: opens a ServiceNow task with a redacted summary and evidence links, assigns an independent test reviewer, waits for approve, reject or request-info, reassigns on a timeout, records comments, signs the approval (no ERP draft without it), resumes by run id and audits every transition. It works through 10 claims (the scored ones) and writes its results to the run's output folder."
          }
        },
        {
          "id": "s3",
          "action": "ooa.run_context/get",
          "args": {},
          "out": {
            "info": "info"
          },
          "description": "Read the run context (run id, runner, user)"
        },
        {
          "id": "s4",
          "action": "core/set",
          "args": {
            "variable": "started",
            "value": {
              "expr": "now()"
            }
          },
          "description": "Remember when the agent started"
        },
        {
          "id": "s5",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "empty",
              "left": "$run_id$"
            }
          },
          "children": [
            {
              "id": "s6",
              "action": "core/set",
              "args": {
                "variable": "run_id",
                "value": "SOLO-${formatDate(now(), '%Y%m%d-%H%M%S')}"
              },
              "description": "Run id for a run on its own"
            }
          ],
          "description": "Running on its own: make a run id"
        },
        {
          "id": "s7",
          "action": "core/set",
          "args": {
            "variable": "out_dir",
            "value": "${base}/output/${run_id}/RW06-B4"
          },
          "description": "This agent's output folder for the run"
        },
        {
          "id": "s8",
          "action": "ooa.folder/create",
          "args": {
            "path": "$out_dir$"
          },
          "description": "Create the output folder"
        },
        {
          "id": "s9",
          "action": "core/set",
          "args": {
            "variable": "log_file",
            "value": "${out_dir}/log.txt"
          },
          "description": "Log file of this agent"
        },
        {
          "id": "s10",
          "action": "ooa.log/write",
          "args": {
            "path": "$log_file$",
            "message": "RW06-B4 Human review coordinator started; run ${run_id}; computer ${info.device}, user ${info.os_user}"
          },
          "description": "Log the start"
        },
        {
          "id": "s11",
          "action": "core/if",
          "args": {
            "condition": "$watch$"
          },
          "children": [
            {
              "id": "s12",
              "action": "ooa.desktop/message_box",
              "args": {
                "title": "RW06-B4 starts",
                "message": "RW06-B4 Human review coordinator\n\nFor each claim: opens a ServiceNow task with a redacted summary and evidence links, assigns an independent test reviewer, waits for approve, reject or request-info, reassigns on a timeout, records comments, signs the approval (no ERP draft without it), resumes by run id and audits every transition.\n\nRecords: 10 claims (the scored ones)\nRun: ${run_id}",
                "timeout_seconds": 4,
                "icon": "information",
                "always_on_top": true
              },
              "description": "Message box that closes by itself"
            }
          ],
          "description": "Show what is happening (watch is on)"
        }
      ],
      "description": "1. Start"
    },
    {
      "id": "s13",
      "action": "core/step",
      "args": {
        "title": "2. Prepare"
      },
      "children": [
        {
          "id": "s14",
          "action": "core/comment",
          "args": {
            "text": "Read the decisions and the extracted fields; 8. read this run's checkpoint to resume."
          }
        },
        {
          "id": "s15",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "ne",
              "left": "$fault_profile$",
              "right": "none"
            }
          },
          "children": [
            {
              "id": "s16",
              "action": "ooa.rest/request",
              "args": {
                "method": "POST",
                "url": "${standin}/qa/faults",
                "json": {
                  "service": "servicenow",
                  "profile": "$fault_profile$",
                  "run_id": "$run_id$"
                }
              },
              "description": "Arm the stand-in's injected faults for this service"
            }
          ],
          "description": "Resilience run: arm the stand-in's faults"
        },
        {
          "id": "s17",
          "action": "core/if",
          "args": {
            "condition": {
              "condition": "ooa.file/exists",
              "args": {
                "path": "${base}/output/${run_id}/RW06-B3/evidence.csv"
              }
            }
          },
          "children": [
            {
              "id": "s18",
              "action": "ooa.csv/read",
              "args": {
                "path": "${base}/output/${run_id}/RW06-B3/evidence.csv"
              },
              "out": {
                "table": "records"
              },
              "description": "Read RW06-B3 evidence"
            }
          ],
          "description": "RW06-B3 ran in this run?",
          "else": [
            {
              "id": "s19",
              "action": "core/comment",
              "args": {
                "text": "Running on its own: use the fixture, a saved copy of RW06-B3's evidence from a checked run."
              }
            },
            {
              "id": "s20",
              "action": "ooa.csv/read",
              "args": {
                "path": "${base}/data/RW06/fixtures/RW06-B3-evidence.csv"
              },
              "out": {
                "table": "records"
              },
              "description": "Read RW06-B3 evidence (fixture)"
            }
          ]
        },
        {
          "id": "s21",
          "action": "core/if",
          "args": {
            "condition": {
              "condition": "ooa.file/exists",
              "args": {
                "path": "${base}/output/${run_id}/RW06-B2/evidence.csv"
              }
            }
          },
          "children": [
            {
              "id": "s22",
              "action": "ooa.csv/read",
              "args": {
                "path": "${base}/output/${run_id}/RW06-B2/evidence.csv"
              },
              "out": {
                "table": "b2"
              },
              "description": "Read RW06-B2 evidence"
            }
          ],
          "description": "RW06-B2 ran in this run?",
          "else": [
            {
              "id": "s23",
              "action": "core/comment",
              "args": {
                "text": "Running on its own: use the fixture, a saved copy of RW06-B2's evidence from a checked run."
              }
            },
            {
              "id": "s24",
              "action": "ooa.csv/read",
              "args": {
                "path": "${base}/data/RW06/fixtures/RW06-B2-evidence.csv"
              },
              "out": {
                "table": "b2"
              },
              "description": "Read RW06-B2 evidence (fixture)"
            }
          ]
        },
        {
          "id": "s25",
          "action": "core/if",
          "args": {
            "condition": {
              "condition": "ooa.file/exists",
              "args": {
                "path": "${out_dir}/evidence.csv"
              }
            }
          },
          "children": [
            {
              "id": "s26",
              "action": "ooa.csv/read",
              "args": {
                "path": "${out_dir}/evidence.csv"
              },
              "out": {
                "table": "done"
              },
              "description": "Read it"
            }
          ],
          "description": "A checkpoint from an earlier try of this run?"
        }
      ],
      "description": "2. Prepare"
    },
    {
      "id": "s27",
      "action": "core/step",
      "args": {
        "title": "3. Work through the records"
      },
      "children": [
        {
          "id": "s28",
          "action": "core/comment",
          "args": {
            "text": "Per claim: task with redacted summary, independent reviewer, wait (reassign on timeout), comments, signed approval, audit."
          }
        },
        {
          "id": "s29",
          "action": "core/loop",
          "args": {
            "iterator": "table_rows",
            "over": "$records$",
            "as": "rec",
            "index": "i"
          },
          "children": [
            {
              "id": "s30",
              "action": "core/set",
              "args": {
                "variable": "rec_note",
                "value": ""
              },
              "description": "Clear the note of the previous record"
            },
            {
              "id": "s31",
              "action": "core/try",
              "args": {},
              "children": [
                {
                  "id": "s32",
                  "action": "ooa.datatable/lookup",
                  "args": {
                    "table": "$done$",
                    "column": "key",
                    "value": "$rec.key$",
                    "return_column": "status",
                    "if_not_found": ""
                  },
                  "out": {
                    "value": "prev"
                  },
                  "description": "8. Decided in an earlier try of this run?"
                },
                {
                  "id": "s33",
                  "action": "core/if",
                  "args": {
                    "condition": "not isEmpty($prev$)"
                  },
                  "children": [
                    {
                      "id": "s34",
                      "action": "ooa.datatable/filter",
                      "args": {
                        "table": "$done$",
                        "column": "key",
                        "operator": "eq",
                        "value": "$rec.key$"
                      },
                      "out": {
                        "table": "again"
                      },
                      "description": "The earlier row"
                    },
                    {
                      "id": "s35",
                      "action": "ooa.datatable/merge",
                      "args": {
                        "tables": [
                          "$evidence$",
                          "$again$"
                        ]
                      },
                      "out": {
                        "table": "evidence"
                      },
                      "description": "Carry it over"
                    },
                    {
                      "id": "s36",
                      "action": "core/set",
                      "args": {
                        "variable": "rec_note",
                        "value": "resumed: ${prev}"
                      },
                      "description": "Note"
                    }
                  ],
                  "description": "Resume",
                  "else": [
                    {
                      "id": "s37",
                      "action": "ooa.datatable/lookup",
                      "args": {
                        "table": "$b2$",
                        "column": "key",
                        "value": "$rec.key$",
                        "return_column": "claimant"
                      },
                      "out": {
                        "value": "claimant"
                      },
                      "description": "Claimant (kept out of the summary)"
                    },
                    {
                      "id": "s38",
                      "action": "core/set",
                      "args": {
                        "variable": "reviewer",
                        "value": {
                          "expr": "if(toNumber($rec.approved_amount$) > 5000, 'reviewer.senior@ooa-qa.test', 'reviewer.claims@ooa-qa.test')"
                        }
                      },
                      "description": "2. Test reviewer by amount"
                    },
                    {
                      "id": "s39",
                      "action": "core/if",
                      "args": {
                        "condition": {
                          "op": "eq",
                          "left": "$reviewer$",
                          "right": "claims-bot@ooa-qa.test"
                        }
                      },
                      "children": [
                        {
                          "id": "s40",
                          "action": "core/set",
                          "args": {
                            "variable": "reviewer",
                            "value": "reviewer.backup@ooa-qa.test"
                          },
                          "description": "Independent reviewer"
                        }
                      ],
                      "description": "4. Reviewer is the requester?"
                    },
                    {
                      "id": "s41",
                      "action": "core/set",
                      "args": {
                        "variable": "summary",
                        "value": "Claim ${rec.claim_id} on ${rec.policy}: amount ${rec.amount}, rules approve ${rec.approved_amount}; ${rec.decision} (${rec.reasons}). Claimant: [redacted]. Evidence: ${base}/output/${run_id}/RW06-B2/evidence.csv"
                      },
                      "description": "1. Redacted summary with evidence link"
                    },
                    {
                      "id": "s42",
                      "action": "ooa.servicenow/create_record",
                      "args": {
                        "table": "sc_task",
                        "fields": {
                          "short_description": "OOA-QA ${run_id} claim review ${rec.claim_id}",
                          "description": "$summary$",
                          "assigned_to": "$reviewer$",
                          "correlation_id": "OOA-QA-${run_id}-${rec.key}"
                        },
                        "instance_url": "$standin$",
                        "access_token": {
                          "$credential": "rw_qa_standins/servicenow/token"
                        }
                      },
                      "out": {
                        "record": "task"
                      },
                      "retry": {
                        "max": 3,
                        "backoff": "exponential",
                        "delayMs": 1000
                      },
                      "description": "1. Review task"
                    },
                    {
                      "id": "s43",
                      "action": "ooa.rest/request",
                      "args": {
                        "method": "POST",
                        "url": "${standin}/approvals/requests",
                        "bearer_token": {
                          "$credential": "rw_qa_standins/servicenow/token"
                        },
                        "json": {
                          "subject": "$rec.claim_id$",
                          "approver": "$reviewer$",
                          "requester": "claims-bot@ooa-qa.test",
                          "run": "$run_id$",
                          "task": "$task.number$"
                        }
                      },
                      "out": {
                        "json": "req"
                      },
                      "retry": {
                        "max": 3,
                        "backoff": "exponential",
                        "delayMs": 1000
                      },
                      "description": "3. Ask the reviewer"
                    },
                    {
                      "id": "s44",
                      "action": "core/set",
                      "args": {
                        "variable": "status",
                        "value": "pending"
                      },
                      "description": "Waiting"
                    },
                    {
                      "id": "s45",
                      "action": "core/set",
                      "args": {
                        "variable": "reassigned",
                        "value": false
                      },
                      "description": "Not reassigned"
                    },
                    {
                      "id": "s46",
                      "action": "core/set",
                      "args": {
                        "variable": "tries",
                        "value": 0
                      },
                      "description": "Count"
                    },
                    {
                      "id": "s47",
                      "action": "core/loop",
                      "args": {
                        "iterator": "while",
                        "condition": "$status$ == 'pending' and $tries$ < 3",
                        "max_iterations": 4
                      },
                      "children": [
                        {
                          "id": "s48",
                          "action": "core/delay",
                          "args": {
                            "seconds": 1
                          },
                          "description": "Wait a second"
                        },
                        {
                          "id": "s49",
                          "action": "core/set",
                          "args": {
                            "variable": "tries",
                            "value": {
                              "expr": "$tries$ + 1"
                            }
                          },
                          "description": "Count"
                        },
                        {
                          "id": "s50",
                          "action": "ooa.rest/request",
                          "args": {
                            "url": "${standin}/approvals/requests/${req.id}",
                            "bearer_token": {
                              "$credential": "rw_qa_standins/servicenow/token"
                            }
                          },
                          "out": {
                            "json": "ans"
                          },
                          "description": "Read the answer"
                        },
                        {
                          "id": "s51",
                          "action": "core/set",
                          "args": {
                            "variable": "status",
                            "value": "$ans.status$"
                          },
                          "description": "Its state"
                        }
                      ],
                      "description": "3. Wait for the answer"
                    },
                    {
                      "id": "s52",
                      "action": "core/if",
                      "args": {
                        "condition": {
                          "op": "eq",
                          "left": "$status$",
                          "right": "pending"
                        }
                      },
                      "children": [
                        {
                          "id": "s53",
                          "action": "core/set",
                          "args": {
                            "variable": "reviewer",
                            "value": "reviewer.backup@ooa-qa.test"
                          },
                          "description": "Backup reviewer"
                        },
                        {
                          "id": "s54",
                          "action": "core/set",
                          "args": {
                            "variable": "reassigned",
                            "value": true
                          },
                          "description": "Reassigned"
                        },
                        {
                          "id": "s55",
                          "action": "ooa.servicenow/update_record",
                          "args": {
                            "table": "sc_task",
                            "sys_id": "$task.sys_id$",
                            "fields": {
                              "assigned_to": "$reviewer$",
                              "work_notes": "Reassigned after a timeout"
                            },
                            "instance_url": "$standin$",
                            "access_token": {
                              "$credential": "rw_qa_standins/servicenow/token"
                            }
                          },
                          "description": "Reassign the task"
                        },
                        {
                          "id": "s56",
                          "action": "ooa.rest/request",
                          "args": {
                            "method": "POST",
                            "url": "${standin}/approvals/requests",
                            "bearer_token": {
                              "$credential": "rw_qa_standins/servicenow/token"
                            },
                            "json": {
                              "subject": "${rec.claim_id}#2",
                              "approver": "$reviewer$",
                              "requester": "claims-bot@ooa-qa.test",
                              "run": "$run_id$"
                            }
                          },
                          "out": {
                            "json": "req"
                          },
                          "retry": {
                            "max": 3,
                            "backoff": "exponential",
                            "delayMs": 1000
                          },
                          "description": "Ask the backup reviewer"
                        },
                        {
                          "id": "s57",
                          "action": "ooa.rest/request",
                          "args": {
                            "url": "${standin}/approvals/requests/${req.id}",
                            "bearer_token": {
                              "$credential": "rw_qa_standins/servicenow/token"
                            }
                          },
                          "out": {
                            "json": "ans"
                          },
                          "description": "Read the answer"
                        },
                        {
                          "id": "s58",
                          "action": "core/set",
                          "args": {
                            "variable": "status",
                            "value": "$ans.status$"
                          },
                          "description": "Its state"
                        }
                      ],
                      "description": "5. Timeout: reassign"
                    },
                    {
                      "id": "s59",
                      "action": "ooa.servicenow/update_record",
                      "args": {
                        "table": "sc_task",
                        "sys_id": "$task.sys_id$",
                        "fields": {
                          "work_notes": "Reviewer ${reviewer}: ${status}",
                          "state": {
                            "expr": "if($status$ == 'approved', '3', '4')"
                          }
                        },
                        "instance_url": "$standin$",
                        "access_token": {
                          "$credential": "rw_qa_standins/servicenow/token"
                        }
                      },
                      "description": "6. Record the reviewer's answer"
                    },
                    {
                      "id": "s60",
                      "action": "ooa.log/write",
                      "args": {
                        "path": "$log_file$",
                        "message": "${rec.claim_id}: review ${status} by ${reviewer} (task ${task.number})"
                      },
                      "description": "9. Audit the transition"
                    },
                    {
                      "id": "s61",
                      "action": "core/if",
                      "args": {
                        "condition": {
                          "op": "ne",
                          "left": "$status$",
                          "right": "approved"
                        }
                      },
                      "children": [
                        {
                          "id": "s62",
                          "action": "core/throw",
                          "args": {
                            "code": "REVIEW.NOT_APPROVED",
                            "message": "${rec.claim_id}: the reviewer answered ${status}"
                          },
                          "description": "7. No ERP draft"
                        }
                      ],
                      "description": "Not approved?"
                    },
                    {
                      "id": "s63",
                      "action": "ooa.crypto/hmac",
                      "args": {
                        "text": "${rec.claim_id}|${rec.approved_amount}|${req.id}",
                        "key": {
                          "$credential": "rw_qa_standins/sign_key/token"
                        }
                      },
                      "out": {
                        "signature": "token"
                      },
                      "description": "7. Sign the approval (the ERP adapter checks it)"
                    },
                    {
                      "id": "s64",
                      "action": "ooa.datatable/add_row",
                      "args": {
                        "table": "$evidence$",
                        "values": {
                          "key": "$rec.key$",
                          "claim_id": "$rec.claim_id$",
                          "task": "$task.number$",
                          "reviewer": "$reviewer$",
                          "status": "approved",
                          "approved_amount": "$rec.approved_amount$",
                          "approval_id": "$req.id$",
                          "token": "$token$"
                        }
                      },
                      "out": {
                        "table": "evidence"
                      },
                      "description": "Approved claim"
                    },
                    {
                      "id": "s65",
                      "action": "core/set",
                      "args": {
                        "variable": "evidence_file",
                        "value": "${out_dir}/evidence.csv"
                      },
                      "description": "Name of the evidence file"
                    },
                    {
                      "id": "s66",
                      "action": "ooa.datatable/write_to_file",
                      "args": {
                        "table": "$evidence$",
                        "path": "$evidence_file$"
                      },
                      "description": "Save the evidence rows"
                    },
                    {
                      "id": "s67",
                      "action": "core/set",
                      "args": {
                        "variable": "rec_note",
                        "value": "approved by ${reviewer}"
                      },
                      "description": "Note"
                    }
                  ]
                },
                {
                  "id": "s68",
                  "action": "ooa.datatable/add_row",
                  "args": {
                    "table": "$results$",
                    "values": {
                      "key": "$rec.key$",
                      "status": "done",
                      "note": "$rec_note$",
                      "time": "${formatDate(now(), '%H:%M:%S')}"
                    }
                  },
                  "out": {
                    "table": "results"
                  },
                  "description": "Add the record's result to the results table"
                },
                {
                  "id": "s69",
                  "action": "core/set",
                  "args": {
                    "variable": "processed",
                    "value": {
                      "expr": "$processed$ + 1"
                    }
                  },
                  "description": "Count the record as handled"
                },
                {
                  "id": "s70",
                  "action": "core/if",
                  "args": {
                    "condition": "$watch$"
                  },
                  "children": [
                    {
                      "id": "s71",
                      "action": "ooa.desktop/message_box",
                      "args": {
                        "title": "RW06-B4 - record ${rec.key}",
                        "message": "RW06-B4: record ${$i + 1} of ${len($records$)}\n\n${rec.claim_id}: reviewer ${reviewer}\nAnswer: ${status}${if($reassigned$, ' (reassigned)', '')}",
                        "timeout_seconds": 2,
                        "icon": "information",
                        "always_on_top": true
                      },
                      "description": "Message box that closes by itself"
                    }
                  ],
                  "description": "Show what is happening (watch is on)"
                }
              ],
              "description": "Handle one record; a failure is caught below and the next record goes on",
              "catch": [
                {
                  "codes": [
                    "*"
                  ],
                  "children": [
                    {
                      "id": "s72",
                      "action": "core/comment",
                      "args": {
                        "text": "The record failed: keep the reason, count it as an exception and go on with the next one."
                      }
                    },
                    {
                      "id": "s73",
                      "action": "ooa.datatable/add_row",
                      "args": {
                        "table": "$results$",
                        "values": {
                          "key": "$rec.key$",
                          "status": "exception",
                          "note": "${err.code}: ${err_msg}",
                          "time": "${formatDate(now(), '%H:%M:%S')}"
                        }
                      },
                      "out": {
                        "table": "results"
                      },
                      "description": "Add the failure to the results table"
                    },
                    {
                      "id": "s74",
                      "action": "core/set",
                      "args": {
                        "variable": "exceptions",
                        "value": {
                          "expr": "$exceptions$ + 1"
                        }
                      },
                      "description": "Count the exception"
                    },
                    {
                      "id": "s75",
                      "action": "ooa.log/write",
                      "args": {
                        "path": "$log_file$",
                        "level": "WARN",
                        "message": "Record ${rec.key}: ${err.code} ${err_msg}"
                      },
                      "description": "Log the exception"
                    },
                    {
                      "id": "s76",
                      "action": "core/if",
                      "args": {
                        "condition": "$watch$"
                      },
                      "children": [
                        {
                          "id": "s77",
                          "action": "ooa.desktop/message_box",
                          "args": {
                            "title": "RW06-B4 - exception",
                            "message": "RW06-B4: record ${rec.key} went to the exception list\n\n${err.code}: ${err_msg}",
                            "timeout_seconds": 3,
                            "icon": "warning",
                            "always_on_top": true
                          },
                          "description": "Message box that closes by itself"
                        }
                      ],
                      "description": "Show what is happening (watch is on)"
                    }
                  ],
                  "as": "err",
                  "message_to": "err_msg"
                }
              ]
            },
            {
              "id": "s78",
              "action": "core/if",
              "args": {
                "condition": "$watch$"
              },
              "children": [
                {
                  "id": "s79",
                  "action": "core/delay",
                  "args": {
                    "seconds": "$pause_seconds$"
                  },
                  "description": "Short pause"
                }
              ],
              "description": "Pause so the screen can be followed (watch is on)"
            }
          ],
          "description": "Once for each of the 10 claims (the scored ones)"
        }
      ],
      "description": "3. Work through the records"
    },
    {
      "id": "s80",
      "action": "core/step",
      "args": {
        "title": "4. Finish"
      },
      "children": [
        {
          "id": "s81",
          "action": "core/comment",
          "args": {
            "text": "Save the results, set the outputs and say how it went."
          }
        },
        {
          "id": "s82",
          "action": "core/set",
          "args": {
            "variable": "evidence_file",
            "value": "${out_dir}/evidence.csv"
          },
          "description": "Name of the evidence file"
        },
        {
          "id": "s83",
          "action": "ooa.datatable/write_to_file",
          "args": {
            "table": "$evidence$",
            "path": "$evidence_file$"
          },
          "description": "Save the evidence rows"
        },
        {
          "id": "s84",
          "action": "core/set",
          "args": {
            "variable": "result_file",
            "value": "${out_dir}/results.csv"
          },
          "description": "Name of the results file"
        },
        {
          "id": "s85",
          "action": "ooa.datatable/write_to_file",
          "args": {
            "table": "$results$",
            "path": "$result_file$"
          },
          "description": "Save one row per record"
        },
        {
          "id": "s86",
          "action": "core/set",
          "args": {
            "variable": "status",
            "value": "success"
          },
          "description": "Every record was handled (exceptions are routed, not lost)"
        },
        {
          "id": "s87",
          "action": "ooa.log/write",
          "args": {
            "path": "$log_file$",
            "message": "RW06-B4 Human review coordinator finished: ${processed} handled, ${exceptions} exceptions"
          },
          "description": "Log the end"
        },
        {
          "id": "s88",
          "action": "core/if",
          "args": {
            "condition": "$watch$"
          },
          "children": [
            {
              "id": "s89",
              "action": "ooa.desktop/message_box",
              "args": {
                "title": "RW06-B4 finished",
                "message": "RW06-B4 Human review coordinator finished\n\nHandled: ${processed}\nExceptions: ${exceptions}\nResults: ${result_file}",
                "timeout_seconds": 4,
                "icon": "information",
                "always_on_top": true
              },
              "description": "Message box that closes by itself"
            }
          ],
          "description": "Show what is happening (watch is on)"
        }
      ],
      "description": "4. Finish"
    }
  ]
}
