{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "rw06_b1",
  "name": "RW06-B1 Document intake and split",
  "description": "RW06-B1 (RW06 real-world test). Reads the 10 tagged claim mails, checks the sender's tenant, validates type and size, drops duplicate packs by hash, splits each pack into its documents at the separator pages, classifies each document, gives it a document id, stores it in the QA library with a retention label and checkpoints the input ids.",
  "tags": [
    "real-world-test",
    "RW06"
  ],
  "variables": [
    {
      "name": "base",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Real-world tests",
      "description": "Folder of the real-world tests: data, output and the stand-in server."
    },
    {
      "name": "run_id",
      "type": "String",
      "direction": "input",
      "default": "",
      "description": "Run id shared by a main agent and its children; made here when empty."
    },
    {
      "name": "standin",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local QA stand-in server (127.0.0.1 only)."
    },
    {
      "name": "watch",
      "type": "Boolean",
      "direction": "input",
      "default": true,
      "description": "Show message boxes and pause between records so a person can follow the run."
    },
    {
      "name": "pause_seconds",
      "type": "Number",
      "direction": "input",
      "default": 1,
      "description": "Pause after each record when watch is on."
    },
    {
      "name": "fault_profile",
      "type": "String",
      "direction": "input",
      "default": "none",
      "description": "none, or resilience: the stand-ins inject the five failures of runbook step 09."
    },
    {
      "name": "info",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "out_dir",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "log_file",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "records",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "rec",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "i",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "err",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "err_msg",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "rec_status",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "rec_note",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "started",
      "type": "DateTime",
      "direction": "local"
    },
    {
      "name": "results",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "key",
          "status",
          "note",
          "time"
        ],
        "rows": []
      }
    },
    {
      "name": "processed",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Records handled without an error."
    },
    {
      "name": "exceptions",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Records routed to the exception list."
    },
    {
      "name": "status",
      "type": "String",
      "direction": "output",
      "default": "not_run",
      "description": "success when every record was handled (routed exceptions included)."
    },
    {
      "name": "result_file",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "CSV file with one row per record."
    },
    {
      "name": "mail",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "files",
      "type": "List",
      "direction": "local"
    },
    {
      "name": "pack",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "sha",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "seen",
      "type": "List",
      "direction": "local",
      "default": []
    },
    {
      "name": "pages",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "pg",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "ptext",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "ranges",
      "type": "List",
      "direction": "local",
      "default": []
    },
    {
      "name": "start",
      "type": "Number",
      "direction": "local",
      "default": 1
    },
    {
      "name": "parts",
      "type": "List",
      "direction": "local"
    },
    {
      "name": "part",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "dtext",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "dtype",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "doc_id",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "n",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "docs",
      "type": "List",
      "direction": "local",
      "default": []
    },
    {
      "name": "item",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "sender_domain",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "max_mb",
      "type": "Number",
      "direction": "input",
      "default": 10,
      "description": "Largest pack accepted (MB)."
    },
    {
      "name": "evidence",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "key",
          "claim_id",
          "mail_id",
          "pack",
          "hash",
          "pages",
          "documents",
          "types",
          "library"
        ],
        "rows": []
      }
    },
    {
      "name": "evidence_file",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "Evidence rows of this agent (one per record)."
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "1. Start"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "What this agent does: Reads the 10 tagged claim mails, checks the sender's tenant, validates type and size, drops duplicate packs by hash, splits each pack into its documents at the separator pages, classifies each document, gives it a document id, stores it in the QA library with a retention label and checkpoints the input ids. It works through 10 synthetic claim packs and writes its results to the run's output folder."
          }
        },
        {
          "id": "s3",
          "action": "ooa.run_context/get",
          "args": {},
          "out": {
            "info": "info"
          },
          "description": "Read the run context (run id, runner, user)"
        },
        {
          "id": "s4",
          "action": "core/set",
          "args": {
            "variable": "started",
            "value": {
              "expr": "now()"
            }
          },
          "description": "Remember when the agent started"
        },
        {
          "id": "s5",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "empty",
              "left": "$run_id$"
            }
          },
          "children": [
            {
              "id": "s6",
              "action": "core/set",
              "args": {
                "variable": "run_id",
                "value": "SOLO-${formatDate(now(), '%Y%m%d-%H%M%S')}"
              },
              "description": "Run id for a run on its own"
            }
          ],
          "description": "Running on its own: make a run id"
        },
        {
          "id": "s7",
          "action": "core/set",
          "args": {
            "variable": "out_dir",
            "value": "${base}/output/${run_id}/RW06-B1"
          },
          "description": "This agent's output folder for the run"
        },
        {
          "id": "s8",
          "action": "ooa.folder/create",
          "args": {
            "path": "$out_dir$"
          },
          "description": "Create the output folder"
        },
        {
          "id": "s9",
          "action": "core/set",
          "args": {
            "variable": "log_file",
            "value": "${out_dir}/log.txt"
          },
          "description": "Log file of this agent"
        },
        {
          "id": "s10",
          "action": "ooa.log/write",
          "args": {
            "path": "$log_file$",
            "message": "RW06-B1 Document intake and split started; run ${run_id}; computer ${info.device}, user ${info.os_user}"
          },
          "description": "Log the start"
        },
        {
          "id": "s11",
          "action": "core/if",
          "args": {
            "condition": "$watch$"
          },
          "children": [
            {
              "id": "s12",
              "action": "ooa.desktop/message_box",
              "args": {
                "title": "RW06-B1 starts",
                "message": "RW06-B1 Document intake and split\n\nReads the 10 tagged claim mails, checks the sender's tenant, validates type and size, drops duplicate packs by hash, splits each pack into its documents at the separator pages, classifies each document, gives it a document id, stores it in the QA library with a retention label and checkpoints the input ids.\n\nRecords: 10 synthetic claim packs\nRun: ${run_id}",
                "timeout_seconds": 4,
                "icon": "information",
                "always_on_top": true
              },
              "description": "Message box that closes by itself"
            }
          ],
          "description": "Show what is happening (watch is on)"
        }
      ],
      "description": "1. Start"
    },
    {
      "id": "s13",
      "action": "core/step",
      "args": {
        "title": "2. Prepare"
      },
      "children": [
        {
          "id": "s14",
          "action": "core/comment",
          "args": {
            "text": "Folders for the packs and their documents."
          }
        },
        {
          "id": "s15",
          "action": "ooa.csv/read",
          "args": {
            "path": "${base}/data/RW06/claims.csv"
          },
          "out": {
            "table": "records"
          },
          "description": "Read the test records (RW06/claims.csv)"
        },
        {
          "id": "s16",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "ne",
              "left": "$fault_profile$",
              "right": "none"
            }
          },
          "children": [
            {
              "id": "s17",
              "action": "ooa.rest/request",
              "args": {
                "method": "POST",
                "url": "${standin}/qa/faults",
                "json": {
                  "service": "graph",
                  "profile": "$fault_profile$",
                  "run_id": "$run_id$"
                }
              },
              "description": "Arm the stand-in's injected faults for this service"
            }
          ],
          "description": "Resilience run: arm the stand-in's faults"
        },
        {
          "id": "s18",
          "action": "ooa.folder/create",
          "args": {
            "path": "${out_dir}/documents"
          },
          "description": "Folder for the split documents"
        }
      ],
      "description": "2. Prepare"
    },
    {
      "id": "s19",
      "action": "core/step",
      "args": {
        "title": "3. Work through the records"
      },
      "children": [
        {
          "id": "s20",
          "action": "core/comment",
          "args": {
            "text": "Per pack: tenant, type and size, hash, split at separators, classify, ids, retention label, library, checkpoint."
          }
        },
        {
          "id": "s21",
          "action": "core/loop",
          "args": {
            "iterator": "table_rows",
            "over": "$records$",
            "as": "rec",
            "index": "i"
          },
          "children": [
            {
              "id": "s22",
              "action": "core/set",
              "args": {
                "variable": "rec_note",
                "value": ""
              },
              "description": "Clear the note of the previous record"
            },
            {
              "id": "s23",
              "action": "core/try",
              "args": {},
              "children": [
                {
                  "id": "s24",
                  "action": "ooa.microsoft365/get_mail",
                  "args": {
                    "id": "$rec.mail_id$",
                    "mark_read": false,
                    "body_as_text": true,
                    "access_token": {
                      "$credential": "rw_qa_standins/graph/token"
                    },
                    "base_url": "${standin}/graph/v1.0",
                    "mailbox": "claims-qa@ooa-qa.test"
                  },
                  "out": {
                    "email": "mail"
                  },
                  "retry": {
                    "max": 3,
                    "backoff": "exponential",
                    "delayMs": 1000
                  },
                  "description": "1. Read the tagged claim mail"
                },
                {
                  "id": "s25",
                  "action": "core/set",
                  "args": {
                    "variable": "sender_domain",
                    "value": {
                      "expr": "lower(last(split($mail.from$, '@')))"
                    }
                  },
                  "description": "Sender's domain"
                },
                {
                  "id": "s26",
                  "action": "core/if",
                  "args": {
                    "condition": "not endsWith($sender_domain$, 'ooa-qa.test')"
                  },
                  "children": [
                    {
                      "id": "s27",
                      "action": "core/throw",
                      "args": {
                        "code": "ROUTE.TENANT",
                        "message": "${rec.claim_id} came from ${sender_domain}, not the QA tenant"
                      },
                      "description": "Reject: wrong tenant"
                    }
                  ],
                  "description": "2. Sender outside the QA tenant?"
                },
                {
                  "id": "s28",
                  "action": "ooa.microsoft365/save_mail_attachments",
                  "args": {
                    "id": "$rec.mail_id$",
                    "target_folder": "${out_dir}/packs/${rec.key}",
                    "overwrite": true,
                    "include_inline": false,
                    "access_token": {
                      "$credential": "rw_qa_standins/graph/token"
                    },
                    "base_url": "${standin}/graph/v1.0",
                    "mailbox": "claims-qa@ooa-qa.test"
                  },
                  "out": {
                    "files": "files"
                  },
                  "retry": {
                    "max": 3,
                    "backoff": "exponential",
                    "delayMs": 1000
                  },
                  "description": "Save the pack"
                },
                {
                  "id": "s29",
                  "action": "core/set",
                  "args": {
                    "variable": "pack",
                    "value": {
                      "expr": "first($files$)"
                    }
                  },
                  "description": "The pack file"
                },
                {
                  "id": "s30",
                  "action": "ooa.file/get_info",
                  "args": {
                    "path": "$pack$"
                  },
                  "out": {
                    "info": "info"
                  },
                  "description": "3. Type and size"
                },
                {
                  "id": "s31",
                  "action": "core/if",
                  "args": {
                    "condition": "lower($info.extension$) != 'pdf' or toNumber($info.size_bytes$) > $max_mb$ * 1048576"
                  },
                  "children": [
                    {
                      "id": "s32",
                      "action": "ooa.microsoft365/move_mail",
                      "args": {
                        "id": "$rec.mail_id$",
                        "to_folder": "rejected",
                        "access_token": {
                          "$credential": "rw_qa_standins/graph/token"
                        },
                        "base_url": "${standin}/graph/v1.0",
                        "mailbox": "claims-qa@ooa-qa.test"
                      },
                      "description": "Route it to Rejected"
                    },
                    {
                      "id": "s33",
                      "action": "core/throw",
                      "args": {
                        "code": "VALIDATION.MIME",
                        "message": "${rec.claim_id}: ${info.name} is not an accepted PDF pack"
                      },
                      "description": "Reject the pack"
                    }
                  ],
                  "description": "Not a PDF or too large?"
                },
                {
                  "id": "s34",
                  "action": "ooa.crypto/hash_file",
                  "args": {
                    "path": "$pack$"
                  },
                  "out": {
                    "hash": "sha"
                  },
                  "description": "4. Hash the pack"
                },
                {
                  "id": "s35",
                  "action": "core/if",
                  "args": {
                    "condition": {
                      "op": "contains",
                      "left": "$seen$",
                      "right": "$sha$"
                    }
                  },
                  "children": [
                    {
                      "id": "s36",
                      "action": "ooa.microsoft365/move_mail",
                      "args": {
                        "id": "$rec.mail_id$",
                        "to_folder": "duplicates",
                        "access_token": {
                          "$credential": "rw_qa_standins/graph/token"
                        },
                        "base_url": "${standin}/graph/v1.0",
                        "mailbox": "claims-qa@ooa-qa.test"
                      },
                      "description": "Route the duplicate"
                    },
                    {
                      "id": "s37",
                      "action": "core/throw",
                      "args": {
                        "code": "ROUTE.DUPLICATE",
                        "message": "${rec.claim_id}: the same pack arrived before"
                      },
                      "description": "Drop the duplicate"
                    }
                  ],
                  "description": "Same pack seen already?"
                },
                {
                  "id": "s38",
                  "action": "ooa.list/add_item",
                  "args": {
                    "list": "$seen$",
                    "item": "$sha$"
                  },
                  "out": {
                    "list": "seen"
                  },
                  "description": "Remember the hash"
                },
                {
                  "id": "s39",
                  "action": "ooa.pdf/page_count",
                  "args": {
                    "path": "$pack$"
                  },
                  "out": {
                    "count": "pages"
                  },
                  "description": "Pages in the pack"
                },
                {
                  "id": "s40",
                  "action": "core/set",
                  "args": {
                    "variable": "ranges",
                    "value": []
                  },
                  "description": "No parts yet"
                },
                {
                  "id": "s41",
                  "action": "core/set",
                  "args": {
                    "variable": "start",
                    "value": 1
                  },
                  "description": "First part starts on page 1"
                },
                {
                  "id": "s42",
                  "action": "core/set",
                  "args": {
                    "variable": "pg",
                    "value": 0
                  },
                  "description": "Page counter"
                },
                {
                  "id": "s43",
                  "action": "core/loop",
                  "args": {
                    "iterator": "while",
                    "condition": "$pg$ < $pages$",
                    "max_iterations": 50
                  },
                  "children": [
                    {
                      "id": "s44",
                      "action": "core/set",
                      "args": {
                        "variable": "pg",
                        "value": {
                          "expr": "$pg$ + 1"
                        }
                      },
                      "description": "Next page"
                    },
                    {
                      "id": "s45",
                      "action": "ooa.pdf/extract_text",
                      "args": {
                        "path": "$pack$",
                        "from_page": "$pg$",
                        "to_page": "$pg$",
                        "mode": "plain"
                      },
                      "out": {
                        "text": "ptext"
                      },
                      "description": "Text of the page"
                    },
                    {
                      "id": "s46",
                      "action": "core/if",
                      "args": {
                        "condition": {
                          "op": "contains",
                          "left": "$ptext$",
                          "right": "OOA-QA SEPARATOR PAGE"
                        }
                      },
                      "children": [
                        {
                          "id": "s47",
                          "action": "ooa.list/add_item",
                          "args": {
                            "list": "$ranges$",
                            "item": "${start}-${$pg$ - 1}"
                          },
                          "out": {
                            "list": "ranges"
                          },
                          "description": "Close the part before it"
                        },
                        {
                          "id": "s48",
                          "action": "core/set",
                          "args": {
                            "variable": "start",
                            "value": {
                              "expr": "$pg$ + 1"
                            }
                          },
                          "description": "Next part starts after it"
                        }
                      ],
                      "description": "A separator page?"
                    }
                  ],
                  "description": "5. Find the separator pages"
                },
                {
                  "id": "s49",
                  "action": "ooa.list/add_item",
                  "args": {
                    "list": "$ranges$",
                    "item": "${start}-${pages}"
                  },
                  "out": {
                    "list": "ranges"
                  },
                  "description": "The last part"
                },
                {
                  "id": "s50",
                  "action": "ooa.pdf/split",
                  "args": {
                    "path": "$pack$",
                    "mode": "ranges",
                    "pages": {
                      "expr": "join($ranges$, ',')"
                    },
                    "target_folder": "${out_dir}/documents/${rec.key}",
                    "file_prefix": "${rec.claim_id}-"
                  },
                  "out": {
                    "files": "parts"
                  },
                  "description": "5. Split into documents"
                },
                {
                  "id": "s51",
                  "action": "core/set",
                  "args": {
                    "variable": "docs",
                    "value": []
                  },
                  "description": "No documents yet"
                },
                {
                  "id": "s52",
                  "action": "core/set",
                  "args": {
                    "variable": "n",
                    "value": 0
                  },
                  "description": "Document counter"
                },
                {
                  "id": "s53",
                  "action": "core/loop",
                  "args": {
                    "iterator": "list",
                    "over": "$parts$",
                    "as": "part"
                  },
                  "children": [
                    {
                      "id": "s54",
                      "action": "core/set",
                      "args": {
                        "variable": "n",
                        "value": {
                          "expr": "$n$ + 1"
                        }
                      },
                      "description": "Count it"
                    },
                    {
                      "id": "s55",
                      "action": "ooa.pdf/extract_text",
                      "args": {
                        "path": "$part$",
                        "to_page": 1,
                        "mode": "plain"
                      },
                      "out": {
                        "text": "dtext"
                      },
                      "description": "Its first lines"
                    },
                    {
                      "id": "s56",
                      "action": "core/set",
                      "args": {
                        "variable": "dtype",
                        "value": {
                          "expr": "if(contains($dtext$, 'CLAIM FORM'), 'claim_form', if(contains($dtext$, 'INVOICE'), 'invoice', if(contains($dtext$, 'POLICE REPORT'), 'police_report', 'other')))"
                        }
                      },
                      "description": "6. Classify it"
                    },
                    {
                      "id": "s57",
                      "action": "core/set",
                      "args": {
                        "variable": "doc_id",
                        "value": "OOA-QA-${run_id}-${rec.key}-D${n}"
                      },
                      "description": "7. Document id"
                    },
                    {
                      "id": "s58",
                      "action": "ooa.microsoft365/upload_file",
                      "args": {
                        "local_path": "$part$",
                        "remote_path": "OOA-QA/${run_id}/claims/${doc_id}-${dtype}.pdf",
                        "drive": "sites/ooa-qa/drive",
                        "access_token": {
                          "$credential": "rw_qa_standins/graph/token"
                        },
                        "base_url": "${standin}/graph/v1.0"
                      },
                      "out": {
                        "item_id": "item"
                      },
                      "retry": {
                        "max": 3,
                        "backoff": "exponential",
                        "delayMs": 1000
                      },
                      "description": "9. Store it in the QA library"
                    },
                    {
                      "id": "s59",
                      "action": "ooa.rest/request",
                      "args": {
                        "method": "PATCH",
                        "bearer_token": {
                          "$credential": "rw_qa_standins/graph/token"
                        },
                        "url": "${standin}/graph/v1.0/sites/ooa-qa/drive/items/${item}/retentionLabel",
                        "json": {
                          "name": "QA-Claims-7y"
                        }
                      },
                      "retry": {
                        "max": 3,
                        "backoff": "exponential",
                        "delayMs": 1000
                      },
                      "continueOnError": true,
                      "description": "8. Apply the retention label"
                    },
                    {
                      "id": "s60",
                      "action": "ooa.list/add_item",
                      "args": {
                        "list": "$docs$",
                        "item": "${dtype}:${part}"
                      },
                      "out": {
                        "list": "docs"
                      },
                      "description": "Remember it"
                    }
                  ],
                  "description": "Each document"
                },
                {
                  "id": "s61",
                  "action": "ooa.datatable/add_row",
                  "args": {
                    "table": "$evidence$",
                    "values": {
                      "key": "$rec.key$",
                      "claim_id": "$rec.claim_id$",
                      "mail_id": "$rec.mail_id$",
                      "pack": "$pack$",
                      "hash": "$sha$",
                      "pages": "$pages$",
                      "documents": {
                        "expr": "join($docs$, ';')"
                      },
                      "types": {
                        "expr": "len($docs$)"
                      },
                      "library": "OOA-QA/${run_id}/claims"
                    }
                  },
                  "out": {
                    "table": "evidence"
                  },
                  "description": "10. Checkpoint the input ids"
                },
                {
                  "id": "s62",
                  "action": "core/set",
                  "args": {
                    "variable": "evidence_file",
                    "value": "${out_dir}/evidence.csv"
                  },
                  "description": "Name of the evidence file"
                },
                {
                  "id": "s63",
                  "action": "ooa.datatable/write_to_file",
                  "args": {
                    "table": "$evidence$",
                    "path": "$evidence_file$"
                  },
                  "description": "Save the evidence rows"
                },
                {
                  "id": "s64",
                  "action": "core/set",
                  "args": {
                    "variable": "rec_note",
                    "value": "${len($docs$)} documents"
                  },
                  "description": "Note for the results"
                },
                {
                  "id": "s65",
                  "action": "ooa.datatable/add_row",
                  "args": {
                    "table": "$results$",
                    "values": {
                      "key": "$rec.key$",
                      "status": "done",
                      "note": "$rec_note$",
                      "time": "${formatDate(now(), '%H:%M:%S')}"
                    }
                  },
                  "out": {
                    "table": "results"
                  },
                  "description": "Add the record's result to the results table"
                },
                {
                  "id": "s66",
                  "action": "core/set",
                  "args": {
                    "variable": "processed",
                    "value": {
                      "expr": "$processed$ + 1"
                    }
                  },
                  "description": "Count the record as handled"
                },
                {
                  "id": "s67",
                  "action": "core/if",
                  "args": {
                    "condition": "$watch$"
                  },
                  "children": [
                    {
                      "id": "s68",
                      "action": "ooa.desktop/message_box",
                      "args": {
                        "title": "RW06-B1 - record ${rec.key}",
                        "message": "RW06-B1: record ${$i + 1} of ${len($records$)}\n\n${rec.claim_id}: ${pages} pages -> ${len($docs$)} documents\n${join($docs$, ', ')}",
                        "timeout_seconds": 2,
                        "icon": "information",
                        "always_on_top": true
                      },
                      "description": "Message box that closes by itself"
                    }
                  ],
                  "description": "Show what is happening (watch is on)"
                }
              ],
              "description": "Handle one record; a failure is caught below and the next record goes on",
              "catch": [
                {
                  "codes": [
                    "*"
                  ],
                  "children": [
                    {
                      "id": "s69",
                      "action": "core/comment",
                      "args": {
                        "text": "The record failed: keep the reason, count it as an exception and go on with the next one."
                      }
                    },
                    {
                      "id": "s70",
                      "action": "ooa.datatable/add_row",
                      "args": {
                        "table": "$results$",
                        "values": {
                          "key": "$rec.key$",
                          "status": "exception",
                          "note": "${err.code}: ${err_msg}",
                          "time": "${formatDate(now(), '%H:%M:%S')}"
                        }
                      },
                      "out": {
                        "table": "results"
                      },
                      "description": "Add the failure to the results table"
                    },
                    {
                      "id": "s71",
                      "action": "core/set",
                      "args": {
                        "variable": "exceptions",
                        "value": {
                          "expr": "$exceptions$ + 1"
                        }
                      },
                      "description": "Count the exception"
                    },
                    {
                      "id": "s72",
                      "action": "ooa.log/write",
                      "args": {
                        "path": "$log_file$",
                        "level": "WARN",
                        "message": "Record ${rec.key}: ${err.code} ${err_msg}"
                      },
                      "description": "Log the exception"
                    },
                    {
                      "id": "s73",
                      "action": "core/if",
                      "args": {
                        "condition": "$watch$"
                      },
                      "children": [
                        {
                          "id": "s74",
                          "action": "ooa.desktop/message_box",
                          "args": {
                            "title": "RW06-B1 - exception",
                            "message": "RW06-B1: record ${rec.key} went to the exception list\n\n${err.code}: ${err_msg}",
                            "timeout_seconds": 3,
                            "icon": "warning",
                            "always_on_top": true
                          },
                          "description": "Message box that closes by itself"
                        }
                      ],
                      "description": "Show what is happening (watch is on)"
                    }
                  ],
                  "as": "err",
                  "message_to": "err_msg"
                }
              ]
            },
            {
              "id": "s75",
              "action": "core/if",
              "args": {
                "condition": "$watch$"
              },
              "children": [
                {
                  "id": "s76",
                  "action": "core/delay",
                  "args": {
                    "seconds": "$pause_seconds$"
                  },
                  "description": "Short pause"
                }
              ],
              "description": "Pause so the screen can be followed (watch is on)"
            }
          ],
          "description": "Once for each of the 10 synthetic claim packs"
        }
      ],
      "description": "3. Work through the records"
    },
    {
      "id": "s77",
      "action": "core/step",
      "args": {
        "title": "4. Finish"
      },
      "children": [
        {
          "id": "s78",
          "action": "core/comment",
          "args": {
            "text": "Save the results, set the outputs and say how it went."
          }
        },
        {
          "id": "s79",
          "action": "core/set",
          "args": {
            "variable": "evidence_file",
            "value": "${out_dir}/evidence.csv"
          },
          "description": "Name of the evidence file"
        },
        {
          "id": "s80",
          "action": "ooa.datatable/write_to_file",
          "args": {
            "table": "$evidence$",
            "path": "$evidence_file$"
          },
          "description": "Save the evidence rows"
        },
        {
          "id": "s81",
          "action": "core/set",
          "args": {
            "variable": "result_file",
            "value": "${out_dir}/results.csv"
          },
          "description": "Name of the results file"
        },
        {
          "id": "s82",
          "action": "ooa.datatable/write_to_file",
          "args": {
            "table": "$results$",
            "path": "$result_file$"
          },
          "description": "Save one row per record"
        },
        {
          "id": "s83",
          "action": "core/set",
          "args": {
            "variable": "status",
            "value": "success"
          },
          "description": "Every record was handled (exceptions are routed, not lost)"
        },
        {
          "id": "s84",
          "action": "ooa.log/write",
          "args": {
            "path": "$log_file$",
            "message": "RW06-B1 Document intake and split finished: ${processed} handled, ${exceptions} exceptions"
          },
          "description": "Log the end"
        },
        {
          "id": "s85",
          "action": "core/if",
          "args": {
            "condition": "$watch$"
          },
          "children": [
            {
              "id": "s86",
              "action": "ooa.desktop/message_box",
              "args": {
                "title": "RW06-B1 finished",
                "message": "RW06-B1 Document intake and split finished\n\nHandled: ${processed}\nExceptions: ${exceptions}\nResults: ${result_file}",
                "timeout_seconds": 4,
                "icon": "information",
                "always_on_top": true
              },
              "description": "Message box that closes by itself"
            }
          ],
          "description": "Show what is happening (watch is on)"
        }
      ],
      "description": "4. Finish"
    }
  ]
}
