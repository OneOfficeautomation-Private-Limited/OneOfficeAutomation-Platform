{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "rw00_run_all",
  "name": "Run all eight",
  "description": "Runs the preflight, then the eight real-world test automations RW01-RW08 one after another, and sums up.",
  "tags": [
    "real-world-test",
    "shared"
  ],
  "variables": [
    {
      "name": "base",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Real-world tests",
      "description": "Folder of the real-world tests: data, output and the stand-in server."
    },
    {
      "name": "run_id",
      "type": "String",
      "direction": "input",
      "default": "",
      "description": "Run id shared by a main agent and its children; made here when empty."
    },
    {
      "name": "standin",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local QA stand-in server (127.0.0.1 only)."
    },
    {
      "name": "watch",
      "type": "Boolean",
      "direction": "input",
      "default": true,
      "description": "Show message boxes and pause between records so a person can follow the run."
    },
    {
      "name": "pause_seconds",
      "type": "Number",
      "direction": "input",
      "default": 1,
      "description": "Pause after each record when watch is on."
    },
    {
      "name": "fault_profile",
      "type": "String",
      "direction": "input",
      "default": "none",
      "description": "none, or resilience: the stand-ins inject the five failures of runbook step 09."
    },
    {
      "name": "concurrency",
      "type": "Number",
      "direction": "input",
      "default": 1,
      "description": "Passed to each main agent."
    },
    {
      "name": "r",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "rs",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "pre",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "summary",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "automation",
          "status"
        ],
        "rows": []
      }
    },
    {
      "name": "failed",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "status",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "success when all eight succeeded."
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "1. Preflight"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "Read-only checks first (runbook step 05)."
          }
        },
        {
          "id": "s3",
          "action": "core/run_bot",
          "args": {
            "automation": "rw00_preflight",
            "fail_on_error": false,
            "inputs": {
              "base": "$base$",
              "standin": "$standin$",
              "watch": "$watch$",
              "pause_seconds": "$pause_seconds$"
            }
          },
          "out": {
            "outputs": "pre"
          },
          "description": "Run the preflight"
        }
      ],
      "description": "1. Preflight"
    },
    {
      "id": "s4",
      "action": "core/step",
      "args": {
        "title": "2. The eight automations"
      },
      "children": [
        {
          "id": "s5",
          "action": "core/comment",
          "args": {
            "text": "One after another; each makes its own run id."
          }
        },
        {
          "id": "s6",
          "action": "core/if",
          "args": {
            "condition": "$watch$"
          },
          "children": [
            {
              "id": "s7",
              "action": "ooa.desktop/message_box",
              "args": {
                "title": "Run all eight",
                "message": "Next: RW01 Customer support",
                "timeout_seconds": 3,
                "icon": "information",
                "always_on_top": true
              },
              "description": "Message box that closes by itself"
            }
          ],
          "description": "Show what is happening (watch is on)"
        },
        {
          "id": "s8",
          "action": "core/run_bot",
          "args": {
            "automation": "rw01_main",
            "fail_on_error": false,
            "inputs": {
              "base": "$base$",
              "standin": "$standin$",
              "watch": "$watch$",
              "pause_seconds": "$pause_seconds$",
              "fault_profile": "$fault_profile$",
              "concurrency": "$concurrency$"
            }
          },
          "out": {
            "outputs": "r",
            "status": "rs"
          },
          "description": "Run RW01 Customer support"
        },
        {
          "id": "s9",
          "action": "ooa.datatable/add_row",
          "args": {
            "table": "$summary$",
            "values": {
              "automation": "RW01 Customer support",
              "status": "${r.status}"
            }
          },
          "out": {
            "table": "summary"
          },
          "description": "Note the result"
        },
        {
          "id": "s10",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "ne",
              "left": "${r.status}",
              "right": "success"
            }
          },
          "children": [
            {
              "id": "s11",
              "action": "core/set",
              "args": {
                "variable": "failed",
                "value": {
                  "expr": "$failed$ + 1"
                }
              },
              "description": "Count it"
            }
          ],
          "description": "Not a success?"
        },
        {
          "id": "s12",
          "action": "core/if",
          "args": {
            "condition": "$watch$"
