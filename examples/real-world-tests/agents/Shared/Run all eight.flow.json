          "id": "s55",
          "action": "ooa.datatable/write_to_file",
          "args": {
            "table": "$summary$",
            "path": "${base}/output/run-all-${formatDate(now(), '%Y%m%d-%H%M%S')}.csv"
          },
          "description": "Save the summary"
        },
        {
          "id": "s56",
          "action": "core/set",
          "args": {
            "variable": "status",
            "value": {
              "expr": "if($failed$ == 0, 'success', 'failed')"
            }
          },
          "description": "Overall result"
        },
        {
          "id": "s57",
          "action": "core/if",
          "args": {
            "condition": "$watch$"
          },
          "children": [
            {
              "id": "s58",
              "action": "ooa.desktop/message_box",
              "args": {
                "title": "Run all eight",
                "message": "Run all eight: ${status}\nPreflight: ${pre.status}\nAutomations not succeeded: ${failed}",
                "timeout_seconds": 8,
                "icon": "information",
                "always_on_top": true
              },
              "description": "Message box that closes by itself"
            }
          ],
          "description": "Show what is happening (watch is on)"
