{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "rw02_b4",
  "name": "RW02-B4 IT fulfilment worker",
  "description": "RW02-B4 (RW02 real-world test). Creates one ServiceNow catalog task per lifecycle item with the identity and request ids, picks the approved laptop and software profile, sets the due date in working days, branches on joiner, mover and leaver, verifies there is exactly one task and saves it.",
  "tags": [
    "real-world-test",
    "RW02"
  ],
  "variables": [
    {
      "name": "base",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Real-world tests",
      "description": "Folder of the real-world tests: data, output and the stand-in server."
    },
    {
      "name": "run_id",
      "type": "String",
      "direction": "input",
      "default": "",
      "description": "Run id shared by a main agent and its children; made here when empty."
    },
    {
      "name": "standin",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local QA stand-in server (127.0.0.1 only)."
    },
    {
      "name": "watch",
      "type": "Boolean",
      "direction": "input",
      "default": true,
      "description": "Show message boxes and pause between records so a person can follow the run."
    },
    {
      "name": "pause_seconds",
      "type": "Number",
      "direction": "input",
      "default": 1,
      "description": "Pause after each record when watch is on."
    },
    {
      "name": "fault_profile",
      "type": "String",
      "direction": "input",
      "default": "none",
      "description": "none, or resilience: the stand-ins inject the five failures of runbook step 09."
    },
    {
      "name": "info",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "out_dir",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "log_file",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "records",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "rec",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "i",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "err",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "err_msg",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "rec_status",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "rec_note",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "started",
      "type": "DateTime",
      "direction": "local"
    },
    {
      "name": "results",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "key",
          "status",
          "note",
          "time"
        ],
        "rows": []
      }
    },
    {
      "name": "processed",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Records handled without an error."
    },
    {
      "name": "exceptions",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Records routed to the exception list."
    },
    {
      "name": "status",
      "type": "String",
      "direction": "output",
      "default": "not_run",
      "description": "success when every record was handled (routed exceptions included)."
    },
    {
      "name": "result_file",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "CSV file with one row per record."
    },
    {
      "name": "roles",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "groups",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "laptop",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "software",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "due",
      "type": "DateTime",
      "direction": "local"
    },
    {
      "name": "task",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "sysid",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "found",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "cnt",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "what",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "again",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "evidence",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "key",
          "request_id",
          "task",
          "profile",
          "due",
          "what"
        ],
        "rows": []
      }
    },
    {
      "name": "evidence_file",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "Evidence rows of this agent (one per record)."
    },
    {
      "name": "items",
      "type": "Table",
      "direction": "local"
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "1. Start"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "What this agent does: Creates one ServiceNow catalog task per lifecycle item with the identity and request ids, picks the approved laptop and software profile, sets the due date in working days, branches on joiner, mover and leaver, verifies there is exactly one task and saves it. It works through 10 IT tasks and writes its results to the run's output folder."
          }
        },
        {
          "id": "s3",
          "action": "ooa.run_context/get",
          "args": {},
          "out": {
            "info": "info"
          },
          "description": "Read the run context (run id, runner, user)"
        },
        {
          "id": "s4",
          "action": "core/set",
          "args": {
            "variable": "started",
            "value": {
              "expr": "now()"
            }
          },
          "description": "Remember when the agent started"
        },
        {
          "id": "s5",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "empty",
              "left": "$run_id$"
            }
          },
          "children": [
            {
              "id": "s6",
              "action": "core/set",
              "args": {
                "variable": "run_id",
                "value": "SOLO-${formatDate(now(), '%Y%m%d-%H%M%S')}"
              },
              "description": "Run id for a run on its own"
            }
          ],
          "description": "Running on its own: make a run id"
        },
        {
          "id": "s7",
          "action": "core/set",
          "args": {
            "variable": "out_dir",
            "value": "${base}/output/${run_id}/RW02-B4"
          },
          "description": "This agent's output folder for the run"
        },
        {
          "id": "s8",
          "action": "ooa.folder/create",
          "args": {
            "path": "$out_dir$"
          },
          "description": "Create the output folder"
        },
        {
          "id": "s9",
          "action": "core/set",
          "args": {
            "variable": "log_file",
            "value": "${out_dir}/log.txt"
          },
          "description": "Log file of this agent"
        },
        {
          "id": "s10",
          "action": "ooa.log/write",
          "args": {
            "path": "$log_file$",
            "message": "RW02-B4 IT fulfilment worker started; run ${run_id}; computer ${info.device}, user ${info.os_user}"
          },
          "description": "Log the start"
        },
        {
          "id": "s11",
          "action": "core/if",
          "args": {
            "condition": "$watch$"
          },
          "children": [
            {
              "id": "s12",
              "action": "ooa.desktop/message_box",
              "args": {
                "title": "RW02-B4 starts",
                "message": "RW02-B4 IT fulfilment worker\n\nCreates one ServiceNow catalog task per lifecycle item with the identity and request ids, picks the approved laptop and software profile, sets the due date in working days, branches on joiner, mover and leaver, verifies there is exactly one task and saves it.\n\nRecords: 10 IT tasks\nRun: ${run_id}",
                "timeout_seconds": 4,
                "icon": "information",
                "always_on_top": true
              },
              "description": "Message box that closes by itself"
            }
          ],
          "description": "Show what is happening (watch is on)"
        }
      ],
      "description": "1. Start"
    },
    {
      "id": "s13",
      "action": "core/step",
      "args": {
        "title": "2. Prepare"
      },
      "children": [
        {
          "id": "s14",
          "action": "core/comment",
          "args": {
            "text": "Read the accepted items and the role profiles."
          }
        },
        {
          "id": "s15",
          "action": "ooa.csv/read",
          "args": {
            "path": "${base}/data/RW02/requests.csv"
          },
          "out": {
            "table": "records"
          },
          "description": "Read the test records (RW02/requests.csv)"
        },
        {
          "id": "s16",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "ne",
              "left": "$fault_profile$",
              "right": "none"
            }
          },
          "children": [
            {
              "id": "s17",
              "action": "ooa.rest/request",
              "args": {
                "method": "POST",
                "url": "${standin}/qa/faults",
                "json": {
                  "service": "servicenow",
                  "profile": "$fault_profile$",
                  "run_id": "$run_id$"
                }
              },
              "description": "Arm the stand-in's injected faults for this service"
            }
          ],
          "description": "Resilience run: arm the stand-in's faults"
        },
        {
          "id": "s18",
          "action": "core/if",
          "args": {
            "condition": {
              "condition": "ooa.file/exists",
              "args": {
                "path": "${base}/output/${run_id}/RW02-B1/evidence.csv"
              }
            }
          },
          "children": [
            {
              "id": "s19",
              "action": "ooa.csv/read",
              "args": {
                "path": "${base}/output/${run_id}/RW02-B1/evidence.csv"
              },
              "out": {
                "table": "items"
              },
              "description": "Read the accepted lifecycle items"
            },
            {
              "id": "s20",
              "action": "ooa.datatable/join",
              "args": {
                "table": "$records$",
                "key_columns": [
                  "key"
                ],
                "other": "$items$",
                "join_type": "inner"
              },
              "out": {
                "table": "records"
              },
              "description": "Keep the requests intake accepted"
            }
          ],
          "description": "Intake ran in this run?",
          "else": [
            {
              "id": "s21",
              "action": "ooa.datatable/filter",
              "args": {
                "table": "$records$",
                "column": "approved",
                "operator": "eq",
                "value": "yes"
              },
              "out": {
                "table": "records"
              },
              "description": "Approved requests only"
            }
          ]
        },
        {
          "id": "s22",
          "action": "ooa.csv/read",
          "args": {
            "path": "${base}/data/RW02/roles.csv"
          },
          "out": {
            "table": "roles"
          },
          "description": "Read the roles (groups, laptop, software)"
        },
        {
          "id": "s23",
          "action": "ooa.csv/read",
          "args": {
            "path": "${base}/data/RW02/groups.csv"
          },
          "out": {
            "table": "groups"
          },
          "description": "Read the groups"
        }
      ],
      "description": "2. Prepare"
    },
    {
      "id": "s24",
      "action": "core/step",
      "args": {
        "title": "3. Work through the records"
      },
      "children": [
        {
          "id": "s25",
          "action": "core/comment",
          "args": {
            "text": "Per item: profile, due date, branch, create the task, start it, check there is one, read it back, keep it."
          }
        },
        {
          "id": "s26",
          "action": "core/loop",
          "args": {
            "iterator": "table_rows",
            "over": "$records$",
            "as": "rec",
            "index": "i"
          },
          "children": [
            {
              "id": "s27",
              "action": "core/set",
              "args": {
                "variable": "rec_note",
                "value": ""
              },
              "description": "Clear the note of the previous record"
            },
            {
              "id": "s28",
              "action": "core/try",
              "args": {},
              "children": [
                {
                  "id": "s29",
                  "action": "ooa.datatable/lookup",
                  "args": {
                    "table": "$roles$",
                    "column": "role",
                    "value": {
                      "expr": "coalesce($rec.role$, $rec.prior_role$)"
                    },
                    "return_column": "laptop",
                    "if_not_found": "standard-laptop"
                  },
                  "out": {
                    "value": "laptop"
                  },
                  "description": "Laptop profile of the role"
                },
                {
                  "id": "s30",
                  "action": "ooa.datatable/lookup",
                  "args": {
                    "table": "$roles$",
                    "column": "role",
                    "value": {
                      "expr": "coalesce($rec.role$, $rec.prior_role$)"
                    },
                    "return_column": "software",
                    "if_not_found": "Office"
                  },
                  "out": {
                    "value": "software"
                  },
                  "description": "Software of the role"
                },
                {
                  "id": "s31",
                  "action": "ooa.datetime/add_working_days",
                  "args": {
                    "value": {
                      "expr": "parseDate($rec.effective$, '%Y-%m-%d')"
                    },
                    "days": -2
                  },
                  "out": {
                    "result": "due"
                  },
                  "description": "Due two working days before the start"
                },
                {
                  "id": "s32",
                  "action": "core/switch",
                  "args": {
                    "value": "$rec.action$",
                    "match": "equals",
                    "ignore_case": true
                  },
                  "description": "What IT has to do",
                  "cases": [
                    {
                      "values": [
                        "joiner"
                      ],
                      "children": [
                        {
                          "id": "s33",
                          "action": "core/set",
                          "args": {
                            "variable": "what",
                            "value": "Prepare ${laptop} with ${software}"
                          },
                          "description": "Joiner: new laptop and software"
                        }
                      ]
                    },
                    {
                      "values": [
                        "mover"
                      ],
                      "children": [
                        {
                          "id": "s34",
                          "action": "core/set",
                          "args": {
                            "variable": "what",
                            "value": "Change software to ${software}"
                          },
                          "description": "Mover: software change"
                        }
                      ]
                    }
                  ],
                  "default": [
                    {
                      "id": "s35",
                      "action": "core/set",
                      "args": {
                        "variable": "what",
                        "value": "Collect the laptop and remove software"
                      },
                      "description": "Leaver: collect and remove"
                    }
                  ]
                },
                {
                  "id": "s36",
                  "action": "ooa.servicenow/query",
                  "args": {
                    "table": "sc_task",
                    "query": "u_request_id=${rec.request_id}^u_run=${run_id}",
                    "instance_url": "$standin$",
                    "access_token": {
                      "$credential": "rw_qa_standins/servicenow/token"
                    }
                  },
                  "out": {
                    "table": "found",
                    "count": "cnt"
                  },
                  "description": "Is there a task for this request already?"
                },
                {
                  "id": "s37",
                  "action": "core/if",
                  "args": {
                    "condition": "$cnt$ > 0"
                  },
                  "children": [
                    {
                      "id": "s38",
                      "action": "core/throw",
                      "args": {
                        "code": "ROUTE.ALREADY_DONE",
                        "message": "${rec.request_id} already has a task"
                      },
                      "description": "Never create it twice"
                    }
                  ],
                  "description": "Already created (a rerun)?"
                },
                {
                  "id": "s39",
                  "action": "ooa.servicenow/create_record",
                  "args": {
                    "table": "sc_task",
                    "fields": {
                      "short_description": "OOA-QA ${rec.request_id} ${what}",
                      "u_request_id": "$rec.request_id$",
                      "u_run": "$run_id$",
                      "u_action": "$rec.action$",
                      "u_profile": "$laptop$",
                      "due_date": "${formatDate($due, '%Y-%m-%d')}"
                    },
                    "instance_url": "$standin$",
                    "access_token": {
                      "$credential": "rw_qa_standins/servicenow/token"
                    }
                  },
                  "out": {
                    "record": "task",
                    "sys_id": "sysid"
                  },
                  "description": "Create the catalog task"
                },
                {
                  "id": "s40",
                  "action": "ooa.servicenow/update_record",
                  "args": {
                    "table": "sc_task",
                    "sys_id": "$sysid$",
                    "fields": {
                      "state": "2"
                    },
                    "instance_url": "$standin$",
                    "access_token": {
                      "$credential": "rw_qa_standins/servicenow/token"
                    }
                  },
                  "description": "Start the task"
                },
                {
                  "id": "s41",
                  "action": "ooa.servicenow/query",
                  "args": {
                    "table": "sc_task",
                    "query": "u_request_id=${rec.request_id}^u_run=${run_id}",
                    "instance_url": "$standin$",
                    "access_token": {
                      "$credential": "rw_qa_standins/servicenow/token"
                    }
                  },
                  "out": {
                    "table": "found",
                    "count": "cnt"
                  },
                  "description": "Verify there is exactly one task"
                },
                {
                  "id": "s42",
                  "action": "core/if",
                  "args": {
                    "condition": "$cnt$ != 1"
                  },
                  "children": [
                    {
                      "id": "s43",
                      "action": "core/throw",
                      "args": {
                        "code": "VERIFY.TASK_COUNT",
                        "message": "${rec.request_id} has ${cnt} tasks"
                      },
                      "description": "Report it"
                    }
                  ],
                  "description": "Not exactly one?"
                },
                {
                  "id": "s44",
                  "action": "ooa.servicenow/get_record",
                  "args": {
                    "table": "sc_task",
                    "sys_id": "$sysid$",
                    "instance_url": "$standin$",
                    "access_token": {
                      "$credential": "rw_qa_standins/servicenow/token"
                    }
                  },
                  "out": {
                    "record": "again"
                  },
                  "description": "Read the task back"
                },
                {
                  "id": "s45",
                  "action": "ooa.datatable/add_row",
                  "args": {
                    "table": "$evidence$",
                    "values": {
                      "key": "$rec.key$",
                      "request_id": "$rec.request_id$",
                      "task": "$again.number$",
                      "profile": "$laptop$",
                      "due": "${formatDate($due, '%Y-%m-%d')}",
                      "what": "$what$"
                    }
                  },
                  "out": {
                    "table": "evidence"
                  },
                  "description": "Save the result"
                },
                {
                  "id": "s46",
                  "action": "core/set",
                  "args": {
                    "variable": "rec_note",
                    "value": "${again.number}"
                  },
                  "description": "Note for the results"
                },
                {
                  "id": "s47",
                  "action": "ooa.datatable/add_row",
                  "args": {
                    "table": "$results$",
                    "values": {
                      "key": "$rec.key$",
                      "status": "done",
                      "note": "$rec_note$",
                      "time": "${formatDate(now(), '%H:%M:%S')}"
                    }
                  },
                  "out": {
                    "table": "results"
                  },
                  "description": "Add the record's result to the results table"
                },
                {
                  "id": "s48",
                  "action": "core/set",
                  "args": {
                    "variable": "processed",
                    "value": {
                      "expr": "$processed$ + 1"
                    }
                  },
                  "description": "Count the record as handled"
                },
                {
                  "id": "s49",
                  "action": "core/if",
                  "args": {
                    "condition": "$watch$"
                  },
                  "children": [
                    {
                      "id": "s50",
                      "action": "ooa.desktop/message_box",
                      "args": {
                        "title": "RW02-B4 - record ${rec.key}",
                        "message": "RW02-B4: record ${$i + 1} of ${len($records$)}\n\n${task.number}: ${what}\nDue ${due}",
                        "timeout_seconds": 2,
                        "icon": "information",
                        "always_on_top": true
                      },
                      "description": "Message box that closes by itself"
                    }
                  ],
                  "description": "Show what is happening (watch is on)"
                }
              ],
              "description": "Handle one record; a failure is caught below and the next record goes on",
              "catch": [
                {
                  "codes": [
                    "*"
                  ],
                  "children": [
                    {
                      "id": "s51",
                      "action": "core/comment",
                      "args": {
                        "text": "The record failed: keep the reason, count it as an exception and go on with the next one."
                      }
                    },
                    {
                      "id": "s52",
                      "action": "ooa.datatable/add_row",
                      "args": {
                        "table": "$results$",
                        "values": {
                          "key": "$rec.key$",
                          "status": "exception",
                          "note": "${err.code}: ${err_msg}",
                          "time": "${formatDate(now(), '%H:%M:%S')}"
                        }
                      },
                      "out": {
                        "table": "results"
                      },
                      "description": "Add the failure to the results table"
                    },
                    {
                      "id": "s53",
                      "action": "core/set",
                      "args": {
                        "variable": "exceptions",
                        "value": {
                          "expr": "$exceptions$ + 1"
                        }
                      },
                      "description": "Count the exception"
                    },
                    {
                      "id": "s54",
                      "action": "ooa.log/write",
                      "args": {
                        "path": "$log_file$",
                        "level": "WARN",
                        "message": "Record ${rec.key}: ${err.code} ${err_msg}"
                      },
                      "description": "Log the exception"
                    },
                    {
                      "id": "s55",
                      "action": "core/if",
                      "args": {
                        "condition": "$watch$"
                      },
                      "children": [
                        {
                          "id": "s56",
                          "action": "ooa.desktop/message_box",
                          "args": {
                            "title": "RW02-B4 - exception",
                            "message": "RW02-B4: record ${rec.key} went to the exception list\n\n${err.code}: ${err_msg}",
                            "timeout_seconds": 3,
                            "icon": "warning",
                            "always_on_top": true
                          },
                          "description": "Message box that closes by itself"
                        }
                      ],
