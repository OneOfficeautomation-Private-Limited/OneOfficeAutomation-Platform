{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "uc_w1_portal_order_capture",
  "name": "W1 Portal order entry (Capture)",
  "description": "Sign in to a web portal, fill in an order form and read the confirmation number. Web steps use captured objects (recorded with OOA Capture) instead of typed selectors where the element is fixed.",
  "variables": [
    {
      "name": "folder",
      "type": "String",
      "direction": "input",
      "default": "Use cases",
      "description": "Folder of these use cases, relative to the workspace."
    },
    {
      "name": "headless",
      "type": "Boolean",
      "direction": "input",
      "default": false,
      "description": "Run the browser without a window (for unattended runs)."
    },
    {
      "name": "portal_user",
      "type": "String",
      "direction": "input",
      "default": "demo.user",
      "description": "Portal user name."
    },
    {
      "name": "portal_password",
      "type": "String",
      "direction": "input",
      "default": "demo-pass",
      "description": "Password of the demo portal (it accepts any). In a real process make this a Credential from the vault."
    },
    {
      "name": "customer",
      "type": "String",
      "direction": "input",
      "default": "Acme",
      "description": "Customer to order for."
    },
    {
      "name": "amount",
      "type": "Number",
      "direction": "input",
      "default": 250,
      "description": "Order amount."
    },
    {
      "name": "kind",
      "type": "String",
      "direction": "input",
      "default": "Express",
      "description": "Delivery: Standard, Express or Return."
    },
    {
      "name": "confirmation",
      "type": "String",
      "direction": "output",
      "description": "Confirmation number shown by the portal."
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "ooa.browser/open",
      "args": {
        "url": "${folder}/site/portal.html",
        "headless": "$headless",
        "engine": "playwright",
        "keep_open": false
      },
      "description": "Open the portal"
    },
