{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "uc_w4_excel_to_web_capture",
  "name": "W4 Register people from Excel in a web form (Capture)",
  "description": "For each row of an Excel sheet, fill in and save a web form, and write the registration number back to the sheet. Web steps use captured objects (recorded with OOA Capture) instead of typed selectors where the element is fixed.",
  "variables": [
    {
      "name": "folder",
      "type": "String",
      "direction": "input",
      "default": "Use cases",
      "description": "Folder of these use cases, relative to the workspace."
    },
    {
      "name": "headless",
      "type": "Boolean",
      "direction": "input",
      "default": false,
      "description": "Run the browser without a window (for unattended runs)."
    },
    {
      "name": "people",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "person",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "i",
      "type": "Number",
      "direction": "local"
    },
    {
      "name": "row_no",
      "type": "Number",
      "direction": "local"
    },
    {
      "name": "reg_id",
      "type": "String",
      "direction": "local"
    },
    {
      "name": "registered",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "People registered."
    },
    {
      "name": "last_id",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "Last registration number."
    },
    {
      "name": "check_cell",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "Registration number written for the second person (D3)."
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "ooa.excel/open",
      "args": {
        "path": "${folder}/data/people.xlsx",
        "session": "people",
        "header": true
      }
    },
    {
      "id": "s2",
      "action": "ooa.excel/get_all_cells",
      "args": {
        "session": "people"
      },
      "out": {
        "table": "people"
      }
    },
    {
      "id": "s3",
      "action": "ooa.browser/open",
      "args": {
        "url": "${folder}/site/form-entry.html",
        "headless": "$headless",
        "engine": "playwright",
        "keep_open": false
      }
    },
    {
      "id": "s13",
      "action": "core/loop",
      "args": {
        "iterator": "table_rows",
        "over": "$people",
        "as": "person",
        "index": "i"
      },
      "children": [
        {
          "id": "s4",
          "action": "ooa.browser/type_text",
          "args": {
            "text": "$person.Name",
            "object": {
              "technology": "web",
              "page": {
                "url": "file:///C:/Users/virup/OOA%20Workspace/Use%20cases/site/form-entry.html",
                "title": "Demo registration",
                "url_match": "starts_with"
