{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "uc_p5_quotes_authors_capture",
  "name": "P5 Quotes and authors (quotes.toscrape.com) (Capture)",
  "description": "Sign in, read every page of the JavaScript-rendered quotes, rank the authors by number of quotes and visit the top authors' pages for their birth details. Web steps use captured objects (recorded with OOA Capture) instead of typed selectors where the element is fixed.",
  "variables": [
    {
      "name": "folder",
      "type": "String",
      "direction": "input",
      "default": "Use cases",
      "description": "Folder of these use cases, relative to the workspace (results go to its output folder)."
    },
    {
      "name": "headless",
      "type": "Boolean",
      "direction": "input",
      "default": false,
      "description": "Run the browser without a window (for unattended runs)."
    },
    {
      "name": "quote_user",
      "type": "String",
      "direction": "input",
      "default": "demo",
      "description": "User name (the site accepts any)."
    },
    {
      "name": "quote_password",
      "type": "String",
      "direction": "input",
      "default": "demo",
      "description": "Password (the site accepts any)."
    },
    {
      "name": "top_n",
      "type": "Number",
      "direction": "input",
      "default": 3,
      "description": "How many top authors to look up."
    },
    {
      "name": "page_quotes",
      "type": "List",
      "direction": "local"
    },
    {
      "name": "page_table",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "quotes",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [],
        "rows": []
      }
    },
    {
      "name": "more",
      "type": "Boolean",
      "direction": "local",
      "default": true
    },
    {
      "name": "ranking",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "a",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "slug",
      "type": "String",
      "direction": "local"
    },
    {
      "name": "born",
      "type": "String",
      "direction": "local"
    },
    {
      "name": "place",
      "type": "String",
      "direction": "local"
    },
    {
      "name": "authors",
      "type": "Table",
      "direction": "local",
      "default": {
        "columns": [
          "Author",
          "Quotes",
          "Born",
          "Born in"
        ],
        "rows": []
      }
    },
    {
      "name": "quote_count",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Quotes read."
    },
    {
      "name": "top_author",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "Author with the most quotes."
    },
    {
      "name": "top_author_born",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "Birth date of that author."
    },
    {
      "name": "signed_in",
      "type": "Boolean",
      "direction": "output",
      "default": false,
      "description": "The sign-in worked."
    }
  ],
  "steps": [
