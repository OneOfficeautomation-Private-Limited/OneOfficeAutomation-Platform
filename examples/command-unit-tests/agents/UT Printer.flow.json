      "children": [
        {
          "id": "s27",
          "action": "core/comment",
          "args": {
            "text": "Shows ooa.printer/remove_printer (refused without confirm) and checks its result."
          }
        },
        {
          "id": "s28",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s30",
              "action": "core/set",
              "args": {
                "variable": "ut_got_error",
                "value": false
              }
            },
            {
              "id": "s31",
              "action": "core/try",
              "args": {},
              "children": [
                {
                  "action": "ooa.printer/remove_printer",
                  "args": {
                    "printer": "x",
                    "confirm": false
                  },
                  "id": "s29"
                }
              ],
              "description": "These steps should fail with PRINTER.CONFIRM_REQUIRED",
              "catch": [
                {
                  "codes": [
                    "PRINTER.CONFIRM_REQUIRED"
                  ],
                  "children": [
                    {
                      "id": "s32",
                      "action": "core/set",
                      "args": {
                        "variable": "ut_got_error",
                        "value": true
                      },
                      "description": "The expected error came"
                    }
                  ]
                }
              ]
            },
            {
              "id": "s33",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ut_got_error$",
                  "right": true
                }
              },
              "children": [
                {
                  "id": "s34",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check error PRINTER.CONFIRM_REQUIRED",
              "else": [
                {
                  "id": "s35",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "error PRINTER.CONFIRM_REQUIRED: expected eq true, got ${ut_got_error}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s36",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s37",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.printer/remove_printer: refused without confirm\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s38",
