              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "2. ooa.printer/get_default - default printer"
    },
    {
      "id": "s26",
      "action": "core/step",
      "args": {
        "title": "3. ooa.printer/remove_printer - refused without confirm"
