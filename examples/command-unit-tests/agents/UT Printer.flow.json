    {
      "id": "s109",
      "action": "core/step",
      "args": {
        "title": "6. ooa.printer/list_printers - the default printer is in the list"
      },
      "children": [
        {
          "id": "s110",
          "action": "core/comment",
          "args": {
            "text": "List printers gives every printer and the default one; it is the same default Get default printer gives."
          }
        },
        {
          "id": "s111",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s112",
              "action": "ooa.printer/list_printers",
              "args": {},
              "out": {
                "printers": "ut_printers",
                "default_printer": "ut_default"
              },
              "description": "List the printers"
            },
            {
              "id": "s113",
              "action": "ooa.printer/get_default",
              "args": {},
              "out": {
                "printer": "ut_default2"
              },
              "description": "Read the default printer"
            },
            {
              "id": "s114",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ut_default$",
                  "right": "$ut_default2$"
                }
              },
              "children": [
                {
                  "id": "s115",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check default printer",
              "else": [
                {
                  "id": "s116",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "default printer: expected eq \"ut_default2\", got ${ut_default}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s117",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "notEmpty",
                  "left": "$ut_default$"
                }
              },
              "children": [
                {
                  "id": "s118",
                  "action": "core/if",
                  "args": {
                    "condition": {
                      "op": "contains",
                      "left": "$ut_printers$",
                      "right": "$ut_default$"
                    }
                  },
                  "children": [
                    {
                      "id": "s119",
                      "action": "core/comment",
                      "args": {
                        "text": "As expected"
                      }
                    }
                  ],
                  "description": "Check printers",
                  "else": [
                    {
                      "id": "s120",
                      "action": "core/throw",
                      "args": {
                        "code": "UT.CHECK_FAILED",
                        "message": "printers: expected contains \"ut_default\", got ${ut_printers}"
                      },
                      "description": "Stop the case: the check failed"
                    }
                  ]
                }
              ],
              "description": "Is there a default printer?"
            },
            {
              "id": "s121",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s122",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.printer/list_printers: the default printer is in the list\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s123",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s124",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.printer/list_printers: the default printer is in the list: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "6. ooa.printer/list_printers - the default printer is in the list"
    },
    {
      "id": "s125",
      "action": "core/step",
      "args": {
        "title": "7. Summary"
      },
      "children": [
        {
          "id": "s126",
          "action": "core/comment",
          "args": {
            "text": "How many cases passed; the run fails when any case failed."
          }
        },
        {
          "id": "s127",
          "action": "core/log",
          "args": {
            "message": "Unit test results: ${ut_pass} passed, ${ut_fail} failed\n${ut_report}",
            "level": "info"
          },
          "description": "Write to the run log"
        },
        {
          "id": "s128",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "gt",
              "left": "$ut_fail$",
              "right": 0
            }
          },
          "children": [
            {
              "id": "s129",
              "action": "core/throw",
              "args": {
                "code": "UT.FAILED",
                "message": "${ut_fail} of the cases failed; see ut_report"
              },
              "description": "Mark the run failed"
            }
          ],
          "description": "Did any case fail?"
        }
      ],
      "description": "7. Summary"
    }
  ]
}
