{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "ut_printer",
  "name": "UT Printer",
  "description": "Unit tests of the Printer commands that change nothing: list printers, the default printer, and the errors for a missing file, an unknown printer and a removal without confirmation. Nothing is printed.",
  "tags": [
    "unit-test",
    "commands"
  ],
  "variables": [
    {
      "name": "ut_dir",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Unit tests",
      "description": "Folder with the test data (files, workbooks, fixtures)."
    },
    {
      "name": "standin_url",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local stand-in that imitates outside services."
    },
    {
      "name": "ut_pass",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks passed."
    },
    {
      "name": "ut_fail",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks failed."
    },
    {
      "name": "ut_report",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "One line per case: PASS or FAIL, the command and the case."
    },
    {
      "name": "ut_err",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "p",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "ut_got_error",
      "type": "Boolean",
      "direction": "local",
      "default": false
    },
    {
      "name": "ut_json",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "ut_default",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "ut_default2",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "ut_printers",
      "type": "List",
      "direction": "local"
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "0. About this agent"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "Unit tests of the Printer commands that change nothing: list printers, the default printer, and the errors for a missing file, an unknown printer and a removal without confirmation. Nothing is printed."
          }
        },
        {
          "id": "s3",
          "action": "core/log",
          "args": {
            "message": "Unit test agent UT Printer started",
            "level": "info"
          },
          "description": "Write to the run log"
        }
      ],
      "description": "0. About this agent"
    },
    {
      "id": "s68",
      "action": "core/step",
      "args": {
        "title": "1. ooa.printer/list_printers - lists printers"
      },
      "children": [
        {
          "id": "s69",
          "action": "core/comment",
          "args": {
            "text": "Shows ooa.printer/list_printers (lists printers) and checks its result."
          }
        },
        {
          "id": "s70",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s80",
              "action": "ooa.folder/delete",
              "args": {
                "path": "ut_case01",
                "recursive": true
              },
              "continueOnError": true,
              "description": "Start with an empty case folder ut_case01"
            },
            {
              "action": "ooa.printer/list_printers",
              "out": {
                "printers": "p"
              },
              "id": "s71"
            },
            {
              "id": "s76",
              "action": "core/set",
              "args": {
                "variable": "ut_json",
                "value": {
                  "expr": "jsonStringify($p)"
                }
              },
              "description": "The value as JSON, to see its type"
            },
            {
              "id": "s77",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "startsWith",
                  "left": "$ut_json$",
                  "right": "["
                }
              },
              "children": [
                {
                  "id": "s78",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check p is array",
              "else": [
                {
                  "id": "s79",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "p is array: expected startsWith \"[\", got ${ut_json}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s72",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s73",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.printer/list_printers: lists printers\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s74",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s75",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.printer/list_printers: lists printers: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "1. ooa.printer/list_printers - lists printers"
    },
    {
      "id": "s81",
      "action": "core/step",
      "args": {
        "title": "2. ooa.printer/get_default - default printer"
