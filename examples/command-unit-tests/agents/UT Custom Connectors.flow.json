            },
            {
              "id": "s33",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$n$",
                  "right": 2
                }
              },
              "children": [
                {
                  "id": "s34",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check n",
              "else": [
                {
                  "id": "s35",
                  "action": "core/throw",
