{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "ut_connector",
  "name": "UT Custom Connectors",
  "description": "Unit tests of every Custom Connectors command: each case shows the command in use against the local stand-in (made-up keys from the vault, never a real account) and checks its result.",
  "tags": [
    "unit-test",
    "commands"
  ],
  "variables": [
    {
      "name": "ut_dir",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Unit tests",
      "description": "Folder with the test data (files, workbooks, fixtures)."
    },
    {
      "name": "standin_url",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local stand-in that imitates outside services."
    },
    {
      "name": "ut_pass",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks passed."
    },
    {
      "name": "ut_fail",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks failed."
    },
    {
      "name": "ut_report",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "One line per case: PASS or FAIL, the command and the case."
    },
    {
      "name": "ut_err",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "ops",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "c",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "n",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "op",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "s",
      "type": "Any",
      "direction": "local"
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "0. About this agent"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "Unit tests of every Custom Connectors command: each case shows the command in use against the local stand-in (made-up keys from the vault, never a real account) and checks its result."
          }
        },
        {
          "id": "s3",
          "action": "core/log",
          "args": {
            "message": "Unit test agent UT Custom Connectors started",
            "level": "info"
          },
          "description": "Write to the run log"
        }
      ],
      "description": "0. About this agent"
    },
    {
      "id": "s4",
      "action": "core/step",
      "args": {
        "title": "1. ooa.connector/import_connector - imports an OpenAPI description as a connector"
      },
      "children": [
        {
          "id": "s5",
          "action": "core/comment",
          "args": {
            "text": "Shows ooa.connector/import_connector (imports an OpenAPI description as a connector) and checks its result."
          }
        },
        {
          "id": "s6",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "action": "ooa.connector/import_connector",
              "args": {
                "spec_text": "{\"openapi\": \"3.0.0\", \"info\": {\"title\": \"Orders\", \"version\": \"1\"}, \"servers\": [{\"url\": \"https://orders.example.invalid\"}], \"paths\": {\"/orders/{id}\": {\"get\": {\"operationId\": \"getOrder\", \"summary\": \"Read one order\", \"parameters\": [{\"name\": \"id\", \"in\": \"path\", \"required\": true, \"schema\": {\"type\": \"string\"}}], \"responses\": {\"200\": {\"description\": \"the order\"}}}}, \"/orders\": {\"get\": {\"operationId\": \"listOrders\", \"summary\": \"List orders\", \"responses\": {\"200\": {\"description\": \"orders\"}}}}}}",
                "name": "orders",
                "server": "$standin_url$/mock/56-20"
              },
              "out": {
                "operations": "ops"
              },
              "id": "s7"
            },
            {
              "id": "s8",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ops$",
                  "right": 2
                }
              },
              "children": [
                {
                  "id": "s9",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check ops",
              "else": [
                {
                  "id": "s10",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "ops: expected eq 2, got ${ops}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s11",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s12",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.connector/import_connector: imports an OpenAPI description as a connector\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s13",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s14",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.connector/import_connector: imports an OpenAPI description as a connector: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "1. ooa.connector/import_connector - imports an OpenAPI description as a connector"
    },
    {
      "id": "s15",
      "action": "core/step",
      "args": {
        "title": "2. ooa.connector/list_connectors - lists the connectors in the workspace"
      },
      "children": [
