{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "ut_credential_manager",
  "name": "UT Credential Manager",
  "description": "Unit tests of every Windows Credential Manager command on the made-up target ooa-unit-test: write, read, list, the Credential exists condition and delete. The target is deleted at the end.",
  "tags": [
    "unit-test",
    "commands"
  ],
  "variables": [
    {
      "name": "ut_dir",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Unit tests",
      "description": "Folder with the test data (files, workbooks, fixtures)."
    },
    {
      "name": "standin_url",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local stand-in that imitates outside services."
    },
    {
      "name": "ut_pass",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks passed."
    },
    {
      "name": "ut_fail",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks failed."
    },
    {
      "name": "ut_report",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "One line per case: PASS or FAIL, the command and the case."
    },
    {
      "name": "ut_err",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "ut_got_error",
      "type": "Boolean",
      "direction": "local",
      "default": false
    },
    {
      "name": "ok",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "cm_password",
      "type": "Credential",
      "direction": "local",
      "default": {
        "$credential": "unit_tests/credman/password"
      }
    },
    {
      "name": "cm_user",
      "type": "String",
      "direction": "local"
    },
    {
      "name": "cm_comment",
      "type": "String",
      "direction": "local"
    },
    {
      "name": "cm_targets",
      "type": "List",
      "direction": "local"
    },
    {
      "name": "cm_table",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "cm_deleted",
      "type": "Boolean",
      "direction": "local"
    },
    {
      "name": "cm_secret",
      "type": "Credential",
      "direction": "local"
    },
    {
      "name": "cm_written",
      "type": "DateTime",
      "direction": "local"
    },
    {
      "name": "ut_cond",
      "type": "Boolean",
      "direction": "local",
      "default": false
    },
    {
      "name": "cm_exists",
      "type": "Boolean",
      "direction": "local",
      "default": true
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "0. About this agent"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "Unit tests of every Windows Credential Manager command on the made-up target ooa-unit-test: write, read, list, the Credential exists condition and delete. The target is deleted at the end."
          }
        },
        {
          "id": "s3",
          "action": "core/log",
          "args": {
            "message": "Unit test agent UT Credential Manager started",
            "level": "info"
          },
          "description": "Write to the run log"
        }
      ],
      "description": "0. About this agent"
    },
    {
      "id": "s4",
      "action": "core/step",
      "args": {
        "title": "1. ooa.credential_manager/read_credential - missing target"
      },
      "children": [
        {
          "id": "s5",
          "action": "core/comment",
          "args": {
            "text": "Shows ooa.credential_manager/read_credential (missing target) and checks its result."
          }
        },
        {
          "id": "s6",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s8",
              "action": "core/set",
              "args": {
                "variable": "ut_got_error",
                "value": false
              }
            },
            {
              "id": "s9",
              "action": "core/try",
              "args": {},
              "children": [
                {
                  "action": "ooa.credential_manager/read_credential",
                  "args": {
                    "target": "ooa-none-9f3a"
                  },
                  "id": "s7"
                }
              ],
              "description": "These steps should fail with CREDMAN.NOT_FOUND",
              "catch": [
                {
                  "codes": [
                    "CREDMAN.NOT_FOUND"
                  ],
                  "children": [
                    {
                      "id": "s10",
                      "action": "core/set",
                      "args": {
                        "variable": "ut_got_error",
                        "value": true
                      },
                      "description": "The expected error came"
                    }
                  ]
                }
              ]
            },
            {
              "id": "s11",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ut_got_error$",
                  "right": true
                }
              },
              "children": [
                {
                  "id": "s12",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check error CREDMAN.NOT_FOUND",
              "else": [
                {
                  "id": "s13",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "error CREDMAN.NOT_FOUND: expected eq true, got ${ut_got_error}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s14",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s15",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.credential_manager/read_credential: missing target\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s16",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s17",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.credential_manager/read_credential: missing target: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "1. ooa.credential_manager/read_credential - missing target"
    },
    {
      "id": "s18",
      "action": "core/step",
      "args": {
        "title": "2. ooa.credential_manager/credential_exists - condition false"
      },
      "children": [
        {
          "id": "s19",
          "action": "core/comment",
          "args": {
            "text": "Shows ooa.credential_manager/credential_exists (condition false) and checks its result."
          }
        },
        {
          "id": "s20",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s21",
              "action": "core/set",
              "args": {
                "variable": "ok",
                "value": true
              },
              "description": "Test value for ok"
            },
            {
              "action": "core/if",
              "args": {
                "condition": {
                  "condition": "ooa.credential_manager/credential_exists",
                  "args": {
                    "target": "ooa-none-9f3a"
                  }
                }
              },
              "else": [
                {
                  "action": "core/set",
                  "args": {
                    "variable": "ok",
                    "value": false
                  },
                  "id": "s23"
                }
              ],
              "id": "s22"
            },
            {
              "id": "s24",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ok$",
                  "right": false
                }
              },
              "children": [
                {
                  "id": "s25",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check ok",
              "else": [
                {
                  "id": "s26",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "ok: expected eq false, got ${ok}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s27",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s28",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.credential_manager/credential_exists: condition false\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s29",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s30",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.credential_manager/credential_exists: condition false: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "2. ooa.credential_manager/credential_exists - condition false"
    },
    {
      "id": "s31",
      "action": "core/step",
      "args": {
        "title": "3. ooa.credential_manager/write_credential - store a generic credential"
      },
      "children": [
        {
          "id": "s32",
          "action": "core/comment",
          "args": {
            "text": "Write credential creates (or replaces) a generic credential for the agent's Windows account. Reading it back gives the user name and the comment."
          }
        },
        {
          "id": "s33",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s34",
              "action": "ooa.credential_manager/delete_credential",
              "args": {
                "target": "ooa-unit-test",
                "missing_ok": true
              },
              "description": "Start clean"
            },
            {
              "id": "s35",
              "action": "ooa.credential_manager/write_credential",
              "args": {
                "target": "ooa-unit-test",
                "username": "ut_robot",
                "password": "$cm_password$",
                "comment": "OOA unit test, safe to delete",
                "persist": "local_machine"
              }
            },
            {
              "id": "s36",
              "action": "ooa.credential_manager/read_credential",
              "args": {
                "target": "ooa-unit-test"
              },
              "out": {
                "username": "cm_user",
                "comment": "cm_comment"
              }
            },
            {
              "id": "s37",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$cm_user$",
                  "right": "ut_robot"
                }
              },
              "children": [
                {
                  "id": "s38",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check cm_user",
              "else": [
                {
                  "id": "s39",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "cm_user: expected eq \"ut_robot\", got ${cm_user}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s40",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$cm_comment$",
                  "right": "OOA unit test, safe to delete"
                }
              },
              "children": [
                {
                  "id": "s41",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check cm_comment",
              "else": [
                {
                  "id": "s42",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "cm_comment: expected eq \"OOA unit test, safe to delete\", got ${cm_comment}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s43",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s44",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.credential_manager/write_credential: store a generic credential\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s45",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s46",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.credential_manager/write_credential: store a generic credential: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "3. ooa.credential_manager/write_credential - store a generic credential"
    },
    {
      "id": "s47",
      "action": "core/step",
      "args": {
        "title": "4. ooa.credential_manager/read_credential - user name, secret and when it was written"
      },
      "children": [
        {
          "id": "s48",
          "action": "core/comment",
          "args": {
            "text": "Read credential gives the user name, the secret as a masked Credential and when it was last written; the secret is used without being shown (checked not empty)."
          }
        },
        {
          "id": "s49",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s50",
              "action": "ooa.credential_manager/read_credential",
              "args": {
                "target": "ooa-unit-test"
              },
              "out": {
                "username": "cm_user",
                "password": "cm_secret",
                "last_written": "cm_written"
              }
            },
            {
              "id": "s51",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$cm_user$",
                  "right": "ut_robot"
                }
              },
              "children": [
                {
                  "id": "s52",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check cm_user",
              "else": [
                {
                  "id": "s53",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "cm_user: expected eq \"ut_robot\", got ${cm_user}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s54",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "notEmpty",
                  "left": "$cm_secret$"
                }
              },
              "children": [
                {
                  "id": "s55",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check the secret",
              "else": [
                {
                  "id": "s56",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "the secret: expected notEmpty , got ${cm_secret}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s57",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "notEmpty",
                  "left": "$cm_written$"
                }
              },
              "children": [
                {
                  "id": "s58",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check last written",
              "else": [
                {
                  "id": "s59",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "last written: expected notEmpty , got ${cm_written}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s60",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s61",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.credential_manager/read_credential: user name, secret and when it was written\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s62",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s63",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.credential_manager/read_credential: user name, secret and when it was written: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "4. ooa.credential_manager/read_credential - user name, secret and when it was written"
    },
    {
      "id": "s64",
      "action": "core/step",
      "args": {
        "title": "5. ooa.credential_manager/list_targets - find the target with a wildcard"
      },
      "children": [
        {
          "id": "s65",
          "action": "core/comment",
          "args": {
            "text": "List targets gives the target names of generic credentials matching a * pattern, without secrets: exactly one matches ooa-unit-test*."
          }
        },
        {
          "id": "s66",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s67",
              "action": "ooa.credential_manager/list_targets",
              "args": {
                "filter": "ooa-unit-test*"
              },
              "out": {
                "targets": "cm_targets",
                "credentials": "cm_table"
              }
            },
            {
              "id": "s68",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$cm_targets$",
                  "right": [
                    "ooa-unit-test"
                  ]
                }
              },
              "children": [
                {
                  "id": "s69",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check cm_targets",
              "else": [
                {
                  "id": "s70",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "cm_targets: expected eq [\"ooa-unit-test\"], got ${cm_targets}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s71",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "contains",
                  "left": "${cm_table}",
                  "right": "ut_robot"
                }
              },
              "children": [
                {
                  "id": "s72",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check the user name in the table",
              "else": [
                {
                  "id": "s73",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "the user name in the table: expected contains \"ut_robot\""
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s74",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s75",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.credential_manager/list_targets: find the target with a wildcard\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s76",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s77",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.credential_manager/list_targets: find the target with a wildcard: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "5. ooa.credential_manager/list_targets - find the target with a wildcard"
    },
    {
      "id": "s78",
      "action": "core/step",
      "args": {
        "title": "6. ooa.credential_manager/credential_exists - the stored target"
      },
      "children": [
        {
          "id": "s79",
