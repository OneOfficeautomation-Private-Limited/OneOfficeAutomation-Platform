{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "ut_application_windows",
  "name": "UT Application (windows)",
  "description": "Unit tests of the Application commands that open windows: open a file with its program and open a program file. Each case closes what it opened.",
  "tags": [
    "unit-test",
    "commands"
  ],
  "variables": [
    {
      "name": "ut_dir",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Unit tests",
      "description": "Folder with the test data (files, workbooks, fixtures)."
    },
    {
      "name": "standin_url",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local stand-in that imitates outside services."
    },
    {
      "name": "ut_pass",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks passed."
    },
    {
      "name": "ut_fail",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks failed."
    },
    {
      "name": "ut_report",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "One line per case: PASS or FAIL, the command and the case."
    },
    {
      "name": "ut_err",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "ut_got_error",
      "type": "Boolean",
      "direction": "local",
      "default": false
    },
    {
      "name": "ut_n",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "ut_ok",
      "type": "Boolean",
      "direction": "local",
      "default": false
    },
    {
      "name": "ut_text",
      "type": "String",
      "direction": "local",
      "default": ""
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "0. About this agent"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "Unit tests of the Application commands that open windows: open a file with its program and open a program file. Each case closes what it opened."
          }
        },
        {
          "id": "s3",
          "action": "core/log",
          "args": {
            "message": "Unit test agent UT Application (windows) started",
            "level": "info"
          },
          "description": "Write to the run log"
        }
      ],
      "description": "0. About this agent"
    },
    {
      "id": "s18",
      "action": "core/step",
      "args": {
        "title": "1. ooa.application/open_file - missing file"
      },
      "children": [
        {
          "id": "s19",
          "action": "core/comment",
          "args": {
            "text": "Shows ooa.application/open_file (missing file) and checks its result."
          }
        },
        {
          "id": "s20",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s32",
              "action": "ooa.folder/delete",
              "args": {
                "path": "ut_case01",
                "recursive": true
              },
              "continueOnError": true,
              "description": "Start with an empty case folder ut_case01"
            },
            {
              "id": "s22",
              "action": "core/set",
              "args": {
                "variable": "ut_got_error",
                "value": false
              }
            },
            {
              "id": "s23",
              "action": "core/try",
              "args": {},
              "children": [
                {
                  "action": "ooa.application/open_file",
                  "args": {
                    "path": "ut_case01/none.pdf"
                  },
                  "id": "s21"
                }
              ],
              "description": "These steps should fail with FILE.NOT_FOUND",
              "catch": [
                {
                  "codes": [
                    "FILE.NOT_FOUND"
                  ],
                  "children": [
                    {
                      "id": "s24",
                      "action": "core/set",
                      "args": {
                        "variable": "ut_got_error",
                        "value": true
                      },
                      "description": "The expected error came"
                    }
                  ]
                }
              ]
            },
            {
              "id": "s25",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ut_got_error$",
                  "right": true
                }
              },
              "children": [
                {
                  "id": "s26",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check error FILE.NOT_FOUND",
              "else": [
                {
                  "id": "s27",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "error FILE.NOT_FOUND: expected eq true, got ${ut_got_error}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s28",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s29",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.application/open_file: missing file\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s30",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s31",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.application/open_file: missing file: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "1. ooa.application/open_file - missing file"
    },
    {
      "id": "s33",
      "action": "core/step",
      "args": {
        "title": "2. ooa.application/open_program_file - a program with parameters, waiting for its window"
      },
      "children": [
        {
          "id": "s34",
          "action": "core/comment",
          "args": {
            "text": "Open program file starts a program file with parameters and, with wait_for_window, carries on once its window shows; it gives the process id, used here to stop it again."
          }
        },
        {
          "id": "s35",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s36",
              "action": "ooa.application/open_program_file",
              "args": {
                "location": "C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe",
                "parameters": "-NoProfile -WindowStyle Hidden -Command \"Add-Type -AssemblyName System.Windows.Forms; $f = New-Object Windows.Forms.Form; $f.Text = 'UT program file window'; $f.Width = 460; $f.Height = 320; $f.StartPosition = 'CenterScreen'; [System.Windows.Forms.Application]::Run($f)\"",
                "wait_for_window": true,
                "wait_seconds": 30
              },
              "out": {
                "process_id": "ut_n"
              },
              "description": "Start PowerShell showing a test window"
            },
            {
              "id": "s37",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "gt",
                  "left": "$ut_n$",
                  "right": 0
                }
              },
              "children": [
                {
                  "id": "s38",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check process id",
              "else": [
                {
                  "id": "s39",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "process id: expected gt 0, got ${ut_n}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s40",
              "action": "ooa.window/wait_for",
              "args": {
                "title": "UT program file window",
                "timeout_seconds": 30
              },
              "out": {
                "met": "ut_ok"
              },
              "description": "The window is there"
            },
            {
              "id": "s41",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ut_ok$",
                  "right": true
                }
              },
              "children": [
                {
                  "id": "s42",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check ut_ok",
              "else": [
                {
                  "id": "s43",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "ut_ok: expected eq true, got ${ut_ok}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s44",
              "action": "ooa.window/close",
              "args": {
                "title": "UT program file window"
              },
              "continueOnError": true,
              "description": "Close the window"
            },
            {
              "id": "s45",
              "action": "ooa.application/stop_program",
              "args": {
                "process_id": "$ut_n$",
                "force": true
              },
              "continueOnError": true,
              "description": "Make sure it ended"
            },
            {
              "id": "s46",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s47",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.application/open_program_file: a program with parameters, waiting for its window\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s48",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s49",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.application/open_program_file: a program with parameters, waiting for its window: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "2. ooa.application/open_program_file - a program with parameters, waiting for its window"
    },
    {
      "id": "s50",
      "action": "core/step",
      "args": {
        "title": "3. ooa.application/open_file - a text file in its program"
      },
      "children": [
        {
          "id": "s51",
          "action": "core/comment",
          "args": {
            "text": "Open file opens a document with the program Windows uses for its type (a .txt in the text editor); the case then closes that window by its title."
          }
        },
        {
          "id": "s52",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s53",
              "action": "ooa.file/write_text",
              "args": {
                "path": "ut_open_file.txt",
                "text": "Opened by the unit test"
              },
              "description": "Write a text file"
            },
            {
              "id": "s54",
              "action": "ooa.application/open_file",
              "args": {
                "path": "ut_open_file.txt"
              },
              "description": "Open it"
            },
            {
              "id": "s55",
              "action": "ooa.window/wait_for",
              "args": {
                "title": "*ut_open_file*",
                "timeout_seconds": 30
              },
              "out": {
                "met": "ut_ok"
              },
              "description": "Wait for its window"
            },
            {
              "id": "s56",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ut_ok$",
                  "right": true
                }
              },
              "children": [
                {
                  "id": "s57",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check ut_ok",
              "else": [
                {
                  "id": "s58",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "ut_ok: expected eq true, got ${ut_ok}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s59",
              "action": "ooa.window/close_all",
              "args": {
                "title": "ut_open_file"
              },
              "out": {
                "count": "ut_n"
              },
              "continueOnError": true,
              "description": "Close the editor window"
            },
            {
              "id": "s60",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s61",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.application/open_file: a text file in its program\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s62",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s63",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.application/open_file: a text file in its program: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "3. ooa.application/open_file - a text file in its program"
    },
    {
      "id": "s64",
      "action": "core/step",
      "args": {
        "title": "4. Summary"
      },
      "children": [
        {
          "id": "s65",
          "action": "core/comment",
          "args": {
            "text": "How many cases passed; the run fails when any case failed."
          }
        },
        {
          "id": "s66",
          "action": "core/log",
          "args": {
            "message": "Unit test results: ${ut_pass} passed, ${ut_fail} failed\n${ut_report}",
            "level": "info"
          },
          "description": "Write to the run log"
        },
        {
          "id": "s67",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "gt",
              "left": "$ut_fail$",
              "right": 0
            }
          },
          "children": [
            {
              "id": "s68",
              "action": "core/throw",
              "args": {
                "code": "UT.FAILED",
                "message": "${ut_fail} of the cases failed; see ut_report"
              },
              "description": "Mark the run failed"
            }
          ],
          "description": "Did any case fail?"
        }
      ],
      "description": "4. Summary"
    }
  ]
}
