{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "ut_interrupts",
  "name": "UT Interrupt handlers",
  "description": "Unit tests of the Interrupt handler commands: add, list, check, remove and clear rules.",
  "tags": [
    "unit-test",
    "commands"
  ],
  "variables": [
    {
      "name": "ut_dir",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Unit tests",
      "description": "Folder with the test data (files, workbooks, fixtures)."
    },
    {
      "name": "standin_url",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local stand-in that imitates outside services."
    },
    {
      "name": "ut_pass",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks passed."
    },
    {
      "name": "ut_fail",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks failed."
    },
    {
      "name": "ut_report",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "One line per case: PASS or FAIL, the command and the case."
    },
    {
      "name": "ut_err",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "handled",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "n",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "r",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "rm",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "ut_rules",
      "type": "List",
      "direction": "local"
    },
    {
      "name": "ut_n",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "ut_removed",
      "type": "Boolean",
      "direction": "local",
      "default": false
    },
    {
      "name": "ut_handled",
      "type": "Boolean",
      "direction": "local",
      "default": false
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "0. About this agent"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "Unit tests of the Interrupt handler commands: add, list, check, remove and clear rules."
          }
        },
        {
          "id": "s3",
          "action": "core/log",
          "args": {
            "message": "Unit test agent UT Interrupt handlers started",
            "level": "info"
          },
          "description": "Write to the run log"
        }
      ],
      "description": "0. About this agent"
    },
    {
      "id": "s4",
      "action": "core/step",
      "args": {
        "title": "1. ooa.interrupts/add_rule - add, list, remove, clear rules"
      },
      "children": [
        {
          "id": "s5",
          "action": "core/comment",
          "args": {
            "text": "Shows ooa.interrupts/add_rule (add, list, remove, clear rules) and checks its result."
          }
        },
        {
          "id": "s6",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "action": "ooa.interrupts/add_rule",
              "args": {
                "name": "popup",
                "when_window": "Session expired",
                "then": "close_window"
              },
              "id": "s7"
            },
            {
              "action": "ooa.interrupts/list_rules",
              "out": {
                "rules": "r"
              },
              "id": "s8"
            },
            {
              "action": "core/set",
              "args": {
                "variable": "n",
                "value": {
                  "expr": "len($r)"
                }
              },
              "id": "s9"
            },
            {
              "action": "ooa.interrupts/check_now",
              "out": {
                "count": "handled"
              },
              "id": "s10"
            },
            {
              "action": "ooa.interrupts/remove_rule",
              "args": {
                "name": "popup"
              },
              "out": {
                "removed": "rm"
              },
              "id": "s11"
            },
            {
              "action": "ooa.interrupts/clear_rules",
              "id": "s12"
            },
            {
              "id": "s13",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$n$",
                  "right": 1
                }
              },
              "children": [
                {
                  "id": "s14",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check n",
              "else": [
                {
                  "id": "s15",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "n: expected eq 1, got ${n}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s16",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$rm$",
                  "right": true
                }
              },
              "children": [
                {
                  "id": "s17",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check rm",
              "else": [
                {
                  "id": "s18",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "rm: expected eq true, got ${rm}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s19",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$handled$",
                  "right": 0
                }
              },
              "children": [
                {
                  "id": "s20",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check handled",
              "else": [
                {
                  "id": "s21",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "handled: expected eq 0, got ${handled}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s22",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s23",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.interrupts/add_rule: add, list, remove, clear rules\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s24",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s25",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.interrupts/add_rule: add, list, remove, clear rules: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "1. ooa.interrupts/add_rule - add, list, remove, clear rules"
    },
    {
      "id": "s26",
      "action": "core/step",
      "args": {
        "title": "2. ooa.interrupts/list_rules - two rules listed"
      },
      "children": [
        {
          "id": "s27",
          "action": "core/comment",
          "args": {
            "text": "List rules gives the rules added so far: a rule that presses Enter on a session pop-up and one that ignores a browser cookie banner."
          }
        },
        {
          "id": "s28",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s29",
              "action": "ooa.interrupts/clear_rules",
              "args": {},
              "description": "Start without rules"
            },
            {
              "id": "s30",
              "action": "ooa.interrupts/add_rule",
              "args": {
                "name": "session warning",
                "when_window": "Session about to expire*",
                "then": "press_keys",
                "target": "{ENTER}",
                "max_times": 3
              },
              "description": "Press Enter when the session warning shows"
            },
            {
              "id": "s31",
              "action": "ooa.interrupts/add_rule",
              "args": {
                "name": "cookie banner",
                "when_element": "#cookie-banner",
                "then": "ignore"
              },
              "description": "Ignore the cookie banner"
            },
            {
              "id": "s32",
              "action": "ooa.interrupts/list_rules",
              "args": {},
              "out": {
                "rules": "ut_rules"
              },
              "description": "List the rules"
            },
            {
              "id": "s33",
              "action": "core/set",
              "args": {
                "variable": "ut_n",
                "value": {
                  "expr": "len($ut_rules)"
                }
              },
              "description": "Count them"
            },
            {
              "id": "s34",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ut_n$",
                  "right": 2
                }
              },
              "children": [
                {
                  "id": "s35",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check ut_n",
              "else": [
                {
                  "id": "s36",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "ut_n: expected eq 2, got ${ut_n}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s37",
              "action": "ooa.interrupts/clear_rules",
              "args": {},
              "description": "Leave no rules behind"
            },
            {
              "id": "s38",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s39",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.interrupts/list_rules: two rules listed\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s40",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s41",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.interrupts/list_rules: two rules listed: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "2. ooa.interrupts/list_rules - two rules listed"
    },
    {
      "id": "s42",
      "action": "core/step",
      "args": {
        "title": "3. ooa.interrupts/remove_rule - remove one, and one that is not there"
      },
      "children": [
        {
          "id": "s43",
          "action": "core/comment",
          "args": {
            "text": "Remove rule takes a rule away by its name and says whether there was one."
          }
        },
        {
          "id": "s44",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s45",
              "action": "ooa.interrupts/clear_rules",
              "args": {},
              "description": "Start without rules"
            },
            {
              "id": "s46",
              "action": "ooa.interrupts/add_rule",
              "args": {
                "name": "popup",
                "when_window": "UT pop-up 9f3a",
                "then": "close_window"
              },
              "description": "A rule to remove"
            },
            {
              "id": "s47",
              "action": "ooa.interrupts/remove_rule",
              "args": {
                "name": "popup"
              },
              "out": {
                "removed": "ut_removed"
              },
              "description": "Remove it"
            },
            {
              "id": "s48",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ut_removed$",
                  "right": true
                }
              },
              "children": [
                {
                  "id": "s49",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check ut_removed",
              "else": [
                {
                  "id": "s50",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "ut_removed: expected eq true, got ${ut_removed}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s51",
              "action": "ooa.interrupts/remove_rule",
              "args": {
                "name": "popup"
              },
              "out": {
                "removed": "ut_removed"
              },
              "description": "Remove it again"
            },
            {
              "id": "s52",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ut_removed$",
                  "right": false
                }
              },
              "children": [
                {
                  "id": "s53",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check ut_removed",
              "else": [
                {
                  "id": "s54",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "ut_removed: expected eq false, got ${ut_removed}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s55",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s56",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.interrupts/remove_rule: remove one, and one that is not there\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s57",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s58",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.interrupts/remove_rule: remove one, and one that is not there: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "3. ooa.interrupts/remove_rule - remove one, and one that is not there"
    },
    {
      "id": "s59",
      "action": "core/step",
      "args": {
        "title": "4. ooa.interrupts/clear_rules - no rules left"
      },
      "children": [
        {
          "id": "s60",
          "action": "core/comment",
          "args": {
            "text": "Clear rules removes every rule."
          }
        },
        {
          "id": "s61",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s62",
              "action": "ooa.interrupts/add_rule",
              "args": {
                "name": "a",
                "when_window": "UT pop-up A 9f3a",
                "then": "close_window"
              },
              "description": "A rule"
            },
            {
              "id": "s63",
              "action": "ooa.interrupts/add_rule",
              "args": {
                "name": "b",
                "when_window": "UT pop-up B 9f3a",
                "then": "close_window"
              },
              "description": "Another rule"
            },
            {
              "id": "s64",
              "action": "ooa.interrupts/clear_rules",
              "args": {},
              "description": "Clear them"
            },
            {
              "id": "s65",
              "action": "ooa.interrupts/list_rules",
              "args": {},
              "out": {
                "rules": "ut_rules"
              },
              "description": "List the rules"
            },
            {
              "id": "s66",
              "action": "core/set",
              "args": {
                "variable": "ut_n",
                "value": {
                  "expr": "len($ut_rules)"
                }
              },
              "description": "Count them"
            },
            {
              "id": "s67",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ut_n$",
                  "right": 0
                }
              },
              "children": [
                {
                  "id": "s68",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check ut_n",
              "else": [
                {
                  "id": "s69",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "ut_n: expected eq 0, got ${ut_n}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s70",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s71",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.interrupts/clear_rules: no rules left\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s72",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s73",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.interrupts/clear_rules: no rules left: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "4. ooa.interrupts/clear_rules - no rules left"
    },
    {
      "id": "s74",
      "action": "core/step",
      "args": {
        "title": "5. ooa.interrupts/check_now - nothing to handle"
      },
      "children": [
        {
          "id": "s75",
          "action": "core/comment",
          "args": {
            "text": "Check now looks once for the rules' windows and handles what it finds; no window with that title is open, so nothing is handled."
          }
        },
        {
          "id": "s76",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s77",
              "action": "ooa.interrupts/clear_rules",
              "args": {},
              "description": "Start without rules"
            },
            {
              "id": "s78",
              "action": "ooa.interrupts/add_rule",
              "args": {
                "name": "never",
                "when_window": "UT never shown 9f3a",
                "then": "close_window"
              },
              "description": "A rule for a window that is not open"
            },
            {
              "id": "s79",
              "action": "ooa.interrupts/check_now",
              "args": {},
              "out": {
                "handled": "ut_rules",
                "count": "ut_n"
              },
              "description": "Check now"
            },
            {
              "id": "s80",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ut_n$",
                  "right": 0
                }
              },
              "children": [
                {
                  "id": "s81",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check ut_n",
              "else": [
                {
                  "id": "s82",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "ut_n: expected eq 0, got ${ut_n}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s83",
              "action": "core/set",
              "args": {
                "variable": "ut_n",
                "value": {
                  "expr": "len($ut_rules)"
                }
              },
              "description": "Count the rules handled"
            },
            {
              "id": "s84",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ut_n$",
                  "right": 0
                }
              },
              "children": [
                {
                  "id": "s85",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check ut_n",
              "else": [
                {
                  "id": "s86",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "ut_n: expected eq 0, got ${ut_n}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s87",
              "action": "ooa.interrupts/clear_rules",
              "args": {},
              "description": "Leave no rules behind"
            },
            {
              "id": "s88",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s89",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.interrupts/check_now: nothing to handle\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s90",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s91",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.interrupts/check_now: nothing to handle: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "5. ooa.interrupts/check_now - nothing to handle"
    },
    {
      "id": "s92",
      "action": "core/step",
      "args": {
        "title": "6. Summary"
      },
      "children": [
        {
          "id": "s93",
          "action": "core/comment",
          "args": {
            "text": "How many cases passed; the run fails when any case failed."
          }
        },
        {
          "id": "s94",
          "action": "core/log",
          "args": {
            "message": "Unit test results: ${ut_pass} passed, ${ut_fail} failed\n${ut_report}",
            "level": "info"
          },
          "description": "Write to the run log"
        },
        {
          "id": "s95",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "gt",
              "left": "$ut_fail$",
              "right": 0
            }
          },
          "children": [
            {
              "id": "s96",
              "action": "core/throw",
              "args": {
                "code": "UT.FAILED",
                "message": "${ut_fail} of the cases failed; see ut_report"
              },
              "description": "Mark the run failed"
            }
          ],
          "description": "Did any case fail?"
        }
      ],
      "description": "6. Summary"
    }
  ]
}
