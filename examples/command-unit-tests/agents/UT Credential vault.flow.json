{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "ut_vault",
  "name": "UT Credential vault",
  "description": "Unit tests of every Credential vault command on the credential unit_tests/ut_vault: save a new value with an expiry date, read the expiry and the Credential has expired condition. Needs One CommandCenter (locally the vault is read-only).",
  "tags": [
    "unit-test",
    "commands"
  ],
  "variables": [
    {
      "name": "ut_dir",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Unit tests",
      "description": "Folder with the test data (files, workbooks, fixtures)."
    },
    {
      "name": "standin_url",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local stand-in that imitates outside services."
    },
    {
      "name": "ut_pass",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks passed."
    },
    {
      "name": "ut_fail",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks failed."
    },
    {
      "name": "ut_report",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "One line per case: PASS or FAIL, the command and the case."
    },
    {
      "name": "ut_err",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "ut_got_error",
      "type": "Boolean",
      "direction": "local",
      "default": false
    },
    {
      "name": "date",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "gone",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "has",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "note",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "pw",
      "type": "Credential",
      "direction": "local",
      "default": {
        "$credential": "unit_tests/ut_vault/new_password"
      }
    },
    {
      "name": "vt_expires",
      "type": "String",
      "direction": "local"
    },
    {
      "name": "vt_days",
      "type": "Number",
      "direction": "local"
    },
    {
      "name": "vt_expired",
      "type": "Boolean",
      "direction": "local"
    },
    {
      "name": "vt_soon",
      "type": "Boolean",
      "direction": "local"
    },
    {
      "name": "vt_has",
      "type": "Boolean",
      "direction": "local"
    },
    {
      "name": "ut_cond",
      "type": "Boolean",
      "direction": "local",
      "default": false
    },
    {
      "name": "vt_cond",
      "type": "Boolean",
      "direction": "local",
      "default": false
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "0. About this agent"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "Unit tests of every Credential vault command on the credential unit_tests/ut_vault: save a new value with an expiry date, read the expiry and the Credential has expired condition. Needs One CommandCenter (locally the vault is read-only)."
          }
        },
        {
          "id": "s3",
          "action": "core/log",
          "args": {
            "message": "Unit test agent UT Credential vault started",
            "level": "info"
          },
          "description": "Write to the run log"
        }
      ],
      "description": "0. About this agent"
    },
    {
      "id": "s18",
      "action": "core/step",
      "args": {
        "title": "1. ooa.vault/save_credential - typed text is refused: the value must be a Credential"
      },
      "children": [
        {
          "id": "s19",
          "action": "core/comment",
          "args": {
            "text": "Shows ooa.vault/save_credential (typed text is refused: the value must be a Credential) and checks its result."
          }
        },
        {
          "id": "s20",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s22",
              "action": "core/set",
              "args": {
                "variable": "ut_got_error",
                "value": false
              }
            },
            {
              "id": "s23",
              "action": "core/try",
              "args": {},
              "children": [
                {
                  "action": "ooa.vault/save_credential",
                  "args": {
                    "credential": "it/app/password",
                    "value": "plain text"
                  },
                  "id": "s21"
                }
              ],
              "description": "These steps should fail with VAULT.NO_SECRET",
              "catch": [
                {
                  "codes": [
                    "VAULT.NO_SECRET"
                  ],
                  "children": [
                    {
                      "id": "s24",
                      "action": "core/set",
                      "args": {
                        "variable": "ut_got_error",
                        "value": true
                      },
                      "description": "The expected error came"
                    }
                  ]
                }
              ]
            },
            {
              "id": "s25",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ut_got_error$",
                  "right": true
                }
              },
              "children": [
                {
                  "id": "s26",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check error VAULT.NO_SECRET",
              "else": [
                {
                  "id": "s27",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "error VAULT.NO_SECRET: expected eq true, got ${ut_got_error}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s28",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s29",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.vault/save_credential: typed text is refused: the value must be a Credential\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s30",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s31",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.vault/save_credential: typed text is refused: the value must be a Credential: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "1. ooa.vault/save_credential - typed text is refused: the value must be a Credential"
    },
