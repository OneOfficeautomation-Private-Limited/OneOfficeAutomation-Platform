    {
      "id": "s104",
      "action": "core/step",
      "args": {
        "title": "5. ooa.vault/credential_expiry - days left, not expired, not expiring soon"
      },
      "children": [
        {
          "id": "s105",
          "action": "core/comment",
          "args": {
            "text": "Credential expiry reads when an attribute expires. Just after it was saved for 90 days: it has an expiry, 89 or 90 days are left, it has not expired and with warn_days 14 it is not expiring soon."
          }
        },
        {
          "id": "s106",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s107",
              "action": "ooa.vault/save_credential",
              "args": {
                "credential": "unit_tests/ut_vault/password",
                "value": "$pw$",
                "expires_in_days": 90
              }
            },
            {
              "id": "s108",
              "action": "ooa.vault/credential_expiry",
