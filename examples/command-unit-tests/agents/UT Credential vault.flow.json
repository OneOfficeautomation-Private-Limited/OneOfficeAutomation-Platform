    {
      "id": "s90",
      "action": "core/step",
      "args": {
        "title": "4. ooa.vault/save_credential - a new value that expires in 90 days"
      },
      "children": [
        {
          "id": "s91",
          "action": "core/comment",
          "args": {
            "text": "Save credential stores a new value of a vault attribute (here the made-up new_password, copied into password) with an expiry date 90 days away; it gives back the date and the days left."
          }
        },
        {
          "id": "s92",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s93",
              "action": "ooa.vault/save_credential",
              "args": {
                "credential": "unit_tests/ut_vault/password",
                "value": "$pw$",
                "expires_in_days": 90
              },
              "out": {
                "expires": "vt_expires",
                "days_left": "vt_days"
              }
            },
            {
              "id": "s94",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "notEmpty",
                  "left": "$vt_expires$"
                }
              },
              "children": [
                {
                  "id": "s95",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check the expiry date",
              "else": [
                {
                  "id": "s96",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "the expiry date: expected notEmpty , got ${vt_expires}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s97",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "between",
                  "left": "$vt_days$",
                  "right": [
                    89,
                    90
                  ]
                }
              },
              "children": [
                {
                  "id": "s98",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check days left",
              "else": [
                {
                  "id": "s99",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "days left: expected between [89, 90], got ${vt_days}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s100",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
