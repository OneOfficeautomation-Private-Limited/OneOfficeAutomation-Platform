                  "-NoProfile",
                  "-WindowStyle",
                  "Hidden",
                  "-Command",
                  "Add-Type -AssemblyName System.Windows.Forms; $f = New-Object Windows.Forms.Form; $f.Text = 'UT vision window'; $f.Width = 460; $f.Height = 320; $f.StartPosition = 'CenterScreen'; $t = New-Object Windows.Forms.TextBox; $t.Name = 'notes'; $t.Multiline = $true; $t.Dock = 'Fill'; $f.Controls.Add($t); $f.TopMost = $true; [System.Windows.Forms.Application]::Run($f)"
                ]
              },
              "description": "Open the test window 'UT vision window'"
            },
            {
              "id": "s65",
              "action": "ooa.window/wait_for",
              "args": {
                "title": "UT vision window",
                "timeout_seconds": 30
              },
              "description": "Wait for the test window"
            },
            {
              "id": "s66",
              "action": "ooa.ai_screen/type_described",
              "args": {
                "description": "the notes text box",
                "text": "typed by vision",
                "provider": "openai_compatible",
                "base_url": "$standin_url$/dsk/ai",
                "model": "ut-vision"
              },
              "description": "Type into the notes box"
            },
            {
              "id": "s67",
              "action": "ooa.desktop_ui/object_action",
              "args": {
                "object": {
                  "technology": "desktop",
                  "window": {
                    "title": "UT vision window",
                    "title_match": "equals"
                  },
                  "properties": [
                    {
                      "name": "ControlType",
                      "value": "Edit",
                      "match": "equals",
                      "use": true
                    },
                    {
                      "name": "AutomationId",
                      "value": "notes",
                      "match": "equals",
                      "use": true
                    }
                  ],
                  "index": 0
                },
                "action": "get_text"
              },
              "out": {
                "result": "ut_text"
              },
              "description": "Read the box"
            },
            {
              "id": "s68",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "contains",
                  "left": "$ut_text$",
                  "right": "typed by vision"
                }
              },
              "children": [
                {
                  "id": "s69",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check notes",
              "else": [
                {
                  "id": "s70",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "notes: expected contains \"typed by vision\", got ${ut_text}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s71",
              "action": "ooa.window/close",
              "args": {
                "title": "UT vision window"
              },
              "continueOnError": true,
              "description": "Close the test window"
            },
            {
              "id": "s72",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s73",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.ai_screen/type_described: type into the notes box\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s74",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s75",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.ai_screen/type_described: type into the notes box: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "4. ooa.ai_screen/type_described - type into the notes box"
    },
    {
      "id": "s76",
      "action": "core/step",
      "args": {
        "title": "5. Summary"
      },
      "children": [
        {
          "id": "s77",
          "action": "core/comment",
          "args": {
            "text": "How many cases passed; the run fails when any case failed."
          }
        },
        {
          "id": "s78",
          "action": "core/log",
          "args": {
            "message": "Unit test results: ${ut_pass} passed, ${ut_fail} failed\n${ut_report}",
            "level": "info"
          },
          "description": "Write to the run log"
        },
        {
          "id": "s79",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "gt",
              "left": "$ut_fail$",
              "right": 0
            }
          },
          "children": [
            {
              "id": "s80",
              "action": "core/throw",
              "args": {
                "code": "UT.FAILED",
                "message": "${ut_fail} of the cases failed; see ut_report"
              },
              "description": "Mark the run failed"
            }
          ],
          "description": "Did any case fail?"
        }
      ],
      "description": "5. Summary"
    }
  ]
}
