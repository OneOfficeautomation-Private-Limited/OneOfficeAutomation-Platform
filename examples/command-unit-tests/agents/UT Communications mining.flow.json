{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "ut_comms",
  "name": "UT Communications mining",
  "description": "Unit tests of every Communications mining command: each case shows the command in use against the local stand-in (made-up keys from the vault, never a real account) and checks its result.",
  "tags": [
    "unit-test",
    "commands"
  ],
  "variables": [
    {
      "name": "ut_dir",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Unit tests",
      "description": "Folder with the test data (files, workbooks, fixtures)."
    },
    {
      "name": "standin_url",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local stand-in that imitates outside services."
    },
    {
      "name": "ut_pass",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks passed."
    },
    {
      "name": "ut_fail",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks failed."
    },
    {
      "name": "ut_report",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "One line per case: PASS or FAIL, the command and the case."
    },
    {
      "name": "ut_err",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "n",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "r",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "t",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "c",
      "type": "Any",
      "direction": "local"
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "0. About this agent"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "Unit tests of every Communications mining command: each case shows the command in use against the local stand-in (made-up keys from the vault, never a real account) and checks its result."
          }
        },
        {
          "id": "s3",
          "action": "core/log",
          "args": {
            "message": "Unit test agent UT Communications mining started",
            "level": "info"
          },
          "description": "Write to the run log"
        }
      ],
      "description": "0. About this agent"
    },
    {
      "id": "s4",
      "action": "core/step",
      "args": {
        "title": "1. ooa.comms/discover_topics - topics in a mailbox export"
      },
      "children": [
        {
          "id": "s5",
          "action": "core/comment",
          "args": {
            "text": "Shows ooa.comms/discover_topics (topics in a mailbox export) and checks its result."
          }
        },
        {
          "id": "s6",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s7",
              "action": "ooa.file/write_text",
              "args": {
                "path": "mail/inbox.csv",
                "text": "id,subject,body\n1,Invoice overdue,Our invoice 1042 is overdue please pay\n2,Invoice question,Question about invoice 1043 payment\n3,Refund request,The laptop arrived damaged I want a refund\n4,Damaged item,Item damaged in transit refund please\n5,Overdue payment,Payment for invoice 1050 overdue\n6,Return refund,Return the damaged chair for a refund\n"
              },
              "description": "Prepare the test file mail/inbox.csv"
            },
            {
              "id": "s8",
              "action": "core/set",
              "args": {
                "variable": "n",
                "value": 0
              },
              "description": "Test value for n"
            },
            {
              "action": "ooa.comms/discover_topics",
              "args": {
                "file": "mail/inbox.csv",
                "id_column": "id",
                "topics": 2
              },
              "out": {
                "topics": "t",
                "rules": "r"
              },
              "id": "s9"
            },
            {
              "action": "core/set",
              "args": {
                "variable": "n",
                "value": {
                  "expr": "len($r)"
                }
              },
              "id": "s10"
            },
            {
              "id": "s11",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$n$",
                  "right": 2
                }
              },
              "children": [
                {
                  "id": "s12",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check n",
              "else": [
                {
                  "id": "s13",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "n: expected eq 2, got ${n}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s14",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s15",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.comms/discover_topics: topics in a mailbox export\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s16",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s17",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.comms/discover_topics: topics in a mailbox export: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "1. ooa.comms/discover_topics - topics in a mailbox export"
    },
    {
      "id": "s18",
      "action": "core/step",
      "args": {
        "title": "2. ooa.comms/route_messages - each message to a queue by its keywords"
      },
      "children": [
        {
          "id": "s19",
          "action": "core/comment",
          "args": {
            "text": "Shows ooa.comms/route_messages (each message to a queue by its keywords) and checks its result."
          }
        },
        {
          "id": "s20",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s21",
              "action": "ooa.file/write_text",
              "args": {
                "path": "mail/inbox.csv",
                "text": "id,subject,body\n1,Invoice overdue,Our invoice 1042 is overdue\n2,Refund request,The laptop arrived damaged\n3,Hello,Just saying thanks\n"
              },
              "description": "Prepare the test file mail/inbox.csv"
            },
            {
              "action": "ooa.comms/route_messages",
              "args": {
                "file": "mail/inbox.csv",
                "id_column": "id",
                "default_queue": "Other",
                "rules": {
                  "Invoices": [
                    "invoice",
                    "overdue"
                  ],
                  "Returns": [
                    "refund",
                    "damaged"
                  ]
                }
              },
              "out": {
                "counts": "c"
              },
              "id": "s22"
            },
            {
              "id": "s23",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$c$",
                  "right": {
                    "Invoices": 1,
                    "Returns": 1,
                    "Other": 1
                  }
                }
              },
              "children": [
                {
                  "id": "s24",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check c",
              "else": [
                {
                  "id": "s25",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "c: expected eq \"Invoices\": 1, \"Returns\": 1, \"Other\": 1, got ${c}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s26",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s27",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.comms/route_messages: each message to a queue by its keywords\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s28",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s29",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.comms/route_messages: each message to a queue by its keywords: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "2. ooa.comms/route_messages - each message to a queue by its keywords"
    },
    {
      "id": "s30",
      "action": "core/step",
      "args": {
        "title": "3. Summary"
      },
      "children": [
        {
          "id": "s31",
          "action": "core/comment",
          "args": {
            "text": "How many cases passed; the run fails when any case failed."
          }
        },
        {
          "id": "s32",
          "action": "core/log",
          "args": {
            "message": "Unit test results: ${ut_pass} passed, ${ut_fail} failed\n${ut_report}",
            "level": "info"
          },
          "description": "Write to the run log"
        },
        {
          "id": "s33",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "gt",
              "left": "$ut_fail$",
              "right": 0
            }
          },
          "children": [
            {
              "id": "s34",
              "action": "core/throw",
              "args": {
                "code": "UT.FAILED",
                "message": "${ut_fail} of the cases failed; see ut_report"
              },
              "description": "Mark the run failed"
            }
          ],
          "description": "Did any case fail?"
        }
      ],
      "description": "3. Summary"
    }
  ]
}
