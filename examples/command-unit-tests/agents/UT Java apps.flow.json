{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "ut_java_apps",
  "name": "UT Java apps",
  "description": "Unit tests of the Java apps commands. No Java desktop program runs here, so the cases check the empty answers and the clear errors; with a Java program open the same steps work on it.",
  "tags": [
    "unit-test",
    "commands"
  ],
  "variables": [
    {
      "name": "ut_dir",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Unit tests",
      "description": "Folder with the test data (files, workbooks, fixtures)."
    },
    {
      "name": "standin_url",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local stand-in that imitates outside services."
    },
    {
      "name": "ut_pass",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks passed."
    },
    {
      "name": "ut_fail",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks failed."
    },
    {
      "name": "ut_report",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "One line per case: PASS or FAIL, the command and the case."
    },
    {
      "name": "ut_err",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "ut_list",
      "type": "List",
      "direction": "local"
    },
    {
      "name": "ut_n",
      "type": "Number",
      "direction": "local",
      "default": 0
    },
    {
      "name": "ut_got_error",
      "type": "Boolean",
      "direction": "local",
      "default": false
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "0. About this agent"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "Unit tests of the Java apps commands. No Java desktop program runs here, so the cases check the empty answers and the clear errors; with a Java program open the same steps work on it."
          }
        },
        {
          "id": "s3",
          "action": "core/log",
          "args": {
            "message": "Unit test agent UT Java apps started",
            "level": "info"
          },
          "description": "Write to the run log"
        }
      ],
      "description": "0. About this agent"
    },
    {
      "id": "s4",
      "action": "core/step",
      "args": {
        "title": "1. ooa.java_apps/list_apps - no Java program of that name"
      },
      "children": [
        {
          "id": "s5",
          "action": "core/comment",
          "args": {
            "text": "List Java apps gives the open Java windows (title, process); none belongs to the made-up process."
          }
        },
        {
          "id": "s6",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s7",
              "action": "ooa.java_apps/list_apps",
              "args": {
                "process": "ut-no-such-java-9f3a"
              },
              "out": {
                "apps": "ut_list"
              },
              "description": "Java windows of a made-up process"
            },
            {
              "id": "s8",
              "action": "core/set",
              "args": {
                "variable": "ut_n",
                "value": {
                  "expr": "len($ut_list)"
                }
              },
              "description": "Count them"
            },
            {
              "id": "s9",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ut_n$",
                  "right": 0
                }
              },
              "children": [
                {
                  "id": "s10",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check ut_n",
              "else": [
                {
                  "id": "s11",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "ut_n: expected eq 0, got ${ut_n}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s12",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s13",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.java_apps/list_apps: no Java program of that name\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s14",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s15",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.java_apps/list_apps: no Java program of that name: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "1. ooa.java_apps/list_apps - no Java program of that name"
    },
    {
      "id": "s16",
      "action": "core/step",
      "args": {
        "title": "2. ooa.java_apps/find_objects - push buttons of a window that is not open"
      },
      "children": [
        {
          "id": "s17",
          "action": "core/comment",
          "args": {
            "text": "Find Java objects lists the accessible objects of a Java window by name and role; with no such window there are none (or a clear error when Java Access Bridge is off)."
          }
        },
        {
          "id": "s18",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s19",
              "action": "core/set",
              "args": {
                "variable": "ut_n",
                "value": 0
              }
            },
            {
              "id": "s20",
              "action": "ooa.java_apps/find_objects",
              "args": {
                "window_title": "UT no such Java window 9f3a",
                "role": "push button",
                "timeout_seconds": 0
              },
              "out": {
                "count": "ut_n"
              },
              "continueOnError": true,
              "description": "Find the push buttons"
            },
            {
              "id": "s21",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ut_n$",
                  "right": 0
                }
              },
              "children": [
                {
                  "id": "s22",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check ut_n",
              "else": [
                {
                  "id": "s23",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "ut_n: expected eq 0, got ${ut_n}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s24",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s25",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.java_apps/find_objects: push buttons of a window that is not open\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s26",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s27",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.java_apps/find_objects: push buttons of a window that is not open: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "2. ooa.java_apps/find_objects - push buttons of a window that is not open"
    },
    {
      "id": "s28",
      "action": "core/step",
      "args": {
        "title": "3. ooa.java_apps/object_action - a window that is not open"
      },
      "children": [
        {
          "id": "s29",
          "action": "core/comment",
          "args": {
            "text": "Java object action works on one object (click, set or get text, select, table cells...); with no such window it fails with a clear error after its time-out."
          }
        },
        {
          "id": "s30",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s31",
              "action": "core/set",
              "args": {
                "variable": "ut_got_error",
                "value": false
              }
            },
            {
              "id": "s32",
              "action": "core/try",
              "args": {},
              "children": [
                {
                  "id": "s33",
                  "action": "ooa.java_apps/object_action",
                  "args": {
                    "window_title": "UT no such Java window 9f3a",
                    "role": "text",
                    "name": "Customer",
                    "value": "Acme",
                    "timeout_seconds": 2,
                    "action": "set_text"
                  },
                  "description": "Set the text of a field"
                }
              ],
              "description": "These steps should fail with *",
              "catch": [
                {
                  "codes": [
                    "*"
                  ],
                  "children": [
                    {
                      "id": "s34",
                      "action": "core/set",
                      "args": {
                        "variable": "ut_got_error",
                        "value": true
                      },
                      "description": "The expected error came"
                    }
                  ]
                }
              ]
            },
            {
              "id": "s35",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ut_got_error$",
                  "right": true
                }
              },
              "children": [
                {
                  "id": "s36",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check error *",
              "else": [
                {
                  "id": "s37",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "error *: expected eq true, got ${ut_got_error}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s38",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s39",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.java_apps/object_action: a window that is not open\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s40",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s41",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.java_apps/object_action: a window that is not open: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "3. ooa.java_apps/object_action - a window that is not open"
    },
    {
      "id": "s42",
      "action": "core/step",
      "args": {
        "title": "4. ooa.java_apps/pick_object - nobody picks: time-out"
      },
      "children": [
        {
          "id": "s43",
          "action": "core/comment",
          "args": {
            "text": "Pick Java object (design time) waits for a person to point at a Java control; nobody does, so it ends with its time-out error after 2 seconds."
          }
        },
        {
          "id": "s44",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s45",
              "action": "core/set",
              "args": {
                "variable": "ut_got_error",
                "value": false
              }
            },
            {
              "id": "s46",
              "action": "core/try",
              "args": {},
              "children": [
                {
                  "id": "s47",
                  "action": "ooa.java_apps/pick_object",
                  "args": {
                    "timeout_seconds": 2
                  },
                  "description": "Wait 2 s for a pick"
                }
              ],
              "description": "These steps should fail with *",
              "catch": [
                {
                  "codes": [
                    "*"
                  ],
                  "children": [
                    {
                      "id": "s48",
                      "action": "core/set",
                      "args": {
                        "variable": "ut_got_error",
                        "value": true
                      },
                      "description": "The expected error came"
                    }
                  ]
                }
              ]
            },
            {
              "id": "s49",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ut_got_error$",
                  "right": true
                }
              },
              "children": [
                {
                  "id": "s50",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check error *",
              "else": [
                {
                  "id": "s51",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "error *: expected eq true, got ${ut_got_error}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s52",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s53",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.java_apps/pick_object: nobody picks: time-out\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s54",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s55",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.java_apps/pick_object: nobody picks: time-out: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "4. ooa.java_apps/pick_object - nobody picks: time-out"
    },
    {
      "id": "s56",
      "action": "core/step",
      "args": {
        "title": "5. Summary"
      },
      "children": [
        {
          "id": "s57",
          "action": "core/comment",
          "args": {
            "text": "How many cases passed; the run fails when any case failed."
          }
        },
        {
          "id": "s58",
          "action": "core/log",
          "args": {
            "message": "Unit test results: ${ut_pass} passed, ${ut_fail} failed\n${ut_report}",
            "level": "info"
          },
          "description": "Write to the run log"
        },
        {
          "id": "s59",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "gt",
              "left": "$ut_fail$",
              "right": 0
            }
          },
          "children": [
            {
              "id": "s60",
              "action": "core/throw",
              "args": {
                "code": "UT.FAILED",
                "message": "${ut_fail} of the cases failed; see ut_report"
              },
              "description": "Mark the run failed"
            }
          ],
          "description": "Did any case fail?"
        }
      ],
      "description": "5. Summary"
    }
  ]
}
