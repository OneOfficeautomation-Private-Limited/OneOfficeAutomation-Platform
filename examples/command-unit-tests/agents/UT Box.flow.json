{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "ut_box",
  "name": "UT Box",
  "description": "Unit tests of every Box command against the local stand-in (made-up records, made-up token from the vault): each case shows the command in use and checks its result.",
  "tags": [
    "unit-test",
    "commands"
  ],
  "variables": [
    {
      "name": "ut_dir",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Unit tests",
      "description": "Folder with the test data (files, workbooks, fixtures)."
    },
    {
      "name": "standin_url",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local stand-in that imitates outside services."
    },
    {
      "name": "ut_pass",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks passed."
    },
    {
      "name": "ut_fail",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks failed."
    },
    {
      "name": "ut_report",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "One line per case: PASS or FAIL, the command and the case."
    },
    {
      "name": "ut_err",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "fid",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "n",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "ut_exists",
      "type": "Boolean",
      "direction": "local",
      "default": false
    },
    {
      "name": "ut_text",
      "type": "String",
      "direction": "local",
      "default": ""
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "0. About this agent"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "Unit tests of every Box command against the local stand-in (made-up records, made-up token from the vault): each case shows the command in use and checks its result."
          }
        },
        {
          "id": "s3",
          "action": "core/log",
          "args": {
            "message": "Unit test agent UT Box started",
            "level": "info"
          },
          "description": "Write to the run log"
        }
      ],
      "description": "0. About this agent"
    },
    {
      "id": "s4",
      "action": "core/step",
      "args": {
        "title": "1. ooa.box/upload_file - upload, list the folder, download"
      },
      "children": [
        {
          "id": "s5",
          "action": "core/comment",
          "args": {
            "text": "Shows ooa.box/upload_file (upload, list the folder, download) and checks its result."
          }
        },
        {
          "id": "s6",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s7",
              "action": "ooa.file/write_text",
              "args": {
                "path": "report.csv",
                "text": "a,b\n1,2"
              },
              "description": "Prepare the test file report.csv"
            },
            {
              "action": "ooa.box/upload_file",
              "args": {
                "local_path": "{tmp}/report.csv",
                "folder_id": "42",
                "access_token": "$tok",
                "upload_url": "{mock}",
                "base_url": "{mock}"
              },
              "out": {
                "file_id": "fid"
              },
              "id": "s8"
            },
            {
              "action": "ooa.box/list_folder",
              "args": {
                "folder_id": "42",
                "access_token": "$tok",
                "base_url": "{mock}"
              },
              "out": {
                "count": "n"
              },
              "id": "s9"
            },
            {
              "action": "ooa.box/download_file",
              "args": {
                "file_id": "$fid",
                "save_as": "{tmp}/back.csv",
                "access_token": "$tok",
                "base_url": "{mock}"
              },
              "id": "s10"
            },
            {
              "id": "s11",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$fid$",
                  "right": "9001"
                }
              },
              "children": [
                {
                  "id": "s12",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check fid",
              "else": [
                {
                  "id": "s13",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "fid: expected eq \"9001\", got ${fid}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s14",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$n$",
                  "right": 1
                }
              },
              "children": [
                {
                  "id": "s15",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check n",
              "else": [
                {
                  "id": "s16",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "n: expected eq 1, got ${n}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s17",
              "action": "ooa.file/read_text",
              "args": {
                "path": "back.csv"
              },
              "out": {
                "text": "ut_text"
              },
              "description": "Read back.csv"
            },
            {
              "id": "s18",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ut_text$",
                  "right": "a,b\n1,2"
                }
              },
              "children": [
                {
                  "id": "s19",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check back.csv",
              "else": [
                {
                  "id": "s20",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "back.csv: expected eq \"a,b\\n1,2\", got ${ut_text}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s21",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s22",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.box/upload_file: upload, list the folder, download\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s23",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s24",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.box/upload_file: upload, list the folder, download: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "1. ooa.box/upload_file - upload, list the folder, download"
    },
    {
      "id": "s25",
      "action": "core/step",
      "args": {
        "title": "2. Summary"
      },
      "children": [
        {
          "id": "s26",
          "action": "core/comment",
          "args": {
            "text": "How many cases passed; the run fails when any case failed."
          }
        },
        {
          "id": "s27",
          "action": "core/log",
          "args": {
            "message": "Unit test results: ${ut_pass} passed, ${ut_fail} failed\n${ut_report}",
            "level": "info"
          },
          "description": "Write to the run log"
        },
        {
          "id": "s28",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "gt",
              "left": "$ut_fail$",
              "right": 0
            }
          },
          "children": [
            {
              "id": "s29",
              "action": "core/throw",
              "args": {
                "code": "UT.FAILED",
                "message": "${ut_fail} of the cases failed; see ut_report"
              },
              "description": "Mark the run failed"
            }
          ],
          "description": "Did any case fail?"
        }
      ],
      "description": "2. Summary"
    }
  ]
}
