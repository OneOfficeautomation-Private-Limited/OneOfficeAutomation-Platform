{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "ut_idp",
  "name": "UT Document Extraction",
  "description": "Unit tests of the document extraction commands on documents made by the agent.",
  "tags": [
    "unit-test",
    "commands"
  ],
  "variables": [
    {
      "name": "ut_dir",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Unit tests",
      "description": "Folder with the test data (files, workbooks, fixtures)."
    },
    {
      "name": "standin_url",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local stand-in that imitates outside services."
    },
    {
      "name": "ut_pass",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks passed."
    },
    {
      "name": "ut_fail",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks failed."
    },
    {
      "name": "ut_report",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "One line per case: PASS or FAIL, the command and the case."
    },
    {
      "name": "ut_err",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "m",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "t",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "ty",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "c",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "f",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "miss",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "n",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "used",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "ut_exists",
      "type": "Boolean",
      "direction": "local",
      "default": false
    },
    {
      "name": "ut_text",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "vals",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "v",
      "type": "Any",
      "direction": "local"
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "0. About this agent"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "Unit tests of the document extraction commands on documents made by the agent."
          }
        },
        {
          "id": "s3",
          "action": "core/log",
          "args": {
            "message": "Unit test agent UT Document Extraction started",
            "level": "info"
          },
          "description": "Write to the run log"
        }
      ],
      "description": "0. About this agent"
    },
    {
      "id": "s4",
      "action": "core/step",
      "args": {
        "title": "1. ooa.idp/classify_document - by keywords, no model needed"
      },
      "children": [
        {
          "id": "s5",
          "action": "core/comment",
          "args": {
            "text": "Shows ooa.idp/classify_document (by keywords, no model needed) and checks its result."
          }
        },
        {
          "id": "s6",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s7",
              "action": "core/set",
              "args": {
                "variable": "t",
                "value": "INVOICE INV-1042  Total due 115.00 EUR  VAT 19%"
              },
              "description": "Test value for t"
            },
            {
              "action": "ooa.idp/classify_document",
              "args": {
                "text": "$t",
                "method": "keywords",
                "types": [
                  {
                    "name": "invoice",
                    "keywords": [
                      "invoice",
                      "VAT",
                      "total due"
                    ]
                  },
                  {
                    "name": "delivery_note",
                    "keywords": [
                      "delivery note",
                      "shipped"
                    ]
                  }
                ]
              },
              "out": {
                "type": "ty",
                "method": "m"
              },
              "id": "s8"
            },
            {
              "id": "s9",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ty$",
                  "right": "invoice"
                }
              },
              "children": [
                {
                  "id": "s10",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check ty",
              "else": [
                {
                  "id": "s11",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "ty: expected eq \"invoice\", got ${ty}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s12",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$m$",
                  "right": "keywords"
                }
              },
              "children": [
                {
                  "id": "s13",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check m",
              "else": [
                {
                  "id": "s14",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "m: expected eq \"keywords\", got ${m}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s15",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s16",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.idp/classify_document: by keywords, no model needed\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s17",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s18",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.idp/classify_document: by keywords, no model needed: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "1. ooa.idp/classify_document - by keywords, no model needed"
    },
    {
      "id": "s34",
      "action": "core/step",
      "args": {
        "title": "3. ooa.idp/extract_by_rules - regex and after a label"
      },
      "children": [
        {
          "id": "s35",
          "action": "core/comment",
          "args": {
            "text": "Shows ooa.idp/extract_by_rules (regex and after a label) and checks its result."
          }
        },
        {
          "id": "s36",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s37",
              "action": "core/set",
              "args": {
                "variable": "t",
                "value": "Invoice INV-1042\nTotal due: 115.00 EUR\nThank you"
              },
              "description": "Test value for t"
            },
            {
              "action": "ooa.idp/extract_by_rules",
              "args": {
                "text": "$t",
                "rules": {
                  "invoice_number": {
                    "regex": "INV-\\d+"
                  },
                  "total": {
                    "after": "Total due:",
                    "until": " EUR"
                  },
                  "po_number": {
                    "regex": "PO-\\d+"
                  }
                }
              },
              "out": {
                "fields": "f",
                "missing": "miss"
              },
              "id": "s38"
            },
            {
              "id": "s39",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$f$",
                  "right": {
                    "invoice_number": "INV-1042",
                    "total": "115.00"
                  }
                }
              },
              "children": [
                {
                  "id": "s40",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check f",
              "else": [
                {
                  "id": "s41",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "f: expected eq \"invoice_number\": \"INV-1042\", \"total\": \"115.00\", got ${f}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s42",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$miss$",
                  "right": [
                    "po_number"
                  ]
                }
              },
              "children": [
                {
                  "id": "s43",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check miss",
              "else": [
                {
                  "id": "s44",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "miss: expected eq [\"po_number\"], got ${miss}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s45",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s46",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.idp/extract_by_rules: regex and after a label\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s47",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s48",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.idp/extract_by_rules: regex and after a label: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "3. ooa.idp/extract_by_rules - regex and after a label"
    },
    {
      "id": "s73",
      "action": "core/step",
      "args": {
        "title": "5. ooa.idp/extract_with_examples - claim decision with one checked example"
      },
      "children": [
        {
          "id": "s74",
          "action": "core/comment",
          "args": {
            "text": "Extract with examples asks a model for named fields and sends the latest checked examples of the same document type along; the case keeps one example, extracts from a new claim and checks the fields and that one example went with the request."
          }
        },
        {
          "id": "s75",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s76",
              "action": "ooa.folder/delete",
              "args": {
                "path": "case5",
                "recursive": true
              },
              "continueOnError": true,
              "description": "Start from an empty case folder (left from an earlier run)"
            },
            {
              "id": "s77",
              "action": "ooa.folder/create",
              "args": {
                "path": "case5"
              },
              "description": "Create the case folder"
            },
            {
              "id": "s78",
              "action": "ooa.idp/save_example",
              "args": {
                "examples_file": "case5/claims.examples.json",
                "document_type": "claim",
                "text": "CLAIM-SUGGEST Claimed amount: 450 Deductible: 50",
                "fields": {
                  "decision": "approve",
                  "approved_amount": 400,
                  "reason": "within policy"
                }
              },
              "out": {
                "count": "n"
              },
              "description": "Keep a checked claim"
            },
            {
              "id": "s79",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$n$",
                  "right": 1
                }
              },
              "children": [
                {
                  "id": "s80",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check n",
              "else": [
                {
                  "id": "s81",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "n: expected eq 1, got ${n}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s82",
              "action": "ooa.idp/extract_with_examples",
              "args": {
                "text": "CLAIM-SUGGEST Claimed amount: 500 Deductible: 100",
                "fields": {
                  "decision": "approve or reject",
                  "approved_amount": "the amount to pay",
                  "reason": "why"
                },
                "examples_file": "case5/claims.examples.json",
                "document_type": "claim",
                "provider": "openai_compatible",
                "base_url": "${standin_url}/v1",
                "api_key": {
                  "$credential": "unit_tests/ai/api_key"
                },
                "model": "qa-scripted"
              },
              "out": {
                "fields": "vals",
                "examples_used": "n"
              },
              "description": "Extract from a new claim"
            },
            {
              "id": "s83",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$n$",
                  "right": 1
                }
              },
              "children": [
                {
                  "id": "s84",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check n",
              "else": [
                {
                  "id": "s85",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "n: expected eq 1, got ${n}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s86",
              "action": "core/set",
              "args": {
                "variable": "v",
                "value": {
                  "expr": "$vals.decision"
                }
              },
              "description": "The decision"
            },
            {
              "id": "s87",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$v$",
                  "right": "approve"
                }
              },
              "children": [
                {
                  "id": "s88",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check v",
              "else": [
                {
                  "id": "s89",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "v: expected eq \"approve\", got ${v}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s90",
              "action": "core/set",
              "args": {
                "variable": "v",
                "value": {
                  "expr": "$vals.approved_amount"
                }
              },
              "description": "The amount"
            },
            {
              "id": "s91",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$v$",
                  "right": 400
                }
              },
              "children": [
                {
                  "id": "s92",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check v",
              "else": [
                {
                  "id": "s93",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "v: expected eq 400, got ${v}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s94",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s95",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.idp/extract_with_examples: claim decision with one checked example\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s96",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s97",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.idp/extract_with_examples: claim decision with one checked example: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "5. ooa.idp/extract_with_examples - claim decision with one checked example"
    },
    {
      "id": "s98",
      "action": "core/step",
      "args": {
        "title": "6. ooa.idp/save_example - two examples of one type"
      },
      "children": [
        {
          "id": "s99",
          "action": "core/comment",
          "args": {
            "text": "Save example keeps a document's checked values in the example file of its type and says how many examples that type now has."
          }
        },
        {
          "id": "s100",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s101",
              "action": "ooa.folder/delete",
              "args": {
                "path": "case6",
                "recursive": true
              },
              "continueOnError": true,
              "description": "Start from an empty case folder (left from an earlier run)"
            },
            {
              "id": "s102",
              "action": "ooa.folder/create",
              "args": {
                "path": "case6"
              },
              "description": "Create the case folder"
            },
            {
              "id": "s103",
              "action": "ooa.idp/save_example",
              "args": {
                "examples_file": "case6/inv.examples.json",
                "document_type": "invoice",
                "text": "Invoice INV-1 Total 10.00",
                "fields": {
                  "invoice_number": "INV-1",
                  "total": "10.00"
                }
              },
              "out": {
                "count": "n"
              },
              "description": "Keep invoice INV-1"
            },
            {
              "id": "s104",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$n$",
                  "right": 1
                }
              },
              "children": [
                {
                  "id": "s105",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check n",
              "else": [
                {
                  "id": "s106",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "n: expected eq 1, got ${n}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s107",
              "action": "ooa.idp/save_example",
              "args": {
                "examples_file": "case6/inv.examples.json",
                "document_type": "invoice",
                "text": "Invoice INV-2 Total 20.00",
                "fields": {
                  "invoice_number": "INV-2",
                  "total": "20.00"
                }
              },
              "out": {
                "count": "n"
              },
              "description": "Keep invoice INV-2"
            },
            {
              "id": "s108",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$n$",
                  "right": 2
                }
              },
              "children": [
                {
                  "id": "s109",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check n",
              "else": [
                {
                  "id": "s110",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "n: expected eq 2, got ${n}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s111",
              "action": "ooa.file/read_text",
              "args": {
                "path": "case6/inv.examples.json"
              },
              "out": {
                "text": "v"
              },
              "description": "Read the example file"
            },
            {
              "id": "s112",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "contains",
                  "left": "$v$",
                  "right": "INV-2"
                }
              },
              "children": [
                {
                  "id": "s113",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check the example file",
              "else": [
                {
                  "id": "s114",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "the example file: expected contains \"INV-2\", got ${v}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s115",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s116",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.idp/save_example: two examples of one type\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s117",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s118",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.idp/save_example: two examples of one type: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "6. ooa.idp/save_example - two examples of one type"
    },
    {
      "id": "s119",
      "action": "core/step",
      "args": {
        "title": "7. Summary"
      },
      "children": [
        {
          "id": "s120",
          "action": "core/comment",
          "args": {
            "text": "How many cases passed; the run fails when any case failed."
          }
        },
        {
          "id": "s121",
          "action": "core/log",
          "args": {
            "message": "Unit test results: ${ut_pass} passed, ${ut_fail} failed\n${ut_report}",
            "level": "info"
          },
          "description": "Write to the run log"
        },
        {
          "id": "s122",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "gt",
              "left": "$ut_fail$",
              "right": 0
            }
          },
          "children": [
            {
              "id": "s123",
              "action": "core/throw",
              "args": {
                "code": "UT.FAILED",
                "message": "${ut_fail} of the cases failed; see ut_report"
              },
              "description": "Mark the run failed"
            }
          ],
          "description": "Did any case fail?"
        }
      ],
      "description": "7. Summary"
    }
  ]
}
