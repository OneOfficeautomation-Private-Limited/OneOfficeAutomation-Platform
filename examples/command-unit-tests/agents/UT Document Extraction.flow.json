{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "ut_idp",
  "name": "UT Document Extraction",
  "description": "Unit tests of the document extraction commands on documents made by the agent.",
  "tags": [
    "unit-test",
    "commands"
  ],
  "variables": [
    {
      "name": "ut_dir",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Unit tests",
      "description": "Folder with the test data (files, workbooks, fixtures)."
    },
    {
      "name": "standin_url",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local stand-in that imitates outside services."
    },
    {
      "name": "ut_pass",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks passed."
    },
    {
      "name": "ut_fail",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks failed."
    },
    {
      "name": "ut_report",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "One line per case: PASS or FAIL, the command and the case."
    },
    {
      "name": "ut_err",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "m",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "t",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "ty",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "c",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "f",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "miss",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "n",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "used",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "ut_exists",
      "type": "Boolean",
      "direction": "local",
      "default": false
    },
    {
      "name": "ut_text",
      "type": "String",
      "direction": "local",
      "default": ""
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "0. About this agent"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "Unit tests of the document extraction commands on documents made by the agent."
          }
        },
        {
          "id": "s3",
          "action": "core/log",
          "args": {
            "message": "Unit test agent UT Document Extraction started",
            "level": "info"
          },
          "description": "Write to the run log"
        }
      ],
      "description": "0. About this agent"
    },
    {
      "id": "s4",
      "action": "core/step",
      "args": {
        "title": "1. ooa.idp/classify_document - by keywords, no model needed"
      },
      "children": [
        {
          "id": "s5",
          "action": "core/comment",
          "args": {
            "text": "Shows ooa.idp/classify_document (by keywords, no model needed) and checks its result."
          }
        },
        {
          "id": "s6",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s7",
              "action": "core/set",
              "args": {
                "variable": "t",
                "value": "INVOICE INV-1042  Total due 115.00 EUR  VAT 19%"
              },
              "description": "Test value for t"
            },
            {
              "action": "ooa.idp/classify_document",
              "args": {
                "text": "$t",
                "method": "keywords",
                "types": [
                  {
                    "name": "invoice",
                    "keywords": [
                      "invoice",
                      "VAT",
                      "total due"
                    ]
                  },
                  {
                    "name": "delivery_note",
                    "keywords": [
                      "delivery note",
                      "shipped"
                    ]
                  }
                ]
              },
              "out": {
                "type": "ty",
                "method": "m"
              },
              "id": "s8"
            },
            {
              "id": "s9",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ty$",
                  "right": "invoice"
                }
              },
              "children": [
                {
                  "id": "s10",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check ty",
              "else": [
                {
                  "id": "s11",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "ty: expected eq \"invoice\", got ${ty}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s12",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$m$",
                  "right": "keywords"
                }
              },
              "children": [
                {
                  "id": "s13",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check m",
              "else": [
                {
                  "id": "s14",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "m: expected eq \"keywords\", got ${m}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s15",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s16",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.idp/classify_document: by keywords, no model needed\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s17",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s18",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.idp/classify_document: by keywords, no model needed: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "1. ooa.idp/classify_document - by keywords, no model needed"
    },
    {
      "id": "s19",
      "action": "core/step",
      "args": {
        "title": "2. ooa.idp/classify_document - by a stand-in model"
      },
      "children": [
        {
          "id": "s20",
          "action": "core/comment",
          "args": {
            "text": "Shows ooa.idp/classify_document (by a stand-in model) and checks its result."
          }
        },
        {
          "id": "s21",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s22",
              "action": "core/set",
              "args": {
                "variable": "t",
                "value": "Goods dispatched to Berlin, 3 parcels"
              },
              "description": "Test value for t"
            },
            {
              "action": "ooa.idp/classify_document",
              "args": {
                "text": "$t",
                "method": "ai",
                "provider": "openai_compatible",
                "base_url": "{mock}",
                "api_key": "$tok",
                "model": "m",
                "types": [
                  {
                    "name": "invoice",
                    "description": "a supplier invoice"
                  },
                  {
                    "name": "delivery_note",
                    "description": "goods sent"
                  }
                ]
              },
              "out": {
                "type": "ty",
                "confidence": "c"
              },
              "id": "s23"
            },
            {
              "id": "s24",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ty$",
                  "right": "delivery_note"
                }
              },
              "children": [
                {
                  "id": "s25",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check ty",
              "else": [
                {
                  "id": "s26",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "ty: expected eq \"delivery_note\", got ${ty}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s27",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$c$",
                  "right": 0.9
                }
              },
              "children": [
                {
                  "id": "s28",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check c",
              "else": [
                {
                  "id": "s29",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "c: expected eq 0.9, got ${c}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s30",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s31",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.idp/classify_document: by a stand-in model\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s32",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s33",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.idp/classify_document: by a stand-in model: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "2. ooa.idp/classify_document - by a stand-in model"
    },
    {
      "id": "s34",
      "action": "core/step",
      "args": {
        "title": "3. ooa.idp/extract_by_rules - regex and after a label"
      },
      "children": [
        {
          "id": "s35",
          "action": "core/comment",
          "args": {
            "text": "Shows ooa.idp/extract_by_rules (regex and after a label) and checks its result."
          }
        },
        {
          "id": "s36",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s37",
              "action": "core/set",
              "args": {
                "variable": "t",
                "value": "Invoice INV-1042\nTotal due: 115.00 EUR\nThank you"
              },
              "description": "Test value for t"
            },
            {
              "action": "ooa.idp/extract_by_rules",
              "args": {
                "text": "$t",
                "rules": {
                  "invoice_number": {
                    "regex": "INV-\\d+"
                  },
                  "total": {
                    "after": "Total due:",
                    "until": " EUR"
                  },
                  "po_number": {
                    "regex": "PO-\\d+"
                  }
                }
              },
              "out": {
                "fields": "f",
                "missing": "miss"
              },
              "id": "s38"
            },
            {
              "id": "s39",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$f$",
                  "right": {
                    "invoice_number": "INV-1042",
                    "total": "115.00"
                  }
                }
              },
              "children": [
                {
                  "id": "s40",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check f",
              "else": [
                {
                  "id": "s41",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "f: expected eq \"invoice_number\": \"INV-1042\", \"total\": \"115.00\", got ${f}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s42",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$miss$",
                  "right": [
                    "po_number"
                  ]
                }
              },
              "children": [
                {
                  "id": "s43",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check miss",
              "else": [
                {
                  "id": "s44",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "miss: expected eq [\"po_number\"], got ${miss}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s45",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s46",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.idp/extract_by_rules: regex and after a label\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s47",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s48",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.idp/extract_by_rules: regex and after a label: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "3. ooa.idp/extract_by_rules - regex and after a label"
    },
    {
      "id": "s49",
      "action": "core/step",
      "args": {
        "title": "4. ooa.idp/save_example - keeps a checked example, then Extract with examples sends it to the model"
      },
      "children": [
        {
          "id": "s50",
          "action": "core/comment",
          "args": {
            "text": "Shows ooa.idp/save_example (keeps a checked example, then Extract with examples sends it to the model) and checks its result."
          }
        },
        {
          "id": "s51",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "action": "ooa.idp/save_example",
              "args": {
                "examples_file": "examples/invoice.examples.json",
                "document_type": "invoice",
                "text": "Invoice INV-1042 Total 115.00",
                "fields": {
                  "invoice_number": "INV-1042",
                  "total": "115.00"
                }
              },
              "out": {
                "count": "n"
              },
              "id": "s52"
            },
            {
              "action": "ooa.idp/extract_with_examples",
              "args": {
                "text": "Invoice INV-2001 Total 80.00",
                "fields": {
                  "invoice_number": "The invoice number",
                  "total": "The total"
                },
                "examples_file": "examples/invoice.examples.json",
                "document_type": "invoice",
                "provider": "openai_compatible",
                "base_url": "{mock}",
                "api_key": "$tok",
                "model": "m"
              },
              "out": {
                "fields": "f",
                "examples_used": "used"
              },
              "id": "s53"
            },
            {
              "id": "s54",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$n$",
                  "right": 1
                }
              },
              "children": [
                {
                  "id": "s55",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check n",
              "else": [
                {
                  "id": "s56",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "n: expected eq 1, got ${n}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s57",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$f$",
                  "right": {
                    "invoice_number": "INV-2001",
                    "total": "80.00"
                  }
                }
              },
              "children": [
                {
                  "id": "s58",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check f",
              "else": [
                {
                  "id": "s59",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "f: expected eq \"invoice_number\": \"INV-2001\", \"total\": \"80.00\", got ${f}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s60",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$used$",
                  "right": 1
                }
              },
              "children": [
                {
                  "id": "s61",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check used",
              "else": [
                {
                  "id": "s62",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "used: expected eq 1, got ${used}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s63",
              "action": "ooa.file/read_text",
              "args": {
                "path": "examples/invoice.examples.json"
              },
              "out": {
                "text": "ut_text"
              },
              "description": "Read examples/invoice.examples.json"
            },
            {
              "id": "s64",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s65",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.idp/save_example: keeps a checked example, then Extract with examples sends it to the model\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s66",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s67",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.idp/save_example: keeps a checked example, then Extract with examples sends it to the model: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "4. ooa.idp/save_example - keeps a checked example, then Extract with examples sends it to the model"
    },
    {
      "id": "s68",
      "action": "core/step",
      "args": {
        "title": "5. Summary"
      },
      "children": [
        {
          "id": "s69",
          "action": "core/comment",
          "args": {
            "text": "How many cases passed; the run fails when any case failed."
          }
        },
        {
          "id": "s70",
          "action": "core/log",
          "args": {
            "message": "Unit test results: ${ut_pass} passed, ${ut_fail} failed\n${ut_report}",
            "level": "info"
          },
          "description": "Write to the run log"
        },
        {
          "id": "s71",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "gt",
              "left": "$ut_fail$",
              "right": 0
            }
          },
          "children": [
            {
              "id": "s72",
              "action": "core/throw",
              "args": {
                "code": "UT.FAILED",
                "message": "${ut_fail} of the cases failed; see ut_report"
              },
              "description": "Mark the run failed"
            }
          ],
          "description": "Did any case fail?"
        }
      ],
      "description": "5. Summary"
    }
  ]
}
