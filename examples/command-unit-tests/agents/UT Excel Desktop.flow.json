    },
    {
      "id": "s72",
      "action": "core/step",
      "args": {
        "title": "4. ooa.excel_desktop/refresh_all - recalculates and saves"
      },
      "children": [
        {
          "id": "s73",
          "action": "core/comment",
          "args": {
            "text": "Refresh all refreshes queries and pivot tables, recalculates and saves; with nothing to refresh, the formula's value is in the saved file afterwards."
          }
        },
        {
          "id": "s74",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s75",
              "action": "ooa.excel/close",
              "args": {},
              "continueOnError": true,
              "description": "Close the session if an earlier case left it open"
            },
            {
              "id": "s76",
              "action": "ooa.folder/delete",
              "args": {
                "path": "case4",
                "recursive": true
              },
              "continueOnError": true,
              "description": "Start from an empty case folder (left from an earlier run)"
            },
            {
              "id": "s77",
              "action": "ooa.folder/create",
              "args": {
                "path": "case4"
              },
              "description": "Create the case folder"
            },
            {
              "id": "s78",
              "action": "ooa.excel/create_workbook",
              "args": {
                "path": "case4/r.xlsx",
                "sheet": "Data"
              },
              "description": "Create a workbook for this case"
            },
            {
              "id": "s79",
              "action": "ooa.excel/set_cell",
              "args": {
                "cell": "A1",
                "value": 21
              },
              "description": "Write a value"
            },
            {
              "id": "s80",
              "action": "ooa.excel/set_formula",
              "args": {
                "cell": "B1",
                "formula": "A1*2"
              },
              "description": "Write a formula"
            },
            {
              "id": "s81",
              "action": "ooa.excel/close",
              "args": {
                "save": true
              },
              "description": "Save and close"
            },
            {
              "id": "s82",
              "action": "ooa.excel_desktop/refresh_all",
              "args": {
                "path": "case4/r.xlsx",
                "save": true
              },
              "description": "Refresh and save"
            },
            {
              "id": "s83",
              "action": "ooa.excel/open",
              "args": {
                "path": "case4/r.xlsx"
              },
              "description": "Open the workbook"
            },
            {
              "id": "s84",
              "action": "ooa.excel/get_cell",
              "args": {
                "cell": "B1"
              },
              "out": {
                "value": "v"
              },
              "description": "Read the formula's value"
            },
            {
              "id": "s85",
              "action": "ooa.excel/close",
              "args": {}
            },
            {
              "id": "s86",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$v$",
