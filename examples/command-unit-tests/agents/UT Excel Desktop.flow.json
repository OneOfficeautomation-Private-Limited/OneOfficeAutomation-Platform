              },
              "children": [
                {
                  "id": "s87",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check v",
              "else": [
                {
                  "id": "s88",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "v: expected eq 42, got ${v}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s89",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s90",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.excel_desktop/refresh_all: recalculates and saves\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s91",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s92",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.excel_desktop/refresh_all: recalculates and saves: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "4. ooa.excel_desktop/refresh_all - recalculates and saves"
    },
    {
      "id": "s93",
      "action": "core/step",
      "args": {
        "title": "5. ooa.excel_desktop/update_links - workbook with no links"
      },
      "children": [
        {
          "id": "s94",
          "action": "core/comment",
          "args": {
            "text": "Update links has Excel refresh the values taken from linked workbooks and save. A link to another workbook cannot be written without Excel, so the case uses a workbook with none: the count of updated links is 0 and the workbook still reads back."
          }
        },
        {
          "id": "s95",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s96",
              "action": "ooa.excel/close",
              "args": {},
              "continueOnError": true,
              "description": "Close the session if an earlier case left it open"
            },
            {
              "id": "s97",
              "action": "ooa.folder/delete",
              "args": {
                "path": "case5",
                "recursive": true
              },
              "continueOnError": true,
              "description": "Start from an empty case folder (left from an earlier run)"
            },
            {
              "id": "s98",
              "action": "ooa.folder/create",
              "args": {
                "path": "case5"
              },
              "description": "Create the case folder"
            },
            {
              "id": "s99",
              "action": "ooa.excel/create_workbook",
              "args": {
                "path": "case5/l.xlsx",
                "sheet": "Data"
              },
              "description": "Create a workbook for this case"
            },
            {
              "id": "s100",
              "action": "ooa.excel/set_cell",
              "args": {
                "cell": "A1",
                "value": "kept"
              },
              "description": "Write a value"
            },
            {
              "id": "s101",
              "action": "ooa.excel/close",
              "args": {
                "save": true
              },
              "description": "Save and close"
            },
            {
              "id": "s102",
              "action": "ooa.excel_desktop/update_links",
              "args": {
                "path": "case5/l.xlsx",
                "save": true
              },
              "out": {
                "count": "n"
              },
              "description": "Update the links and save"
            },
            {
              "id": "s103",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$n$",
                  "right": 0
                }
              },
              "children": [
                {
                  "id": "s104",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check n",
              "else": [
                {
                  "id": "s105",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "n: expected eq 0, got ${n}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s106",
              "action": "ooa.excel/open",
              "args": {
                "path": "case5/l.xlsx"
              },
              "description": "Open the workbook"
            },
            {
              "id": "s107",
              "action": "ooa.excel/get_cell",
              "args": {
                "cell": "A1"
              },
              "out": {
                "value": "v"
              },
              "description": "Read A1"
            },
            {
              "id": "s108",
              "action": "ooa.excel/close",
              "args": {}
            },
            {
              "id": "s109",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$v$",
                  "right": "kept"
                }
              },
              "children": [
                {
                  "id": "s110",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check v",
              "else": [
                {
                  "id": "s111",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "v: expected eq \"kept\", got ${v}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s112",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s113",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.excel_desktop/update_links: workbook with no links\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s114",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s115",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.excel_desktop/update_links: workbook with no links: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "5. ooa.excel_desktop/update_links - workbook with no links"
    },
    {
      "id": "s116",
      "action": "core/step",
      "args": {
        "title": "6. ooa.excel_desktop/run_macro - a workbook without the macro"
      },
      "children": [
        {
          "id": "s117",
          "action": "core/comment",
          "args": {
            "text": "Run macro runs a VBA macro in a macro-enabled workbook. A workbook without the macro stops with EXCEL_DESKTOP.FAILED (a workbook with VBA cannot be made here without changing Excel's trust settings)."
          }
        },
        {
          "id": "s118",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s119",
              "action": "ooa.excel/close",
              "args": {},
              "continueOnError": true,
              "description": "Close the session if an earlier case left it open"
            },
            {
              "id": "s120",
              "action": "ooa.folder/delete",
              "args": {
                "path": "case6",
                "recursive": true
              },
              "continueOnError": true,
              "description": "Start from an empty case folder (left from an earlier run)"
            },
            {
              "id": "s121",
              "action": "ooa.folder/create",
              "args": {
                "path": "case6"
              },
              "description": "Create the case folder"
            },
            {
              "id": "s122",
              "action": "ooa.excel/create_workbook",
              "args": {
                "path": "case6/m.xlsx",
                "sheet": "Data"
              },
              "description": "Create a workbook for this case"
            },
            {
              "id": "s123",
              "action": "ooa.excel/close",
              "args": {
                "save": true
              },
              "description": "Save and close"
            },
            {
              "id": "s124",
              "action": "core/set",
              "args": {
                "variable": "ut_got_error",
                "value": false
              }
            },
            {
              "id": "s125",
              "action": "core/try",
              "args": {},
              "children": [
                {
                  "id": "s126",
                  "action": "ooa.excel_desktop/run_macro",
                  "args": {
                    "path": "case6/m.xlsx",
                    "macro": "NoSuchMacro"
                  },
                  "out": {
                    "result": "result"
                  },
                  "description": "Run a macro that is not there"
                }
              ],
              "description": "These steps should fail with EXCEL_DESKTOP.FAILED",
              "catch": [
                {
                  "codes": [
                    "EXCEL_DESKTOP.FAILED"
                  ],
                  "children": [
                    {
                      "id": "s127",
                      "action": "core/set",
                      "args": {
                        "variable": "ut_got_error",
                        "value": true
                      },
                      "description": "The expected error came"
                    }
                  ]
                }
              ]
            },
            {
              "id": "s128",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ut_got_error$",
                  "right": true
                }
              },
              "children": [
                {
                  "id": "s129",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check error EXCEL_DESKTOP.FAILED",
              "else": [
                {
                  "id": "s130",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "error EXCEL_DESKTOP.FAILED: expected eq true, got ${ut_got_error}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s131",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s132",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.excel_desktop/run_macro: a workbook without the macro\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s133",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s134",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.excel_desktop/run_macro: a workbook without the macro: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "6. ooa.excel_desktop/run_macro - a workbook without the macro"
    },
    {
      "id": "s135",
      "action": "core/step",
      "args": {
        "title": "7. Summary"
      },
      "children": [
        {
          "id": "s136",
          "action": "core/comment",
          "args": {
            "text": "How many cases passed; the run fails when any case failed."
          }
        },
        {
          "id": "s137",
          "action": "core/log",
          "args": {
            "message": "Unit test results: ${ut_pass} passed, ${ut_fail} failed\n${ut_report}",
            "level": "info"
          },
          "description": "Write to the run log"
        },
        {
          "id": "s138",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "gt",
              "left": "$ut_fail$",
              "right": 0
            }
          },
          "children": [
            {
              "id": "s139",
              "action": "core/throw",
              "args": {
                "code": "UT.FAILED",
                "message": "${ut_fail} of the cases failed; see ut_report"
              },
              "description": "Mark the run failed"
            }
          ],
          "description": "Did any case fail?"
        }
      ],
      "description": "7. Summary"
    }
  ]
}
