{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "ut_services",
  "name": "UT Windows Services",
  "description": "Unit tests of the Windows service commands: read-only checks on real services; commands that start, stop or change a service are built against a service name that does not exist.",
  "tags": [
    "unit-test",
    "commands"
  ],
  "variables": [
    {
      "name": "ut_dir",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Unit tests",
      "description": "Folder with the test data (files, workbooks, fixtures)."
    },
    {
      "name": "standin_url",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local stand-in that imitates outside services."
    },
    {
      "name": "ut_pass",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks passed."
    },
    {
      "name": "ut_fail",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks failed."
    },
    {
      "name": "ut_report",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "One line per case: PASS or FAIL, the command and the case."
    },
    {
      "name": "ut_err",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "s",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "ok",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "ut_got_error",
      "type": "Boolean",
      "direction": "local",
      "default": false
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "0. About this agent"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "Unit tests of the Windows service commands: read-only checks on real services; commands that start, stop or change a service are built against a service name that does not exist."
          }
        },
        {
          "id": "s3",
          "action": "core/log",
          "args": {
            "message": "Unit test agent UT Windows Services started",
            "level": "info"
          },
          "description": "Write to the run log"
        }
      ],
      "description": "0. About this agent"
    },
    {
      "id": "s4",
      "action": "core/step",
      "args": {
        "title": "1. ooa.services/get_status - a Windows service"
      },
      "children": [
        {
          "id": "s5",
          "action": "core/comment",
          "args": {
            "text": "Shows ooa.services/get_status (a Windows service) and checks its result."
          }
        },
        {
          "id": "s6",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "action": "ooa.services/get_status",
              "args": {
                "name": "EventLog"
              },
              "out": {
                "status": "s"
              },
              "id": "s7"
            },
            {
              "id": "s8",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$s$",
                  "right": "RUNNING"
                }
              },
              "children": [
                {
                  "id": "s9",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check s",
              "else": [
                {
                  "id": "s10",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "s: expected eq \"RUNNING\", got ${s}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s11",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s12",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.services/get_status: a Windows service\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s13",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s14",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.services/get_status: a Windows service: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "1. ooa.services/get_status - a Windows service"
    },
