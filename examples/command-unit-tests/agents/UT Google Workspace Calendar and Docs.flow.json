              "description": "Check n",
              "else": [
                {
                  "id": "s70",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "n: expected eq 1, got ${n}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s71",
              "action": "core/set",
              "args": {
                "variable": "ut_v",
                "value": {
                  "expr": "$t.rows[0][5]"
                }
              },
              "description": "Take location for the check"
            },
            {
              "id": "s72",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ut_v$",
                  "right": "Room 4"
