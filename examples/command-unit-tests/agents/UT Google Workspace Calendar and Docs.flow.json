                "end": "2026-11-30T00:00:00",
                "time_zone": "UTC",
                "search": "Month-end"
              },
              "out": {
                "table": "t",
                "count": "n"
              },
              "description": "List November"
            },
            {
              "id": "s68",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$n$",
                  "right": 1
