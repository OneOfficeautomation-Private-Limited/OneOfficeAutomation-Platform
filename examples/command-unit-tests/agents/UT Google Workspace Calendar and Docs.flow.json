{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "ut_google_calendar_docs",
  "name": "UT Google Workspace Calendar and Docs",
  "description": "Unit tests of the Google Workspace Calendar and Docs commands against the local Google stand-in.",
  "tags": [
    "unit-test",
    "commands"
  ],
  "variables": [
    {
      "name": "ut_dir",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Unit tests",
      "description": "Folder with the test data (files, workbooks, fixtures)."
    },
    {
      "name": "standin_url",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local stand-in that imitates outside services."
    },
    {
      "name": "ut_pass",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks passed."
    },
    {
      "name": "ut_fail",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks failed."
    },
    {
      "name": "ut_report",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "One line per case: PASS or FAIL, the command and the case."
    },
    {
      "name": "ut_err",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "ut_got_error",
      "type": "Boolean",
      "direction": "local",
      "default": false
    },
    {
      "name": "ut_v",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "t",
      "type": "Table",
      "direction": "local"
    },
    {
      "name": "n",
      "type": "Number",
      "direction": "local"
    },
    {
      "name": "s",
      "type": "String",
      "direction": "local"
    },
    {
      "name": "s2",
      "type": "String",
      "direction": "local"
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "0. About this agent"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "Unit tests of the Google Workspace Calendar and Docs commands against the local Google stand-in."
          }
        },
        {
          "id": "s3",
          "action": "core/log",
          "args": {
            "message": "Unit test agent UT Google Workspace Calendar and Docs started",
            "level": "info"
          },
          "description": "Write to the run log"
        }
      ],
      "description": "0. About this agent"
    },
    {
      "id": "s46",
      "action": "core/step",
      "args": {
        "title": "Prepare: fresh stand-in records"
      },
      "children": [
        {
          "id": "s47",
          "action": "core/comment",
          "args": {
            "text": "Every case below talks to the local Google stand-in; the calendar and the documents start as seeded."
          }
        },
        {
          "id": "s48",
          "action": "ooa.rest/request",
          "args": {
            "url": "${standin_url}/msgoogle/reset",
            "method": "POST"
          },
          "out": {
            "status": "ut_v"
          },
          "description": "Put the stand-in's made-up records back as they were seeded"
        }
      ],
      "description": "Prepare: fresh stand-in records"
    },
    {
      "id": "s49",
      "action": "core/step",
      "args": {
        "title": "1. ooa.google/calendar_create_event - with Meet link and attendee"
      },
      "children": [
        {
          "id": "s50",
          "action": "core/comment",
          "args": {
            "text": "Create Google Calendar event gives the event id, its link and a Meet link."
          }
        },
        {
          "id": "s51",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s52",
              "action": "ooa.google/calendar_create_event",
              "args": {
                "access_token": {
                  "$credential": "unit_tests/google/token"
                },
                "base_url": "${standin_url}/msgoogle",
                "subject": "UT planning",
                "start": "2026-12-01T10:00:00",
                "end": "2026-12-01T11:00:00",
                "time_zone": "UTC",
                "notify": false,
                "attendees": "ann.lee@ut-google.test",
                "location": "Room 1",
                "add_meet_link": true,
                "reminder_minutes": 10
              },
              "out": {
                "event_id": "s"
              },
              "description": "Create the test event 'UT planning'"
            },
            {
              "id": "s53",
              "action": "ooa.google/calendar_create_event",
              "args": {
                "access_token": {
                  "$credential": "unit_tests/google/token"
                },
                "base_url": "${standin_url}/msgoogle",
                "subject": "UT planning 2",
                "start": "2026-12-02T10:00:00",
                "end": "2026-12-02T11:00:00",
                "time_zone": "UTC",
                "add_meet_link": true,
                "notify": false
              },
              "out": {
                "meet_link": "s2"
              },
              "description": "Create another to read the Meet link"
            },
            {
              "id": "s54",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "notEmpty",
                  "left": "$s$"
                }
              },
              "children": [
                {
                  "id": "s55",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check event id",
              "else": [
                {
                  "id": "s56",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "event id: expected notEmpty , got ${s}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s57",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "contains",
                  "left": "$s2$",
                  "right": "meet.test"
                }
              },
              "children": [
                {
                  "id": "s58",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check Meet link",
              "else": [
                {
                  "id": "s59",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "Meet link: expected contains \"meet.test\", got ${s2}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s60",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s61",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.google/calendar_create_event: with Meet link and attendee\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s62",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s63",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.google/calendar_create_event: with Meet link and attendee: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "1. ooa.google/calendar_create_event - with Meet link and attendee"
    },
    {
      "id": "s64",
      "action": "core/step",
      "args": {
