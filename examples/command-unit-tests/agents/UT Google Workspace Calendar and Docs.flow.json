    {
      "id": "s109",
      "action": "core/step",
      "args": {
        "title": "5. ooa.google/docs_create_document - with starting text"
      },
      "children": [
        {
          "id": "s110",
          "action": "core/comment",
          "args": {
            "text": "Create Google Doc makes a document with text and gives its id and link."
          }
        },
        {
          "id": "s111",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s112",
              "action": "ooa.google/docs_create_document",
              "args": {
                "access_token": {
                  "$credential": "unit_tests/google/token"
                },
                "base_url": "${standin_url}/msgoogle",
                "title": "UT Notes",
                "text": "First line"
              },
              "out": {
                "document_id": "s",
                "url": "s2"
              },
              "description": "Create UT Notes"
            },
            {
              "id": "s113",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "contains",
                  "left": "$s2$",
                  "right": "docs.google.com/document/d/"
                }
              },
              "children": [
                {
                  "id": "s114",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check link",
              "else": [
                {
                  "id": "s115",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "link: expected contains \"docs.google.com/document/d/\", got ${s2}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s116",
              "action": "ooa.google/docs_read_text",
