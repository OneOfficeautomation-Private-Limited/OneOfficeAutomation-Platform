      },
      "children": [
        {
          "id": "s155",
          "action": "core/comment",
          "args": {
            "text": "Shows ooa.pgp/verify (a partner imports the public key and checks the signature) and checks its result."
          }
        },
        {
          "id": "s156",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s157",
              "action": "core/set",
              "args": {
                "variable": "cred_pw",
