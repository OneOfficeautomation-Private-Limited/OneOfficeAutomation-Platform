            },
            {
              "id": "s158",
              "action": "ooa.file/write_text",
              "args": {
                "path": "ut_tmp/c5/report.csv",
                "text": "id,amount\n1,42.50\n"
              },
              "description": "Prepare the test file report.csv"
            },
            {
              "action": "ooa.pgp/create_keys",
              "args": {
                "name": "Ann Agent",
                "email": "ann@acme.test",
                "passphrase": "$cred_pw",
                "public_key_file": "ut_tmp/c5/ann.pub.asc",
                "private_key_file": "ut_tmp/c5/ann.key.asc",
                "gnupg_home": "ut_tmp/c5/keys"
              },
              "out": {
                "fingerprint": "fpr"
              },
              "id": "s159"
            },
            {
              "action": "ooa.pgp/sign",
              "args": {
                "path": "ut_tmp/c5/report.csv",
                "signature": "ut_tmp/c5/report.csv.sig",
                "passphrase": "$cred_pw",
                "gnupg_home": "ut_tmp/c5/keys"
              },
              "id": "s160"
            },
            {
              "action": "ooa.pgp/import_key",
              "args": {
                "path": "ut_tmp/c5/ann.pub.asc",
                "gnupg_home": "ut_tmp/c5/partner"
              },
              "id": "s161"
            },
            {
              "action": "ooa.pgp/verify",
              "args": {
                "path": "ut_tmp/c5/report.csv",
                "signature": "ut_tmp/c5/report.csv.sig",
                "gnupg_home": "ut_tmp/c5/partner"
              },
              "out": {
                "valid": "ok"
              },
              "id": "s162"
            },
            {
              "id": "s163",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ok$",
                  "right": true
                }
              },
              "children": [
                {
                  "id": "s164",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check ok",
              "else": [
                {
                  "id": "s165",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "ok: expected eq true, got ${ok}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s166",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s167",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.pgp/verify: a partner imports the public key and checks the signature\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s168",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s169",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.pgp/verify: a partner imports the public key and checks the signature: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "5. ooa.pgp/verify - a partner imports the public key and checks the signature"
    },
