            },
            {
              "action": "ooa.pgp/decrypt",
              "args": {
                "path": "ut_tmp/c3/report.csv.pgp",
                "target": "ut_tmp/c3/back.csv",
                "passphrase": "$cred_pw",
                "gnupg_home": "ut_tmp/c3/keys"
              },
              "id": "s128"
            },
            {
              "action": "ooa.file/read_text",
              "args": {
                "path": "ut_tmp/c3/back.csv"
              },
              "out": {
