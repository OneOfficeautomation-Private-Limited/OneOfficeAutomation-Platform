{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "ut_pgp",
  "name": "UT PGP",
  "description": "Unit tests of every PGP command. Each case shows the command in use and checks its result.",
  "tags": [
    "unit-test",
    "commands"
  ],
  "variables": [
    {
      "name": "ut_dir",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Unit tests",
      "description": "Folder with the test data (files, workbooks, fixtures)."
    },
    {
      "name": "standin_url",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local stand-in that imitates outside services."
    },
    {
      "name": "ut_pass",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks passed."
    },
    {
      "name": "ut_fail",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks failed."
    },
    {
      "name": "ut_report",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "One line per case: PASS or FAIL, the command and the case."
    },
    {
      "name": "ut_err",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "fpr",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "cred_pw",
      "type": "Credential",
      "direction": "local"
    },
    {
      "name": "ut_exists",
      "type": "Boolean",
      "direction": "local",
      "default": false
    },
    {
      "name": "enc",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "t",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "ok",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "f",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "n",
      "type": "Any",
      "direction": "local"
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "0. About this agent"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "Unit tests of every PGP command. Each case shows the command in use and checks its result."
          }
        },
        {
          "id": "s3",
          "action": "core/log",
          "args": {
            "message": "Unit test agent UT PGP started",
            "level": "info"
          },
          "description": "Write to the run log"
        },
        {
          "id": "s81",
          "action": "ooa.file/delete",
          "args": {
            "path": "ut_tmp",
            "pattern": "*",
            "include_subfolders": true
          },
          "continueOnError": true,
          "description": "Empty the case folders left by an earlier run"
        }
      ],
      "description": "0. About this agent"
    },
    {
      "id": "s82",
      "action": "core/step",
      "args": {
        "title": "1. ooa.pgp/create_keys - creates a key pair and saves both keys as files"
      },
      "children": [
        {
          "id": "s83",
          "action": "core/comment",
          "args": {
            "text": "Shows ooa.pgp/create_keys (creates a key pair and saves both keys as files) and checks its result."
          }
        },
        {
          "id": "s84",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s85",
              "action": "core/set",
              "args": {
                "variable": "cred_pw",
                "value": {
                  "$credential": "unit_tests/samples_test_mail/password"
                }
              },
              "description": "Test passphrase from the vault for cred_pw"
            },
            {
              "id": "s86",
              "action": "ooa.file/write_text",
              "args": {
                "path": "ut_tmp/c1/report.csv",
                "text": "id,amount\n1,42.50\n"
              },
              "description": "Prepare the test file report.csv"
            },
            {
              "action": "ooa.pgp/create_keys",
              "args": {
                "name": "Ann Agent",
                "email": "ann@acme.test",
                "passphrase": "$cred_pw",
                "public_key_file": "ut_tmp/c1/ann.pub.asc",
                "private_key_file": "ut_tmp/c1/ann.key.asc",
                "gnupg_home": "ut_tmp/c1/keys"
              },
              "out": {
                "fingerprint": "fpr"
              },
              "id": "s87"
            },
            {
              "id": "s88",
              "action": "core/set",
              "args": {
                "variable": "ut_exists",
                "value": false
              }
            },
            {
              "id": "s89",
              "action": "core/if",
              "args": {
                "condition": {
                  "condition": "ooa.file/exists",
                  "args": {
                    "path": "ut_tmp/c1/ann.pub.asc"
                  }
                }
              },
              "children": [
                {
                  "id": "s90",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_exists",
                    "value": true
                  }
                }
              ],
              "description": "Look for ann.pub.asc"
            },
            {
              "id": "s91",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ut_exists$",
                  "right": true
                }
              },
              "children": [
                {
                  "id": "s92",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check ann.pub.asc exists",
              "else": [
                {
                  "id": "s93",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "ann.pub.asc exists: expected eq true, got ${ut_exists}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s94",
              "action": "core/set",
              "args": {
                "variable": "ut_exists",
                "value": false
              }
            },
            {
              "id": "s95",
              "action": "core/if",
              "args": {
                "condition": {
                  "condition": "ooa.file/exists",
                  "args": {
                    "path": "ut_tmp/c1/ann.key.asc"
                  }
                }
              },
              "children": [
                {
                  "id": "s96",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_exists",
                    "value": true
                  }
                }
              ],
              "description": "Look for ann.key.asc"
            },
            {
              "id": "s97",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ut_exists$",
                  "right": true
                }
              },
              "children": [
                {
                  "id": "s98",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check ann.key.asc exists",
              "else": [
                {
                  "id": "s99",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "ann.key.asc exists: expected eq true, got ${ut_exists}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s100",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s101",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.pgp/create_keys: creates a key pair and saves both keys as files\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s102",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s103",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.pgp/create_keys: creates a key pair and saves both keys as files: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "1. ooa.pgp/create_keys - creates a key pair and saves both keys as files"
    },
    {
      "id": "s104",
      "action": "core/step",
      "args": {
        "title": "2. ooa.pgp/encrypt - encrypts for a key in the key folder"
