    },
    {
      "id": "s83",
      "action": "core/step",
      "args": {
        "title": "4. ooa.powerpoint/find_replace_picture - missing image"
      },
      "children": [
        {
          "id": "s84",
          "action": "core/comment",
          "args": {
            "text": "Shows ooa.powerpoint/find_replace_picture (missing image) and checks its result."
          }
        },
        {
          "id": "s85",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s88",
              "action": "core/set",
              "args": {
                "variable": "ut_got_error",
                "value": false
              }
            },
            {
              "id": "s89",
              "action": "core/try",
              "args": {},
              "children": [
                {
                  "action": "ooa.powerpoint/create_presentation",
                  "args": {
                    "path": "{tmp}/fr.pptx"
                  },
                  "id": "s86"
                },
                {
                  "action": "ooa.powerpoint/find_replace_picture",
                  "args": {
                    "image": "{tmp}/none.png",
                    "index": 1
                  },
                  "id": "s87"
                }
              ],
              "description": "These steps should fail with PPT.IMAGE_NOT_FOUND",
              "catch": [
                {
                  "codes": [
                    "PPT.IMAGE_NOT_FOUND"
                  ],
                  "children": [
                    {
                      "id": "s90",
                      "action": "core/set",
                      "args": {
                        "variable": "ut_got_error",
                        "value": true
                      },
                      "description": "The expected error came"
                    }
                  ]
                }
              ]
            },
            {
              "id": "s91",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ut_got_error$",
                  "right": true
                }
              },
              "children": [
                {
                  "id": "s92",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check error PPT.IMAGE_NOT_FOUND",
              "else": [
                {
                  "id": "s93",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "error PPT.IMAGE_NOT_FOUND: expected eq true, got ${ut_got_error}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s94",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s95",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.powerpoint/find_replace_picture: missing image\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s96",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s97",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.powerpoint/find_replace_picture: missing image: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "4. ooa.powerpoint/find_replace_picture - missing image"
    },
    {
      "id": "s98",
      "action": "core/step",
      "args": {
        "title": "5. ooa.powerpoint/extract_text - reads a saved presentation's text, slide after slide"
