      "children": [
        {
          "id": "s99",
          "action": "core/comment",
          "args": {
            "text": "Shows ooa.powerpoint/extract_text (reads a saved presentation's text, slide after slide) and checks its result."
          }
        },
        {
          "id": "s100",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "action": "ooa.powerpoint/create_presentation",
              "args": {
                "path": "{tmp}/deck.pptx"
              },
              "id": "s101"
            },
            {
              "action": "ooa.powerpoint/add_slide",
              "args": {
                "layout": "title_only",
                "title": "Quarterly results"
              },
              "id": "s102"
            },
            {
              "action": "ooa.powerpoint/close",
              "args": {
                "save": true
              },
              "id": "s103"
            },
            {
              "action": "ooa.powerpoint/extract_text",
              "args": {
                "path": "{tmp}/deck.pptx"
              },
              "out": {
                "text": "t"
              },
              "id": "s104"
            },
            {
              "action": "ooa.string/count_occurrences",
              "args": {
                "text": "$t",
                "find": "Quarterly results"
              },
              "out": {
                "count": "n"
              },
              "id": "s105"
            },
            {
              "id": "s106",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$n$",
                  "right": 1
                }
              },
              "children": [
                {
                  "id": "s107",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check n",
              "else": [
                {
                  "id": "s108",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "n: expected eq 1, got ${n}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s109",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s110",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.powerpoint/extract_text: reads a saved presentation's text, slide after slide\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s111",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s112",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.powerpoint/extract_text: reads a saved presentation's text, slide after slide: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "5. ooa.powerpoint/extract_text - reads a saved presentation's text, slide after slide"
    },
    {
      "id": "s113",
      "action": "core/step",
      "args": {
        "title": "6. Summary"
      },
      "children": [
        {
          "id": "s114",
          "action": "core/comment",
          "args": {
            "text": "How many cases passed; the run fails when any case failed."
          }
        },
        {
          "id": "s115",
          "action": "core/log",
          "args": {
            "message": "Unit test results: ${ut_pass} passed, ${ut_fail} failed\n${ut_report}",
            "level": "info"
          },
          "description": "Write to the run log"
        },
        {
          "id": "s116",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "gt",
              "left": "$ut_fail$",
              "right": 0
            }
          },
          "children": [
            {
              "id": "s117",
              "action": "core/throw",
              "args": {
                "code": "UT.FAILED",
                "message": "${ut_fail} of the cases failed; see ut_report"
              },
              "description": "Mark the run failed"
            }
          ],
          "description": "Did any case fail?"
        }
      ],
      "description": "6. Summary"
    }
  ]
