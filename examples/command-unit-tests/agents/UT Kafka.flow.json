          }
        },
        {
          "id": "s85",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s86",
              "action": "ooa.kafka/disconnect",
              "args": {},
              "out": {
                "closed": "k_closed"
              },
              "description": "Close the session"
            },
            {
              "id": "s87",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$k_closed$",
                  "right": true
                }
              },
              "children": [
                {
                  "id": "s88",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check k_closed",
              "else": [
                {
                  "id": "s89",
                  "action": "core/throw",
