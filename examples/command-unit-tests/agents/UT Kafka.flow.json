                    "value": "${ut_report}FAIL  ooa.kafka/disconnect: close the session: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
