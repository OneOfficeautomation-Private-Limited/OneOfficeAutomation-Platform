                    "message": "k_closed: expected eq true, got ${k_closed}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s90",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s91",
              "action": "core/set",
              "args": {
