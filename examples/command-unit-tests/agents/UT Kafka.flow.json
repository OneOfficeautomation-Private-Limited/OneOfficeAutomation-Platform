{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "ut_kafka",
  "name": "UT Kafka",
  "description": "Unit tests of every Kafka command: each case shows the command in use against the local stand-in (made-up keys from the vault, never a real account) and checks its result.",
  "tags": [
    "unit-test",
    "commands"
  ],
  "variables": [
    {
      "name": "ut_dir",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Unit tests",
      "description": "Folder with the test data (files, workbooks, fixtures)."
    },
    {
      "name": "standin_url",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local stand-in that imitates outside services."
    },
    {
      "name": "ut_pass",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks passed."
    },
    {
      "name": "ut_fail",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks failed."
    },
    {
      "name": "ut_report",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "One line per case: PASS or FAIL, the command and the case."
    },
    {
      "name": "ut_err",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "o",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "n",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "c",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "i",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "k_names",
      "type": "List",
      "direction": "local"
    },
    {
      "name": "k_offset",
      "type": "Number",
      "direction": "local"
    },
    {
      "name": "k_closed",
      "type": "Boolean",
      "direction": "local"
    }
  ],
  "steps": [
