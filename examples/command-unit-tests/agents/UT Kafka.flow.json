      },
      "children": [
        {
          "id": "s68",
          "action": "core/comment",
          "args": {
            "text": "Connect keeps the REST proxy's address and the API key and secret (from the vault) under a session, so later steps need not repeat them. Checked: a message sent and the topic listed without an address."
          }
        },
        {
          "id": "s69",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s70",
              "action": "ooa.kafka/connect",
              "args": {
                "base_url": "$standin_url$/kafka",
                "api_key": "ut-key",
                "api_secret": {
                  "$credential": "unit_tests/kafka/secret"
                }
              },
              "description": "Connect to the stand-in Kafka"
            },
