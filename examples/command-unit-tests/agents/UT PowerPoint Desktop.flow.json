{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "ut_powerpoint_desktop",
  "name": "UT PowerPoint Desktop",
  "description": "Unit tests of the commands that drive the installed PowerPoint program.",
  "tags": [
    "unit-test",
    "commands"
  ],
  "variables": [
    {
      "name": "ut_dir",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Unit tests",
      "description": "Folder with the test data (files, workbooks, fixtures)."
    },
    {
      "name": "standin_url",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local stand-in that imitates outside services."
    },
    {
      "name": "ut_pass",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks passed."
    },
    {
      "name": "ut_fail",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks failed."
    },
    {
      "name": "ut_report",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "One line per case: PASS or FAIL, the command and the case."
    },
    {
      "name": "ut_err",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "ut_got_error",
      "type": "Boolean",
      "direction": "local",
      "default": false
    },
    {
      "name": "shape",
      "type": "String",
      "direction": "local"
    },
    {
      "name": "pos",
      "type": "Dictionary",
      "direction": "local"
    },
    {
      "name": "n",
      "type": "Number",
      "direction": "local"
    },
    {
      "name": "text",
      "type": "String",
      "direction": "local"
    },
    {
      "name": "ut_screen",
      "type": "Boolean",
      "direction": "input",
      "default": false,
      "description": "Run the cases that take over the screen, open windows or print (off: they are built but not run)."
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "0. About this agent"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "Unit tests of the commands that drive the installed PowerPoint program."
          }
        },
        {
          "id": "s3",
          "action": "core/log",
          "args": {
            "message": "Unit test agent UT PowerPoint Desktop started",
            "level": "info"
          },
          "description": "Write to the run log"
        }
      ],
      "description": "0. About this agent"
    },
    {
      "id": "s4",
      "action": "core/step",
      "args": {
        "title": "1. ooa.powerpoint_desktop/run_macro - macro name is checked (G13)"
      },
      "children": [
        {
          "id": "s5",
          "action": "core/comment",
          "args": {
            "text": "Shows ooa.powerpoint_desktop/run_macro (macro name is checked (G13)) and checks its result."
          }
        },
        {
          "id": "s6",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s80",
              "action": "ooa.powerpoint/close",
              "args": {},
              "continueOnError": true,
              "description": "Close the session if an earlier case left it open"
            },
            {
              "id": "s81",
              "action": "ooa.folder/delete",
              "args": {
                "path": "case1",
                "recursive": true
              },
              "continueOnError": true,
              "description": "Start from an empty case folder (left from an earlier run)"
            },
            {
              "id": "s82",
              "action": "ooa.folder/create",
              "args": {
                "path": "case1"
              },
              "description": "Create the case folder"
            },
            {
              "id": "s7",
              "action": "ooa.file/write_text",
              "args": {
                "path": "case1/deck.pptm",
                "text": "x"
              },
              "description": "Prepare the test file deck.pptm"
            },
            {
              "id": "s9",
              "action": "core/set",
              "args": {
                "variable": "ut_got_error",
                "value": false
              }
            },
            {
              "id": "s10",
              "action": "core/try",
              "args": {},
              "children": [
                {
                  "action": "ooa.powerpoint_desktop/run_macro",
                  "args": {
                    "path": "case1/deck.pptm",
                    "macro": "Go; Remove-Item"
                  },
                  "id": "s8"
                }
              ],
              "description": "These steps should fail with POWERPOINT_DESKTOP.BAD_MACRO",
              "catch": [
                {
                  "codes": [
                    "POWERPOINT_DESKTOP.BAD_MACRO"
                  ],
                  "children": [
                    {
                      "id": "s11",
                      "action": "core/set",
                      "args": {
                        "variable": "ut_got_error",
                        "value": true
                      },
                      "description": "The expected error came"
                    }
                  ]
                }
              ]
            },
            {
              "id": "s12",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ut_got_error$",
                  "right": true
                }
              },
              "children": [
                {
                  "id": "s13",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check error POWERPOINT_DESKTOP.BAD_MACRO",
              "else": [
                {
                  "id": "s14",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "error POWERPOINT_DESKTOP.BAD_MACRO: expected eq true, got ${ut_got_error}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s15",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s16",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.powerpoint_desktop/run_macro: macro name is checked (G13)\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s17",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s18",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.powerpoint_desktop/run_macro: macro name is checked (G13): ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "1. ooa.powerpoint_desktop/run_macro - macro name is checked (G13)"
    },
