    {
      "id": "s119",
      "action": "core/step",
      "args": {
        "title": "7. ooa.powerpoint_desktop/paste - paste text from the clipboard"
      },
      "children": [
        {
          "id": "s120",
          "action": "core/comment",
          "args": {
            "text": "Paste puts what is on the clipboard onto a slide; the case copies a text and pastes it as text. (Runs only when the input ut_screen is on, because it takes over the screen.)"
          }
        },
        {
          "id": "s121",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s122",
              "action": "ooa.folder/delete",
              "args": {
                "path": "case7",
                "recursive": true
              },
              "continueOnError": true,
              "description": "Start from an empty case folder (left from an earlier run)"
            },
            {
              "id": "s123",
              "action": "ooa.folder/create",
              "args": {
                "path": "case7"
              },
              "description": "Create the case folder"
            },
            {
              "id": "s124",
              "action": "core/if",
              "args": {
                "condition": "$ut_screen$"
              },
              "children": [
                {
                  "id": "s125",
                  "action": "ooa.powerpoint/create_presentation",
                  "args": {
                    "path": "case7/deck.pptx"
                  },
                  "description": "Create a presentation"
                },
                {
                  "id": "s126",
                  "action": "ooa.powerpoint/add_slide",
                  "args": {
                    "layout": "blank"
                  },
                  "description": "Add a blank slide"
                },
                {
                  "id": "s127",
                  "action": "ooa.powerpoint/close",
                  "args": {
                    "save": true
                  },
                  "description": "Save and close"
                },
                {
                  "id": "s128",
                  "action": "ooa.desktop/clipboard_set",
                  "args": {
                    "text": "Pasted by the unit test"
                  },
                  "description": "Put a text on the clipboard"
                },
                {
                  "id": "s129",
                  "action": "ooa.powerpoint_desktop/paste",
                  "args": {
                    "path": "case7/deck.pptx",
                    "slide": 1,
                    "paste_as": "text"
                  },
                  "out": {
                    "shape": "shape"
                  },
                  "description": "Paste it on slide 1"
                },
                {
                  "id": "s130",
                  "action": "ooa.powerpoint/extract_text",
                  "args": {
                    "path": "case7/deck.pptx"
                  },
                  "out": {
                    "text": "text"
                  },
                  "description": "Read the presentation"
                },
                {
                  "id": "s131",
                  "action": "core/if",
                  "args": {
                    "condition": {
                      "op": "contains",
                      "left": "$text$",
                      "right": "Pasted by the unit test"
                    }
                  },
                  "children": [
                    {
                      "id": "s132",
                      "action": "core/comment",
                      "args": {
                        "text": "As expected"
                      }
                    }
                  ],
                  "description": "Check text",
                  "else": [
                    {
                      "id": "s133",
                      "action": "core/throw",
                      "args": {
                        "code": "UT.CHECK_FAILED",
                        "message": "text: expected contains \"Pasted by the unit test\", got ${text}"
                      },
                      "description": "Stop the case: the check failed"
                    }
                  ]
                }
              ],
              "description": "Only when screen cases are switched on",
              "else": [
                {
                  "id": "s134",
                  "action": "core/log",
                  "args": {
                    "message": "Not run: ooa.powerpoint_desktop/paste needs the screen (switch on ut_screen to run it)",
                    "level": "info"
                  },
                  "description": "Write to the run log"
                }
              ]
            },
            {
              "id": "s135",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s136",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.powerpoint_desktop/paste: paste text from the clipboard\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s137",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s138",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.powerpoint_desktop/paste: paste text from the clipboard: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "7. ooa.powerpoint_desktop/paste - paste text from the clipboard"
    },
    {
      "id": "s139",
      "action": "core/step",
      "args": {
        "title": "8. Summary"
      },
      "children": [
        {
          "id": "s140",
          "action": "core/comment",
          "args": {
            "text": "How many cases passed; the run fails when any case failed."
          }
        },
        {
          "id": "s141",
          "action": "core/log",
          "args": {
            "message": "Unit test results: ${ut_pass} passed, ${ut_fail} failed\n${ut_report}",
            "level": "info"
          },
          "description": "Write to the run log"
        },
        {
          "id": "s142",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "gt",
              "left": "$ut_fail$",
              "right": 0
            }
          },
          "children": [
            {
              "id": "s143",
              "action": "core/throw",
              "args": {
                "code": "UT.FAILED",
                "message": "${ut_fail} of the cases failed; see ut_report"
              },
              "description": "Mark the run failed"
            }
          ],
          "description": "Did any case fail?"
        }
      ],
      "description": "8. Summary"
    }
  ]
}
