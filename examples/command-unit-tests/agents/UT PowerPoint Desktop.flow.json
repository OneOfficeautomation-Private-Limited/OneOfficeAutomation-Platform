            "text": "Insert file embeds a file on a slide as an icon; the case embeds a csv, saves to a new file and checks the shape name and that the new file was written."
          }
        },
        {
          "id": "s97",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s98",
              "action": "ooa.powerpoint/close",
              "args": {},
              "continueOnError": true,
              "description": "Close the session if an earlier case left it open"
            },
            {
              "id": "s99",
              "action": "ooa.folder/delete",
              "args": {
                "path": "case6",
                "recursive": true
              },
              "continueOnError": true,
              "description": "Start from an empty case folder (left from an earlier run)"
            },
            {
              "id": "s100",
              "action": "ooa.folder/create",
              "args": {
                "path": "case6"
              },
              "description": "Create the case folder"
            },
            {
              "id": "s101",
              "action": "ooa.powerpoint/create_presentation",
              "args": {
                "path": "case6/deck.pptx"
              },
              "description": "Create a presentation"
