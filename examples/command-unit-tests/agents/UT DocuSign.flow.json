{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "ut_docusign",
  "name": "UT DocuSign",
  "description": "Unit tests of every DocuSign command against the local stand-in (made-up records, made-up token from the vault): each case shows the command in use and checks its result.",
  "tags": [
    "unit-test",
    "commands"
  ],
  "variables": [
    {
      "name": "ut_dir",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Unit tests",
      "description": "Folder with the test data (files, workbooks, fixtures)."
    },
    {
      "name": "standin_url",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local stand-in that imitates outside services."
    },
    {
      "name": "ut_pass",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks passed."
    },
    {
      "name": "ut_fail",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks failed."
    },
    {
      "name": "ut_report",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "One line per case: PASS or FAIL, the command and the case."
    },
    {
      "name": "ut_err",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "n",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "env",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "st",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "ut_exists",
      "type": "Boolean",
      "direction": "local",
      "default": false
    },
    {
      "name": "ut_text",
      "type": "String",
      "direction": "local",
      "default": ""
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "0. About this agent"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "Unit tests of every DocuSign command against the local stand-in (made-up records, made-up token from the vault): each case shows the command in use and checks its result."
          }
        },
        {
          "id": "s3",
          "action": "core/log",
          "args": {
            "message": "Unit test agent UT DocuSign started",
            "level": "info"
          },
          "description": "Write to the run log"
        }
      ],
      "description": "0. About this agent"
    },
    {
      "id": "s4",
      "action": "core/step",
      "args": {
        "title": "1. ooa.docusign/add_recipients - signer and copy (new)"
      },
      "children": [
        {
          "id": "s5",
          "action": "core/comment",
          "args": {
            "text": "Shows ooa.docusign/add_recipients (signer and copy (new)) and checks its result."
          }
        },
        {
          "id": "s6",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "action": "ooa.docusign/add_recipients",
              "args": {
                "base_url": "{mock}",
                "account_id": "acc",
                "envelope_id": "11111111-2222-3333-4444-555555555555",
                "access_token": "$tok",
                "recipients": [
                  {
                    "name": "Ann",
                    "email": "ann@acme.test"
                  },
                  {
                    "name": "Bob",
                    "email": "bob@acme.test",
                    "type": "copy"
                  }
                ]
              },
              "out": {
                "count": "n"
              },
              "id": "s7"
            },
            {
              "id": "s8",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$n$",
                  "right": 2
                }
              },
              "children": [
                {
                  "id": "s9",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check n",
              "else": [
                {
                  "id": "s10",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "n: expected eq 2, got ${n}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s11",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s12",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.docusign/add_recipients: signer and copy (new)\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s13",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s14",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.docusign/add_recipients: signer and copy (new): ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "1. ooa.docusign/add_recipients - signer and copy (new)"
    },
    {
      "id": "s15",
      "action": "core/step",
      "args": {
        "title": "2. ooa.docusign/create_envelope - send for signature, check the status, download the signed PDF"
      },
      "children": [
        {
          "id": "s16",
          "action": "core/comment",
          "args": {
            "text": "Shows ooa.docusign/create_envelope (send for signature, check the status, download the signed PDF) and checks its result."
          }
        },
        {
          "id": "s17",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "id": "s18",
              "action": "ooa.file/write_text",
              "args": {
                "path": "nda.pdf",
                "text": "%PDF-1.4 nda"
              },
              "description": "Prepare the test file nda.pdf"
            },
            {
              "action": "ooa.docusign/create_envelope",
              "args": {
                "base_url": "{mock}/restapi",
                "account_id": "1a2b3c4d-0000-1111-2222-333344445555",
                "access_token": "$tok",
                "documents": [
                  "{tmp}/nda.pdf"
                ],
                "signers": [
                  {
                    "name": "Ann Lee",
                    "email": "ann@acme.com"
                  }
                ],
                "email_subject": "Please sign the NDA",
                "send_now": true
              },
              "out": {
                "envelope_id": "env"
              },
              "id": "s19"
            },
            {
              "action": "ooa.docusign/get_envelope_status",
              "args": {
                "base_url": "{mock}/restapi",
                "account_id": "1a2b3c4d-0000-1111-2222-333344445555",
                "access_token": "$tok",
                "envelope_id": "$env"
              },
              "out": {
                "status": "st"
              },
              "id": "s20"
            },
            {
              "action": "ooa.docusign/download_combined_pdf",
              "args": {
                "base_url": "{mock}/restapi",
                "account_id": "1a2b3c4d-0000-1111-2222-333344445555",
                "access_token": "$tok",
                "envelope_id": "$env",
                "save_as": "{tmp}/signed.pdf"
              },
              "id": "s21"
            },
            {
              "id": "s22",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$st$",
                  "right": "completed"
                }
              },
              "children": [
                {
                  "id": "s23",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check st",
              "else": [
                {
                  "id": "s24",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "st: expected eq \"completed\", got ${st}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s25",
              "action": "ooa.file/read_text",
              "args": {
                "path": "signed.pdf"
              },
              "out": {
                "text": "ut_text"
              },
              "description": "Read signed.pdf"
            },
            {
              "id": "s26",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ut_text$",
                  "right": "%PDF signed"
                }
              },
              "children": [
                {
                  "id": "s27",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check signed.pdf",
              "else": [
                {
                  "id": "s28",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "signed.pdf: expected eq \"%PDF signed\", got ${ut_text}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s29",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s30",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.docusign/create_envelope: send for signature, check the status, download the signed PDF\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s31",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s32",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.docusign/create_envelope: send for signature, check the status, download the signed PDF: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "2. ooa.docusign/create_envelope - send for signature, check the status, download the signed PDF"
    },
    {
      "id": "s33",
      "action": "core/step",
      "args": {
        "title": "3. Summary"
      },
      "children": [
        {
          "id": "s34",
          "action": "core/comment",
          "args": {
            "text": "How many cases passed; the run fails when any case failed."
          }
        },
        {
          "id": "s35",
          "action": "core/log",
          "args": {
            "message": "Unit test results: ${ut_pass} passed, ${ut_fail} failed\n${ut_report}",
            "level": "info"
          },
          "description": "Write to the run log"
        },
        {
          "id": "s36",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "gt",
              "left": "$ut_fail$",
              "right": 0
            }
          },
          "children": [
            {
              "id": "s37",
              "action": "core/throw",
              "args": {
                "code": "UT.FAILED",
                "message": "${ut_fail} of the cases failed; see ut_report"
              },
              "description": "Mark the run failed"
            }
          ],
          "description": "Did any case fail?"
        }
      ],
      "description": "3. Summary"
    }
  ]
}
