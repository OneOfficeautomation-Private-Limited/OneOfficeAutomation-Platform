{
  "$schema": "https://schemas.oneofficeautomation.com/flow/v1.json",
  "kind": "TaskBot",
  "id": "ut_run_context",
  "name": "UT Run context",
  "description": "Unit tests of every Run context command. Each case shows the command in use and checks its result.",
  "tags": [
    "unit-test",
    "commands"
  ],
  "variables": [
    {
      "name": "ut_dir",
      "type": "String",
      "direction": "input",
      "default": "C:/Users/virup/OOA Unit tests",
      "description": "Folder with the test data (files, workbooks, fixtures)."
    },
    {
      "name": "standin_url",
      "type": "String",
      "direction": "input",
      "default": "http://127.0.0.1:8791",
      "description": "Address of the local stand-in that imitates outside services."
    },
    {
      "name": "ut_pass",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks passed."
    },
    {
      "name": "ut_fail",
      "type": "Number",
      "direction": "output",
      "default": 0,
      "description": "Commands whose checks failed."
    },
    {
      "name": "ut_report",
      "type": "String",
      "direction": "output",
      "default": "",
      "description": "One line per case: PASS or FAIL, the command and the case."
    },
    {
      "name": "ut_err",
      "type": "String",
      "direction": "local",
      "default": ""
    },
    {
      "name": "i",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "ok",
      "type": "Any",
      "direction": "local"
    },
    {
      "name": "v",
      "type": "Any",
      "direction": "local"
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "core/step",
      "args": {
        "title": "0. About this agent"
      },
      "children": [
        {
          "id": "s2",
          "action": "core/comment",
          "args": {
            "text": "Unit tests of every Run context command. Each case shows the command in use and checks its result."
          }
        },
        {
          "id": "s3",
          "action": "core/log",
          "args": {
            "message": "Unit test agent UT Run context started",
            "level": "info"
          },
          "description": "Write to the run log"
        },
        {
          "id": "s27",
          "action": "ooa.file/delete",
          "args": {
            "path": "ut_tmp",
            "pattern": "*",
            "include_subfolders": true
          },
          "continueOnError": true,
          "description": "Empty the case folders left by an earlier run"
        }
      ],
      "description": "0. About this agent"
    },
    {
      "id": "s28",
      "action": "core/step",
      "args": {
        "title": "1. ooa.run_context/get - run information"
      },
      "children": [
        {
          "id": "s29",
          "action": "core/comment",
          "args": {
            "text": "Shows ooa.run_context/get (run information) and checks its result."
          }
        },
        {
          "id": "s30",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "action": "ooa.run_context/get",
              "out": {
                "info": "i"
              },
              "id": "s31"
            },
            {
              "id": "s32",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "startsWith",
                  "left": "$i$",
                  "right": "{"
                }
              },
              "children": [
                {
                  "id": "s33",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check i is a Dictionary",
              "else": [
                {
                  "id": "s34",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "i is a Dictionary: expected startsWith \"\", got ${i}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s35",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s36",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.run_context/get: run information\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s37",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s38",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.run_context/get: run information: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "1. ooa.run_context/get - run information"
    },
    {
      "id": "s39",
      "action": "core/step",
      "args": {
        "title": "2. ooa.run_context/get_value - processors"
      },
      "children": [
        {
          "id": "s40",
          "action": "core/comment",
          "args": {
            "text": "Shows ooa.run_context/get_value (processors) and checks its result."
          }
        },
        {
          "id": "s41",
          "action": "core/try",
          "args": {},
          "children": [
            {
              "action": "ooa.run_context/get_value",
              "args": {
                "name": "processors"
              },
              "out": {
                "value": "v"
              },
              "id": "s42"
            },
            {
              "action": "core/set",
              "args": {
                "variable": "ok",
                "value": {
                  "expr": "$v >= 1"
                }
              },
              "id": "s43"
            },
            {
              "id": "s44",
              "action": "core/if",
              "args": {
                "condition": {
                  "op": "eq",
                  "left": "$ok$",
                  "right": true
                }
              },
              "children": [
                {
                  "id": "s45",
                  "action": "core/comment",
                  "args": {
                    "text": "As expected"
                  }
                }
              ],
              "description": "Check ok",
              "else": [
                {
                  "id": "s46",
                  "action": "core/throw",
                  "args": {
                    "code": "UT.CHECK_FAILED",
                    "message": "ok: expected eq true, got ${ok}"
                  },
                  "description": "Stop the case: the check failed"
                }
              ]
            },
            {
              "id": "s47",
              "action": "core/set",
              "args": {
                "variable": "ut_pass",
                "value": {
                  "expr": "$ut_pass + 1"
                }
              },
              "description": "Count the case as passed"
            },
            {
              "id": "s48",
              "action": "core/set",
              "args": {
                "variable": "ut_report",
                "value": "${ut_report}PASS  ooa.run_context/get_value: processors\n"
              },
              "description": "Add a PASS line to the report"
            }
          ],
          "description": "Run the command and check what it gave back",
          "catch": [
            {
              "codes": [
                "*"
              ],
              "children": [
                {
                  "id": "s49",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_fail",
                    "value": {
                      "expr": "$ut_fail + 1"
                    }
                  },
                  "description": "Count the case as failed"
                },
                {
                  "id": "s50",
                  "action": "core/set",
                  "args": {
                    "variable": "ut_report",
                    "value": "${ut_report}FAIL  ooa.run_context/get_value: processors: ${ut_err}\n"
                  },
                  "description": "Add a FAIL line with the reason"
                }
              ],
              "message_to": "ut_err"
            }
          ]
        }
      ],
      "description": "2. ooa.run_context/get_value - processors"
    },
    {
      "id": "s51",
      "action": "core/step",
      "args": {
        "title": "3. Summary"
      },
      "children": [
        {
          "id": "s52",
          "action": "core/comment",
          "args": {
            "text": "How many cases passed; the run fails when any case failed."
          }
        },
        {
          "id": "s53",
          "action": "core/log",
          "args": {
            "message": "Unit test results: ${ut_pass} passed, ${ut_fail} failed\n${ut_report}",
            "level": "info"
          },
          "description": "Write to the run log"
        },
        {
          "id": "s54",
          "action": "core/if",
          "args": {
            "condition": {
              "op": "gt",
              "left": "$ut_fail$",
              "right": 0
            }
          },
          "children": [
            {
              "id": "s55",
              "action": "core/throw",
              "args": {
                "code": "UT.FAILED",
                "message": "${ut_fail} of the cases failed; see ut_report"
              },
              "description": "Mark the run failed"
            }
          ],
          "description": "Did any case fail?"
        }
      ],
      "description": "3. Summary"
    }
  ]
}
