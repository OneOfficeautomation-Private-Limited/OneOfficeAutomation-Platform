        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/GitSync*Test.java",
        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/ApiTasks*Test.java",
        "platform/ui/src/console/AgentApis.tsx"
      ],
      "dependsOn": [
        "kernel"
      ]
    },
    {
      "id": "enterprise-ops",
      "name": "Enterprise operations",
      "layer": 3,
      "description": "Backups, SaaS regions and tenants, IP allow lists.",
      "paths": [
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/Backups.java",
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/RegionConfig.java",
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/RegionDirectory.java",
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/Tenants.java",
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/TenantHost.java",
