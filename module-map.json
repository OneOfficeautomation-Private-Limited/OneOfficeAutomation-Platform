        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/RegionConfig*Test.java",
        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/RegionDirectory*Test.java",
        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/Tenants*Test.java",
        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/TenantHost*Test.java",
        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/IpAllowList*Test.java"
      ],
      "dependsOn": [
        "kernel"
      ]
    },
    {
      "id": "apps",
      "name": "Applications and packaging",
      "layer": 4,
      "description": "The CLI and Studio, the runner program, the UI shell, installers, containers and Helm.",
      "paths": [
        "platform/cli/**",
        "platform/agent/**",
        "platform/vendor-tools/**",
        "platform/ui/**",
        "platform/customer/**",
        "platform/customer-setup/**",
        "platform/docker/**",
        "platform/linux/**",
        "platform/deploy/**",
        "platform/scripts/**",
        "platform/browser-extension/**"
      ],
      "dependsOn": [
        "kernel",
        "toolkits",
        "toolkits-microsoft",
        "toolkits-google",
        "toolkits-enterprise",
        "toolkits-cloud-data",
        "toolkits-ai",
        "toolkits-devops"
      ]
    }
  ]
}