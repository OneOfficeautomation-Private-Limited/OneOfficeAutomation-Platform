{
  "version": 1,
  "about": "Which module owns each file. The most specific match wins (a feature module's path beats the kernel's platform/control-room/**). Used by the module boundary report (ArchitectureTest) and, from phase 7, by CI to test only what changed. See docs/architecture/13-modules.md.",
  "layers": {
    "0": "foundation",
    "1": "toolkits",
    "2": "Command Center kernel",
    "3": "Command Center feature modules",
    "4": "applications and packaging"
  },
  "rules": [
    "A module uses only modules in lower layers, and the kernel.",
    "A feature module never uses another feature module's classes; they talk through kernel events.",
    "The kernel never names a feature module's classes; it reaches them through the module contract."
  ],
  "modules": [
    {
      "id": "foundation",
      "name": "Foundation",
      "layer": 0,
      "description": "The SDK, the agent engine and the JSON adapters: the same everywhere.",
      "paths": [
        "platform/sdk/**",
        "platform/runner/**",
        "platform/adapters-jackson/**",
        "contracts/**",
        "reference/**"
      ],
      "dependsOn": []
    },
    {
      "id": "toolkits",
      "name": "Toolkits (core)",
      "layer": 1,
      "description": "The core first-party toolkits (strings, lists, files, JSON, REST, databases, GenAI, OCR...) and the optional ones (packages-*); FirstPartyPackages finds the toolkit groups with ServiceLoader (phase 5).",
      "paths": [
        "platform/packages/**",
        "platform/packages-*/**",
        "docs/reference/toolkits/**"
      ],
      "dependsOn": [
        "foundation"
      ]
    },
    {
      "id": "toolkits-microsoft",
      "name": "Toolkits: microsoft",
      "layer": 1,
      "description": "The microsoft toolkit group (Microsoft365, ActiveDirectory, AzureVm, Exchange), in platform/toolkits/microsoft.",
      "paths": [
        "platform/toolkits/microsoft/**"
      ],
      "dependsOn": [
        "foundation",
        "toolkits"
      ]
    },
    {
      "id": "toolkits-google",
      "name": "Toolkits: google",
      "layer": 1,
      "description": "The google toolkit group (Google), in platform/toolkits/google.",
      "paths": [
        "platform/toolkits/google/**"
      ],
      "dependsOn": [
        "foundation",
        "toolkits"
      ]
    },
    {
      "id": "toolkits-enterprise",
      "name": "Toolkits: enterprise",
      "layer": 1,
      "description": "The enterprise toolkit group (Sap, SapBapi, Salesforce, ServiceNow, Workday, Jira, Zendesk, Asana, DocuSign, Box, Slack, Okta), in platform/toolkits/enterprise.",
      "paths": [
        "platform/toolkits/enterprise/**"
      ],
      "dependsOn": [
        "foundation",
        "toolkits"
      ]
    },
    {
      "id": "toolkits-cloud-data",
      "name": "Toolkits: cloud-data",
      "layer": 1,
      "description": "The cloud-data toolkit group (Ec2, AwsAi, Databricks, Snowflake, Kafka), in platform/toolkits/cloud-data.",
      "paths": [
        "platform/toolkits/cloud-data/**"
      ],
      "dependsOn": [
        "foundation",
        "toolkits"
      ]
    },
    {
      "id": "toolkits-ai",
      "name": "Toolkits: ai",
      "layer": 1,
      "description": "The ai toolkit group (AiAgent, AiSkills, AiScreen, Knowledge, Mining), in platform/toolkits/ai.",
      "paths": [
        "platform/toolkits/ai/**"
      ],
      "dependsOn": [
        "foundation",
        "toolkits"
      ]
    },
    {
      "id": "toolkits-devops",
      "name": "Toolkits: devops",
      "layer": 1,
      "description": "The devops toolkit group (GitHub, AzureDevOps), in platform/toolkits/devops.",
      "paths": [
        "platform/toolkits/devops/**"
      ],
      "dependsOn": [
        "foundation",
        "toolkits"
      ]
    },
    {
      "id": "kernel",
      "name": "Command Center kernel",
      "layer": 2,
      "description": "Sign-in, users, roles, folders, repository, runs and dispatch, audit, vault, settings, database, cluster, licensing, and the module contract every feature module plugs into. Anything in platform/control-room not claimed by a feature module.",
      "paths": [
        "platform/control-room/**"
      ],
      "dependsOn": [
        "foundation",
        "toolkits",
        "toolkits-microsoft",
        "toolkits-google",
        "toolkits-enterprise",
        "toolkits-cloud-data",
        "toolkits-ai",
        "toolkits-devops"
      ]
    },
    {
      "id": "document-automation",
      "name": "Document Automation",
      "layer": 3,
      "description": "Platform side of Document Automation: the DocFlow proxy and its settings, the mail inbox, document events and review tasks, MCP document tools, and the Document Automation screens. The DocFlow service itself is the separate oneoffice-docauto repository. Moved out of the kernel in phase 1: platform/modules/document-automation (Gradle project :document-automation), reached only through the module contract.",
      "paths": [
        "platform/modules/document-automation/**",
        "platform/ui/src/modules/document-automation/**",
        "platform/ui/docflow.html",
        "platform/packages/src/main/java/com/oneofficeautomation/packages/DocumentAutomationPackage.java",
        "docs/DOCUMENT_AUTOMATION.md",
        "docs/integration/document-automation-contract.md",
        "platform/docker/compose.docflow.yaml",
        "platform/docker/compose.saas.docflow.yaml"
      ],
      "dependsOn": [
        "kernel"
      ]
    },
    {
      "id": "one-chat",
      "name": "One Chat",
      "layer": 3,
      "description": "Running agents and checking runs in plain words. Moved out of the kernel: platform/modules/one-chat (Gradle project :one-chat).",
      "paths": [
        "platform/modules/one-chat/**",
        "platform/ui/src/modules/one-chat/**",
        "platform/conversation/**",
        "docs/user-guide/16-one-chat.md"
      ],
      "dependsOn": [
        "kernel"
      ]
    },
    {
      "id": "orchestration",
      "name": "Orchestration",
      "layer": 3,
      "description": "Schedules, triggers, long-running agents, environment locks, business calendars, workflows and work queues.",
      "paths": [
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/ScheduleRules.java",
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/TriggerKinds.java",
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/TriggerPollers.java",
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/RunWaits.java",
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/EnvironmentLocks.java",
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/Workflows.java",
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/QueueTools.java",
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/PollHttp.java",
        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/ScheduleRules*Test.java",
        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/TriggerKinds*Test.java",
        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/TriggerPollers*Test.java",
        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/RunWaits*Test.java",
        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/EnvironmentLocks*Test.java",
        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/Workflows*Test.java",
        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/QueueTools*Test.java",
        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/PollHttp*Test.java",
        "platform/ui/src/console/Schedules.tsx",
        "platform/ui/src/console/Triggers.tsx",
        "platform/ui/src/console/SuspendedRuns.tsx",
        "platform/ui/src/console/EnvironmentLocks.tsx",
        "platform/ui/src/console/Workflows.tsx",
        "platform/ui/src/console/Queues.tsx",
        "platform/ui/src/console/QueueInsights.tsx",
        "platform/ui/src/console/Inbox.tsx",
        "platform/ui/src/console/SuspendedRuns.test.tsx",
        "platform/ui/src/console/EnvironmentLocks.test.tsx"
      ],
      "dependsOn": [
        "kernel"
      ]
    },
    {
      "id": "governance",
      "name": "Governance",
      "layer": 3,
      "description": "Code analysis, policies, AI governance, production approval and approval channels.",
      "paths": [
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/CodeAnalysis.java",
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/Policies.java",
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/ProductionApproval.java",
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/ApprovalChannels.java",
        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/CodeAnalysis*Test.java",
        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/Policies*Test.java",
        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/ProductionApproval*Test.java",
        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/ApprovalChannels*Test.java",
        "platform/ui/src/console/Policies.tsx",
        "platform/ui/src/console/Governance.tsx",
        "platform/ui/src/console/PhoneNotifications.tsx",
        "platform/ui/src/console/PhoneNotifications.test.tsx"
      ],
      "dependsOn": [
        "kernel"
      ]
    },
    {
      "id": "insights",
      "name": "Insights",
      "layer": 3,
      "description": "Analytics, dashboards, alerts, metrics and events out.",
      "paths": [
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/Analytics.java",
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/Dashboards.java",
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/Alerts.java",
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/Metrics.java",
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/EventSubscriptions.java",
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/SyslogForwarder.java",
        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/Analytics*Test.java",
        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/Dashboards*Test.java",
        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/Alerts*Test.java",
        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/Metrics*Test.java",
        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/EventSubscriptions*Test.java",
        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/SyslogForwarder*Test.java",
        "platform/ui/src/console/Insights.tsx",
        "platform/ui/src/console/Dashboards.tsx",
        "platform/ui/src/console/Alerts.tsx",
        "platform/ui/src/console/Operations.tsx",
        "platform/ui/src/console/Overview.tsx",
        "platform/ui/src/console/Value.tsx",
        "platform/ui/src/console/Capacity.tsx",
        "platform/ui/src/console/EventSubscriptions.tsx",
        "platform/ui/src/console/Activity.tsx",
        "platform/ui/src/console/EventSubscriptions.test.tsx",
        "platform/ui/src/console/BusinessAgents.tsx"
      ],
      "dependsOn": [
        "kernel"
      ]
    },
    {
      "id": "ai-services",
      "name": "AI services",
      "layer": 3,
      "description": "Prompt skills and knowledge bases. (Model connections, the AI gateway, are the kernel's.) Moved out of the kernel: platform/modules/ai-services (Gradle project :ai-services).",
      "paths": [
        "platform/modules/ai-services/**",
        "platform/ui/src/modules/ai-services/**"
      ],
      "dependsOn": [
        "kernel"
      ]
    },
    {
      "id": "low-code",
      "name": "Low-code apps",
      "layer": 3,
      "description": "Low-code apps, apps embedded in other sites and the business data store. (The console as a phone app, MobileApp, is the kernel's shell.) Moved out of the kernel: platform/modules/low-code (Gradle project :low-code).",
      "paths": [
        "platform/modules/low-code/**",
        "platform/ui/src/modules/low-code/**"
      ],
      "dependsOn": [
        "kernel"
      ]
    },
    {
      "id": "coe",
      "name": "Automation ideas",
      "layer": 3,
      "description": "Ideas suggested, voted, assessed and linked to the agent built. Moved out of the kernel: platform/modules/coe (Gradle project :coe).",
      "paths": [
        "platform/modules/coe/**",
        "platform/ui/src/modules/coe/**"
      ],
      "dependsOn": [
        "kernel"
      ]
    },
    {
      "id": "testing",
      "name": "Agent testing",
      "layer": 3,
      "description": "Test sets and their runs.",
      "paths": [
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/TestSets.java",
        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/TestSets*Test.java",
        "platform/ui/src/console/Tests.tsx"
      ],
      "dependsOn": [
        "kernel"
      ]
    },
    {
      "id": "runner-management",
      "name": "Runner management",
      "layer": 3,
      "description": "Runner pools, auto-scaling, runner care and updates.",
      "paths": [
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/PoolScaling.java",
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/RunnerCare.java",
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/RunnerUpdates.java",
        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/PoolScaling*Test.java",
        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/RunnerCare*Test.java",
        "platform/control-room/src/test/java/com/oneofficeautomation/controlroom/RunnerUpdates*Test.java",
        "platform/ui/src/console/Devices.tsx",
        "platform/ui/src/console/PoolScaling.tsx",
        "platform/ui/src/console/PoolScaling.test.tsx"
      ],
      "dependsOn": [
        "kernel"
      ]
    },
    {
      "id": "integration",
      "name": "Integration",
      "layer": 3,
      "description": "Agent APIs and serverless runs, the MCP server, SCIM, Git sync and API tasks.",
      "paths": [
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/ServerlessRuns.java",
        "platform/control-room/src/main/java/com/oneofficeautomation/controlroom/McpServer.java",
